{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "makariosvar/phue",
    "description": "Almost a web development framework.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Makarios Vardaxis",
            "email": "makariosvar@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "phue": "php bin/phue",
        "phue_test": "php bin/phue_test"
    },
    "require": {
        "php": ">=8.5",
        "nyholm/psr7": "^1.8",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "spiral/roadrunner-http": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Phue\\": "src/"
        },
        "files": [
            "src/Core/functions.php",
            "src/Core/Debug/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phue\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/phue"],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}