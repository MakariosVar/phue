{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "makarios-var/phue",
    "description": "Almost a web development framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Makarios Vardaxis",
            "email": "makariosvar@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Phue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phue\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
