<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">

    <!-- one testsuite per framework module + kit for cross-module tests. -->
    <testsuites>
        <testsuite name="core">
            <directory suffix="Test.php">tests/Core</directory>
        </testsuite>
        <testsuite name="schii">
            <directory suffix="Test.php">tests/Schii</directory>
        </testsuite>
        <testsuite name="rest">
            <directory suffix="Test.php">tests/Rest</directory>
        </testsuite>
        <testsuite name="phii">
            <directory suffix="Test.php">tests/Phii</directory>
        </testsuite>
        <testsuite name="auth">
            <directory suffix="Test.php">tests/Auth</directory>
        </testsuite>
        <testsuite name="server">
            <directory suffix="Test.php">tests/Server</directory>
        </testsuite>
        <testsuite name="events">
            <directory suffix="Test.php">tests/Events</directory>
        </testsuite>
        <testsuite name="compiler">
            <directory suffix="Test.php">tests/Compiler</directory>
        </testsuite>
        <testsuite name="devtools">
            <directory suffix="Test.php">tests/DevTools</directory>
        </testsuite>
        <testsuite name="kit">
            <directory suffix="Test.php">tests/App</directory>
            <directory suffix="Test.php">tests/Benchmark</directory>
            <directory suffix="Test.php">tests/Cache</directory>
            <directory suffix="Test.php">tests/ErrorPages</directory>
            <directory suffix="Test.php">tests/Production</directory>
        </testsuite>
        <!--
            Cross-cutting contracts about the test suite itself: the known-vulnerability
            ratchet, namespace/PSR-4 hygiene, the independence guard. These read other
            test files, so they must not live inside a module suite.
        -->
        <testsuite name="suite">
            <directory suffix="Test.php">tests/Suite</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/Modules/Phii/Generator/templates</directory>
        </exclude>
    </source>

</phpunit>