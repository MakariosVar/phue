<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">

    <testsuites>
        <testsuite name="Phue Test Suite">
            <directory suffix=".php">tests</directory>
        <exclude>tests/Core/Stubs</exclude>
        <exclude>tests/Schii/Stubs</exclude>
        <exclude>tests/Compiler/Fixtures</exclude>
        <exclude>tests/Benchmark/BenchmarkRunner.php</exclude>
        <exclude>tests/*/_tmp_*</exclude>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>

</phpunit>