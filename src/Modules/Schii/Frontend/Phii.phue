<php>
$phiiState = $state ?? [];

return [
    'title' => 'Phii Console',
    'state' => [
        'apiPrefix' => $phiiState['apiPrefix'] ?? '/api/schii',
        'phiiPrefix' => $phiiState['phiiPrefix'] ?? '/phii',
        'module' => $phiiState['module'] ?? 'admin',
    ],
    'scripts' => [],
];
</php>

<template>
<div class="phii-console p-4" v-cloak>
    <ph-toast ref="toast" position="top-right" :max="5" :duration="5000" />

    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="lg" class="mb-4">
        <div>
            <ph-heading :level="1" class="mb-0">Phii Generator Console</ph-heading>
            <ph-text color="muted">Plan, preview and apply schema-powered code generation</ph-text>
        </div>
        <ph-badge label="Schema-powered codegen" variant="info" pill />
    </ph-flex>

    <ph-row gutter="3">
        <ph-col span="12" lg="6">
            <ph-card title="Generate" subtitle="Pick a generator and scaffold application code from your schema." hoverable>
                <form id="phii-generate-form" @submit.prevent="submitGenerate">
                    <ph-select
                        v-model="form.generator"
                        label="Generator Type"
                        :options="generatorOptions"
                        helper-text="Pick the artifact to scaffold."
                        required
                    />

                    <div>
                        <ph-input
                            v-model="form.entity"
                            label="Entity / Model Name"
                            :placeholder="generator === 'module' ? 'e.g. Blog (new module)' : 'e.g. Profile'"
                            :helper-text="entityHelperText"
                            required
                            :list="entitiesLoaded ? 'entity-suggestions' : undefined"
                            @input="onEntityInput"
                        />
                        <datalist v-if="entitiesLoaded" id="entity-suggestions">
                            <option v-for="e in knownEntities" :key="e" :value="e" />
                        </datalist>
                    </div>

                    <ph-row gutter="3">
                        <ph-col span="12" md="6">
                            <ph-input v-model="form.module" label="Module" placeholder="admin" required />
                        </ph-col>
                        <ph-col span="12" md="6">
                            <template v-if="generator === 'model'">
                                <ph-select
                                    v-model="form.type"
                                    label="Model Type"
                                    :options="modelTypeOptions"
                                    helper-text="ActiveRecord or DataMapper."
                                    required
                                />
                            </template>
                            <template v-else-if="generator === 'migration'">
                                <ph-select
                                    v-model="form.driver"
                                    label="Driver"
                                    :options="driverOptions"
                                    helper-text="SQL target dialect for the migration."
                                    required
                                />
                            </template>
                            <template v-else-if="generator === 'controller'">
                                <ph-checkbox
                                    v-model="form.options.actions.index"
                                    label="index"
                                />
                                <ph-checkbox
                                    v-model="form.options.actions.store"
                                    label="store"
                                />
                                <ph-checkbox
                                    v-model="form.options.actions.show"
                                    label="show"
                                />
                                <ph-checkbox
                                    v-model="form.options.actions.update"
                                    label="update"
                                />
                                <ph-checkbox
                                    v-model="form.options.actions.delete"
                                    label="delete"
                                />
                                <ph-text v-if="Object.keys(form.options.actions).length === 0" color="muted" size="sm" class="mt-2">No actions selected — all will be generated.</ph-text>
                            </template>
                            <template v-else-if="generator === 'crud'">
                                <ph-text color="muted" size="sm">Uses standard defaults — Preview to inspect files</ph-text>
                            </template>
                            <template v-else-if="generator === 'module'">
                                <ph-text color="muted" size="sm">Module scaffold — no additional options</ph-text>
                            </template>
                        </ph-col>
                    </ph-row>

                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <ph-button type="button" variant="outline" :loading="previewing" @click="previewPlan">
                            Preview
                        </ph-button>
                        <ph-button type="button" variant="primary" :loading="submitting" @click="confirmGenerate">
                            Generate
                        </ph-button>
                    </div>
                </form>
            </ph-card>
        </ph-col>

        <ph-col span="12" lg="6">
            <ph-card title="Execution Plan" subtitle="Plan mutations, inspect diffs, then apply (with optional ZIP backup)." hoverable>
                <template v-if="stage === 'preview' && plan.length">
                    <phii-preview-panel
                        :plan="plan"
                        :applying="applying"
                        :selected-paths="selectedPaths"
                        :conflict-policy="conflictPolicy"
                        @apply="confirmApply"
                        @toggle-path="togglePath"
                        @conflict-policy-change="conflictPolicy = $event"
                    />
                </template>

                <template v-else-if="stage === 'result' && result.length">
                    <ph-alert variant="success" title="Generation complete">
                        <ul class="mb-0 mt-1 small">
                            <li v-for="path in result" :key="path"><ph-text size="sm" as="code" class="mb-0 text-break">{{ path }}</ph-text></li>
                        </ul>
                    </ph-alert>
                    <ph-button variant="ghost" size="sm" class="mt-2" @click="stage = 'idle'; result = []">Dismiss</ph-button>
                </template>

                <template v-else-if="stage === 'applied' && applyResult">
                    <ph-alert variant="success" title="Plan applied">
                        <ul class="mb-0 mt-1 small">
                            <li>Written: {{ applyResult.written ?? 0 }}</li>
                            <li>Skipped: {{ applyResult.skipped ?? 0 }}</li>
                            <li>Conflicts: {{ applyResult.conflicts ?? 0 }}</li>
                            <li v-if="applyResult.backup">Backup: {{ applyResult.backup }}</li>
                        </ul>
                    </ph-alert>
                    <ph-button variant="ghost" size="sm" class="mt-2" @click="stage = 'idle'; applyResult = null">Dismiss</ph-button>
                </template>

                <ph-text v-else color="muted">
                    Use Preview to inspect the exact mutations before writing. Nothing is written to disk
                    until you Apply the plan.
                </ph-text>
            </ph-card>
        </ph-col>
    </ph-row>

    <ph-modal v-model="confirmGenerateOpen" title="Confirm Generate" size="md">
        <ph-text>Generate <strong>{{ form.generator.toUpperCase() }}</strong> for <strong>{{ form.entity }}</strong> in module <strong>{{ form.module }}</strong>?</ph-text>
        <ph-checkbox v-model="generateForce" label="Force overwrite existing files" />
        <template #footer>
            <ph-button variant="ghost" @click="confirmGenerateOpen = false">Cancel</ph-button>
            <ph-button variant="primary" :loading="submitting" @click="executeGenerate">Generate</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="confirmApplyOpen" title="Confirm Apply" size="md">
        <ph-text>Apply <strong>{{ selectedCount }}</strong> of <strong>{{ plan.length }}</strong> planned file(s)?</ph-text>
        <ph-checkbox v-model="applyBackup" label="Create ZIP backup before writing" />
        <template #footer>
            <ph-button variant="ghost" @click="confirmApplyOpen = false">Cancel</ph-button>
            <ph-button variant="danger" :loading="applying" @click="executeApply">Apply</ph-button>
        </template>
    </ph-modal>
</div>
</template>

<script type="module">
import { createApp, ref, reactive, computed, onMounted } from 'vue';

if (typeof document !== 'undefined' && !document.getElementById('phue-v-cloak-style')) {
    const style = document.createElement('style');
    style.id = 'phue-v-cloak-style';
    style.textContent = '[v-cloak] { display: none !important; }';
    document.head.appendChild(style);
}

function api(url, opts = {}) {
    const headers = Object.assign({ 'Accept': 'application/json' }, opts.headers || {});
    return fetch(url, Object.assign({}, opts, { headers }));
}

export default function mountApp() {
    window.__phueApp?.unmount?.();

    window.__phueApp = createApp({
        setup() {
            const initialState = window.__INITIAL_STATE__ || {};
            const phiiPrefix = initialState.phiiPrefix || '/phii';
            const apiBase = initialState.apiPrefix || '/api/schii';

            const generators = ref(['crud', 'model', 'controller', 'migration', 'module']);
            const submitting = ref(false);
            const previewing = ref(false);
            const applying = ref(false);
            const toast = ref(null);
            const result = ref([]);
            const applyResult = ref(null);
            const plan = ref([]);
            const selectedPaths = ref(null);
            const conflictPolicy = ref('overwrite');
            const stage = ref('idle'); // idle | preview | result | applied

            const knownEntities = ref([]);
            const entitiesLoaded = ref(false);

            const form = reactive({
                generator: 'crud',
                entity: '',
                module: initialState.module || 'admin',
                type: 'active-record',
                driver: 'sqlite',
                options: {
                    actions: {
                        index: true,
                        store: true,
                        show: true,
                        update: true,
                        delete: true,
                    },
                },
            });

            const generatorOptions = computed(() =>
                generators.value.map(g => ({ label: g.toUpperCase(), value: g }))
            );

            const modelTypeOptions = computed(() => [
                { label: 'ActiveRecord', value: 'active-record' },
                { label: 'DataMapper', value: 'data-mapper' },
            ]);

            const driverOptions = computed(() => [
                { label: 'SQLite', value: 'sqlite' },
                { label: 'MySQL', value: 'mysql' },
                { label: 'PostgreSQL', value: 'pgsql' },
            ]);

            const generator = computed(() => form.generator);

            const entityHelperText = computed(() => {
                if (generator.value === 'module') return 'Module slug — a brand new module will be scaffolded.';
                return 'Autocompletes discovered entities; short names resolve against App\\Models.';
            });

            const loadEntities = async () => {
                if (entitiesLoaded.value) return;
                try {
                    const res = await api(`${apiBase}/schema`);
                    if (!res.ok) return;
                    const data = await res.json();
                    knownEntities.value = Array.isArray(data) ? data : (data.entities || []);
                    entitiesLoaded.value = true;
                } catch {
                    entitiesLoaded.value = false;
                }
            };

            const onEntityInput = () => {
                if (!entitiesLoaded.value) loadEntities();
            };

            const validateForm = () => {
                const errors = [];
                if (!form.entity.trim()) errors.push('Entity / Model Name is required.');
                if (!form.module.trim()) errors.push('Module is required.');
                if (generator.value === 'model' && !form.type) errors.push('Model Type is required.');
                if (generator.value === 'migration' && !form.driver) errors.push('Driver is required.');
                if (generator.value === 'controller') {
                    const hasActions = Object.values(form.options.actions).some(v => v);
                    if (!hasActions) errors.push('At least one controller action must be selected.');
                }
                return errors;
            };

            const notify = (message, variant = 'info') => {
                toast.value?.push({ message, variant });
            };

            const confirmGenerate = () => {
                const errors = validateForm();
                if (errors.length) {
                    notify(errors.join(' '), 'error');
                    return;
                }
                confirmGenerateOpen.value = true;
            };

            const executeGenerate = async () => {
                confirmGenerateOpen.value = false;
                const options = buildOptions();
                if (!options) return;

                submitting.value = true;
                try {
                    const res = await api(`${phiiPrefix}/generate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ...makePayload(options), force: generateForce.value }),
                    });

                    const data = await res.json().catch(() => ({}));

                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }

                    result.value = Array.isArray(data.paths) ? data.paths : (data.paths ? [data.paths] : []);
                    stage.value = 'result';
                    notify(result.value.length ? `Generated ${result.value.length} file(s).` : 'Generation completed.', 'success');
                } catch (err) {
                    notify(err?.message || 'Failed to execute generate action.', 'error');
                    result.value = [];
                } finally {
                    submitting.value = false;
                }
            };

            const previewPlan = async () => {
                const errors = validateForm();
                if (errors.length) {
                    notify(errors.join(' '), 'error');
                    return;
                }

                const options = buildOptions();
                if (!options) return;

                previewing.value = true;
                try {
                    const res = await api(`${phiiPrefix}/preview`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(makePayload(options)),
                    });

                    const data = await res.json().catch(() => ({}));

                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }

                    plan.value = Array.isArray(data.plan) ? data.plan : [];
                    selectedPaths.value = plan.value.map(p => p.path);
                    result.value = [];
                    applyResult.value = null;
                    stage.value = 'preview';
                    notify(plan.value.length ? `Preview ready: ${plan.value.length} mutation(s).` : 'No mutations were planned.', plan.value.length ? 'info' : 'warning');
                } catch (err) {
                    notify(err?.message || 'Failed to preview plan.', 'error');
                    plan.value = [];
                } finally {
                    previewing.value = false;
                }
            };

            const confirmApply = ({ backup }) => {
                if (!plan.value.length) return;
                applyBackup.value = backup;
                confirmApplyOpen.value = true;
            };

            const executeApply = async () => {
                confirmApplyOpen.value = false;
                const options = buildOptions();
                if (!options) return;

                applying.value = true;
                try {
                    const res = await api(`${phiiPrefix}/apply`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            ...makePayload(options),
                            backup: applyBackup.value,
                            conflictPolicy: conflictPolicy.value,
                            paths: Array.isArray(selectedPaths.value) ? selectedPaths.value : undefined,
                        }),
                    });

                    const data = await res.json().catch(() => ({}));

                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }

                    applyResult.value = data;
                    plan.value = [];
                    selectedPaths.value = null;
                    result.value = [];
                    stage.value = 'applied';
                    notify(`Applied: ${data.written ?? 0} written, ${data.skipped ?? 0} skipped, ${data.conflicts ?? 0} conflict(s).${data.backup ? ` Backup: ${data.backup}` : ''}`, 'success');
                } catch (err) {
                    notify(err?.message || 'Failed to apply plan.', 'error');
                } finally {
                    applying.value = false;
                }
            };

            const togglePath = (path) => {
                if (!Array.isArray(selectedPaths.value)) {
                    selectedPaths.value = plan.value.map(p => p.path);
                }
                const idx = selectedPaths.value.indexOf(path);
                if (idx >= 0) {
                    selectedPaths.value = selectedPaths.value.filter(p => p !== path);
                } else {
                    selectedPaths.value = [...selectedPaths.value, path];
                }
            };

            const buildOptions = () => {
                const opts = {};
                if (generator.value === 'model') opts.type = form.type;
                else if (generator.value === 'migration') opts.driver = form.driver;
                else if (generator.value === 'controller') opts.actions = { ...form.options.actions };
                return opts;
            };

            const makePayload = (options) => ({
                generator: form.generator,
                entity: form.entity.trim(),
                module: form.module.trim() || 'admin',
                options,
            });

            const selectedCount = computed(() => {
                if (!Array.isArray(selectedPaths.value)) return plan.value.length;
                return selectedPaths.value.length;
            });

            const confirmGenerateOpen = ref(false);
            const generateForce = ref(false);
            const confirmApplyOpen = ref(false);
            const applyBackup = ref(true);

            onMounted(loadEntities);

            return {
                generators,
                generatorOptions,
                modelTypeOptions,
                driverOptions,
                generator,
                entityHelperText,
                form,
                submitting,
                previewing,
                applying,
                toast,
                result,
                applyResult,
                plan,
                selectedPaths,
                conflictPolicy,
                stage,
                knownEntities,
                entitiesLoaded,
                confirmGenerateOpen,
                generateForce,
                confirmApplyOpen,
                applyBackup,
                selectedCount,
                submitGenerate: confirmGenerate,
                previewPlan,
                applyPlan: confirmApply,
                togglePath,
                onEntityInput,
            };
        }
    });

    window.__phueApp.mount('#app');
}

if (typeof window !== 'undefined' && !window.__phueExplorerInitialized) {
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountApp);
    } else {
        mountApp();
    }
}
</script>