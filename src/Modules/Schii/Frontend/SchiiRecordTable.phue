<template>
  <div>
    <div v-if="(selectable && rows.length) || visibleFields.length < fields.length" class="d-flex align-items-center gap-2 mb-2 flex-wrap">
      <template v-if="selectable && rows.length">
        <ph-checkbox
          :model-value="allOnPageSelected"
          :indeterminate="someOnPageSelected"
          label="Select all on page"
          @update:model-value="selectAllPage($event)"
        />
        <ph-badge v-if="selected.length" :label="`${selected.length} selected`" variant="info" pill />
        <ph-button v-if="selected.length" variant="ghost" size="sm" @click="clearSelection">Clear</ph-button>
      </template>
      <span v-if="visibleFields.length < fields.length" class="text-body-secondary small ms-auto">
        {{ fields.length - visibleFields.length }} hidden column(s)
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle">
        <thead>
          <tr>
            <th v-if="selectable" scope="col"></th>
            <th v-for="col in columns" :key="col.key" scope="col">
              <ph-flex direction="row" align="center" gap="xs">
                <span
                  :class="['fw-semibold', { 'text-primary': sortable(col) }]"
                  :style="sortable(col) ? 'cursor: pointer;' : ''"
                  role="button"
                  :tabindex="sortable(col) ? 0 : null"
                  :aria-sort="sortAria(col)"
                  @click="sortable(col) && toggleSort(col)"
                  @keyup.enter="sortable(col) && toggleSort(col)"
                >{{ col.label || col.key }}</span>
                <span v-if="isSortedAsc(col)" class="text-primary fw-bold small" aria-hidden="true">▲</span>
                <span v-else-if="isSortedDesc(col)" class="text-primary fw-bold small" aria-hidden="true">▼</span>
              </ph-flex>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr v-if="rows.length === 0">
            <td :colspan="columns.length + (selectable ? 1 : 0)" class="text-center text-body-secondary py-4">
              <ph-flex direction="column" align="center" gap="sm">
                <ph-text color="muted">No records found.</ph-text>
                <ph-button v-if="$parent && typeof $parent.openCreateModal === 'function'" variant="primary" size="sm" @click="$parent.openCreateModal()">Create first record</ph-button>
              </ph-flex>
            </td>
          </tr>
          <tr
            v-for="(row, idx) in rows"
            :key="row.id ?? idx"
            :class="{ 'table-active': selected.includes(row.id) }"
          >
            <td v-if="selectable" class="text-center" @click.stop>
              <ph-checkbox
                :model-value="isSelected(row.id)"
                @update:model-value="toggleSelect(row.id, $event)"
              />
            </td>
            <td v-for="col in columns" :key="col.key">
              <template v-if="col.key === '__actions'">
                <div class="d-flex gap-2">
                  <ph-button variant="outline" size="sm" @click.stop="$emit('edit', row)" :aria-label="`Edit ${row.id || 'record'}`">Edit</ph-button>
                  <ph-button variant="ghost" size="sm" @click.stop="$emit('detail', row)" :aria-label="`View detail for ${row.id || 'record'}`">Detail</ph-button>
                  <ph-button variant="danger" size="sm" @click.stop="$emit('delete-request', row.id)" :aria-label="`Delete ${row.id || 'record'}`">Delete</ph-button>
                </div>
              </template>
              <template v-else>
                <ph-badge v-if="isBoolField(col)" :label="row[col.key] ? 'Yes' : 'No'" :variant="row[col.key] ? 'success' : 'secondary'" />
                <ph-badge
                  v-else-if="isSelectField(col)"
                  :label="selectLabel(col, row[col.key])"
                  variant="info"
                  pill
                />
                <template v-else>{{ formatCell(col, row[col.key]) }}</template>
              </template>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div v-if="lastPage > 1" class="d-flex justify-content-center mt-3">
      <ph-pagination
        :current-page="page"
        :total-pages="lastPage"
        @page-change="(p) => $emit('page-change', p)"
      />
    </div>
  </div>
</template>

<script>
export default {
  name: 'SchiiRecordTable',
  props: {
    fields: {
      type: Array,
      default: () => []
    },
    rows: {
      type: Array,
      default: () => []
    },
    loading: {
      type: Boolean,
      default: false
    },
    page: {
      type: Number,
      default: 1
    },
    lastPage: {
      type: Number,
      default: 1
    },
    selected: {
      type: Array,
      default: () => []
    },
    selectable: {
      type: Boolean,
      default: false
    },
    visibleFields: {
      type: Array,
      default: null
    },
    sort: {
      type: [String, Object],
      default: null
    }
  },
  emits: ['update:selected', 'page-change', 'edit', 'delete-request', 'sort-change', 'detail'],
  data() {
    return {};
  },
  computed: {
    columns() {
      const cols = this.fields
        .filter(f => this.isVisible(f))
        .map(f => ({ key: f.name, label: f.label || f.name, field: f }));
      cols.push({ key: '__actions', label: 'Actions', field: null });
      return cols;
    },
    boolFields() {
      return this.fields
        .filter(f => f.type === 'boolean' || f.type === 'bool' || f.widget === 'checkbox')
        .map(f => f.name);
    },
    selectFields() {
      return this.fields
        .filter(f => f.type === 'select' || f.widget === 'select')
        .reduce((acc, f) => {
          acc[f.name] = f;
          return acc;
        }, {});
    },
    sortState() {
      if (typeof this.sort === 'string') {
        const idx = this.sort.indexOf(':');
        if (idx === -1) return { field: this.sort, dir: 'asc' };
        return { field: this.sort.slice(0, idx), dir: this.sort.slice(idx + 1) };
      }
      return this.sort || {};
    },
    onPageIds() {
      return this.rows.map(r => r.id).filter(id => id !== undefined && id !== null);
    },
    allOnPageSelected() {
      return this.onPageIds.length > 0 && this.onPageIds.every(id => this.isSelected(id));
    },
    someOnPageSelected() {
      return this.onPageIds.some(id => this.isSelected(id)) && !this.allOnPageSelected;
    }
  },
  methods: {
    rowKey(row) {
      return row.id !== undefined && row.id !== null ? `id:${row.id}` : `idx:${row.__idx ?? JSON.stringify(row)}`;
    },
    isVisible(field) {
      if (!Array.isArray(this.visibleFields)) return true;
      return this.visibleFields.includes(field.name);
    },
    isBoolField(key) {
      return this.boolFields.includes(key);
    },
    isSelectField(col) {
      return !!this.selectFields[col.key];
    },
    selectLabel(col, value) {
      const field = this.selectFields[col.key];
      const opts = Array.isArray(field.options) ? field.options : [];
      const opt = opts.find(o => (typeof o === 'object' ? (o.value ?? o.label) === value : o === value));
      if (opt === undefined) return value ?? '—';
      return typeof opt === 'object' ? (opt.label ?? opt.value) : String(opt);
    },
    sortable(col) {
      return !!(col.field && col.field.sortable);
    },
    sortAria(col) {
      if (this.sortState.field !== col.key) return null;
      return this.sortState.dir === 'asc' ? 'ascending' : 'descending';
    },
    isSortedAsc(col) {
      return this.sortState.field === col.key && this.sortState.dir !== 'desc';
    },
    isSortedDesc(col) {
      return this.sortState.field === col.key && this.sortState.dir === 'desc';
    },
    toggleSort(col) {
      if (!col.field || !col.field.sortable) return;
      if (this.sortState.field !== col.key) {
        this.$emit('sort-change', `${col.key}:asc`);
      } else {
        this.$emit('sort-change', `${col.key}:${this.sortState.dir === 'asc' ? 'desc' : 'asc'}`);
      }
    },
    formatCell(col, value) {
      if (value === null || value === undefined) return '—';
      if (Array.isArray(value)) return value.join(', ');
      if (typeof value === 'object') {
        try {
          return JSON.stringify(value);
        } catch {
          return String(value);
        }
      }
      if (col && (col.type === 'date' || col.widget === 'date') && typeof value === 'string' && value.includes('T')) {
        try {
          return new Date(value).toLocaleString();
        } catch {
          return value;
        }
      }
      if (typeof value === 'number') return String(value);
      const s = String(value);
      return s.length > 120 ? `${s.slice(0, 120)}…` : s;
    },
    isSelected(id) {
      return this.selected.includes(id);
    },
    toggleSelect(id, checked) {
      if (checked) {
        if (!this.isSelected(id)) {
          this.$emit('update:selected', [...this.selected, id]);
        }
      } else {
        this.$emit('update:selected', this.selected.filter(v => v !== id));
      }
    },
    selectAllPage(checked) {
      if (checked) {
        const merged = new Set([...this.selected, ...this.onPageIds]);
        this.$emit('update:selected', [...merged]);
      } else {
        const remaining = this.selected.filter(id => !this.onPageIds.includes(id));
        this.$emit('update:selected', remaining);
      }
    },
    clearSelection() {
      this.$emit('update:selected', []);
    }
  }
};
</script>