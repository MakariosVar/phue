<php>
$schiiState = $state ?? [];
$configuredPrefix = $schiiState['apiPrefix'] ?? null;

return [
    'title' => 'Schii Console',
    'state' => [
        'apiPrefix' => $configuredPrefix ?? $apiPrefix ?? '/api/schii',
    ],
    'scripts' => [],
];
</php>

<template>
<div class="schii-console p-4" v-cloak>
    <ph-toast ref="toast" position="top-right" :max="5" :duration="5000" />
    
    <div class="page-header mb-4">
        <ph-heading :level="1" class="mb-1">Schii Console</ph-heading>
        <ph-text color="muted">Zero-Controller Dynamic REST Management Interface</ph-text>
    </div>

    <ph-row gutter="3">
        <ph-col span="12" md="4" lg="3">
            <ph-card :title="`Entities (${entities.length})`" :bordered="false">
                <div class="mb-2">
                    <ph-input
                        v-model="entitySearch"
                        type="search"
                        placeholder="Search entities…"
                        style="margin-bottom: 0;"
                    />
                </div>
                <div v-if="loadingEntities">
                    <ph-skeleton v-for="n in 4" :key="n" variant="text" width="100%" height="18" class="d-block mb-3" />
                </div>
                <ph-stack v-else-if="filteredEntities.length" gap="xs">
                    <div v-for="slug in filteredEntities" :key="slug">
                        <ph-button
                            :variant="currentEntity === slug ? 'primary' : 'ghost'"
                            block
                            class="text-start"
                            @click="selectEntity(slug)"
                            :aria-current="currentEntity === slug ? 'page' : undefined"
                        >
                            <span class="d-flex align-items-center gap-2">
                                <span v-if="entityMeta[slug]?.icon" aria-hidden="true">{{ entityMeta[slug].icon }}</span>
                                <span class="flex-grow-1">{{ entityMeta[slug]?.label || slug }}</span>
                            </span>
                        </ph-button>
                    </div>
                </ph-stack>
                <ph-text v-else-if="entitySearch" color="muted" size="sm">No entities match “{{ entitySearch }}”.</ph-text>
                <ph-text v-else color="muted" size="sm">No entities discovered.</ph-text>
            </ph-card>
        </ph-col>

        <ph-col span="12" md="8" lg="9">
            <ph-card>
                <template #header>
                    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="md">
                        <div>
                            <ph-text weight="semibold" size="lg" class="mb-0">
                                {{ currentLabel || currentEntity || 'Data Browser' }}
                            </ph-text>
                            <ph-text v-if="currentEntity" size="sm" color="muted" class="mb-0">
                                {{ total }} record(s) &middot; page {{ page }} of {{ lastPage }}
                            </ph-text>
                            <ph-text v-if="currentEntity && entityMeta[currentEntity]?.description" size="sm" color="muted" class="mb-0 mt-1">
                                {{ entityMeta[currentEntity].description }}
                            </ph-text>
                        </div>
                        <ph-badge v-if="currentEntity" :label="currentEntity" variant="info" pill />
                    </ph-flex>
                </template>

                <template v-if="!currentEntity">
                    <ph-text color="muted">Select an entity from the sidebar to inspect schema and records.</ph-text>
                </template>

                <template v-else>
                    <schii-record-toolbar
                        :entity="currentEntity"
                        v-model:query="query"
                        :selected="selected"
                        :fields="fields"
                        :filters="filters"
                        :sort="sort"
                        :page-size="pageSize"
                        :visible-fields="visibleFields"
                        @search="search"
                        @refresh="loadRows"
                        @create="openCreateModal"
                        @schema-diff="openDiff"
                        @audit="openAudit"
                        @import-open="importOpen = true"
                        @export-csv="exportRecords('csv')"
                        @export-json="exportRecords('json')"
                        @bulk-delete="askBulk('delete')"
                        @filters-change="onFiltersChange"
                        @sort-change="onSortChange"
                        @page-size-change="onPageSizeChange"
                        @visible-fields-change="onVisibleFieldsChange"
                    />

                    <template v-if="loading">
                        <ph-skeleton v-for="n in 4" :key="n" variant="text" width="100%" height="18" class="d-block mb-3" />
                    </template>
                    <ph-alert v-else-if="rowsError" variant="warning" :message="rowsError + (currentEntity && /no such table|table .* doesn't exist|SQLSTATE\\[HY000\\].*no such table/i.test(rowsError) ? ' — Use the Schema Diff button in the Admin dropdown to create the table.' : '')" dismissible class="mb-3" @dismiss="rowsError = null" />

                    <template v-else>
                        <schii-record-table
                            :fields="fields"
                            :rows="rows"
                            :page="page"
                            :last-page="lastPage"
                            :visible-fields="visibleFields"
                            :sort="sort"
                            :layout="layout"
                            v-model:selected="selected"
                            selectable
                            @page-change="onPageChange"
                            @edit="openEditModal"
                            @delete-request="askDelete"
                            @sort-change="onSortChange"
                        />
                    </template>
                </template>
            </ph-card>
        </ph-col>
    </ph-row>

    <ph-modal v-model="showModal"
              :title="isEditing ? 'Edit ' + (currentLabel || currentEntity) : 'Create ' + (currentLabel || currentEntity)"
              size="lg"
              :closable="!dirty"
              @close="requestCloseModal">
        <ph-alert v-if="formError" variant="error" :message="formError" class="mb-3" />

        <form id="schii-record-form" novalidate @submit.prevent="submitForm">
            <ph-row gutter="3">
                <ph-col v-for="field in writableFields" :key="field.name" span="12" md="6">
                    <ph-input
                        v-if="isTextWidget(field)"
                        v-model="form[field.name]"
                        :type="inputType(field)"
                        :step="inputStep(field)"
                        :label="field.label || field.name"
                        :required="field.required"
                        :error="fieldErrors[field.name]"
                        :helper-text="fieldHelper(field)"
                        :disabled="isEditing && field.name === 'id'"
                        @blur="touchField(field.name)"
                    />
                    <ph-form-field
                        v-else-if="field.widget === 'radio'"
                        :label="field.label || field.name"
                        :error="fieldErrors[field.name]"
                    >
                        <div class="d-flex flex-wrap gap-3 pt-1">
                            <ph-radio
                                v-for="opt in selectOptions(field)"
                                :key="opt.value"
                                v-model="form[field.name]"
                                :name="'schii-' + field.name"
                                :value="opt.value"
                                :label="opt.label"
                            />
                        </div>
                    </ph-form-field>
                    <ph-select
                        v-else-if="field.type === 'select' || field.widget === 'select'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                        :options="selectOptions(field)"
                        :required="field.required"
                        :error="fieldErrors[field.name]"
                    />
                    <ph-textarea
                        v-else-if="field.widget === 'textarea' || field.type === 'json'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                        :rows="field.type === 'json' ? 5 : 3"
                        :required="field.required"
                        :error="fieldErrors[field.name]"
                        :helper-text="field.type === 'json' ? 'JSON object' : undefined"
                    />
                    <ph-checkbox
                        v-else-if="field.type === 'boolean' || field.type === 'bool' || field.widget === 'checkbox'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                    />
                </ph-col>
            </ph-row>
        </form>

        <template #footer>
            <ph-text v-if="dirty" size="sm" color="muted" class="me-auto">You have unsaved changes.</ph-text>
            <ph-button variant="ghost" @click="requestCloseModal">Cancel</ph-button>
            <ph-button variant="primary" :loading="submitting" @click="submitForm" :disabled="!isFormValid">Save</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="confirmCloseOpen" title="Discard changes?" size="sm">
        <ph-text>You have unsaved changes in the current form. Discard them?</ph-text>
        <template #footer>
            <ph-button variant="ghost" @click="confirmCloseOpen = false">Keep editing</ph-button>
            <ph-button variant="danger" @click="forceCloseModal">Discard</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="confirmOpen" title="Confirm delete" size="sm">
        <ph-text>Are you sure you want to delete record #{{ pendingDeleteId }}? This cannot be undone.</ph-text>
        <template #footer>
            <ph-button variant="ghost" @click="confirmOpen = false">Cancel</ph-button>
            <ph-button variant="danger" @click="confirmDelete">Delete</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="bulkConfirmOpen" :title="bulkTitle" size="sm">
        <ph-text>{{ bulkMessage }}</ph-text>
        <template #footer>
            <ph-button variant="ghost" @click="bulkConfirmOpen = false">Cancel</ph-button>
            <ph-button
                variant="danger"
                :loading="bulkSubmitting"
                @click="confirmBulk"
            >Confirm</ph-button>
        </template>
    </ph-modal>

    <schii-import-modal
        v-model="importOpen"
        :entity="currentEntity"
        :fields="fields"
        :busy="importing"
        :result="importResult"
        @import="onImport"
    />

    <schii-schema-diff-modal
        v-model="diffOpen"
        :entity="currentEntity"
        :diff="diff"
        :loading="diffLoading"
        :applying="diffApplying"
        :sync-result="diffResult"
        @apply="onApplyDiff"
        @reload="loadDiff"
    />

    <schii-audit-panel
        v-model="auditOpen"
        :logs="auditLogs"
        :loading="auditLoading"
        @refresh="loadAudit"
    />
</div>
</template>

<script type="module">
import { createApp, ref, reactive, computed, onMounted, watch } from 'vue';

if (typeof document !== 'undefined' && !document.getElementById('phue-v-cloak-style')) {
    const style = document.createElement('style');
    style.id = 'phue-v-cloak-style';
    style.textContent = '[v-cloak] { display: none !important; }';
    document.head.appendChild(style);
}

function parseQuery(win) {
    const out = {};
    if (!win) return out;
    const qs = win.location.search.replace(/^\?/, '');
    if (!qs) return out;
    new URLSearchParams(qs).forEach((v, k) => {
        const match = /^filter\[(.+)\]$/.exec(k);
        if (match) {
            out.filter = out.filter || {};
            out.filter[match[1]] = v;
        } else {
            out[k] = v;
        }
    });
    return out;
}

function api(url, opts = {}) {
    const headers = Object.assign({ 'Accept': 'application/json' }, opts.headers || {});
    return fetch(url, Object.assign({}, opts, { headers })).then(res => {
        if (res.status === 401) {
            if (typeof window !== 'undefined' && window.location.pathname !== '/login') {
                window.location.href = '/login';
            }
        }
        return res;
    });
}

export default function mountApp() {
    window.__phueApp?.unmount?.();

    window.__phueApp = createApp({
        setup() {
            const DEFAULT_PAGE_SIZE = 10;
            const apiPrefix = window.__INITIAL_STATE__?.apiPrefix || '/api/schii';

            const queryParams = parseQuery(window);

            const entities = ref([]);
            const entityMeta = ref({});
            const loadingEntities = ref(true);
            const entitySearch = ref('');
            const currentEntity = ref(queryParams.entity || null);
            const fields = ref([]);
            const layout = ref('grid');
            const rows = ref([]);
            const loading = ref(false);
            const rowsError = ref(null);
            const toast = ref(null);

            const page = ref(parseInt(queryParams.page) || 1);
            const lastPage = ref(1);
            const total = ref(0);
            const query = ref(queryParams.q || '');
            const filters = reactive({});
            const sort = ref(queryParams.sort || '');
            const pageSize = ref(parseInt(queryParams.limit) || DEFAULT_PAGE_SIZE);
            const visibleFields = ref(null);
            const selected = ref([]);

            Object.entries(queryParams.filter || {}).forEach(([k, v]) => {
                if (v !== '') filters[k] = v;
            });

            const writableFields = computed(() =>
                fields.value.filter(f => !f.primaryKey && f.name !== 'id' && f.writable !== false && !f.readonly)
            );

            const currentLabel = computed(() =>
                (entityMeta.value[currentEntity.value] || {}).label || currentEntity.value
            );

            const filteredEntities = computed(() => {
                const term = entitySearch.value.trim().toLowerCase();
                if (!term) return entities.value;
                return entities.value.filter(slug =>
                    slug.toLowerCase().includes(term) ||
                    ((entityMeta.value[slug] || {}).label || '').toLowerCase().includes(term)
                );
            });

            const showModal = ref(false);
            const isEditing = ref(false);
            const activeId = ref(null);
            const submitting = ref(false);
            const formError = ref(null);
            const form = reactive({});
            const dirty = ref(false);
            const dirtySnapshot = ref({});
            const touched = ref({});
            const fieldErrors = ref({});
            const pendingClose = ref(false);
            const confirmCloseOpen = ref(false);

            const confirmOpen = ref(false);
            const pendingDeleteId = ref(null);

            const bulkConfirmOpen = ref(false);
            const pendingBulk = ref(null);
            const bulkSubmitting = ref(false);

            const importOpen = ref(false);
            const importing = ref(false);
            const importResult = ref(null);

            const diffOpen = ref(false);
            const diff = ref(null);
            const diffLoading = ref(false);
            const diffApplying = ref(false);
            const diffResult = ref(null);

            const auditOpen = ref(false);
            const auditLogs = ref([]);
            const auditLoading = ref(false);

            const bulkTitle = computed(() =>
                pendingBulk.value && pendingBulk.value.type === 'delete'
                    ? 'Delete selected records'
                    : 'Confirm bulk action'
            );

            const bulkMessage = computed(() => {
                if (!pendingBulk.value) return '';
                const count = selected.value.length;
                const action = pendingBulk.value.type;
                const what = action === 'delete' ? 'deleted' : 'updated';
                const verb = action === 'delete' ? 'delete' : 'update';
                return `This will ${verb} ${count} selected record(s). They will be ${what}. This cannot be undone.`;
            });

            const isFormValid = computed(() => {
                currentFieldsValidate();
                return !Object.values(fieldErrors.value).some(Boolean);
            });

            const notify = (message, variant = 'info') => {
                toast.value?.push({ message, variant });
            };

            const fetchEntities = async () => {
                loadingEntities.value = true;
                try {
                    const res = await api(`${apiPrefix}/schema`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    const slugs = Array.isArray(data) ? data : (data.entities || []);
                    entities.value = slugs;
                    await hydrateEntityMeta(slugs);
                } catch (err) {
                    notify(err?.message || 'Failed to discover entity schemas.', 'error');
                } finally {
                    loadingEntities.value = false;
                }
            };

            const hydrateEntityMeta = async (slugs) => {
                const meta = {};
                const chunk = Math.max(1, Math.min(slugs.length, 8));
                for (let i = 0; i < slugs.length; i += chunk) {
                    const batch = slugs.slice(i, i + chunk);
                    await Promise.all(batch.map(async (slug) => {
                        if (entityMeta.value[slug]) {
                            meta[slug] = entityMeta.value[slug];
                            return;
                        }
                        try {
                            const res = await api(`${apiPrefix}/schema/${encodeURIComponent(slug)}`);
                            if (!res.ok) return;
                            const data = await res.json();
                            meta[slug] = {
                                label: data.label || slug,
                                icon: data.icon || '',
                                description: data.description || '',
                            };
                        } catch {
                            meta[slug] = { label: slug, icon: '' };
                        }
                    }));
                }
                entityMeta.value = { ...entityMeta.value, ...meta };
            };

            const syncUrl = () => {
                if (typeof window === 'undefined' || !window.history) return;
                const params = new URLSearchParams();
                if (currentEntity.value) params.set('entity', currentEntity.value);
                if (page.value > 1) params.set('page', String(page.value));
                if (query.value.trim()) params.set('q', query.value.trim());
                if (sort.value) params.set('sort', sort.value);
                if (pageSize.value !== DEFAULT_PAGE_SIZE) params.set('limit', String(pageSize.value));
                Object.entries(filters).forEach(([k, v]) => {
                    if (v !== '') params.set(`filter[${k}]`, String(v));
                });
                const qs = params.toString();
                window.history.replaceState(null, '', qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
            };

            const loadSchema = async () => {
                try {
                    const res = await api(`${apiPrefix}/schema/${currentEntity.value}`);
                    if (res.ok) {
                        const data = await res.json();
                        fields.value = data.fields || [];
                        layout.value = data.layout === 'list' ? 'list' : 'grid';
                        visibleFields.value = (data.fields || [])
                            .filter(f => f.column !== false && f.column !== 0)
                            .map(f => f.name);
                        if (data.label !== currentLabel.value) {
                            entityMeta.value[currentEntity.value] = {
                                label: data.label || currentEntity.value,
                                icon: data.icon || '',
                                description: data.description || '',
                            };
                        }
                        if (!Object.keys(filters).length) {
                            data.fields.filter(f => f.filterable && f.required).forEach(f => {
                                filters[f.name] = '';
                            });
                        }
                    }
                } catch (err) {
                    notify(err?.message || 'Failed to load schema.', 'error');
                }
            };

            const loadRows = async () => {
                if (!currentEntity.value) return;
                loading.value = true;
                rowsError.value = null;
                try {
                    const params = new URLSearchParams({
                        page: String(page.value),
                        limit: String(pageSize.value),
                    });
                    if (query.value.trim()) params.set('q', query.value.trim());
                    if (sort.value) params.set('sort', sort.value);
                    Object.entries(filters).forEach(([k, v]) => {
                        if (v !== '' && v !== null && v !== undefined) params.set(`filter[${k}]`, String(v));
                    });
                    syncUrl();

                    const res = await api(`${apiPrefix}/${currentEntity.value}?${params.toString()}`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    rows.value = Array.isArray(data) ? data : (data.data || []);
                    const meta = data.meta || {};
                    total.value = typeof meta.total === 'number' ? meta.total : rows.value.length;
                    lastPage.value = Math.max(
                        1,
                        meta.last_page ?? meta.pages ?? Math.ceil(total.value / pageSize.value)
                    );
                } catch (err) {
                    rowsError.value = err?.message || 'Failed to load records.';
                    rows.value = [];
                } finally {
                    loading.value = false;
                }
            };

            const selectEntity = async (entity) => {
                if (currentEntity.value === entity) return;
                currentEntity.value = entity;
                page.value = 1;
                query.value = '';
                sort.value = '';
                Object.keys(filters).forEach(k => delete filters[k]);
                rows.value = [];
                fields.value = [];
                selected.value = [];
                await Promise.all([loadSchema(), loadRows()]);
            };

            const onPageChange = (p) => {
                page.value = p;
                loadRows();
            };

            const search = () => {
                page.value = 1;
                loadRows();
            };

            const onSortChange = (val) => {
                sort.value = val || '';
                page.value = 1;
                loadRows();
            };

            const onFiltersChange = (val) => {
                Object.keys(filters).forEach(k => delete filters[k]);
                Object.entries(val || {}).forEach(([k, v]) => { filters[k] = String(v); });
                page.value = 1;
                loadRows();
            };

            const onPageSizeChange = (val) => {
                pageSize.value = parseInt(val) || DEFAULT_PAGE_SIZE;
                page.value = 1;
                loadRows();
            };

            const onVisibleFieldsChange = (val) => {
                visibleFields.value = val;
            };

            const resetForm = () => {
                writableFields.value.forEach(f => {
                    if (f.type === 'boolean' || f.type === 'bool' || f.widget === 'checkbox') {
                        form[f.name] = false;
                    } else if (f.type === 'select' || f.widget === 'select' || f.widget === 'radio') {
                        const first = Array.isArray(f.options) ? f.options[0] : null;
                        form[f.name] = first
                            ? (typeof first === 'object' ? (first.value ?? first.label) : first)
                            : '';
                    } else {
                        form[f.name] = '';
                    }
                });
                formError.value = null;
                touched.value = {};
                fieldErrors.value = {};
                dirtySnapshot.value = JSON.stringify({ ...form });
                dirty.value = false;
            };

            const openCreateModal = () => {
                isEditing.value = false;
                activeId.value = null;
                resetForm();
                showModal.value = true;
            };

            const openEditModal = (row) => {
                isEditing.value = true;
                activeId.value = row.id;
                resetForm();
                writableFields.value.forEach(f => {
                    form[f.name] = row[f.name] ?? '';
                });
                dirtySnapshot.value = JSON.stringify({ ...form });
                dirty.value = false;
                showModal.value = true;
            };

            const requestCloseModal = () => {
                if (!dirty.value) {
                    showModal.value = false;
                    return;
                }
                confirmCloseOpen.value = true;
                pendingClose.value = true;
            };

            const closeModal = () => {
                confirmCloseOpen.value = false;
                showModal.value = false;
            };

            const forceCloseModal = () => {
                confirmCloseOpen.value = false;
                showModal.value = false;
            };

            const fieldHelper = (f) => {
                if (f.helper || f.helperText) return f.helper || f.helperText;
                if (f.placeholder) return f.placeholder;
                if (f.rules && f.rules.length) return `Rules: ${f.rules.join(', ')}`;
                return '';
            };

            /**
 * Client-side presence check only. Rule MEANING is the server's.
 *
 * This used to re-implement the rule vocabulary in JavaScript, and the two
 * copies disagreed: min:N compared the VALUE on the server and the STRING
 * LENGTH here, so #[Field(type: 'float', rules: ['min:1000'])] rejected 1200
 * in the browser and accepted it on save. A rule that means one thing to the
 * form and another to the database is worse than a rule that is not enforced
 * in the form at all — the user is told their input is wrong and it is not.
 *
 * The rules are still surfaced (fieldHelper above), so the constraint stays
 * visible while editing. The browser's own required/min/max still apply
 * through PhForm; what is gone is the second opinion that could contradict the
 * first.
 */
const currentFieldsValidate = () => {
                const errors = {};
                writableFields.value.forEach(f => {
                    const value = form[f.name];
                    const isMissing = value === '' || value === null || value === undefined;
                    if (f.required && isMissing) {
                        errors[f.name] = `${f.label || f.name} is required.`;
                    }
                });
                fieldErrors.value = errors;
                return errors;
            };

            const touchField = (name) => {
                touched.value = { ...touched.value, [name]: true };
                currentFieldsValidate();
            };

            const submitForm = async () => {
                const errors = currentFieldsValidate();
                if (Object.keys(errors).length) {
                    Object.keys(errors).forEach(k => { touched.value[k] = true; });
                    formError.value = 'Please fix the highlighted fields.';
                    return;
                }
                submitting.value = true;
                formError.value = null;
                try {
                    const url = isEditing.value
                        ? `${apiPrefix}/${currentEntity.value}/${activeId.value}`
                        : `${apiPrefix}/${currentEntity.value}`;
                    const res = await api(url, {
                        method: isEditing.value ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(form),
                    });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        const serverErrors = errData.errors;
                        if (serverErrors && typeof serverErrors === 'object') {
                            currentFieldsValidate();
                            const mapped = {};
                            Object.entries(serverErrors).forEach(([k, v]) => {
                                const fieldName = writableFields.value.find(f => f.name === k) ? k : k.replace(/[^a-zA-Z0-9_]/g, '_');
                                mapped[fieldName] = typeof v === 'string' ? v : v.error || String(v);
                            });
                            fieldErrors.value = { ...fieldErrors.value, ...mapped };
                            throw new Error(errData.error || 'Validation failed.');
                        }
                        throw new Error(errData.error || errData.message || 'Failed to save record.');
                    }
                    closeModal();
                    notify(isEditing.value ? 'Record updated.' : 'Record created.', 'success');
                    dirty.value = false;
                    await loadRows();
                } catch (err) {
                    formError.value = err?.message || 'Failed to save record.';
                } finally {
                    submitting.value = false;
                }
            };

            const askDelete = (id) => {
                pendingDeleteId.value = id;
                confirmOpen.value = true;
            };

            const confirmDelete = async () => {
                confirmOpen.value = false;
                if (pendingDeleteId.value == null) return;
                const id = pendingDeleteId.value;
                pendingDeleteId.value = null;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/${id}`, { method: 'DELETE' });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || 'Failed to delete record.');
                    }
                    notify('Record deleted.', 'success');
                    await loadRows();
                } catch (err) {
                    notify(err?.message || 'Failed to delete record.', 'error');
                }
            };

            const askBulk = (type) => {
                if (!selected.value.length) return;
                pendingBulk.value = { type };
                bulkConfirmOpen.value = true;
            };

            const confirmBulk = async () => {
                if (!pendingBulk.value) return;
                const type = pendingBulk.value.type;
                const ids = [...selected.value];
                bulkSubmitting.value = true;
                bulkConfirmOpen.value = false;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/bulk`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: type, ids }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    const summary = data.summary || data;
                    const affected = summary.affected ?? summary.updated ?? summary.deleted ?? ids.length;
                    notify(`Bulk ${type} complete: ${affected} record(s) affected.`, 'success');
                    selected.value = [];
                    pendingBulk.value = null;
                    await loadRows();
                } catch (err) {
                    notify(err?.message || 'Bulk action failed.', 'error');
                    pendingBulk.value = null;
                } finally {
                    bulkSubmitting.value = false;
                }
            };

            const blobDownload = (blob, filename) => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
            };

            const exportRecords = async (format) => {
                if (!currentEntity.value) return;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/export?format=${format}`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const blob = await res.blob();
                    blobDownload(blob, `${currentEntity.value}.${format}`);
                    notify(`Exported ${currentEntity.value} as ${format.toUpperCase()}.`, 'success');
                } catch (err) {
                    notify(err?.message || `Failed to export ${format}.`, 'error');
                }
            };

            const onImport = async (payload) => {
                importing.value = true;
                importResult.value = null;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/import`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    importResult.value = data;
                    notify('Import finished.', 'success');
                    await loadRows();
                } catch (err) {
                    // Server returns top-level {imported, updated, validated, failed, errors}
                    importResult.value = {
                        imported: 0,
                        updated: 0,
                        failed: 1,
                        errors: [err?.message || 'Import failed.'],
                    };
                } finally {
                    importing.value = false;
                }
            };

            const loadDiff = async () => {
                if (!currentEntity.value) return;
                diffLoading.value = true;
                diff.value = null;
                diffResult.value = null;
                try {
                    const res = await api(`${apiPrefix}/schema/${currentEntity.value}/diff`);
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    diff.value = data;
                } catch (err) {
                    notify(err?.message || 'Failed to compute schema diff.', 'error');
                } finally {
                    diffLoading.value = false;
                }
            };

            const openDiff = () => {
                diffOpen.value = true;
                loadDiff();
            };

            const onApplyDiff = async ({ allowDrops }) => {
                if (!currentEntity.value) return;
                diffApplying.value = true;
                diffResult.value = null;
                try {
                    const res = await api(`${apiPrefix}/schema/${currentEntity.value}/sync`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ apply: true, allowDrops }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    diffResult.value = data;
                    if (data.success) {
                        notify('Schema synchronized.', 'success');
                        await Promise.all([loadSchema(), loadRows()]);
                    }
                } catch (err) {
                    diffResult.value = { success: false, executed: [err?.message || 'Sync failed.'] };
                } finally {
                    diffApplying.value = false;
                }
            };

            const loadAudit = async (filters = {}) => {
                auditLoading.value = true;
                try {
                    const params = new URLSearchParams();
                    if (filters.entity) params.set('entity', filters.entity);
                    if (filters.verb) params.set('verb', filters.verb);
                    const qs = params.toString();
                    const res = await api(`${apiPrefix}/audit${qs ? '?' + qs : ''}`);
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    auditLogs.value = Array.isArray(data.logs) ? data.logs : [];
                } catch (err) {
                    notify(err?.message || 'Failed to load audit logs.', 'error');
                    auditLogs.value = [];
                } finally {
                    auditLoading.value = false;
                }
            };

            const openAudit = () => {
                auditOpen.value = true;
                loadAudit();
            };

            const isTextWidget = (f) => !(f.type === 'select' || f.widget === 'select' || f.type === 'boolean' || f.type === 'bool' || f.widget === 'checkbox' || f.widget === 'textarea' || f.widget === 'radio' || f.type === 'json');

            const inputType = (f) =>
                f.widget === 'password'
                    ? 'password'
                    : (f.type === 'int' || f.type === 'float' || f.type === 'integer' || f.type === 'number' || f.type === 'numeric'
                        ? 'number'
                        : (f.type === 'date' ? 'date' : (f.type === 'email' ? 'email' : 'text')));

            const inputStep = (f) => (f.type === 'float' ? 'any' : undefined);

            const selectOptions = (f) => {
                if (!Array.isArray(f.options)) return [];
                return f.options.map(o =>
                    typeof o === 'object'
                        ? { label: o.label ?? o.value, value: o.value, disabled: !!o.disabled }
                        : { label: String(o), value: o }
                );
            };

            watch(form, () => {
                dirty.value = JSON.stringify({ ...form }) !== dirtySnapshot.value;
            }, { deep: true });

            if (currentEntity.value) {
                onMounted(async () => {
                    await fetchEntities();
                    await Promise.all([loadSchema(), loadRows()]);
                });
            } else {
                onMounted(fetchEntities);
            }

            return {
                entities,
                filteredEntities,
                entityMeta,
                entitySearch,
                loadingEntities,
                currentEntity,
                currentLabel,
                fields,
                layout,
                writableFields,
                rows,
                loading,
                rowsError,
                toast,
                page,
                lastPage,
                total,
                query,
                filters,
                sort,
                pageSize,
                visibleFields,
                selected,
                showModal,
                isEditing,
                submitting,
                formError,
                form,
                dirty,
                fieldErrors,
                confirmCloseOpen,
                confirmOpen,
                pendingDeleteId,
                bulkConfirmOpen,
                pendingBulk,
                bulkSubmitting,
                bulkTitle,
                bulkMessage,
                importOpen,
                importing,
                importResult,
                diffOpen,
                diff,
                diffLoading,
                diffApplying,
                diffResult,
                auditOpen,
                auditLogs,
                auditLoading,
                isFormValid,
                selectEntity,
                onPageChange,
                search,
                onSortChange,
                onFiltersChange,
                onPageSizeChange,
                onVisibleFieldsChange,
                loadRows,
                openCreateModal,
                openEditModal,
                requestCloseModal,
                closeModal,
                forceCloseModal,
                submitForm,
                touchField,
                fieldHelper,
                askDelete,
                confirmDelete,
                askBulk,
                confirmBulk,
                exportRecords,
                onImport,
                openDiff,
                loadDiff,
                onApplyDiff,
                openAudit,
                loadAudit,
                isTextWidget,
                inputType,
                inputStep,
                selectOptions,
            };
        }
    });

    window.__phueApp.mount('#app');
}

if (typeof window !== 'undefined' && !window.__phueExplorerInitialized) {
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountApp);
    } else {
        mountApp();
    }
}
</script>