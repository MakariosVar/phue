<php>
$schiiState = $state ?? [];
$configuredPrefix = $schiiState['apiPrefix'] ?? null;

return [
    'title' => 'Schii Console',
    'state' => [
        'apiPrefix' => $configuredPrefix ?? $apiPrefix ?? '/api/schii',
    ],
    'scripts' => [],
];
</php>

<template>
<div class="schii-console p-4" v-cloak>
    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="lg" class="mb-4">
        <div>
            <ph-heading :level="1" class="mb-0">Schii Console</ph-heading>
            <ph-text color="muted">Zero-Controller Dynamic REST Management Interface</ph-text>
        </div>
        <ph-badge label="REST + Bulk + Import/Export + Audit" variant="info" pill />
    </ph-flex>

    <ph-alert
        v-if="errorMsg"
        variant="error"
        :message="errorMsg"
        dismissible
        class="mb-3"
        @dismiss="errorMsg = null"
    />
    <ph-alert
        v-if="successMsg"
        variant="success"
        :message="successMsg"
        dismissible
        class="mb-3"
        @dismiss="successMsg = null"
    />

    <ph-row gutter="3">
        <ph-col span="12" md="4" lg="3">
            <ph-card title="Entities" :bordered="false">
                <div v-if="loadingEntities">
                    <ph-skeleton v-for="n in 4" :key="n" variant="text" width="100%" height="18" class="d-block mb-3" />
                </div>
                <ph-stack v-else-if="entities.length" gap="xs">
                    <ph-button
                        v-for="entity in entities"
                        :key="entity"
                        :variant="currentEntity === entity ? 'primary' : 'ghost'"
                        block
                        @click="selectEntity(entity)"
                    >{{ entity }}</ph-button>
                </ph-stack>
                <ph-text v-else color="muted" size="sm">No entities discovered.</ph-text>
            </ph-card>
        </ph-col>

        <ph-col span="12" md="8" lg="9">
            <ph-card>
                <template #header>
                    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="md">
                        <div>
                            <ph-text weight="semibold" size="lg" class="mb-0">
                                {{ currentEntity || 'Data Browser' }}
                            </ph-text>
                            <ph-text v-if="currentEntity" size="sm" color="muted" class="mb-0">
                                {{ total }} record(s) &middot; page {{ page }} of {{ lastPage }}
                            </ph-text>
                        </div>
                        <ph-badge v-if="currentEntity" label="REST" variant="info" pill />
                    </ph-flex>
                </template>

                <template v-if="!currentEntity">
                    <ph-text color="muted">Select an entity from the sidebar to inspect schema and records.</ph-text>
                </template>

                <template v-else>
                    <schii-record-toolbar
                        :entity="currentEntity"
                        v-model:query="query"
                        :selected="selected"
                        @search="search"
                        @refresh="loadRows"
                        @create="openCreateModal"
                        @schema-diff="openDiff"
                        @audit="openAudit"
                        @import-open="importOpen = true"
                        @export-csv="exportRecords('csv')"
                        @export-json="exportRecords('json')"
                        @bulk-delete="askBulk('delete')"
                    />

                    <template v-if="loading">
                        <ph-skeleton v-for="n in 4" :key="n" variant="text" width="100%" height="18" class="d-block mb-3" />
                    </template>

                    <template v-else>
                        <schii-record-table
                            :fields="fields"
                            :rows="rows"
                            :page="page"
                            :last-page="lastPage"
                            v-model:selected="selected"
                            selectable
                            @page-change="onPageChange"
                            @edit="openEditModal"
                            @delete-request="askDelete"
                        />
                    </template>
                </template>
            </ph-card>
        </ph-col>
    </ph-row>

    <ph-modal v-model="showModal"
              :title="isEditing ? 'Edit ' + currentEntity : 'Create ' + currentEntity"
              size="lg">
        <ph-alert v-if="formError" variant="error" :message="formError" class="mb-3" />

        <form id="schii-record-form" novalidate @submit.prevent="submitForm">
            <ph-row gutter="3">
                <ph-col v-for="field in writableFields" :key="field.name" span="12" md="6">
                    <ph-input
                        v-if="isTextWidget(field)"
                        v-model="form[field.name]"
                        :type="inputType(field)"
                        :step="inputStep(field)"
                        :label="field.label || field.name"
                        :required="field.required"
                        :disabled="isEditing && field.name === 'id'"
                    />
                    <ph-select
                        v-else-if="field.type === 'select' || field.widget === 'select'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                        :options="selectOptions(field)"
                        :required="field.required"
                    />
                    <ph-textarea
                        v-else-if="field.widget === 'textarea'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                        :rows="3"
                        :required="field.required"
                    />
                    <ph-checkbox
                        v-else-if="field.type === 'boolean' || field.widget === 'checkbox'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                    />
                </ph-col>
            </ph-row>
        </form>

        <template #footer>
            <ph-button variant="ghost" @click="closeModal">Cancel</ph-button>
            <ph-button variant="primary" :loading="submitting" @click="submitForm">Save</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="confirmOpen" title="Confirm delete" size="sm">
        <ph-text>Are you sure you want to delete record #{{ pendingDeleteId }}? This cannot be undone.</ph-text>
        <template #footer>
            <ph-button variant="ghost" @click="confirmOpen = false">Cancel</ph-button>
            <ph-button variant="danger" @click="confirmDelete">Delete</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="bulkConfirmOpen" :title="bulkTitle" size="sm">
        <ph-text>{{ bulkMessage }}</ph-text>
        <template #footer>
            <ph-button variant="ghost" @click="bulkConfirmOpen = false">Cancel</ph-button>
            <ph-button
                variant="danger"
                :loading="bulkSubmitting"
                @click="confirmBulk"
            >Confirm</ph-button>
        </template>
    </ph-modal>

    <schii-import-modal
        v-model="importOpen"
        :entity="currentEntity"
        :fields="fields"
        :busy="importing"
        :result="importResult"
        @import="onImport"
    />

    <schii-schema-diff-modal
        v-model="diffOpen"
        :entity="currentEntity"
        :diff="diff"
        :loading="diffLoading"
        :applying="diffApplying"
        :sync-result="diffResult"
        @apply="onApplyDiff"
        @reload="loadDiff"
    />

    <schii-audit-panel
        v-model="auditOpen"
        :logs="auditLogs"
        :loading="auditLoading"
        @refresh="loadAudit"
    />
</div>
</template>

<script type="module">
import { createApp, ref, reactive, computed, onMounted } from 'vue';

if (typeof document !== 'undefined' && !document.getElementById('phue-v-cloak-style')) {
    const style = document.createElement('style');
    style.id = 'phue-v-cloak-style';
    style.textContent = '[v-cloak] { display: none !important; }';
    document.head.appendChild(style);
}

function api(url, opts = {}) {
    const headers = Object.assign({ 'Accept': 'application/json' }, opts.headers || {});
    return fetch(url, Object.assign({}, opts, { headers })).then(res => {
        if (res.status === 401) {
            if (typeof window !== 'undefined' && window.location.pathname !== '/login') {
                window.location.href = '/login';
            }
        }
        return res;
    });
}

export default function mountApp() {
    window.__phueApp?.unmount?.();

    window.__phueApp = createApp({
        setup() {
            const PAGE_SIZE = 10;
            const apiPrefix = window.__INITIAL_STATE__?.apiPrefix || '/api/schii';

            const entities = ref([]);
            const loadingEntities = ref(true);
            const currentEntity = ref(null);
            const fields = ref([]);
            const rows = ref([]);
            const loading = ref(false);
            const errorMsg = ref(null);
            const successMsg = ref(null);

            const page = ref(1);
            const lastPage = ref(1);
            const total = ref(0);
            const query = ref('');
            const selected = ref([]);

            const writableFields = computed(() =>
                fields.value.filter(f => !f.primaryKey && f.name !== 'id' && f.writable !== false && !f.readonly)
            );

            const showModal = ref(false);
            const isEditing = ref(false);
            const activeId = ref(null);
            const submitting = ref(false);
            const formError = ref(null);
            const form = reactive({});

            const confirmOpen = ref(false);
            const pendingDeleteId = ref(null);

            const bulkConfirmOpen = ref(false);
            const pendingBulk = ref(null);
            const bulkSubmitting = ref(false);

            const importOpen = ref(false);
            const importing = ref(false);
            const importResult = ref(null);

            const diffOpen = ref(false);
            const diff = ref(null);
            const diffLoading = ref(false);
            const diffApplying = ref(false);
            const diffResult = ref(null);

            const auditOpen = ref(false);
            const auditLogs = ref([]);
            const auditLoading = ref(false);

            const bulkTitle = computed(() => {
                if (!pendingBulk.value) return 'Confirm bulk action';
                return pendingBulk.value.type === 'delete'
                    ? 'Delete selected records'
                    : 'Confirm bulk action';
            });

            const bulkMessage = computed(() => {
                if (!pendingBulk.value) return '';
                const count = selected.value.length;
                const action = pendingBulk.value.type;
                const what = action === 'delete' ? 'deleted' : 'updated';
                const verb = action === 'delete' ? 'delete' : 'update';
                return `This will ${verb} ${count} selected record(s). They will be ${what}. This cannot be undone.`;
            });

            const fetchEntities = async () => {
                loadingEntities.value = true;
                try {
                    const res = await api(`${apiPrefix}/schema`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    entities.value = Array.isArray(data) ? data : (data.entities || []);
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to discover entity schemas.';
                } finally {
                    loadingEntities.value = false;
                }
            };

            const loadSchema = async () => {
                try {
                    const res = await api(`${apiPrefix}/schema/${currentEntity.value}`);
                    if (res.ok) {
                        const data = await res.json();
                        fields.value = data.fields || [];
                    }
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to load schema.';
                }
            };

            const loadRows = async () => {
                if (!currentEntity.value) return;
                loading.value = true;
                try {
                    const params = new URLSearchParams({
                        page: String(page.value),
                        limit: String(PAGE_SIZE),
                    });
                    if (query.value.trim()) params.set('q', query.value.trim());

                    const res = await api(`${apiPrefix}/${currentEntity.value}?${params.toString()}`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    rows.value = Array.isArray(data) ? data : (data.data || []);
                    const meta = data.meta || {};
                    total.value = typeof meta.total === 'number' ? meta.total : rows.value.length;
                    lastPage.value = Math.max(
                        1,
                        meta.last_page ?? meta.pages ?? Math.ceil(total.value / PAGE_SIZE)
                    );
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to load records.';
                    rows.value = [];
                } finally {
                    loading.value = false;
                }
            };

            const selectEntity = async (entity) => {
                if (currentEntity.value === entity) return;
                currentEntity.value = entity;
                page.value = 1;
                query.value = '';
                rows.value = [];
                fields.value = [];
                selected.value = [];
                await Promise.all([loadSchema(), loadRows()]);
            };

            const onPageChange = (p) => {
                page.value = p;
                loadRows();
            };

            const search = () => {
                page.value = 1;
                loadRows();
            };

            const resetForm = () => {
                writableFields.value.forEach(f => {
                    if (f.type === 'boolean' || f.widget === 'checkbox') {
                        form[f.name] = false;
                    } else if (f.type === 'select' && Array.isArray(f.options) && f.options.length) {
                        const first = f.options[0];
                        form[f.name] = typeof first === 'object' ? (first.value ?? first) : first;
                    } else {
                        form[f.name] = '';
                    }
                });
                formError.value = null;
            };

            const openCreateModal = () => {
                isEditing.value = false;
                activeId.value = null;
                resetForm();
                showModal.value = true;
            };

            const openEditModal = (row) => {
                isEditing.value = true;
                activeId.value = row.id;
                resetForm();
                writableFields.value.forEach(f => {
                    form[f.name] = row[f.name] ?? '';
                });
                showModal.value = true;
            };

            const closeModal = () => {
                showModal.value = false;
            };

            const submitForm = async () => {
                submitting.value = true;
                formError.value = null;
                try {
                    const url = isEditing.value
                        ? `${apiPrefix}/${currentEntity.value}/${activeId.value}`
                        : `${apiPrefix}/${currentEntity.value}`;
                    const res = await api(url, {
                        method: isEditing.value ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(form),
                    });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || 'Failed to save record.');
                    }
                    closeModal();
                    successMsg.value = isEditing.value ? 'Record updated.' : 'Record created.';
                    await loadRows();
                } catch (err) {
                    formError.value = err?.message || 'Failed to save record.';
                } finally {
                    submitting.value = false;
                }
            };

            const askDelete = (id) => {
                pendingDeleteId.value = id;
                confirmOpen.value = true;
            };

            const confirmDelete = async () => {
                confirmOpen.value = false;
                if (pendingDeleteId.value == null) return;
                const id = pendingDeleteId.value;
                pendingDeleteId.value = null;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/${id}`, { method: 'DELETE' });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || 'Failed to delete record.');
                    }
                    successMsg.value = 'Record deleted.';
                    await loadRows();
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to delete record.';
                }
            };

            const askBulk = (type) => {
                if (!selected.value.length) return;
                pendingBulk.value = { type };
                bulkConfirmOpen.value = true;
            };

            const confirmBulk = async () => {
                if (!pendingBulk.value) return;
                const type = pendingBulk.value.type;
                const ids = [...selected.value];
                bulkSubmitting.value = true;
                bulkConfirmOpen.value = false;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/bulk`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: type, ids }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    const summary = data.summary || data;
                    const affected = summary.affected ?? summary.updated ?? summary.deleted ?? ids.length;
                    successMsg.value = `Bulk ${type} complete: ${affected} record(s) affected.`;
                    selected.value = [];
                    pendingBulk.value = null;
                    await loadRows();
                } catch (err) {
                    errorMsg.value = err?.message || 'Bulk action failed.';
                    pendingBulk.value = null;
                } finally {
                    bulkSubmitting.value = false;
                }
            };

            const blobDownload = (blob, filename) => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
            };

            const exportRecords = async (format) => {
                if (!currentEntity.value) return;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/export?format=${format}`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const blob = await res.blob();
                    blobDownload(blob, `${currentEntity.value}.${format}`);
                    successMsg.value = `Exported ${currentEntity.value} as ${format.toUpperCase()}.`;
                } catch (err) {
                    errorMsg.value = err?.message || `Failed to export ${format}.`;
                }
            };

            const onImport = async (payload) => {
                importing.value = true;
                importResult.value = null;
                try {
                    const res = await api(`${apiPrefix}/${currentEntity.value}/import`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    importResult.value = data;
                    successMsg.value = 'Import finished.';
                    await loadRows();
                } catch (err) {
                    // Server returns top-level {imported, updated, validated, failed, errors}
                    importResult.value = {
                        imported: 0,
                        updated: 0,
                        failed: 1,
                        errors: [err?.message || 'Import failed.'],
                    };
                } finally {
                    importing.value = false;
                }
            };

            const loadDiff = async () => {
                if (!currentEntity.value) return;
                diffLoading.value = true;
                diff.value = null;
                diffResult.value = null;
                try {
                    const res = await api(`${apiPrefix}/schema/${currentEntity.value}/diff`);
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    diff.value = data;
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to compute schema diff.';
                } finally {
                    diffLoading.value = false;
                }
            };

            const openDiff = () => {
                diffOpen.value = true;
                loadDiff();
            };

            const onApplyDiff = async ({ allowDrops }) => {
                if (!currentEntity.value) return;
                diffApplying.value = true;
                diffResult.value = null;
                try {
                    const res = await api(`${apiPrefix}/schema/${currentEntity.value}/sync`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ apply: true, allowDrops }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    diffResult.value = data;
                    if (data.success) {
                        successMsg.value = 'Schema synchronized.';
                        await Promise.all([loadSchema(), loadRows()]);
                    }
                } catch (err) {
                    diffResult.value = { success: false, executed: [err?.message || 'Sync failed.'] };
                } finally {
                    diffApplying.value = false;
                }
            };

            const loadAudit = async (filters = {}) => {
                auditLoading.value = true;
                try {
                    const params = new URLSearchParams();
                    if (filters.entity) params.set('entity', filters.entity);
                    if (filters.verb) params.set('verb', filters.verb);
                    const qs = params.toString();
                    const res = await api(`${apiPrefix}/audit${qs ? '?' + qs : ''}`);
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }
                    auditLogs.value = Array.isArray(data.logs) ? data.logs : [];
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to load audit logs.';
                    auditLogs.value = [];
                } finally {
                    auditLoading.value = false;
                }
            };

            const openAudit = () => {
                auditOpen.value = true;
                loadAudit();
            };

            const isTextWidget = (f) => !(f.type === 'select' || f.widget === 'select' || f.type === 'boolean' || f.type === 'bool' || f.widget === 'checkbox' || f.widget === 'textarea');

            // Force a matched native input type. FieldSchema types are already
            // normalized to 'int'/'float' server-side; legacy aliases are kept
            // for robustness, and 'date' renders a real date picker (S5).
            const inputType = (f) =>
                f.type === 'int' || f.type === 'float' || f.type === 'integer' || f.type === 'number' || f.type === 'numeric'
                    ? 'number'
                    : (f.type === 'date' ? 'date' : (f.type === 'email' ? 'email' : 'text'));

            const inputStep = (f) => (f.type === 'float' ? 'any' : undefined);

            const selectOptions = (f) => {
                if (!Array.isArray(f.options)) return [];
                return f.options.map(o =>
                    typeof o === 'object'
                        ? { label: o.label ?? o.value, value: o.value, disabled: !!o.disabled }
                        : { label: String(o), value: o }
                );
            };

            onMounted(fetchEntities);

            return {
                entities,
                loadingEntities,
                currentEntity,
                fields,
                writableFields,
                rows,
                loading,
                errorMsg,
                successMsg,
                page,
                lastPage,
                total,
                query,
                selected,
                showModal,
                isEditing,
                submitting,
                formError,
                form,
                confirmOpen,
                pendingDeleteId,
                bulkConfirmOpen,
                pendingBulk,
                bulkSubmitting,
                bulkTitle,
                bulkMessage,
                importOpen,
                importing,
                importResult,
                diffOpen,
                diff,
                diffLoading,
                diffApplying,
                diffResult,
                auditOpen,
                auditLogs,
                auditLoading,
                selectEntity,
                onPageChange,
                search,
                loadRows,
                openCreateModal,
                openEditModal,
                closeModal,
                submitForm,
                askDelete,
                confirmDelete,
                askBulk,
                confirmBulk,
                exportRecords,
                onImport,
                openDiff,
                loadDiff,
                onApplyDiff,
                openAudit,
                loadAudit,
                isTextWidget,
                inputType,
                inputStep,
                selectOptions,
            };
        }
    });

    window.__phueApp.mount('#app');
}

if (typeof window !== 'undefined' && !window.__phueExplorerInitialized) {
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountApp);
    } else {
        mountApp();
    }
}
</script>