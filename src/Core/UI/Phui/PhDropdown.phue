<template>
  <div
    ref="root"
    data-phui="dropdown"
    class="dropdown d-inline-block position-relative"
    @keydown="onRootKeydown"
  >
    <slot name="trigger" :open="open" :toggle="toggle">
      <button
        type="button"
        class="btn d-inline-flex align-items-center"
        :class="[variantClass, sizeClass]"
        :disabled="disabled"
        aria-haspopup="menu"
        :aria-expanded="open ? 'true' : 'false'"
        @click="toggle"
      >
        <span>{{ label }}</span>
        <ph-icon
          name="chevron-down"
          size="sm"
          class="ms-1"
          :style="chevronStyle"
        />
      </button>
    </slot>
    <teleport to="body" v-if="open">
      <div
        ref="menu"
        data-phui="dropdown-menu"
        class="dropdown-menu show"
        role="menu"
        :style="menuStyle"
      >
        <template v-for="(item, index) in items" :key="index">
          <h6 v-if="item.header" class="dropdown-header">{{ item.header }}</h6>
          <hr v-else-if="item.divider" class="dropdown-divider" />
          <span
            v-else-if="item.disabled"
            class="dropdown-item disabled d-flex align-items-center"
            aria-disabled="true"
          >
            <ph-icon v-if="item.icon" :name="item.icon" size="sm" class="me-2" />
            {{ item.label }}
          </span>
          <a
            v-else
            class="dropdown-item d-flex align-items-center"
            href="#"
            role="menuitem"
            @click.prevent="select(item)"
          >
            <ph-icon v-if="item.icon" :name="item.icon" size="sm" class="me-2" />
            {{ item.label }}
          </a>
        </template>

        <slot :close="close" />
      </div>
    </teleport>
  </div>
</template>

<script>

const MENU_Z = 1040;

// Gap between the trigger and the menu, matching the previous `marginTop: 0.125rem`.
const MENU_GAP = 2;

// Breathing room kept between the menu and the viewport edge when clamping.
const VIEWPORT_MARGIN = 8;

export default {
  name: 'PhDropdown',
  composables: ['position'],
  props: {
    label: {
      type: String,
      default: 'Menu'
    },
    items: {
      type: Array,
      default: () => []
    },
    variant: {
      type: String,
      default: 'secondary',
      validator: (val) => ['primary', 'secondary', 'outline', 'ghost', 'danger', 'light'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    align: {
      type: String,
      default: 'start',
      validator: (val) => ['start', 'end'].includes(val)
    },
    closeOnSelect: {
      type: Boolean,
      default: true
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['select', 'open', 'close'],
  data() {
    return {
      open: false,
      /** Viewport-space trigger geometry; positionFor adds the scroll offset back. */
      anchorRect: null,
      /** Teleported menu size, needed before flip and clamp can be decided. */
      panelSize: { width: 0, height: 0 },
      /** Output of positionFor(), or null while the menu is not yet placeable. */
      panelPos: null,
      /**
       * Resolved once per open, not per render: the menu has to paint above the
       * overlay it was teleported out of, and reading that overlay's computed
       * z-index inside a computed property would force a style recalc on every
       * render. Null when the trigger is not inside one.
       */
      overlayLayer: null,
      viewportHandle: null
    };
  },
  computed: {
    variantClass() {
      const map = {
        primary: 'btn-primary',
        secondary: 'btn-secondary',
        outline: 'btn-outline-secondary',
        ghost: 'btn-link',
        danger: 'btn-danger',
        light: 'btn-light'
      }
      return map[this.variant] || 'btn-secondary';
    },
    sizeClass() {
      if (this.size === 'sm') return 'btn-sm';
      if (this.size === 'lg') return 'btn-lg';
      return '';
    },
    chevronStyle() {
      return {
        transition: 'transform 0.15s ease',
        transform: this.open ? 'rotate(180deg)' : 'none'
      };
    },
    menuStyle() {
      // Two things can be missing here: the trigger was never measured, or the
      // menu is teleported but has not been measured yet. In both cases the
      // coordinates are unknown, so hide rather than flash at the top-left of
      // the document.
      if (!this.panelPos || !this.panelPos.measured) {
        return { visibility: 'hidden' };
      }

      return {
        position: 'absolute',
        top: `${this.panelPos.top}px`,
        left: `${this.panelPos.left}px`,
        zIndex: this.overlayLayer || MENU_Z
      };
    }
  },
  watch: {
    open(value) {
      this.$emit(value ? 'open' : 'close');

      if (value) {
        this.startTracking();
      } else {
        this.stopTracking();
      }
    }
  },
  mounted() {
    document.addEventListener('click', this.onDocumentClick);
    document.addEventListener('keydown', this.onKeydown);
  },
  beforeUnmount() {
    document.removeEventListener('click', this.onDocumentClick);
    document.removeEventListener('keydown', this.onKeydown);
    this.stopTracking();
  },
  methods: {
    /**
     * Viewport-space geometry of the trigger.
     *
     * Kept in viewport space on purpose: the scroll offset is passed to
     * positionFor() instead of being folded in here, so one arithmetic identity
     * owns the document-space conversion.
     */
    measureAnchor() {
      const trigger = this.$refs.root;
      this.anchorRect = measureAnchor(trigger);
    },
    measurePanel() {
      const menu = this.$refs.menu;
      if (!menu || typeof menu.getBoundingClientRect !== 'function') {
        this.panelSize = { width: 0, height: 0 };
        return;
      }

      const rect = menu.getBoundingClientRect();
      this.panelSize = { width: rect.width, height: rect.height };
    },
    /**
     * Recomputes the menu position from freshly measured geometry.
     *
     * Both the trigger and the menu are re-measured: a nested scroller moves the
     * trigger, and the menu's own size decides whether it flips or clamps.
     */
    reposition() {
      this.measureAnchor();
      this.measurePanel();

      if (!this.anchorRect || typeof window === 'undefined') {
        this.panelPos = null;
        return;
      }

      this.panelPos = positionFor(this.anchorRect, {
        placement: 'bottom',
        align: this.align,
        size: this.panelSize,
        // clientWidth/clientHeight, not innerWidth/innerHeight: those include
        // the scrollbar, which would let a clamped menu hide under it.
        viewport: {
          width: document.documentElement.clientWidth,
          height: document.documentElement.clientHeight
        },
        scroll: {
          x: window.scrollX || 0,
          y: window.scrollY || 0
        },
        offset: MENU_GAP,
        clamp: true,
        margin: VIEWPORT_MARGIN
      });
    },
    /**
     * Subscribes to viewport changes through the shared composable.
     *
     * trackViewport() listens on scroll in the capture phase, which is what
     * makes *nested* scrollers (a scrolling column around the trigger) visible
     * to it — scroll events do not bubble, so a bubbling listener would miss
     * them. It also coalesces bursts into one rAF callback.
     */
    startTracking() {
      if (this.viewportHandle) return;

      this.measureAnchor();
      this.overlayLayer = overlayLayerFor(this.$refs.root, MENU_Z);
      this.viewportHandle = trackViewport(this.reposition);

      // The menu is teleported, so it does not exist until Vue has flushed the
      // open state. Measure it on the next tick, then place it.
      this.$nextTick(() => {
        this.reposition();
      });
    },
    stopTracking() {
      if (this.viewportHandle) {
        releaseViewport(this.viewportHandle);
        this.viewportHandle = null;
      }
      this.panelPos = null;
      this.overlayLayer = null;
    },
    toggle() {
      if (this.disabled) return;

      if (this.open) {
        this.close();
      } else {
        this.open = true;
      }
    },
    close() {
      if (this.open) {
        this.open = false;
      }
    },
    select(item) {
      if (!item || item.disabled) return;
      this.$emit('select', item);
      if (item.href) {
        window.location.href = item.href;
      }
      if (this.closeOnSelect) {
        this.close();
      }
    },
    onDocumentClick(event) {
      if (!this.open) return;

      // The menu is no longer a descendant of the component, so "outside" means
      // outside the trigger AND outside the teleported panel. Checking only the
      // root would close the menu on every click inside it.
      const inTrigger = this.$refs.root && this.$refs.root.contains(event.target);
      const inMenu = this.$refs.menu && this.$refs.menu.contains(event.target);

      if (!inTrigger && !inMenu) {
        this.close();
      }
    },
    onRootKeydown(event) {
      if (this.disabled) {
        return;
      }
      const key = event.key;
      if (key === 'Escape') {
        if (!this.open) {
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        this.close();
        return;
      }
      if (key === 'ArrowDown' || key === 'ArrowUp' || key === 'Enter' || key === ' ') {
        if (this.open && key === 'Enter' && this.isItemNode(event.target)) {
          event.stopPropagation();
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        this.open = true;
      }
    },
    isItemNode(node) {
      return !!node && node.nodeType === 1 && node.getAttribute('role') === 'menuitem';
    },
    onKeydown(event) {
      if (event.key === 'Escape' && this.open) {
        event.stopPropagation();
        this.close();
      }
    }
  }
};
</script>