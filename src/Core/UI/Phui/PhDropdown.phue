<template>
  <div
    ref="root"
    data-phui="dropdown"
    class="dropdown d-inline-block position-relative"
    @keydown="onRootKeydown"
  >
    <slot name="trigger" :open="open" :toggle="toggle">
      <button
        type="button"
        class="btn d-inline-flex align-items-center"
        :class="[variantClass, sizeClass]"
        :disabled="disabled"
        aria-haspopup="menu"
        :aria-expanded="open ? 'true' : 'false'"
        @click="toggle"
      >
        <span>{{ label }}</span>
        <ph-icon
          name="chevron-down"
          size="sm"
          class="ms-1"
          :style="chevronStyle"
        />
      </button>
    </slot>
    <teleport to="body" v-if="open">
      <div
        ref="menu"
        data-phui="dropdown-menu"
        class="dropdown-menu show"
        role="menu"
        :style="menuStyle"
      >
        <template v-for="(item, index) in items" :key="index">
          <h6 v-if="item.header" class="dropdown-header">{{ item.header }}</h6>
          <hr v-else-if="item.divider" class="dropdown-divider" />
          <span
            v-else-if="item.disabled"
            class="dropdown-item disabled d-flex align-items-center"
            aria-disabled="true"
          >
            <ph-icon v-if="item.icon" :name="item.icon" size="sm" class="me-2" />
            {{ item.label }}
          </span>
          <a
            v-else
            class="dropdown-item d-flex align-items-center"
            href="#"
            role="menuitem"
            @click.prevent="select(item)"
          >
            <ph-icon v-if="item.icon" :name="item.icon" size="sm" class="me-2" />
            {{ item.label }}
          </a>
        </template>

        <slot :close="close" />
      </div>
    </teleport>
  </div>
</template>

<script>

const MENU_Z = 1040;

export default {
  name: 'PhDropdown',
  props: {
    label: {
      type: String,
      default: 'Menu'
    },
    items: {
      type: Array,
      default: () => []
    },
    variant: {
      type: String,
      default: 'secondary',
      validator: (val) => ['primary', 'secondary', 'outline', 'ghost', 'danger', 'light'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    align: {
      type: String,
      default: 'start',
      validator: (val) => ['start', 'end'].includes(val)
    },
    closeOnSelect: {
      type: Boolean,
      default: true
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['select', 'open', 'close'],
  data() {
    return {
      open: false,
      // Page-space geometry of the trigger, measured when the menu opens.
      anchorRect: null,
      tracking: false
    };
  },
  computed: {
    variantClass() {
      const map = {
        primary: 'btn-primary',
        secondary: 'btn-secondary',
        outline: 'btn-outline-secondary',
        ghost: 'btn-link',
        danger: 'btn-danger',
        light: 'btn-light'
      };
      return map[this.variant] || 'btn-secondary';
    },
    sizeClass() {
      if (this.size === 'sm') return 'btn-sm';
      if (this.size === 'lg') return 'btn-lg';
      return '';
    },
    chevronStyle() {
      return {
        transition: 'transform 0.15s ease',
        transform: this.open ? 'rotate(180deg)' : 'none'
      };
    },
    menuStyle() {
      if (!this.anchorRect) {
        // Opened before the first measurement (can only happen before mount):
        // hide it rather than flash it at the top-left of the document.
        return { visibility: 'hidden' };
      }

      const style = {
        position: 'absolute',
        top: `${this.anchorRect.bottom}px`,
        marginTop: '0.125rem',
        zIndex: MENU_Z
      };

      if (this.align === 'end') {
        // Right edge of the menu on the right edge of the trigger. Bootstrap's
        // `.dropdown-menu-end` is not used: it sets `right: 0` against the
        // original offset parent, which no longer exists once teleported.
        style.left = `${this.anchorRect.right}px`;
        style.transform = 'translateX(-100%)';
      } else {
        style.left = `${this.anchorRect.left}px`;
      }

      return style;
    }
  },
  watch: {
    open(value) {
      this.$emit(value ? 'open' : 'close');

      if (value) {
        this.startTracking();
      } else {
        this.stopTracking();
      }
    }
  },
  mounted() {
    document.addEventListener('click', this.onDocumentClick);
    document.addEventListener('keydown', this.onKeydown);
  },
  beforeUnmount() {
    document.removeEventListener('click', this.onDocumentClick);
    document.removeEventListener('keydown', this.onKeydown);
    this.stopTracking();
  },
  methods: {
    /** Trigger geometry in document space, so page scroll needs no recompute. */
    measure() {
      const trigger = this.$refs.root;
      if (!trigger || typeof trigger.getBoundingClientRect !== 'function') {
        this.anchorRect = null;
        return;
      }

      const rect = trigger.getBoundingClientRect();
      this.anchorRect = {
        left: rect.left + window.scrollX,
        right: rect.right + window.scrollX,
        bottom: rect.bottom + window.scrollY
      };
    },
    /**
     * Page scrolling is already handled by the document-space coordinates; what
     * still moves the trigger without moving the menu is a *nested* scroller —
     * the column the trigger sits inside. A scroll listener on window in the
     * capture phase sees those too, since scroll events do not bubble.
     */
    startTracking() {
      if (this.tracking) return;
      this.tracking = true;
      this.measure();

      window.addEventListener('scroll', this.onViewportChange, true);
      window.addEventListener('resize', this.onViewportChange);
    },
    stopTracking() {
      if (!this.tracking) return;
      this.tracking = false;

      window.removeEventListener('scroll', this.onViewportChange, true);
      window.removeEventListener('resize', this.onViewportChange);
    },
    onViewportChange() {
      if (this.open) {
        this.measure();
      }
    },
    toggle() {
      if (this.disabled) return;

      if (this.open) {
        this.close();
      } else {
        this.open = true;
      }
    },
    close() {
      if (this.open) {
        this.open = false;
      }
    },
    select(item) {
      if (!item || item.disabled) return;
      this.$emit('select', item);
      if (item.href) {
        window.location.href = item.href;
      }
      if (this.closeOnSelect) {
        this.close();
      }
    },
    onDocumentClick(event) {
      if (!this.open) return;

      // The menu is no longer a descendant of the component, so "outside" means
      // outside the trigger AND outside the teleported panel. Checking only the
      // root would close the menu on every click inside it.
      const inTrigger = this.$refs.root && this.$refs.root.contains(event.target);
      const inMenu = this.$refs.menu && this.$refs.menu.contains(event.target);

      if (!inTrigger && !inMenu) {
        this.close();
      }
    },
    onRootKeydown(event) {
      if (this.disabled) {
        return;
      }
      const key = event.key;
      if (key === 'Escape') {
        if (!this.open) {
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        this.close();
        return;
      }
      if (key === 'ArrowDown' || key === 'ArrowUp' || key === 'Enter' || key === ' ') {
        if (this.open && key === 'Enter' && this.isItemNode(event.target)) {
          event.stopPropagation();
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        this.open = true;
      }
    },
    isItemNode(node) {
      return !!node && node.nodeType === 1 && node.getAttribute('role') === 'menuitem';
    },
    onKeydown(event) {
      if (event.key === 'Escape' && this.open) {
        event.stopPropagation();
        this.close();
      }
    }
  }
};
</script>