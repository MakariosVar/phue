<template>
  <div
    :class="['card', { 'border-0': !bordered }]"
    :style="hoverStyle"
    @mouseenter="hovered = true"
    @mouseleave="hovered = false"
  >
    <div v-if="$slots.header || title" class="card-header bg-transparent">
      <slot name="header">
        <h3 class="card-title mb-0">{{ title }}</h3>
        <p v-if="subtitle" class="card-subtitle text-body-secondary mt-1 mb-0">{{ subtitle }}</p>
      </slot>
    </div>

    <div class="card-body">
      <slot />
    </div>

    <div v-if="$slots.footer" class="card-footer bg-transparent">
      <slot name="footer" />
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhCard',
  props: {
    title: {
      type: String,
      default: ''
    },
    subtitle: {
      type: String,
      default: ''
    },
    bordered: {
      type: Boolean,
      default: true
    },
    hoverable: {
      type: Boolean,
      default: false
    }
  },
  data() {
    return {
      hovered: false
    };
  },
  computed: {
    hoverStyle() {
      if (!this.hoverable) {
        return null;
      }
      const style = {
        cursor: 'pointer',
        transition: 'box-shadow 0.15s ease, transform 0.15s ease'
      };
      if (this.hovered) {
        style.boxShadow = 'var(--bs-box-shadow-sm)';
        style.transform = 'translateY(-2px)';
      }
      return style;
    }
  }
};
</script>