<template>
  <div :class="['card', { 'border-0': !bordered, 'card-hoverable': hoverable }]">
    <div v-if="$slots.header || title" class="card-header bg-transparent">
      <slot name="header">
        <h3 class="card-title mb-0">{{ title }}</h3>
        <p v-if="subtitle" class="card-subtitle text-body-secondary mt-1 mb-0">{{ subtitle }}</p>
      </slot>
    </div>

    <div class="card-body">
      <slot />
    </div>

    <div v-if="$slots.footer" class="card-footer bg-transparent">
      <slot name="footer" />
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhCard',
  props: {
    title: {
      type: String,
      default: ''
    },
    subtitle: {
      type: String,
      default: ''
    },
    bordered: {
      type: Boolean,
      default: true
    },
    hoverable: {
      type: Boolean,
      default: false
    }
  }
};
</script>