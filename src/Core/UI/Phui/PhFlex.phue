<template>
  <div :class="flexClasses" :style="customStyles">
    <slot />
  </div>
</template>

<script>
export default {
  name: 'PhFlex',
  props: {
    direction: {
      type: String,
      default: 'row',
      validator: (val) => ['row', 'row-reverse', 'column', 'column-reverse'].includes(val)
    },
    wrap: {
      type: String,
      default: 'nowrap',
      validator: (val) => ['nowrap', 'wrap', 'wrap-reverse'].includes(val)
    },
    align: {
      type: String,
      default: 'stretch',
      validator: (val) => ['stretch', 'flex-start', 'center', 'flex-end', 'baseline'].includes(val)
    },
    justify: {
      type: String,
      default: 'flex-start',
      validator: (val) => ['flex-start', 'center', 'flex-end', 'space-between', 'space-around', 'space-evenly'].includes(val)
    },
    gap: {
      type: [String, Number],
      default: '0'
    }
  },
  computed: {
    directionClass() {
      const map = {
        row: 'flex-row',
        'row-reverse': 'flex-row-reverse',
        column: 'flex-column',
        'column-reverse': 'flex-column-reverse'
      };
      return map[this.direction] || 'flex-row';
    },
    wrapClass() {
      const map = {
        nowrap: 'flex-nowrap',
        wrap: 'flex-wrap',
        'wrap-reverse': 'flex-wrap-reverse'
      };
      return map[this.wrap] || 'flex-nowrap';
    },
    alignClass() {
      const map = {
        stretch: 'align-items-stretch',
        'flex-start': 'align-items-start',
        center: 'align-items-center',
        'flex-end': 'align-items-end',
        baseline: 'align-items-baseline'
      };
      return map[this.align] || 'align-items-stretch';
    },
    justifyClass() {
      const map = {
        'flex-start': 'justify-content-start',
        center: 'justify-content-center',
        'flex-end': 'justify-content-end',
        'space-between': 'justify-content-between',
        'space-around': 'justify-content-around',
        'space-evenly': 'justify-content-evenly'
      };
      return map[this.justify] || 'justify-content-start';
    },
    flexClasses() {
      return ['d-flex', this.directionClass, this.wrapClass, this.alignClass, this.justifyClass];
    },
    customStyles() {
      const gapMap = { none: '0', xs: '0.25rem', sm: '0.5rem', md: '0.75rem', lg: '1rem', xl: '1.5rem', '2xl': '2rem' };
      const gapVal = typeof this.gap === 'number' ? `${this.gap}px` : (gapMap[this.gap] || this.gap);
      if (gapVal) return { gap: gapVal };
      return {};
    }
  }
};
</script>
