<template>
  <teleport to="body" v-if="mounted && modelValue">
    <div
      ref="overlayRoot"
      data-phui="drawer"
      tabindex="-1"
      :style="backdropStyle"
      @click="onBackdropClick"
    >
      <div
        class="d-flex flex-column"
        role="dialog"
        aria-modal="true"
        :aria-label="title || null"
        :style="panelStyle"
        @click.stop
      >
        <div class="d-flex align-items-center border-bottom px-3 py-2">
          <slot name="header">
            <h5 class="mb-0 me-auto">{{ title }}</h5>
          </slot>
          <button
            v-if="closable"
            type="button"
            class="btn-close ms-2"
            aria-label="Close"
            @click="close"
          ></button>
        </div>

        <div
          class="flex-grow-1 px-3 py-3"
          :style="{ overflowY: scrollable ? 'auto' : 'visible' }"
        >
          <slot />
        </div>

        <div v-if="$slots.footer" class="border-top px-3 py-2">
          <slot name="footer" />
        </div>
      </div>
    </div>
  </teleport>
</template>

<script>
export default {
  name: 'PhDrawer',
  ssr: false,
  composables: ['overlay'],
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    position: {
      type: String,
      default: 'end',
      validator: (val) => ['start', 'end', 'top', 'bottom'].includes(val)
    },
    size: {
      type: String,
      default: null
    },
    title: {
      type: String,
      default: ''
    },
    closable: {
      type: Boolean,
      default: true
    },
    closeOnBackdrop: {
      type: Boolean,
      default: true
    },
    scrollable: {
      type: Boolean,
      default: true
    }
  },
  emits: ['update:modelValue', 'close', 'open'],
  data() {
    return {
      mounted: false,
      trap: null
    };
  },
  computed: {
    backdropStyle() {
      return {
        position: 'fixed',
        inset: '0',
        zIndex: 1045,
        background: 'rgba(0, 0, 0, 0.5)'
      };
    },
    panelStyle() {
      const isHorizontal = this.position === 'start' || this.position === 'end';
      const dimension = this.size || (isHorizontal ? '25rem' : '20rem');
      const style = {
        position: 'fixed',
        zIndex: 1046,
        background: 'var(--bs-body-bg)',
        boxShadow: '0 0.5rem 1.5rem rgba(0, 0, 0, 0.25)',
        transition: 'transform 0.2s ease',
        maxWidth: '100vw',
        maxHeight: '100vh'
      };
      if (this.position === 'start') {
        style.top = '0';
        style.bottom = '0';
        style.left = '0';
        style.width = dimension;
      } else if (this.position === 'end') {
        style.top = '0';
        style.bottom = '0';
        style.right = '0';
        style.width = dimension;
      } else if (this.position === 'top') {
        style.left = '0';
        style.right = '0';
        style.top = '0';
        style.height = dimension;
      } else {
        style.left = '0';
        style.right = '0';
        style.bottom = '0';
        style.height = dimension;
      }
      return style;
    }
  },
  watch: {
    modelValue(value) {
      if (value) {
        this.activate();
      } else {
        this.deactivate();
      }
    }
  },
  mounted() {
    this.mounted = true;
    if (this.modelValue) {
      this.activate();
    }
  },
  beforeUnmount() {
    this.deactivate();
  },
  methods: {
    close() {
      this.$emit('update:modelValue', false);
      this.$emit('close');
    },
    onBackdropClick() {
      if (this.closeOnBackdrop && this.closable) {
        this.close();
      }
    },

    /**
     * Hands focus containment to the shared composable.
     *
     * The trap root is the outermost teleported element, not the panel: the
     * sibling scan that makes the background inert walks the root's parent's
     * children, and only the outer wrapper is a direct child of <body>.
     * Trapping on the panel would find no siblings and leave the page tabbable
     * behind the drawer.
     *
     * `tabindex="-1"` sits on that wrapper so a drawer with no focusable
     * children still has a valid programmatic fallback focus target.
     */
    activate() {
      this.$nextTick(() => {
        const root = this.$refs.overlayRoot;
        if (!root) {
          return;
        }

        this.releaseTrap();
        this.trap = focusTrap(root, {
          onEscape: () => {
            if (this.closable) {
              this.close();
            }
          }
        });

        this.$emit('open');
      });
    },
    deactivate() {
      this.releaseTrap();
    },
    releaseTrap() {
      if (this.trap && typeof this.trap.release === 'function') {
        this.trap.release();
      }
      this.trap = null;
    }
  }
};
</script>