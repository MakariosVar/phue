<template>
  <div :class="boxClasses" :style="boxStyles">
    <slot />
  </div>
</template>

<script>
export default {
  name: 'PhBox',
  props: {
    padding: {
      type: [String, Number],
      default: 'md'
    },
    margin: {
      type: [String, Number],
      default: '0'
    },
    border: {
      type: Boolean,
      default: false
    },
    radius: {
      type: String,
      default: 'md'
    },
    bg: {
      type: String,
      default: 'surface'
    }
  },
  computed: {
    boxClasses() {
      const classes = [];
      if (this.border) classes.push('border');
      const radiusMap = {
        none: 'rounded-0',
        sm: 'rounded-1',
        md: 'rounded',
        lg: 'rounded-3',
        full: 'rounded-pill'
      };
      if (radiusMap[this.radius]) classes.push(radiusMap[this.radius]);
      const bgMap = {
        primary: 'bg-primary',
        secondary: 'bg-secondary',
        success: 'bg-success',
        danger: 'bg-danger',
        warning: 'bg-warning',
        light: 'bg-light',
        dark: 'bg-dark',
        white: 'bg-white',
        transparent: 'bg-transparent'
      };
      if (bgMap[this.bg]) classes.push(bgMap[this.bg]);
      return classes;
    },
    boxStyles() {
      const padVal = typeof this.padding === 'number' ? `${this.padding}px` : (this.paddingMap[this.padding] || this.padding);
      const marVal = typeof this.margin === 'number' ? `${this.margin}px` : (this.marginMap[this.margin] || this.margin);
      const bgVal = !this.bgMap[this.bg] ? this.bg : undefined;

      const styles = {};
      if (padVal) styles.padding = padVal;
      if (marVal !== '0') styles.margin = marVal;
      if (bgVal) styles.backgroundColor = bgVal;
      return styles;
    },
    paddingMap() {
      return { none: '0', xs: '0.25rem', sm: '0.5rem', md: '0.75rem', lg: '1rem', xl: '1.5rem', '2xl': '2rem' };
    },
    marginMap() {
      return { none: '0', xs: '0.25rem', sm: '0.5rem', md: '0.75rem', lg: '1rem', xl: '1.5rem', '2xl': '2rem' };
    },
    bgMap() {
      return {
        primary: true, secondary: true, success: true, danger: true,
        warning: true, light: true, dark: true, white: true, transparent: true
      };
    }
  }
};
</script>
