<template>
  <span
    ref="root"
    data-phui="tooltip"
    class="position-relative d-inline-block"
    :aria-describedby="visible ? tipId : null"
    @mouseenter="onEnter"
    @mouseleave="onLeave"
    @focusin="onFocusIn"
    @focusout="onFocusOut"
    @click="onClick"
  >
    <slot />

    <teleport to="body" v-if="rendered">
      <span
        v-show="visible"
        ref="tip"
        :id="tipId"
        role="tooltip"
        :class="tipClasses"
        :style="tipStyle"
      >
        <slot name="content">{{ content }}</slot>
      </span>
    </teleport>
  </span>
</template>

<script>
import { useId } from "vue";


const TIP_Z = 1080;
const TIP_OFFSET = 8;
const VIEWPORT_MARGIN = 8;

export default {
  name: 'PhTooltip',
  props: {
    content: {
      type: String,
      default: ''
    },
    placement: {
      type: String,
      default: 'top',
      validator: (val) => ['top', 'bottom', 'start', 'end'].includes(val)
    },
    trigger: {
      type: String,
      default: 'hover',
      validator: (val) => ['hover', 'focus', 'click'].includes(val)
    },
    delay: {
      type: Number,
      default: 120
    },
    disabled: {
      type: Boolean,
      default: false
    },
    variant: {
      type: String,
      default: 'dark',
      validator: (val) => ['dark', 'light'].includes(val)
    },
    maxWidth: {
      type: String,
      default: '260px'
    }
  },
  setup() {
    const HashID = useId();
    return { HashID };
  },
  data() {
    return {
      visible: false,
      rendered: false,
      positioned: false,
      timer: null,
      triggerRect: null,
      tipSize: { width: 0, height: 0 }
    };
  },
  computed: {
    tipId() {
      return `ph-tooltip-${this.HashID}`;
    },
    tipClasses() {
      const classes = ['small', 'rounded', 'px-2', 'py-1', 'shadow-sm'];
      if (this.variant === 'light') {
        classes.push('bg-light', 'text-dark', 'border');
      } else {
        classes.push('bg-dark', 'text-white');
      }
      return classes;
    },
    tipStyle() {
      const style = {
        position: 'absolute',
        zIndex: TIP_Z,
        whiteSpace: 'normal',
        width: 'max-content',
        maxWidth: this.maxWidth,
        pointerEvents: 'none',
        top: '0',
        left: '0',
       visibility: this.positioned ? 'visible' : 'hidden'
      };

      if (!this.positioned || !this.triggerRect || typeof document === 'undefined') {
        return style;
      }

      const rect = this.triggerRect;
      const placement = this.placementToUse(rect);
      const w = this.tipSize.width;
      const h = this.tipSize.height;
      const vw = document.documentElement.clientWidth;
      const vh = document.documentElement.clientHeight;

     let top;
      let left;

      if (placement === 'top') {
        top = rect.top - h - TIP_OFFSET;
      } else if (placement === 'bottom') {
        top = rect.bottom + TIP_OFFSET;
      } else {
        top = rect.top + rect.height / 2 - h / 2;
      }

      if (placement === 'start') {
        left = rect.left - w - TIP_OFFSET;
      } else if (placement === 'end') {
        left = rect.right + TIP_OFFSET;
      } else {
        left = rect.left + rect.width / 2 - w / 2;
      }

      left = this.clamp(left, VIEWPORT_MARGIN, vw - w - VIEWPORT_MARGIN);
      top = this.clamp(top, VIEWPORT_MARGIN, vh - h - VIEWPORT_MARGIN);

      // The measurement above is in viewport coordinates; the element is placed in
      // document space, so the scroll offset has to be added back.
      const scrollX = window.scrollX || window.pageXOffset || 0;
      const scrollY = window.scrollY || window.pageYOffset || 0;

      style.left = `${left + scrollX}px`;
      style.top = `${top + scrollY}px`;

      return style;
    }
  },
  watch: {
    visible(isVisible) {
      if (isVisible) {
        this.trackViewport();
      } else {
        this.releaseViewport();
      }
    }
  },
  mounted() {
    this.rendered = true;
  },
  beforeUnmount() {
    this.clearTimer();
    this.releaseViewport();
  },
  methods: {
    clamp(value, min, max) {
      if (max < min) {
        return min;
      }
      return Math.min(Math.max(value, min), max);
    },
    placementToUse(rect) {
      const vw = document.documentElement.clientWidth;
      const vh = document.documentElement.clientHeight;
      const vertical = this.placement === 'top' || this.placement === 'bottom';
      const opposite = { top: 'bottom', bottom: 'top', start: 'end', end: 'start' };
      const room = {
        top: rect.top,
        bottom: vh - rect.bottom,
        start: rect.left,
        end: vw - rect.right
      };
      const needed = (vertical ? this.tipSize.height : this.tipSize.width)
        + TIP_OFFSET
        + VIEWPORT_MARGIN;
      const flipped = opposite[this.placement];

      if (room[this.placement] < needed && room[flipped] >= needed) {
        return flipped;
      }

      return this.placement;
    },
    measureTrigger() {
      const root = this.$refs.root;
      if (root) {
        this.triggerRect = root.getBoundingClientRect();
      }
    },
    measureTip() {
      const tip = this.$refs.tip;
      if (tip) {
        this.tipSize = { width: tip.offsetWidth, height: tip.offsetHeight };
      }
      this.positioned = true;
    },
    trackViewport() {
      window.addEventListener('scroll', this.onViewportChange, true);
      window.addEventListener('resize', this.onViewportChange);
      document.addEventListener('keydown', this.onKeydown);
    },
    releaseViewport() {
      window.removeEventListener('scroll', this.onViewportChange, true);
      window.removeEventListener('resize', this.onViewportChange);
      document.removeEventListener('keydown', this.onKeydown);
    },
    onViewportChange() {
      if (this.visible) {
        this.measureTrigger();
      }
    },
    onKeydown(event) {
     if (event.key === 'Escape' && this.visible) {
        this.hide();
      }
    },
    clearTimer() {
      if (this.timer) {
        clearTimeout(this.timer);
        this.timer = null;
      }
    },
    reveal() {
      if (this.disabled) return;
      this.positioned = false;
      this.measureTrigger();
      this.visible = true;
      this.$nextTick(() => this.measureTip());
    },
    show() {
      this.reveal();
    },
    hide() {
      this.clearTimer();
      this.visible = false;
      this.positioned = false;
      this.triggerRect = null;
    },
    scheduleShow() {
      if (this.disabled) return;
      this.clearTimer();
      if (this.delay > 0) {
        this.timer = setTimeout(() => this.reveal(), this.delay);
      } else {
        this.reveal();
      }
    },
    onEnter() {
      if (this.trigger === 'click') return;
      this.scheduleShow();
    },
    onLeave() {
      if (this.trigger === 'click') return;
      this.hide();
    },
    onFocusIn() {
      if (this.trigger === 'click') return;
      this.show();
    },
    onFocusOut() {
      if (this.trigger === 'click') return;
      this.hide();
    },
    onClick() {
      if (this.trigger !== 'click') return;
      if (this.visible) {
        this.hide();
      } else {
        this.show();
      }
    }
  }
};
</script>
