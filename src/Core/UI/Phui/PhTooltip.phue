<template>
  <span
    ref="root"
    data-phui="tooltip"
    class="position-relative d-inline-block"
    :aria-describedby="visible ? tipId : null"
    @mouseenter="onEnter"
    @mouseleave="onLeave"
    @focusin="onFocusIn"
    @focusout="onFocusOut"
    @click="onClick"
  >
    <slot />

    <teleport to="body" v-if="rendered">
      <span
        v-show="visible"
        ref="tip"
        :id="tipId"
        role="tooltip"
        :class="tipClasses"
        :style="tipStyle"
      >
        <slot name="content">{{ content }}</slot>
      </span>
    </teleport>
  </span>
</template>

<script>
import { useId } from "vue";


const TIP_Z = 1080;
const TIP_OFFSET = 8;
const VIEWPORT_MARGIN = 8;

export default {
  name: 'PhTooltip',
  composables: ['position', 'overlay'],
  props: {
    content: {
      type: String,
      default: ''
    },
    placement: {
      type: String,
      default: 'top',
      validator: (val) => ['top', 'bottom', 'start', 'end'].includes(val)
    },
    trigger: {
      type: String,
      default: 'hover',
      validator: (val) => ['hover', 'focus', 'click'].includes(val)
    },
    delay: {
      type: Number,
      default: 120
    },
    disabled: {
      type: Boolean,
      default: false
    },
    variant: {
      type: String,
      default: 'dark',
      validator: (val) => ['dark', 'light'].includes(val)
    },
    maxWidth: {
      type: String,
      default: '260px'
    }
  },
  setup() {
    const HashID = useId();
    return { HashID };
  },
  data() {
    return {
      visible: false,
      rendered: false,
      positioned: false,
      timer: null,
      anchorRect: null,
      tipSize: { width: 0, height: 0 },
      viewportHandle: null,
      /** Slot in the shared Escape stack, held only while the panel is open. */
      escapeHandle: null
    };
  },
  computed: {
    tipId() {
      return `ph-tooltip-${this.HashID}`;
    },
    tipClasses() {
      const classes = ['small', 'rounded', 'px-2', 'py-1', 'shadow-sm'];
      if (this.variant === 'light') {
        classes.push('bg-light', 'text-dark', 'border');
      } else {
        classes.push('bg-dark', 'text-white');
      }
      return classes;
    },
    tipStyle() {
      const style = {
        position: 'absolute',
        zIndex: TIP_Z,
        whiteSpace: 'normal',
        width: 'max-content',
        maxWidth: this.maxWidth,
        pointerEvents: 'none',
        top: '0',
        left: '0',
       visibility: 'hidden'
      };

      if (!this.positioned || !this.anchorRect || typeof document === 'undefined') {
        return style;
      }

      // A tooltip always sits centred against its trigger on the cross axis,
      // whichever side it ends up on, so `align` is 'center' for all four
      // placements rather than following the placement.
      const pos = positionFor(this.anchorRect, {
        size: this.tipSize,
        placement: this.placement,
        align: 'center',
        offset: TIP_OFFSET,
        gap: TIP_OFFSET,
        allowFlip: true,
        clamp: true,
        margin: VIEWPORT_MARGIN,
        // clientWidth/clientHeight, not innerWidth/innerHeight: those include
        // the scrollbar, which would let a clamped tip hide under it.
        viewport: {
          width: document.documentElement.clientWidth,
          height: document.documentElement.clientHeight
        },
        scroll: {
          x: window.scrollX || window.pageXOffset || 0,
          y: window.scrollY || window.pageYOffset || 0
        }
      });

      style.left = `${pos.left}px`;
      style.top = `${pos.top}px`;
      // A clamped tip whose trigger has scrolled away would otherwise stay pinned to
      // the viewport edge, following nothing.
      style.visibility = pos.offscreen ? 'hidden' : 'visible';

      return style;
    }
  },
  watch: {
    visible(isVisible) {
      if (isVisible) {
        this.claimEscape();
        this.trackViewport();
      } else {
        this.releaseEscape();
        this.releaseViewport();
      }
    }
  },
  mounted() {
    this.rendered = true;
  },
  beforeUnmount() {
    this.clearTimer();
    this.releaseViewport();
  },
  methods: {
    measureAnchorRect() {
      this.anchorRect = measureAnchor(this.$refs.root);
    },
    measureTip() {
      const tip = this.$refs.tip;
      if (tip) {
        this.tipSize = { width: tip.offsetWidth, height: tip.offsetHeight };
      }
    },
    reposition() {
      if (!this.visible) {
        return;
      }
      // Both edges are re-measured: the trigger moves on scroll, and the tip can
      // change size if its content grew. `positioned` is restored in the same
      // tick, so the reactivity flush never renders a hidden tip in between.
      this.positioned = false;
      this.measureAnchorRect();
      this.measureTip();
      this.positioned = true;
    },
    trackViewport() {
      this.releaseViewport();
      this.viewportHandle = trackViewport(this.reposition);
    },
    releaseViewport() {
      if (this.viewportHandle) {
        releaseViewport(this.viewportHandle);
        this.viewportHandle = null;
      }
      if (typeof document !== 'undefined') {
      }
    },
    clearTimer() {
      if (this.timer) {
        clearTimeout(this.timer);
        this.timer = null;
      }
    },
    reveal() {
      if (this.disabled) return;
      this.positioned = false;
      this.measureAnchorRect();
      this.visible = true;
      this.$nextTick(() => {
        this.measureTip();
        this.positioned = true;
      });
    },
    show() {
      this.reveal();
    },
    /**
     * Claims the shared Escape slot for as long as the tip is visible.
     *
     * The tip is teleported to `body`, so a tip inside a dialog is a sibling of that
     * dialog rather than a child of it. Escape has to be claimed rather than
     * inherited: the stack decides, and the topmost surface wins. A tip is the
     * shortest-lived surface in the kit, so releasing on hide matters — a tip that
     * held the slot would swallow the Escape meant for the dialog underneath.
     */
    claimEscape() {
      this.releaseEscape();
      this.escapeHandle = registerEscapeHandler((event) => {
        event.stopPropagation();
        this.hide();
      }, this.$refs.root);
    },
    releaseEscape() {
      if (this.escapeHandle && typeof this.escapeHandle.release === 'function') {
        this.escapeHandle.release();
      }
      this.escapeHandle = null;
    },
    hide() {
      this.clearTimer();
      this.visible = false;
      this.positioned = false;
      this.anchorRect = null;
    },
    scheduleShow() {
      if (this.disabled) return;
      this.clearTimer();
      if (this.delay > 0) {
        this.timer = setTimeout(() => this.reveal(), this.delay);
      } else {
        this.reveal();
      }
    },
    onEnter() {
      if (this.trigger === 'click') return;
      this.scheduleShow();
    },
    onLeave() {
      if (this.trigger === 'click') return;
      this.hide();
    },
    onFocusIn() {
      if (this.trigger === 'click') return;
      this.show();
    },
    onFocusOut() {
      if (this.trigger === 'click') return;
      this.hide();
    },
    onClick() {
      if (this.trigger !== 'click') return;
      if (this.visible) {
        this.hide();
      } else {
        this.show();
      }
    }
  }
};
</script>
