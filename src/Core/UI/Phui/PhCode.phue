<template>
  <div
    class="border rounded position-relative bg-body-secondary"
    data-phui="code"
    :data-ph-theme-scope="scopeId"
  >
    <div
      v-if="language || copyable || themeSwitcher"
      class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom rounded-top bg-body-tertiary"
    >
      <span class="text-body-secondary small text-uppercase fw-semibold">{{ languageLabel }}</span>
      <div class="d-flex align-items-center gap-2">
        <ph-dropdown
          v-if="themeSwitcher"
          variant="ghost"
          size="sm"
          align="end"
          :items="themeItems"
          @select="selectTheme"
        >
          <template #trigger="{ open, toggle }">
            <button
              type="button"
              data-phui="theme-picker"
              class="btn btn-link btn-sm d-inline-flex align-items-center text-body-secondary"
              :aria-expanded="open ? 'true' : 'false'"
              title="Code theme"
              @click="toggle"
            >
              <ph-icon name="paint-bucket" size="sm" class="me-1" />
              <span class="small">{{ activeThemeLabel }}</span>
              <ph-icon
                name="chevron-down"
                size="sm"
                class="ms-1"
                :style="{ transition: 'transform 0.15s ease', transform: open ? 'rotate(180deg)' : 'none' }"
              />
            </button>
          </template>
        </ph-dropdown>
        <button
          v-if="copyable"
          type="button"
          class="btn btn-link btn-sm"
          data-phui="code-copy"
          @click="copy"
          :disabled="copying"
          :aria-label="copied ? 'Copied' : 'Copy to clipboard'"
        >
          <i v-if="!copied" class="bi bi-clipboard"></i>
          <i v-else class="bi bi-check" style="color:var(--bs-success,green);"></i>
        </button>
      </div>
    </div>
    <pre
      data-phui="code-pre"
      class="m-0 p-3 overflow-auto rounded-bottom font-monospace small mb-0"
      :class="[codeClasses, { 'line-numbers': lineNumbers }]"
      :style="preStyles"
    ><code
      ref="codeEl"
      :class="[codeClasses, { 'line-numbers': lineNumbers }]"
      :data-ph-highlighted="highlighted ? '1' : '0'"
      v-text="code"
    ></code></pre>
  </div>
</template>

<script>
import { useId } from "vue";

// Prism is served same-origin by the framework's npm vendor pipeline
// (`bin/phue npm:install prismjs` -> /assets/vendor/prismjs). It has to be
// same-origin: SecurityMiddleware ships `script-src 'self'; style-src 'self'`,
// so any third-party origin is blocked and the block stays plain text forever.
const DEFAULT_ASSET_BASE = '/assets/vendor/prismjs';
const LOAD_TIMEOUT = 10000;
const PLAIN_LANGUAGES = ['', 'none', 'plain', 'text', 'txt'];

// Mirrors storage/assets/vendor/prismjs/themes/ as shipped by `npm:install
// prismjs`. The browser cannot list a directory, so the picker is a static
// list; a theme dropped in by hand is reachable via the `themes` prop.
const THEMES = ['coy', 'dark', 'funky', 'okaidia', 'solarizedlight', 'tomorrow', 'twilight'];

const THEME_LABELS = {
  coy: 'Coy',
  dark: 'Dark',
  funky: 'Funky',
  okaidia: 'Okaidia',
  solarizedlight: 'Solarized Light',
  tomorrow: 'Tomorrow',
  twilight: 'Twilight',
};

// url -> promise, so N PhCode blocks on a page share one request per asset.
const inflight = new Map();

// Theme CSS text, cached per URL. The *raw* sheet is shared by every block; the
// scoped rewrite on top of it is per instance.
const themeText = new Map();

let corePromise = null;
let lineNumbersPromise = null;
let hasWarned = false;

/**
 * Splits a selector list on top-level commas only.
 *
 * A naive `list.split(',')` breaks the moment a selector contains a comma
 * inside brackets or parens — and Prism's themes are full of them:
 * `[class*=language-]`, `:not(pre)>code[class*=language-]`, and
 * `code[class*=language-],pre[class*=language-]` on one line. Splitting inside
 * `:not(a,b)` produces fragments that are not selectors at all, and the scoped
 * rule silently never matches.
 */
function splitSelectors(list) {
  const parts = [];
  let current = '';
  let depth = 0;
  let quote = null;

  for (let i = 0; i < list.length; i += 1) {
    const ch = list[i];

    if (quote) {
      current += ch;
      if (ch === quote && list[i - 1] !== '\\') quote = null;
      continue;
    }

    if (ch === '"' || ch === "'") {
      quote = ch;
      current += ch;
      continue;
    }

    if (ch === '(' || ch === '[') depth += 1;
    else if (ch === ')' || ch === ']') depth -= 1;

    if (ch === ',' && depth === 0) {
      parts.push(current);
      current = '';
      continue;
    }

    current += ch;
  }

  parts.push(current);

  return parts.map((part) => part.trim()).filter(Boolean);
}

// Selectors that already address the page root. `[scope] :root` would mean "a
// :root somewhere inside this block", which matches nothing, so these are
// rewritten to the scope element itself.
const ROOT_SELECTORS = [':root', 'html', 'body'];

/**
 * Prefixes every selector in a list with the instance scope, so the rule can
 * only ever match inside this block.
 */
function prefixSelectorList(list, prefix) {
  return splitSelectors(list)
    .map((selector) => {
      if (ROOT_SELECTORS.indexOf(selector.toLowerCase()) !== -1) {
        return prefix;
      }
      return prefix + ' ' + selector;
    })
    .join(',');
}

// At-rules whose *body* is a nested list of rules and therefore needs the same
// recursive treatment. Everything else (@font-face, @keyframes, @import) has no
// selectors in its body and must be passed through untouched — prefixing
// `from`/`0%` inside a @keyframes would destroy the animation.
const NESTING_AT_RULES = ['media', 'supports', 'layer', 'container', 'scope'];

/**
 * Rewrites a Prism theme so it applies to one block only.
 *
 * A Prism theme is page-global CSS: `.token.comment`, `code[class*=language-]`,
 * and friends match across the whole document, which is why a `<link>` can only
 * ever be a page-wide switch. This walks the sheet rule by rule and anchors each
 * selector to `[data-ph-theme-scope="<id>"]`, so two blocks on one page can hold
 * two different themes at once.
 *
 * It is a scanner rather than a full CSS parser on purpose: the component ships
 * no build step and no dependency, and the grammar it has to survive is the one
 * Prism's themes actually use.
 */
function scopeThemeCss(css, prefix) {
  let output = '';
  let cursor = 0;

  while (cursor < css.length) {
    const braceStart = css.indexOf('{', cursor);
    if (braceStart === -1) {
      output += css.slice(cursor);
      break;
    }

    const prelude = css.slice(cursor, braceStart);
    const trimmed = prelude.trim();

    // Match the closing brace of this block, tracking nesting.
    let depth = 1;
    let end = braceStart + 1;
    while (end < css.length && depth > 0) {
      if (css[end] === '{') depth += 1;
      else if (css[end] === '}') depth -= 1;
      end += 1;
    }
    const body = css.slice(braceStart + 1, end - 1);

    if (trimmed.charAt(0) === '@') {
      const at = /^@([a-z-]+)/i.exec(trimmed);
      const name = at ? at[1].toLowerCase() : '';

      output += NESTING_AT_RULES.indexOf(name) !== -1
        ? prelude + '{' + scopeThemeCss(body, prefix) + '}'
        : prelude + '{' + body + '}';
    } else if (trimmed) {
      output += prefixSelectorList(trimmed, prefix) + '{' + body + '}';
    }

    cursor = end;
  }

  return output;
}

/**
 * Fetches a theme's CSS, shared across every block on the page.
 *
 * The sheets are same-origin (`/assets/vendor/prismjs`), so this is allowed by
 * the shell's `default-src 'self'` — and it has to be a fetch rather than a
 * `<link>`, because a `<link>` cannot be scoped.
 */
function fetchThemeCss(url) {
  if (themeText.has(url)) {
    return themeText.get(url);
  }

  const pending = fetch(url, { credentials: 'same-origin' })
    .then((response) => {
      if (!response.ok) {
        throw new Error('Cannot load ' + url + ' (HTTP ' + response.status + ')');
      }
      return response.text();
    })
    .catch((error) => {
      // Drop the rejection so a later block (or a retry) can try again.
      themeText.delete(url);
      throw error;
    });

  themeText.set(url, pending);

  return pending;
}

function warnOnce(message) {
  if (!hasWarned) {
    hasWarned = true;
    console.warn('[PhCode] ' + message);
  }
}

function withTimeout(promise) {
  return Promise.race([
    promise,
    new Promise((resolve) => setTimeout(() => resolve(false), LOAD_TIMEOUT)),
  ]);
}

function loadScript(base, path) {
  const url = base + path;
  let pending = inflight.get(url);

  if (!pending) {
    pending = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = url;
      script.addEventListener('load', () => resolve(true), { once: true });
      script.addEventListener('error', () => reject(new Error('Cannot load ' + url)), { once: true });
      document.head.appendChild(script);
    }).catch((error) => {
      // Drop the rejection so a later block (or a retry) can try again.
      inflight.delete(url);
      throw error;
    });

    inflight.set(url, pending);
  }

  return pending;
}

function loadStyle(base, path, marker) {
  if (document.querySelector('link[data-prism-css="' + marker + '"]')) {
    return;
  }
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = base + path;
  link.setAttribute('data-prism-css', marker);
  document.head.appendChild(link);
}

/**
 * Applies a theme to **this block only**.
 *
 * The previous implementation kept a single page-wide
 * `<link data-prism-css="theme-*">` and removed any other block's sheet, so
 * switching one block's theme repainted every block on the page — and a second
 * block with a different theme silently fought it for ownership of the one
 * link. Themes are now fetched once, rewritten against this instance's scope
 * attribute, and injected as a `<style>` owned by this component.
 */
async function applyScopedTheme(base, theme, scopeId) {
  // The theme name reaches a URL, so it is validated before interpolation.
  if (!/^[a-z0-9-]+$/i.test(theme || '')) {
    return false;
  }

  const href = base + '/themes/prism-' + theme + '.min.css';
  const css = await withTimeout(fetchThemeCss(href));

  if (!css) {
    return false;
  }

  const selector = '[data-ph-theme-scope="' + scopeId + '"]';
  const style = document.createElement('style');
  style.setAttribute('type', 'text/css');
  style.setAttribute('data-ph-theme-scope', scopeId);
  style.textContent = scopeThemeCss(css, selector);

  // Replacing, not accumulating: only the active theme's colours may apply, and
  // A -> B -> A must not leave three sheets behind.
  const previous = document.querySelectorAll('style[data-ph-theme-scope="' + scopeId + '"]');
  previous.forEach((node) => node.remove());

  document.head.appendChild(style);

  return true;
}

/**
 * Last-resort page-wide theme, used only when the theme sheet could not be
 * fetched. It cannot be scoped, so it is deliberately not the normal path: a
 * degraded block is better than an unstyled one, but every block sharing a
 * theme is exactly the bug this replaced.
 */
function applyGlobalThemeFallback(base, theme) {
  if (!/^[a-z0-9-]+$/i.test(theme || '')) {
    return;
  }

  const href = base + '/themes/prism-' + theme + '.min.css';
  const current = document.querySelector('link[data-prism-css^="theme-"]');

  if (current && current.getAttribute('href') === href) {
    return;
  }

  document.querySelectorAll('link[data-prism-css^="theme-"]').forEach((link) => link.remove());

  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = href;
  link.setAttribute('data-prism-css', 'theme-' + theme);
  document.head.appendChild(link);
}

function ensureCore(base) {
  if (window.Prism) {
    return Promise.resolve(true);
  }

  if (!corePromise) {
    corePromise = (async () => {
      try {
        await loadScript(base, '/components/prism-core.min.js');
        await loadScript(base, '/plugins/autoloader/prism-autoloader.min.js');

        const autoloader = window.Prism.plugins.autoloader;
        autoloader.languages_path = base + '/components/';
        autoloader.use_minified = true;
        return true;
      } catch (error) {
        corePromise = null;
        warnOnce('Prism assets are missing — run `bin/phue npm:install prismjs`, showing plain code.');
        return false;
      }
    })();
  }

  return corePromise;
}

function ensureLineNumbers(base) {
  if (!lineNumbersPromise) {
    lineNumbersPromise = (async () => {
      loadStyle(base, '/plugins/line-numbers/prism-line-numbers.min.css', 'line-numbers');
      try {
        await loadScript(base, '/plugins/line-numbers/prism-line-numbers.min.js');
        return true;
      } catch (error) {
        return false;
      }
    })();
  }

  return lineNumbersPromise;
}

/**
 * Resolves once the grammar is registered in Prism.languages.
 *
 * Must be awaited BEFORE highlightElement: the autoloader only reacts to
 * Prism's "complete" hook, i.e. after a pass, so highlighting first would
 * render raw text and nothing would re-run it.
 */
function ensureGrammar(language) {
  if (!window.Prism || PLAIN_LANGUAGES.indexOf(language) !== -1 || window.Prism.languages[language]) {
    return Promise.resolve(true);
  }

  const autoloader = window.Prism.plugins.autoloader;
  if (!autoloader || typeof autoloader.loadLanguages !== 'function') {
    return Promise.resolve(false);
  }

  return new Promise((resolve) => {
    let settled = false;
    const done = () => {
      if (!settled) {
        settled = true;
        resolve(!!window.Prism.languages[language]);
      }
    };
    autoloader.loadLanguages([language], done, done);
  });
}

export default {
  name: 'PhCode',
  props: {
    code: { type: String, required: true },
    language: { type: String, default: 'text' },
    lineNumbers: { type: Boolean, default: false },
    copyable: { type: Boolean, default: true },
    wrap: { type: Boolean, default: false },
    maxHeight: { type: [String, Number], default: '400px' },
    theme: { type: String, default: 'twilight' },
    themeSwitcher: { type: Boolean, default: true },
    themes: { type: Array, default: () => THEMES },
    assetBase: { type: String, default: DEFAULT_ASSET_BASE },
  },
  emits: ['copy', 'theme-change'],
  setup() {
    // Hydration-stable per-instance id, used as the scope the theme is rewritten
    // against. A module counter would drift between the server render and the
    // client, which is fine for correctness but produces a confusing mismatch.
    return { scopeId: 'ph-theme-' + useId() };
  },
  data() {
    return {
      copied: false,
      copying: false,
      highlighted: false,
      // True until the first highlight pass settles, whatever its outcome.
      pending: true,
      // Local copy of `theme`: the picker writes here, the prop stays read-only.
      activeTheme: this.theme,
      // False only when the scoped sheet could not be applied and the component
      // fell back to the page-wide theme.
      themed: true,
      unwatch: [],
    };
  },
  computed: {
    languageLabel() {
      const aliases = {
        html: 'HTML', css: 'CSS', js: 'JavaScript', ts: 'TypeScript', php: 'PHP',
        python: 'Python', bash: 'Bash', sh: 'Shell', json: 'JSON', yaml: 'YAML',
        sql: 'SQL', markdown: 'Markdown', dockerfile: 'Dockerfile', nginx: 'Nginx',
        vue: 'Vue', jsx: 'JSX', tsx: 'TSX', phue: 'phue'
      };
      return aliases[this.language] || String(this.language || 'text').toUpperCase();
    },
    prismLanguage() {
      const aliases = {
        vue: 'markup', html: 'markup', xml: 'markup', svg: 'markup',
        js: 'javascript', mjs: 'javascript', ts: 'typescript',
        sh: 'bash', shell: 'bash', zsh: 'bash', py: 'python', rb: 'ruby',
        cs: 'csharp', 'c#': 'csharp', 'c++': 'cpp', golang: 'go', kt: 'kotlin',
        yml: 'yaml', md: 'markdown', dockerfile: 'docker', txt: 'text', phue: 'markup',
      };
      const normalized = String(this.language || 'text').trim().toLowerCase();
      return aliases[normalized] || normalized;
    },
    codeClasses() {
      return 'language-' + this.prismLanguage.replace(/[^a-z0-9-]/g, '');
    },
    assetRoot() {
      return this.assetBase.replace(/\/+$/, '');
    },
    preStyles() {
      return {
        maxHeight: typeof this.maxHeight === 'number' ? this.maxHeight + 'px' : this.maxHeight,
        whiteSpace: this.wrap ? 'pre-wrap' : 'pre',
        // Prism has to tokenize after 2-3 network round-trips, and the theme
        // background only exists once its stylesheet lands. The block is server
        // rendered and readable, so the honest fix is a soft pending state, not
        // v-cloak (which would hide real content) and not a skeleton (which
        // would replace readable code with a placeholder).
        opacity: this.pending ? 0.55 : 1,
        transition: 'opacity 0.15s ease',
      };
    },
    activeThemeLabel() {
      return THEME_LABELS[this.activeTheme] || this.activeTheme;
    },
    themeItems() {
      return this.themes.map((name) => ({
        value: name,
        label: THEME_LABELS[name] || name,
        icon: name === this.activeTheme ? 'check-lg' : null,
      }));
    },
  },
  methods: {
    selectTheme(item) {
      if (!item || !item.value || item.value === this.activeTheme) {
        return;
      }

      this.activeTheme = item.value;
      this.$emit('theme-change', item.value);
    },
    async loadPrism() {
      const base = this.assetRoot;

      // The theme and Prism core are independent, so they are STARTED together
      // and awaited in sequence. A scoped theme has to be fetched as text before
      // it can be rewritten, which is one round trip the old <link> never paid —
      // awaiting the theme first and *then* starting the scripts would serialise
      // the two and put the white flash straight back. Issuing both before the
      // first await keeps them in flight together.
      const coreTask = withTimeout(ensureCore(base));

      await this.loadTheme();

      if (!(await coreTask)) {
        return false;
      }

      if (this.lineNumbers) {
        await withTimeout(ensureLineNumbers(base));
      }

      return true;
    },
    /**
     * Puts this block's theme in place, scoped to this block.
     *
     * Falls back to a page-wide `<link>` only when the sheet could not be
     * fetched, so a missing/blocked theme degrades to "shared theme" rather
     * than to "unreadable code".
     */
    async loadTheme() {
      try {
        if (await applyScopedTheme(this.assetRoot, this.activeTheme, this.scopeId)) {
          this.themed = true;
          return;
        }
        throw new Error('timed out or returned an unsafe theme name');
      } catch (error) {
        this.themed = false;
        applyGlobalThemeFallback(this.assetRoot, this.activeTheme);
        warnOnce('Could not scope the code theme (' + error.message + ') — falling back to one shared theme for the page.');
      }
    },
    async highlight() {
      const el = this.$refs.codeEl;
      if (!el) {
        return;
      }

      try {
        // Prism rewrote innerHTML on the previous pass: re-seed from the prop so a
        // language switch cannot re-tokenize Prism's own markup, and re-apply the
        // class the plugin stripped from <code> (Vue will not re-patch it).
        el.textContent = this.code;
        el.classList.toggle('line-numbers', this.lineNumbers);

        if (!(await this.loadPrism())) {
          this.highlighted = false;
          return;
        }

        this.highlighted = await withTimeout(ensureGrammar(this.prismLanguage));

        try {
          window.Prism.highlightElement(el, false);
        } catch (e) {
          this.highlighted = false;
          console.warn('[PhCode] Highlight failed:', e);
        }
      } finally {
        // Always, in a finally: `pending` is a "first pass done" flag, not a
        // "highlighted" flag. Clearing it only on success would leave every
        // plain-text block and every missing-vendor block permanently dimmed.
        this.pending = false;
      }
    },
    async copy() {
      this.copying = true;
      try {
        const text = this.code;
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.style.cssText = 'position:fixed;left:-9999px;top:-9999px;opacity:1';
          document.body.appendChild(textarea);
          textarea.select();
          const copied = document.execCommand('copy');
          document.body.removeChild(textarea);
          if (!copied) {
            throw new Error('execCommand copy returned false');
          }
        }
        this.copied = true;
        this.$emit('copy', text);
        setTimeout(() => { this.copied = false; }, 2000);
      } catch (e) {
        console.warn('[PhCode] Copy failed:', e);
        this.copied = false;
      } finally {
        this.copying = false;
      }
    },
  },
  async mounted() {
    await this.highlight();

    this.unwatch = [
      this.$watch(
        () => [this.code, this.language, this.lineNumbers, this.theme, this.assetBase, this.activeTheme],
        () => { this.$nextTick(() => this.highlight()); },
      ),
      // The page owns the `theme` prop: an external change outranks the local
      // pick. Watched separately so a picker click is not bounced straight back
      // by the very prop it is overriding.
      this.$watch(() => this.theme, (value) => { this.activeTheme = value; }),
    ];
  },
  beforeUnmount() {
    for (const stop of this.unwatch) {
      stop();
    }

    // Drop this instance's sheet. The raw theme text stays in the module cache,
    // so a remount re-injects it without another request.
    if (typeof document === 'undefined' || !this.themed) {
      return;
    }
    document
      .querySelectorAll('style[data-ph-theme-scope="' + this.scopeId + '"]')
      .forEach((node) => node.remove());
  },
};
</script>
<php>
/**
 * PhCode - Syntax highlighted code block with copy button and line numbers.
 * Loads Prism.js core + autoloader + theme on demand from the framework's own
 * npm vendor pipeline (same origin, `bin/phue npm:install prismjs`); the
 * autoloader then fetches the grammar per language, cached per page.
 */
return [
    'title' => 'Code Block',
    'state' => [],
];
</php>
