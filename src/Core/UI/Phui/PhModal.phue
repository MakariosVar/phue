<template>
  <teleport to="body">
    <div v-if="modelValue" class="ph-modal-backdrop" @click="handleBackdropClick">
      <div
        :class="['ph-modal', `ph-modal--${size}`]"
        role="dialog"
        aria-modal="true"
        @click.stop
      >
        <div class="ph-modal__header">
          <slot name="header">
            <h3 class="ph-modal__title">{{ title }}</h3>
          </slot>
          <button
            v-if="closable"
            type="button"
            class="ph-modal__close"
            aria-label="Close"
            @click="close"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" class="ph-modal__close-icon">
              <path d="M4.646 4.646a.5.5 0 01.708 0L8 7.293l2.646-2.647a.5.5 0 01.708.708L8.707 8l2.647 2.646a.5.5 0 01-.708.708L8 8.707l-2.646 2.647a.5.5 0 01-.708-.708L7.293 8 4.646 5.354a.5.5 0 010-.708z"/>
            </svg>
          </button>
        </div>

        <div class="ph-modal__body">
          <slot />
        </div>

        <div v-if="$slots.footer" class="ph-modal__footer">
          <slot name="footer" />
        </div>
      </div>
    </div>
  </teleport>
</template>

<script>
export default {
  name: 'PhModal',
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    title: {
      type: String,
      default: ''
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg', 'xl', 'full'].includes(val)
    },
    closable: {
      type: Boolean,
      default: true
    },
    closeOnBackdrop: {
      type: Boolean,
      default: true
    }
  },
  emits: ['update:modelValue', 'close'],
  methods: {
    close() {
      this.$emit('update:modelValue', false);
      this.$emit('close');
    },
    handleBackdropClick() {
      if (this.closeOnBackdrop && this.closable) {
        this.close();
      }
    }
  }
};
</script>