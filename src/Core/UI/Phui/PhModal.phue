<template>
  <teleport to="body">
    <div
      v-if="modelValue"
      class="modal fade show d-block"
      tabindex="-1"
      role="dialog"
      aria-modal="true"
      @click="handleBackdropClick"
    >
      <div :class="['modal-dialog', sizeClass]">
        <div class="modal-content" @click.stop>
          <div class="modal-header">
            <slot name="header">
              <h3 class="modal-title">{{ title }}</h3>
            </slot>
            <button
              v-if="closable"
              type="button"
              class="btn-close"
              aria-label="Close"
              @click="close"
            ></button>
          </div>

          <div class="modal-body">
            <slot />
          </div>

          <div v-if="$slots.footer" class="modal-footer">
            <slot name="footer" />
          </div>
        </div>
      </div>
    </div>
    <div v-if="modelValue" class="modal-backdrop fade show"></div>
  </teleport>
</template>

<script>
export default {
  name: 'PhModal',
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    title: {
      type: String,
      default: ''
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg', 'xl', 'full'].includes(val)
    },
    closable: {
      type: Boolean,
      default: true
    },
    closeOnBackdrop: {
      type: Boolean,
      default: true
    }
  },
  emits: ['update:modelValue', 'close'],
  computed: {
    sizeClass() {
      const map = {
        sm: 'modal-sm',
        md: '',
        lg: 'modal-lg',
        xl: 'modal-xl',
        full: 'modal-fullscreen'
      };
      return map[this.size] || '';
    }
  },
  methods: {
    close() {
      this.$emit('update:modelValue', false);
      this.$emit('close');
    },
    handleBackdropClick() {
      if (this.closeOnBackdrop && this.closable) {
        this.close();
      }
    }
  }
};
</script>