<template>
  <div
    data-phui="switch"
    class="form-check form-switch"
    :class="wrapperClasses"
    :style="wrapperStyle"
  >
    <input
      :id="switchId"
      ref="inputEl"
      class="form-check-input"
      type="checkbox"
      role="switch"
      :name="name || null"
      :style="inputStyle"
      :checked="modelValue"
      :disabled="disabled"
      :required="required"
      :aria-checked="modelValue ? 'true' : 'false'"
      @change="$emit('update:modelValue', $event.target.checked)"
      @blur="$emit('blur', $event)"
      @focus="$emit('focus', $event)"
    />
    <label
      v-if="label || $slots.default"
      class="form-check-label"
      :for="switchId"
    >
      <slot>{{ label }}</slot>
    </label>
  </div>
</template>

<script>
import { useId } from "vue";

const SIZE_TOKENS = {
  sm: { fontSize: '.875rem', offset: '2.1875rem' },
  md: { fontSize: '1rem', offset: '2.5rem' },
  lg: { fontSize: '1.25rem', offset: '3.125rem' }
};

export default {
  name: 'PhSwitch',
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    id: {
      type: String,
      default: null
    },
    name: {
      type: String,
      default: ''
    },
    label: {
      type: String,
      default: ''
    },
    disabled: {
      type: Boolean,
      default: false
    },
    required: {
      type: Boolean,
      default: false
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => Object.prototype.hasOwnProperty.call(SIZE_TOKENS, val)
    }
  },
  emits: ['update:modelValue', 'blur', 'focus'],
  setup() {
    const HashID = useId();
    return { HashID };
  },
  computed: {
    switchId() {
      return this.id || `ph-switch-${this.HashID}`;
    },
    wrapperClasses() {
      return [`ph-switch--${this.size}`];
    },
    wrapperStyle() {
      if (this.size === 'md') {
        return null;
      }

      return { paddingLeft: SIZE_TOKENS[this.size].offset };
    },
    inputStyle() {
      if (this.size === 'md') {
        return null;
      }

      return { fontSize: SIZE_TOKENS[this.size].fontSize };
    }
  }
};
</script>
