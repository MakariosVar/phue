<template>
  <div
    data-phui="switch"
    class="form-check form-switch"
    :class="wrapperClasses"
  >
    <input
      :id="switchId"
      ref="inputEl"
      class="form-check-input"
      type="checkbox"
      role="switch"
      :checked="modelValue"
      :disabled="disabled"
      :required="required"
      :aria-checked="modelValue ? 'true' : 'false'"
      @change="$emit('update:modelValue', $event.target.checked)"
      @blur="$emit('blur', $event)"
      @focus="$emit('focus', $event)"
    />
    <label
      v-if="label || $slots.default"
      class="form-check-label"
      :for="switchId"
    >
      <slot>{{ label }}</slot>
    </label>
  </div>
</template>

<script>
import { useId } from "vue";

export default {
  name: 'PhSwitch',
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    id: {
      type: String,
      default: null
    },
    label: {
      type: String,
      default: ''
    },
    disabled: {
      type: Boolean,
      default: false
    },
    required: {
      type: Boolean,
      default: false
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    }
  },
  emits: ['update:modelValue', 'blur', 'focus'],
  setup() {
    const HashID = useId();
    return { HashID };
  },
  computed: {
    switchId() {
      return this.id || `ph-switch-${this.HashID}`;
    },
    wrapperClasses() {
      const classes = [];
      if (this.size === 'lg') {
        classes.push('form-switch-lg');
      }
      if (this.size === 'sm') {
        classes.push('form-switch-sm');
      }
      return classes;
    }
  }
};
</script>
