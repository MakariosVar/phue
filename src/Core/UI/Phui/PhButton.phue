<template>
  <button
    :type="type"
    :class="[
      'btn',
      variantClass,
      size === 'sm' ? 'btn-sm' : size === 'lg' ? 'btn-lg' : '',
      { 'w-100': block, 'disabled': loading }
    ]"
    :disabled="disabled || loading"
    @click="$emit('click', $event)"
  >
    <span v-if="loading" class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
    <span class="btn__content">
      <slot />
    </span>
  </button>
</template>

<script>
export default {
  name: 'PhButton',
  props: {
    type: {
      type: String,
      default: 'button'
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (val) => ['primary', 'secondary', 'outline', 'ghost', 'danger'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    block: {
      type: Boolean,
      default: false
    },
    disabled: {
      type: Boolean,
      default: false
    },
    loading: {
      type: Boolean,
      default: false
    }
  },
  emits: ['click'],
  computed: {
    variantClass() {
      const map = {
        primary: 'btn-primary',
        secondary: 'btn-secondary',
        outline: 'btn-outline-primary',
        ghost: 'btn-link',
        danger: 'btn-danger'
      };
      return map[this.variant] || 'btn-primary';
    }
  }
};
</script>