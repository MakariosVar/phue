<template>
  <div class="form-check">
    <input
      ref="inputEl"
      type="checkbox"
      :name="name || null"
      :checked="modelValue"
      :disabled="disabled"
      class="form-check-input"
      @change="$emit('update:modelValue', $event.target.checked)"
    />
    <label v-if="label || $slots.default" class="form-check-label">
      <slot>{{ label }}</slot>
    </label>
  </div>
</template>

<script>
export default {
  name: 'PhCheckbox',
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    label: {
      type: String,
      default: ''
    },
    name: {
      type: String,
      default: ''
    },
    indeterminate: {
      type: Boolean,
      default: false
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['update:modelValue'],
  mounted() {
    this.syncIndeterminate();
  },
  watch: {
    indeterminate: 'syncIndeterminate'
  },
  methods: {
    syncIndeterminate() {
      if (this.$refs.inputEl) {
        this.$refs.inputEl.indeterminate = this.indeterminate;
      }
    }
  }
};
</script>