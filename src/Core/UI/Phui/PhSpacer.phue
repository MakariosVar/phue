<template>
  <div class="flex-shrink-0" :style="spacerStyles" aria-hidden="true"></div>
</template>

<script>
export default {
  name: 'PhSpacer',
  props: {
    size: {
      type: [String, Number],
      default: 'md'
    },
    horizontal: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    spacerStyles() {
      const sizeMap = { none: '0', xs: '0.25rem', sm: '0.5rem', md: '0.75rem', lg: '1rem', xl: '1.5rem', '2xl': '2rem' };
      const val = typeof this.size === 'number' ? `${this.size}px` : (sizeMap[this.size] || this.size);
      return this.horizontal
        ? { width: val, height: '100%' }
        : { height: val, width: '100%' };
    }
  }
};
</script>
