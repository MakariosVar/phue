<template>
  <div
    data-phui="popover"
    class="position-relative d-inline-block"
  >
    <!--
      `data-phui` here is load-bearing, not decoration: measureAnchor() measures
      this element by it. The attribute was missing entirely, so the rect was always
      null, popoverStyle returned {}, and the panel fell back to its static position
      — which read as "positioned fine" while the panel was viewport-fixed, and
      became "invisible" the moment it moved to document space.

      It is `data-phui` and not a `class`: the kit ships no stylesheet, so a
      `ph-*` class would be styling with nowhere to live.
    -->
    <div
      data-phui="popover-trigger"
      @click="toggle"
      @keydown.space.prevent="toggle"
      @keydown.enter.prevent="toggle"
      tabindex="0"
      :aria-expanded="open"
    >
      <slot name="trigger">
        <ph-button variant="outline-secondary" size="sm">{{ triggerLabel }}</ph-button>
      </slot>
    </div>
    <teleport to="body" v-if="open">
      <div
        ref="panel"
        class="popover"
        :class="[
          'show',
          placementClass,
          variant ? `border-${variant}` : ''
        ]"
        :style="popoverStyle"
        role="dialog"
        :aria-describedby="contentId"
      >
        <!-- No popover-arrow: Bootstrap only *positions* it, it never sets
             position itself — Popper writes `position: absolute` + transform
             inline. Without Popper the arrow stays a display:block box in normal
             flow at the top of the box, pushing the header down. -->
        <h3 v-if="title" class="popover-header" :id="titleId">{{ title }}</h3>
        <div class="popover-body" :id="contentId">
          <slot name="content">{{ content }}</slot>
        </div>
      </div>
      <!--
        A real backdrop. It was an empty div with no styles, so it had no height
        and covered nothing: the documented "a click on the backdrop closes it"
        had never worked. `position: fixed` + inset is what makes it a surface.

        Click triggers only. A backdrop this size covers the trigger that is still
        under the pointer, so the browser retargets to it and fires `mouseleave`
        — the popover closed the instant it opened and re-opened on the next
        hover, forever. A `hover`/`focus` popover closes by leaving the trigger,
        which is the whole point of not putting a pointer-eater over it.
      -->
      <div
        v-if="trigger === 'click'"
        data-phui="popover-backdrop"
        style="position: fixed; inset: 0; z-index: 1069;"
        @click="close"
      ></div>
    </teleport>
  </div>
</template>

<script>
import { useId } from "vue";

// Breathing room between the panel and the trigger, and between a clamped panel
// and the viewport edge.
const PANEL_GAP = 8;
const VIEWPORT_MARGIN = 8;

// Bootstrap's compound placement (`top-start`) is one string; the composable
// takes the two axes separately. The cross-axis token names the side the panel
// hugs on that axis, so `top` and `start` both mean 'start' and `bottom` and
// `end` both mean 'end'. An absent token means centred.
const ALIGN_TOKENS = { top: 'start', bottom: 'end', start: 'start', end: 'end' };

const OPPOSITE = { top: 'bottom', bottom: 'top', start: 'end', end: 'start' };

function splitPlacement(placement) {
  const parts = String(placement).split('-');
  return {
    placement: parts[0],
    align: parts.length > 1 ? ALIGN_TOKENS[parts[1]] : 'center'
  };
}

export default {
  name: 'PhPopover',
  composables: ['position', 'overlay'],
  setup() {
    // `this._uid` is Vue 2 only — in Vue 3 it is undefined, so every popover on
    // the page rendered id="ph-popover-content-undefined" and aria-describedby
    // pointed at a duplicate.
    return { HashID: useId() };
  },
  props: {
    /**
     * Optional open state. Left as null the popover is uncontrolled; bind it (or
     * use v-model) to own the open flag, which is how a parent keeps several
     * popovers mutually exclusive — one open, the rest closed.
     */
    modelValue: {
      type: Boolean,
      default: null
    },
    title: {
      type: String,
      default: ''
    },
    content: {
      type: String,
      default: ''
    },
    triggerLabel: {
      type: String,
      default: 'Popover'
    },
    placement: {
      type: String,
      default: 'top',
      validator: (v) => ['top', 'bottom', 'start', 'end', 'top-start', 'top-end', 'bottom-start', 'bottom-end', 'start-top', 'start-bottom', 'end-top', 'end-bottom'].includes(v)
    },
    trigger: {
      type: String,
      default: 'click',
      validator: (v) => ['click', 'hover', 'focus'].includes(v)
    },
    disabled: {
      type: Boolean,
      default: false
    },
    variant: {
      type: String,
      default: '',
      validator: (v) => ['', 'primary', 'secondary', 'success', 'danger', 'warning', 'info'].includes(v)
    }
  },
  emits: ['show', 'hide', 'update:modelValue'],
  data() {
    return {
      internalOpen: false,
      anchorRect: null,
      panelSize: { width: 0, height: 0 },
      // { left, top, flipped }, written by reposition(). Keeping the resolved
      // numbers in data rather than deriving them inside a computed is what lets
      // placementClass follow the flip without the two computed properties
      // invalidating each other.
      panelPos: null,
      positioned: false,
      viewportHandle: null,
      /** Slot in the shared Escape stack, held only while the panel is open. */
      escapeHandle: null
    };
  },
  computed: {
    /** The prop when bound, the internal flag otherwise. The setter keeps every
     *  `this.open = ...` call site working while announcing the change. */
    open: {
      get() {
        return this.modelValue === null ? this.internalOpen : this.modelValue;
      },
      set(value) {
        // Deliberately nothing but the flag and the emit. Positioning cannot live
        // here: `open` reads the prop whenever `model-value` is bound, so it only
        // becomes true once the parent echoes the value back. Anything measured
        // at this point would guard against an `open` that is still false, and a
        // controlled popover would then never place its panel at all.
        this.internalOpen = value;
        this.$emit('update:modelValue', value);
      }
    },
    placementClass() {
      // Follows the flip, not the prop. The class drives the arrow, so a panel
      // that flipped below its trigger while still claiming `bs-popover-top`
      // points its arrow up at empty space.
      const base = splitPlacement(this.placement).placement;
      const flipped = this.panelPos !== null && this.panelPos.flipped;
      return `bs-popover-${flipped ? OPPOSITE[base] : base}`;
    },
    popoverStyle() {
      const styles = {
        position: 'absolute',
        zIndex: 1070,
        top: '0px',
        left: '0px',
        // Bootstrap's placement classes set bottom/right; an explicit top/left
        // has to clear them or the two fight over the same box.
        bottom: 'auto',
        right: 'auto'
      };

      if (!this.positioned || !this.panelPos || typeof document === 'undefined') {
        styles.visibility = 'hidden';
        return styles;
      }

      styles.left = `${this.panelPos.left}px`;
      styles.top = `${this.panelPos.top}px`;

      return styles;
    },
    contentId() {
      return `ph-popover-content-${this.HashID}`;
    },
    titleId() {
      return `ph-popover-title-${this.HashID}`;
    }
  },
  watch: {
    open(val) {
      this.$emit(val ? 'show' : 'hide');

      // The viewport listeners live exactly as long as the panel is open: attached
      // for the whole lifetime of the component they would re-measure a closed
      // popover on every scroll event for nothing.
      if (val) {
        // Measured before the render, so the first paint already has a rect; the
        // panel's own size is not knowable until it exists, hence the tick.
        this.measureAnchor();
        this.$nextTick(() => this.reposition());
        this.trackViewport();
      } else {
        this.releaseEscape();
        this.releaseViewport();
        this.positioned = false;
        this.anchorRect = null;
        this.panelPos = null;
      }
    }
  },
  mounted() {
    // Bound: addEventListener would call these with `this` = the DOM element,
    // so `this.open = true` wrote to the element and the popover never opened.
    // The same references are handed back to removeEventListener below.
    this.onEnter = () => this.openPopover();
    this.onLeave = () => this.close();

    if (this.trigger === 'hover') {
      this.$el.addEventListener('mouseenter', this.onEnter);
      this.$el.addEventListener('mouseleave', this.onLeave);
    } else if (this.trigger === 'focus') {
      this.$el.addEventListener('focusin', this.onEnter);
      this.$el.addEventListener('focusout', this.onLeave);
    }
  },
  beforeUnmount() {
    this.releaseViewport();
    if (this.onEnter) this.$el.removeEventListener('mouseenter', this.onEnter);
    if (this.onEnter) this.$el.removeEventListener('focusin', this.onEnter);
    if (this.onLeave) this.$el.removeEventListener('mouseleave', this.onLeave);
    if (this.onLeave) this.$el.removeEventListener('focusout', this.onLeave);
  },
  methods: {
    openPopover() {
      if (this.disabled || this.open) return;
      this.open = true;
    },
    close() {
      this.open = false;
    },
    toggle() {
      if (this.disabled) return;
      this.open = this.open ? false : true;
    },
    /**
     * Claims the shared Escape slot for as long as this surface is open.
     *
     * Registering is what makes Escape reach this surface instead of whatever it is
     * nested in: the stack is ordered, so the topmost surface wins and the one below
     * it waits its turn. Without the stack the surface below fired first and this one
     * was left open on the floor.
     */
    claimEscape() {
      this.releaseEscape();
      this.escapeHandle = registerEscapeHandler((event) => {
        event.stopPropagation();
        this.close();
      }, this.$refs.root);
    },
    releaseEscape() {
      if (this.escapeHandle && typeof this.escapeHandle.release === 'function') {
        this.escapeHandle.release();
      }
      this.escapeHandle = null;
    },
    measureAnchor() {
      const trigger = this.$el.querySelector('[data-phui="popover-trigger"]');
      this.anchorRect = trigger ? measureAnchor(trigger) : null;
    },
    measurePanel() {
      const panel = this.$refs.panel;
      if (panel) {
        const rect = panel.getBoundingClientRect();
        this.panelSize = { width: rect.width, height: rect.height };
      }
    },
    reposition() {
      // No `open` guard on purpose: this runs from the viewport handle and from a
      // post-render tick, and a `model-value` bound popover can be mid-round-trip
      // in either. The panel ref is the honest signal — without it there is
      // nothing to place.
      if (!this.$refs.panel || !this.anchorRect || typeof document === 'undefined') {
        return;
      }

      this.measurePanel();

      const { placement, align } = splitPlacement(this.placement);
      const pos = positionFor(this.anchorRect, {
        size: this.panelSize,
        placement,
        align,
        offset: PANEL_GAP,
        gap: PANEL_GAP,
        allowFlip: true,
        clamp: true,
        // clientWidth/clientHeight, not 100vw/100vh or innerWidth: those include
        // the scrollbar, which pushed every `start`/`top` popover further off
        // than it should be.
        viewport: {
          width: document.documentElement.clientWidth,
          height: document.documentElement.clientHeight
        },
        scroll: {
          x: window.scrollX || window.pageXOffset || 0,
          y: window.scrollY || window.pageYOffset || 0
        }
      });

      // Last: `positioned` is what un-hides the panel, and both edges have to be
      // known before that. The composable reports `measured: false` when it had
      // nothing to measure against; believing it anyway placed the panel as if
      // it had no size, which is worse than not placing it at all.
      this.panelPos = pos;
      // `offscreen` joins the guard for the same reason the other floats carry it:
      // a clamped panel whose trigger has scrolled away would otherwise stay pinned
      // to the viewport edge, following nothing.
      this.positioned = pos.measured !== false
        && pos.offscreen !== true
        && (this.panelSize.width > 0 || this.panelSize.height > 0);
    },
    trackViewport() {
      this.releaseViewport();
      this.viewportHandle = trackViewport(this.reposition);
    },
    releaseViewport() {
      if (this.viewportHandle) {
        releaseViewport(this.viewportHandle);
        this.viewportHandle = null;
      }
    },
  }
};
</script>