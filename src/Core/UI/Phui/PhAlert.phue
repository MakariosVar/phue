<template>
  <div v-if="visible" :class="['ph-alert', `ph-alert--${variant}`]" role="alert">
    <div class="ph-alert__content">
      <h4 v-if="title" class="ph-alert__title">{{ title }}</h4>
      <div class="ph-alert__body">
        <slot>{{ message }}</slot>
      </div>
    </div>
    <button
      v-if="dismissible"
      type="button"
      class="ph-alert__close"
      aria-label="Close"
      @click="dismiss"
    >
      <svg viewBox="0 0 16 16" fill="currentColor" class="ph-alert__close-icon">
        <path d="M4.646 4.646a.5.5 0 01.708 0L8 7.293l2.646-2.647a.5.5 0 01.708.708L8.707 8l2.647 2.646a.5.5 0 01-.708.708L8 8.707l-2.646 2.647a.5.5 0 01-.708-.708L7.293 8 4.646 5.354a.5.5 0 010-.708z"/>
      </svg>
    </button>
  </div>
</template>

<script>
export default {
  name: 'PhAlert',
  props: {
    title: {
      type: String,
      default: ''
    },
    message: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'info',
      validator: (val) => ['info', 'success', 'warning', 'error'].includes(val)
    },
    dismissible: {
      type: Boolean,
      default: false
    }
  },
  emits: ['dismiss'],
  data() {
    return {
      visible: true
    };
  },
  methods: {
    dismiss() {
      this.visible = false;
      this.$emit('dismiss');
    }
  }
};
</script>