<template>
  <span :class="['ph-chip', `ph-chip--${variant}`, { 'ph-chip--disabled': disabled }]">
    <span class="ph-chip__content">
      <slot>{{ label }}</slot>
    </span>
    <button
      v-if="removable && !disabled"
      type="button"
      class="ph-chip__remove"
      aria-label="Remove"
      @click.stop="$emit('remove')"
    >
      <svg viewBox="0 0 16 16" fill="currentColor" class="ph-chip__icon">
        <path d="M4.646 4.646a.5.5 0 01.708 0L8 7.293l2.646-2.647a.5.5 0 01.708.708L8.707 8l2.647 2.646a.5.5 0 01-.708.708L8 8.707l-2.646 2.647a.5.5 0 01-.708-.708L7.293 8 4.646 5.354a.5.5 0 010-.708z"/>
      </svg>
    </button>
  </span>
</template>

<script>
export default {
  name: 'PhChip',
  props: {
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'neutral',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error', 'info', 'neutral'].includes(val)
    },
    removable: {
      type: Boolean,
      default: false
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['remove']
};
</script>