<template>
  <span :class="['badge rounded-pill d-flex align-items-center', variantClass, { 'opacity-50 pe-none': disabled }]">
    <span >
      <slot>{{ label }}</slot>
    </span>
    <button
      v-if="removable && !disabled"
      type="button"
      class="btn-close ms-1"
      aria-label="Remove"
      @click.stop="$emit('remove')"
    ></button>
  </span>
</template>

<script>
export default {
  name: 'PhChip',
  props: {
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'neutral',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error', 'info', 'neutral'].includes(val)
    },
    removable: {
      type: Boolean,
      default: false
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['remove'],
  computed: {
    variantClass() {
      const map = {
        primary: 'text-bg-primary',
        secondary: 'text-bg-secondary',
        success: 'text-bg-success',
        warning: 'text-bg-warning',
        error: 'text-bg-danger',
        info: 'text-bg-info',
        neutral: 'text-bg-secondary'
      };
      return map[this.variant] || 'text-bg-secondary';
    }
  }
};
</script>