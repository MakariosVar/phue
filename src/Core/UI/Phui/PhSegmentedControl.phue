<template>
  <div
    data-phui="segmented-control"
    class="d-flex align-items-center gap-1"
    :class="{'flex-column': block}"
    role="radiogroup"
    :aria-label="ariaLabel"
  >
    <template v-for="(option, index) in options":key="option.key || option.value || index">
      <input
        type="radio"
        class="btn-check"
        :id="`${inputId}-${index}`"
        :name="groupName"
        :value="option.value"
        :checked="modelValue == option.value"
        :disabled="option.disabled || disabled"
        @change="$emit('update:modelValue', option.value); $emit('change', option.value)"
      />
      <label
        :for="`${inputId}-${index}`"
        class="btn"
        :class="[
          modelValue == option.value ? 'active' : '',
          `btn-outline-${variant}`,
          size === 'sm' ? 'btn-sm' : size === 'lg' ? 'btn-lg' : '',
          block ? 'w-100' : ''
        ]"
        :aria-pressed="modelValue == option.value"
      >
        <ph-icon v-if="option.icon" :name="option.icon" size="sm" class="me-1" />
        {{ option.label }}
      </label>
    </template>
  </div>
</template>

<script>
import { useId } from "vue";

export default {
  name: 'PhSegmentedControl',
  props: {
    modelValue: {
      type: [String, Number, Boolean],
      default: null
    },
    options: {
      type: Array,
      required: true
    },
    size: {
      type: String,
      default: 'md',
      validator: (v) => ['sm', 'md', 'lg'].includes(v)
    },
    block: {
      type: Boolean,
      default: false
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (v) => ['primary', 'secondary', 'success', 'danger', 'warning', 'info'].includes(v)
    },
    disabled: {
      type: Boolean,
      default: false
    },
    name: {
      type: String,
      default: null
    },
    ariaLabel: {
      type: String,
      default: 'Segmented control'
    }
  },
  emits: ['update:modelValue', 'change'],
  setup() {
    const HashID = useId();
    return { HashID };
  },
  computed: {
    inputId() {
      return `ph-segmented-${this.HashID}`;
    },
    /**
     * Radios are grouped by `name`, so two controls that shared a name would
     * silently uncheck each other. Scope the fallback name per instance.
     */
    groupName() {
      return this.name || this.inputId;
    }
  }
};
</script>