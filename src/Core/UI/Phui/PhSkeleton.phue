<template>
  <span
    :class="['d-inline-block', { 'placeholder-glow': animated }]"
    :style="skeletonStyles"
  >
    <span
      :class="['placeholder', 'w-100', 'h-100', variantClass, { 'placeholder-wave': animated }]"
    ></span>
  </span>
</template>

<script>
export default {
  name: 'PhSkeleton',
  props: {
    variant: {
      type: String,
      default: 'text',
      validator: (val) => ['text', 'circular', 'rectangular'].includes(val)
    },
    width: {
      type: [String, Number],
      default: '100%'
    },
    height: {
      type: [String, Number],
      default: null
    },
    animated: {
      type: Boolean,
      default: true
    }
  },
  computed: {
    variantClass() {
      const map = {
        text: 'rounded',
        circular: 'rounded-circle',
        rectangular: 'rounded-0'
      };
      return map[this.variant] || 'rounded';
    },
    skeletonStyles() {
      const w = typeof this.width === 'number' ? `${this.width}px` : this.width;
      let h = this.height;
      if (h !== null && typeof h === 'number') {
        h = `${h}px`;
      }
      if (!h) {
        h = this.variant === 'text' ? '1em' : this.variant === 'circular' ? w : '100%';
      }

      return {
        width: w,
        height: h
      };
    }
  }
};
</script>