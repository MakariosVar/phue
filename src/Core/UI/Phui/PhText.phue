<template>
  <component
    :is="as"
    :class="[
      sizeClass,
      weightClass,
      colorClass,
      alignClass,
      { 'text-truncate': truncate }
    ]"
  >
    <slot />
  </component>
</template>

<script>
export default {
  name: 'PhText',
  props: {
    as: {
      type: String,
      default: 'p'
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['xs', 'sm', 'md', 'lg', 'xl'].includes(val)
    },
    weight: {
      type: String,
      default: 'normal',
      validator: (val) => ['light', 'normal', 'medium', 'semibold', 'bold'].includes(val)
    },
    color: {
      type: String,
      default: 'default'
    },
    align: {
      type: String,
      default: 'left',
      validator: (val) => ['left', 'center', 'right', 'justify'].includes(val)
    },
    truncate: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    sizeClass() {
      const map = {
        xs: 'small',
        sm: 'small',
        md: '',
        lg: 'fs-5',
        xl: 'fs-3'
      };
      return map[this.size] || '';
    },
    weightClass() {
      const map = {
        light: 'fw-light',
        normal: 'fw-normal',
        medium: 'fw-medium',
        semibold: 'fw-semibold',
        bold: 'fw-bold'
      };
      return map[this.weight] || 'fw-normal';
    },
    colorClass() {
      const map = {
        default: '',
        muted: 'text-body-secondary',
        main: 'text-body-emphasis',
        primary: 'text-primary',
        secondary: 'text-secondary',
        danger: 'text-danger',
        inverse: 'text-white'
      };
      return map[this.color] || '';
    },
    alignClass() {
      const map = {
        left: 'text-start',
        center: 'text-center',
        right: 'text-end',
        justify: 'text-justify'
      };
      return map[this.align] || 'text-start';
    }
  }
};
</script>
