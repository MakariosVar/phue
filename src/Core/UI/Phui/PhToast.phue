<template>
  <teleport v-if="mounted" to="body">
    <div
      v-if="toasts.length"
      
      style="position: fixed; z-index: 1090; display: flex; flex-direction: column; gap: 0.5rem; pointer-events: none; max-width: min(380px, calc(100vw - 2rem));"
      :style="regionStyle"
      aria-live="polite"
      aria-atomic="false"
    >
      <div
        v-for="t in toasts"
        :key="t.id"
        role="status"
        :class="['toast', t.leaving ? '' : 'show']"
        :style="toastStyle(t)"
        @pointerenter="pause(t.id)"
        @pointerleave="resume(t.id)"
      >
        <div class="toast-header">
          <strong class="me-auto">{{ t.title || defaultTitle(t.variant) }}</strong>
          <button
            v-if="dismissible"
            type="button"
            class="btn-close ms-2 mb-1"
            aria-label="Dismiss"
            @click="remove(t.id)"
          ></button>
        </div>
        <div v-if="t.message" class="toast-body">{{ t.message }}</div>
      </div>
    </div>
  </teleport>
</template>

<script>
let toastSeq = 0;

export default {
    name: 'PhToast',
    ssr: false,
    props: {
        position: {
            type: String,
            default: 'top-right',
            validator: (val) => ['top-right', 'top-left', 'bottom-right', 'bottom-left', 'top-center', 'bottom-center'].includes(val)
        },
        duration: {
            type: Number,
            default: 5000
        },
        max: {
            type: Number,
            default: 5
        },
        dismissible: {
            type: Boolean,
            default: true
        }
    },
    emits: ['dismiss'],
    data() {
        return {
            mounted: false,
            toasts: []
        };
    },
  mounted() {
    this.mounted = true;
    if (typeof window !== 'undefined') {
      // Bound, not the raw instance: `window.toast.push(...)` is a method call
      // ON window, so an unbound `this` would be `window` and every
      // `this.duration` / `this.toasts` / `this.startTimer` would be undefined.
      window.toast = {
        push: this.push.bind(this),
        remove: this.remove.bind(this),
        clear: this.clear.bind(this),
        __owner: this
      };
    }
  },
  beforeUnmount() {
    if (typeof window !== 'undefined' && window.toast?.__owner === this) {
      window.toast = null;
    }
  },
  computed: {
    regionStyle() {
      const base = {
        alignItems: 'flex-end'
      };
      const p = this.position;
      if (p === 'top-left' || p === 'bottom-left') base.alignItems = 'flex-start';
      if (p === 'top-center' || p === 'bottom-center') base.alignItems = 'center';
      if (p.startsWith('top')) {
        base.top = '1rem';
      } else {
        base.bottom = '1rem';
      }
      if (p.endsWith('right')) {
        base.right = '1rem';
      } else if (p.endsWith('left')) {
        base.left = '1rem';
      } else {
        base.left = '50%';
        base.transform = 'translateX(-50%)';
      }
      return base;
    }
  },
  methods: {
    push(source) {
      const item = typeof source === 'string' ? { message: source } : (source || {});
      const duration = typeof item.duration === 'number' && item.duration > 0 ? item.duration : this.duration;
      const toast = {
        id: ++toastSeq,
        variant: item.variant || 'info',
        title: item.title || '',
        message: item.message || '',
        duration,
        remaining: duration,
        startedAt: Date.now(),
        timer: null,
        leaving: false
      };
      this.toasts.push(toast);
      if (this.toasts.length > this.max) {
        const overflow = this.toasts.length - this.max;
        this.toasts.splice(0, overflow);
      }
      this.startTimer(toast.id);
      return toast.id;
    },
    remove(id) {
      const t = this.toasts.find(x => x.id === id);
      if (!t || t.removing) return;
      t.removing = true;
      clearTimeout(t.timer);
      t.leaving = true;
      setTimeout(() => {
        this.toasts = this.toasts.filter(x => x.id !== id);
        this.$emit('dismiss', id);
      }, 200);
    },
    clear() {
      this.toasts.forEach(t => clearTimeout(t.timer));
      this.toasts = [];
    },
    pause(id) {
      const t = this.toasts.find(x => x.id === id);
      if (!t) return;
      clearTimeout(t.timer);
      t.remaining -= Date.now() - t.startedAt;
    },
    resume(id) {
      const t = this.toasts.find(x => x.id === id);
      if (!t || t.leaving) return;
      t.startedAt = Date.now();
      t.timer = setTimeout(() => this.remove(id), Math.max(0, t.remaining));
    },
    startTimer(id) {
      const t = this.toasts.find(x => x.id === id);
      if (!t) return;
      t.startedAt = Date.now();
      t.timer = setTimeout(() => this.remove(id), t.remaining);
    },
    defaultTitle(variant) {
      const map = {
        info: 'Info',
        success: 'Success',
        warning: 'Warning',
        error: 'Error'
      };
      return map[variant] || 'Notice';
    },
    toastStyle(t) {
      const map = {
        info: 'var(--bs-info)',
        success: 'var(--bs-success)',
        warning: 'var(--bs-warning)',
        error: 'var(--bs-danger)'
      };
      return {
        maxWidth: '100%',
        pointerEvents: 'auto',
        borderLeft: `0.25rem solid ${map[t.variant] || map.info}`,
        marginBottom: 0,
        transition: 'opacity 0.15s linear'
      };
    }
  }
};
</script>