<template>
  <teleport v-if="mounted" to="body">
    <div
      v-if="toasts.length"

      style="position: fixed; z-index: 1090; display: flex; flex-direction: column; gap: 0.5rem; pointer-events: none; max-width: min(380px, calc(100vw - 2rem));"
      :style="regionStyle"
      aria-live="polite"
      aria-atomic="false"
    >
      <div
        v-for="t in toasts"
        :key="t.id"
        role="status"
        :class="['toast', t.leaving ? '' : 'show']"
        :style="toastStyle(t)"
        @pointerenter="pause(t.id)"
        @pointerleave="resume(t.id)"
      >
        <div class="toast-header">
          <strong class="me-auto">{{ t.title }}</strong>
          <button
            v-if="dismissible"
            type="button"
            class="btn-close ms-2 mb-1"
            aria-label="Dismiss"
            @click="dismiss(t.id)"
          ></button>
        </div>
        <div v-if="t.message" class="toast-body">{{ t.message }}</div>
      </div>
    </div>
  </teleport>
</template>

<script>
// One store instance per evaluated module.
//
// The store itself is a factory precisely so that this declaration is the only
// place state is created: this module is evaluated once per browser page and,
// because PhToast is `ssr: false`, never on the server — so no toast can leak
// between concurrent requests in a long-running worker.
//
// `createToastStore` is reachable here even though the loader appends the
// prelude after this script: the composable contract mandates `export function`
// declarations, which are hoisted.
const toastStore = createToastStore();

let hostSeq = 0;

export default {
    name: 'PhToast',
    ssr: false,
    composables: ['store'],
    props: {
        position: {
            type: String,
            default: 'top-right',
            validator: (val) => ['top-right', 'top-left', 'bottom-right', 'bottom-left', 'top-center', 'bottom-center'].includes(val)
        },
        duration: {
            type: Number,
            default: 5000
        },
        max: {
            type: Number,
            default: 5
        },
        dismissible: {
            type: Boolean,
            default: true
        }
    },
    emits: ['dismiss'],
    data() {
        return {
            mounted: false,
            isPrimary: true,
            // Replaced wholesale on every store notification; see unsubscribe().
            toasts: []
        };
    },
    computed: {
        regionStyle() {
            const base = {
              alignItems: 'flex-end'
            }
            const p = this.position;
            if (p === 'top-left' || p === 'bottom-left') base.alignItems = 'flex-start';
            if (p === 'top-center' || p === 'bottom-center') base.alignItems = 'center';
            if (p.startsWith('top')) {
              base.top = '1rem';
            } else {
              base.bottom = '1rem';
            }
            if (p.endsWith('right')) {
              base.right = '1rem';
            } else if (p.endsWith('left')) {
              base.left = '1rem';
            } else {
              base.left = '50%';
              base.transform = 'translateX(-50%)';
            }
            return base;
        }
    },
    watch: {
        max(value) {
            toastStore.state.maxToasts = value;
        }
    },
    mounted() {
        this.mounted = true;
        toastStore.state.maxToasts = this.max;

        // First-Claim-Wins: a second <ph-toast> registers as a non-primary host
        // and renders nothing, so two hosts can never fight over the viewport.
        this.hostId = 'ph-toast-' + (++hostSeq);
        this.isPrimary = toastStore.attachHost(this.hostId);

        this.toasts = toastStore.state.toasts.slice();
        this.unsubscribe = toastStore.subscribe((list) => {
            this.toasts = list.slice();
        });

        if (typeof window !== 'undefined' && this.isPrimary) {
            // Bound, not the raw instance: `window.toast.push(...)` is a method
            // call ON window, so an unbound `this` would be `window`.
            window.toast = this.buildFacade();
        }
    },
    beforeUnmount() {
        if (typeof this.unsubscribe === 'function') {
            this.unsubscribe();
        }
        if (typeof window !== 'undefined' && window.toast?.__hostId === this.hostId) {
            window.toast = null;
        }
        toastStore.detachHost(this.hostId);
    },
    methods: {
        /**
         * The `window.toast` surface.
         *
         * Every method delegates to the store, which owns ids, timers, the
         * leave animation, the overflow cap and pause/resume bookkeeping. The
         * facade only injects the `duration` prop as the default for callers
         * that do not pass one, so a mounted <ph-toast duration="9000"> keeps
         * controlling timing exactly as before.
         */
        buildFacade() {
            const self = this;
            const withDefaults = (options) => {
                const opts = typeof options === 'string' ? { message: options } : { ...(options || {}) };
                if (typeof opts.duration !== 'number') {
                    opts.duration = self.duration;
                }
                return opts;
            };
            const shortcut = (variant) => (message, title, duration) => (
                toastStore.push(withDefaults({ message, title, variant, duration }))
            );

            return {
                push: (options) => toastStore.push(withDefaults(options)),
                // Immediate removal. The animated path is `dismiss()`.
                remove: (id) => toastStore.remove(id),
                dismiss: (id) => toastStore.dismiss(id),
                clear: () => toastStore.clear(),
                pause: (id) => toastStore.pause(id),
                resume: (id) => toastStore.resume(id),
                success: shortcut('success'),
                error: shortcut('error'),
                warning: shortcut('warning'),
                info: shortcut('info'),
                __hostId: this.hostId,
                __store: toastStore
            };
        },
        dismiss(id) {
            const leaving = this.toasts.some((t) => t.id === id);
            toastStore.dismiss(id);
            if (leaving) {
                this.$emit('dismiss', id);
            }
        },
        pause(id) {
            toastStore.pause(id);
        },
        resume(id) {
            toastStore.resume(id);
        },
        toastStyle(t) {
            const map = {
                info: 'var(--bs-info)',
                success: 'var(--bs-success)',
                warning: 'var(--bs-warning)',
                error: 'var(--bs-danger)'
            }
            return {
                maxWidth: '100%',
                pointerEvents: 'auto',
                borderLeft: `0.25rem solid ${map[t.variant] || map.info}`,
                marginBottom: 0,
                transition: 'opacity 0.15s linear'
            };
        }
    }
};
</script>