<template>
  <div>
    <ul class="nav nav-tabs" role="tablist">
      <li v-for="tab in items" :key="tab.value" class="nav-item">
        <button
          type="button"
          :class="['nav-link', { active: modelValue === tab.value, disabled: tab.disabled }]"
          role="tab"
          :aria-selected="modelValue === tab.value"
          :disabled="tab.disabled"
          @click="selectTab(tab)"
        >
          {{ tab.label }}
        </button>
      </li>
    </ul>
    <div class="tab-content py-3" role="tabpanel">
      <slot :active-tab="modelValue" />
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhTabs',
  props: {
    modelValue: {
      type: [String, Number],
      required: true
    },
    items: {
      type: Array,
      required: true,
      validator: (arr) => arr.every((tab) => typeof tab === 'object' && tab.label && tab.value !== undefined)
    }
  },
  emits: ['update:modelValue', 'change'],
  methods: {
    selectTab(tab) {
      if (!tab.disabled && tab.value !== this.modelValue) {
        this.$emit('update:modelValue', tab.value);
        this.$emit('change', tab.value);
      }
    }
  }
};
</script>