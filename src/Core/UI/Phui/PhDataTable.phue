<template>
  <div>
    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle">
        <thead>
          <tr>
            <th
              v-for="col in columns"
              :key="col.key"
              :class="col.sortable ? 'user-select-none' : ''"
              :style="col.sortable ? { cursor: 'pointer' } : null"
              @click="col.sortable ? handleSort(col.key) : null"
            >
              <span >
                <span>{{ col.label || col.key }}</span>
                <span v-if="col.sortable" class="ms-1">
                  <template v-if="sortKey === col.key">
                    {{ sortOrder === 'asc' ? '▲' : '▼' }}
                  </template>
                  <template v-else>↕</template>
                </span>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr v-if="paginatedData.length === 0">
            <td :colspan="columns.length" class="text-center text-body-secondary py-4">
              <slot name="empty">No data available</slot>
            </td>
          </tr>
          <tr v-for="(row, rowIndex) in paginatedData" :key="row.id || rowIndex">
            <td v-for="col in columns" :key="col.key">
              <slot :name="`cell(${col.key})`" :row="row" :value="row[col.key]">
                {{ row[col.key] }}
              </slot>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div v-if="paginated && totalPages > 1" class="d-flex justify-content-between align-items-center mt-3">
      <button
        type="button"
        class="btn btn-sm btn-outline-secondary"
        :disabled="currentPage === 1"
        @click="currentPage--"
      >
        Previous
      </button>
      <span class="text-body-secondary">
        Page {{ currentPage }} of {{ totalPages }}
      </span>
      <button
        type="button"
        class="btn btn-sm btn-outline-secondary"
        :disabled="currentPage === totalPages"
        @click="currentPage++"
      >
        Next
      </button>
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhDataTable',
  props: {
    columns: {
      type: Array,
      required: true
    },
    items: {
      type: Array,
      default: () => []
    },
    paginated: {
      type: Boolean,
      default: false
    },
    pageSize: {
      type: Number,
      default: 10
    }
  },
  data() {
    return {
      sortKey: '',
      sortOrder: 'asc',
      currentPage: 1
    };
  },
  computed: {
    sortedData() {
      if (!this.sortKey) return this.items;
      return [...this.items].sort((a, b) => {
        const valA = a[this.sortKey];
        const valB = b[this.sortKey];
        if (valA === valB) return 0;
        const res = valA > valB ? 1 : -1;
        return this.sortOrder === 'asc' ? res : -res;
      });
    },
    totalPages() {
      if (!this.paginated || this.pageSize <= 0) return 1;
      return Math.ceil(this.sortedData.length / this.pageSize) || 1;
    },
    paginatedData() {
      if (!this.paginated) return this.sortedData;
      const start = (this.currentPage - 1) * this.pageSize;
      return this.sortedData.slice(start, start + this.pageSize);
    }
  },
  methods: {
    handleSort(key) {
      if (this.sortKey === key) {
        this.sortOrder = this.sortOrder === 'asc' ? 'desc' : 'asc';
      } else {
        this.sortKey = key;
        this.sortOrder = 'asc';
      }
    }
  }
};
</script>