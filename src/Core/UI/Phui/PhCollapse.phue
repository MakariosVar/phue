<template>
  <div
    data-phui="collapse"
    class="accordion-item"
    :class="rootClasses"
  >
    <h2 class="accordion-header mb-0" :id="headerId">
      <button
        type="button"
        class="accordion-button"
        :class="buttonClasses"
        :aria-expanded="open ? 'true' : 'false'"
        :aria-controls="panelId"
        :disabled="disabled"
        @click="toggle"
      >
        <slot name="header" :open="open" :toggle="toggle">
          <ph-icon v-if="icon" :name="icon" size="sm" class="me-2" />
          {{ title }}
        </slot>
      </button>
    </h2>

    <!--
      No `collapse` class: Bootstrap's `.collapse:not(.show){display:none}` fights
      `v-show` — both own the display of the same element and the panel flickers
      between them on the first toggle. The height animation is driven through
      `<Transition>` hooks against Bootstrap's own `collapsing`, which is exactly
      what `<ph-accordion>` does.
    -->
    <Transition
      @enter="onEnter"
      @after-enter="onAfterEnter"
      @enter-cancelled="onEnterCancelled"
      @leave="onLeave"
      @after-leave="onAfterLeave"
      @leave-cancelled="onLeaveCancelled"
    >
      <div
        v-show="open"
        :id="panelId"
        class="accordion-collapse"
        role="region"
        :aria-labelledby="headerId"
        :style="panelStyle"
      >
        <div class="accordion-body">
          <!--
            `lazy` keeps the slot unmounted until the first open. It is a real
            wrapper rather than a `v-if` on `<slot>`: slot content cannot carry
            its own conditional, and an unmounted subtree is the whole point
            (a heavy form inside a collapsed section should not run).
          -->
          <div v-if="hasOpened">
            <slot :open="open" />
          </div>
        </div>
      </div>
    </Transition>
  </div>
</template>

<script>
import { useId } from "vue";

export default {
  name: 'PhCollapse',
  props: {
    modelValue: {
      type: Boolean,
      default: false
    },
    title: {
      type: String,
      default: ''
    },
    /** Bootstrap Icons name in front of the title. */
    icon: {
      type: String,
      default: ''
    },
    disabled: {
      type: Boolean,
      default: false
    },
    bordered: {
      type: Boolean,
      default: true
    },
    /**
     * Do not mount the panel until it is first opened. An initially-open panel
     * is mounted on the server too, so the SSR markup is never an empty shell
     * for content the reader can see.
     */
    lazy: {
      type: Boolean,
      default: false
    },
    /** Ms. Overrides Bootstrap's hard-coded `.collapsing` duration. */
    duration: {
      type: Number,
      default: 350
    }
  },
  emits: ['update:modelValue', 'change'],
  setup() {
    // Hydration-stable per-instance prefix: two collapses on one page must not
    // emit the same header/panel ids, or `aria-controls` cross-wires them.
    return { uid: 'ph-collapse-' + useId() };
  },
  data() {
    return {
      open: this.modelValue === true,
      // Seeded from the initial value, NOT from a watcher: `lazy` must be able
      // to say "the panel is closed, so nothing is mounted" and stay truthful.
      hasOpened: this.modelValue === true
    };
  },
  computed: {
    headerId() {
      return `ph-collapse-header-${this.uid}`;
    },
    panelId() {
      return `ph-collapse-panel-${this.uid}`;
    },
    rootClasses() {
      return this.bordered ? null : 'border-0';
    },
    buttonClasses() {
      return {
        // Without `collapsed` the ::after chevron keeps pointing the wrong way.
        collapsed: !this.open,
        'bg-body-secondary': !this.bordered,
        'shadow-none': !this.bordered
      };
    },
    panelStyle() {
      return { transitionDuration: this.duration + 'ms' };
    }
  },
  watch: {
    modelValue(value) {
      const next = value === true;
      this.setOpen(next);
    }
  },
  methods: {
    toggle() {
      if (this.disabled) return;
      this.setOpen(!this.open);
    },
    setOpen(next) {
      if (next === this.open) return;
      this.open = next;
      if (next) {
        this.hasOpened = true;
      }
      this.$emit('update:modelValue', next);
      this.$emit('change', next);
    },
    /** Programmatic open, so a parent can drive it without a template ref. */
    openPanel() {
      this.setOpen(true);
    },
    closePanel() {
      this.setOpen(false);
    },

    // Bootstrap's height transition, driven through Vue's hooks. The `collapsing`
    // class is the only thing that carries a CSS height transition, and there is
    // no bootstrap.js here to add it.

    onEnter(el) {
      el.style.height = '0px';
      el.classList.remove('show');
      el.classList.add('collapsing');
      void el.offsetHeight; // reflow, so the 0px baseline is committed
      el.style.height = el.scrollHeight + 'px';
    },
    onAfterEnter(el) {
      el.classList.remove('collapsing');
      el.classList.add('show');
      el.style.height = '';
    },
    onEnterCancelled(el) {
      el.classList.remove('collapsing');
      el.style.height = '';
    },
    onLeave(el) {
      el.classList.add('show');
      el.style.height = el.scrollHeight + 'px';
      void el.offsetHeight;
      el.classList.add('collapsing');
      el.classList.remove('show');
      el.style.height = '0px';
    },
    onAfterLeave(el) {
      el.classList.remove('collapsing', 'show');
      el.style.height = '';
    },
    onLeaveCancelled(el) {
      el.classList.remove('collapsing', 'show');
      el.style.height = '';
    }
  }
};
</script>
