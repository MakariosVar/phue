<template>

  <div :class="rootClasses" @click="onNavClick">
    <component :is="isSidebar ? 'nav' : 'ul'" :class="navClasses">
    <!-- Sidebar Mode -->
    <template v-if="isSidebar">
        <template v-for="(item, idx) in items" :key="idx">
          <h6
            data-phui="nav-group"
            v-if="item.group && item.group !== (items[idx - 1]?.group)" 
            class="px-3 mt-3 mb-1 text-muted text-uppercase small"
          >
            {{ item.group }}
          </h6>
          
          <span v-if="item.disabled" class="nav-link disabled" aria-disabled="true">
            {{ item.label }}
          </span>
          <a 
            v-else 
            :href="item.href || '#'" 
            :class="['nav-link', { active: isRouteActive(item.href) }]" 
            :aria-current="isRouteActive(item.href) ? 'page' : null"
            :data-no-spa="item.method && item.method !== 'GET' ? '' : null"
            :data-method="item.method && item.method !== 'GET' ? item.method : null"
            @click="onLinkClick($event, item)"
          >
            {{ item.label }}
          </a>
        </template>
      </template>

      <!-- Topbar Mode -->
      <template v-else>
        <template v-for="(node, idx) in groupedNodes" :key="idx">
          <!-- Single Nav Item -->
          <li v-if="node.type === 'single'" class="nav-item">
            <span v-if="node.item.disabled" class="nav-link disabled" aria-disabled="true">
              {{ node.item.label }}
            </span>
            <a 
              v-else 
              :href="node.item.href || '#'" 
              :class="['nav-link', { active: isRouteActive(node.item.href) }]" 
              :aria-current="isRouteActive(node.item.href) ? 'page' : null"
              :data-no-spa="node.item.method && node.item.method !== 'GET' ? '' : null"
              :data-method="node.item.method && node.item.method !== 'GET' ? node.item.method : null"
              @click="onLinkClick($event, node.item)"
            >
              {{ node.item.label }}
            </a>
          </li>

          <!-- Dropdown Group -->
          <li
            v-else
            class="nav-item dropdown"
            :class="{ show: openDropdown === node.name }"
          >
            <a
              href="#"
              :class="['nav-link', 'dropdown-toggle', { show: openDropdown === node.name, active: node.items.some(child => isRouteActive(child.href)) }]"
              role="button"
              aria-haspopup="true"
              :aria-expanded="openDropdown === node.name ? 'true' : 'false'"
              @click.prevent="toggleDropdown(node.name)"
              @keydown.enter.prevent="toggleDropdown(node.name)"
              @keydown.space.prevent="toggleDropdown(node.name)"
            >
              {{ node.name }}
            </a>
            <ul class="dropdown-menu" :class="{ show: openDropdown === node.name }">
              <li v-for="(child, cIdx) in node.items" :key="cIdx">
                <span v-if="child.disabled" class="dropdown-item disabled" aria-disabled="true">
                  {{ child.label }}
                </span>
                <a 
                  v-else 
                  :href="child.href || '#'" 
                  :class="['dropdown-item', { active: isRouteActive(child.href) }]"
                  :aria-current="isRouteActive(child.href) ? 'page' : null"
                  :data-no-spa="child.method && child.method !== 'GET' ? '' : null"
                  :data-method="child.method && child.method !== 'GET' ? child.method : null"
                  @click="onLinkClick($event, child, true)"
                >
                  {{ child.label }}
                </a>
              </li>
            </ul>
          </li>
        </template>
      </template>
    </component>

      <!-- Header Actions & Theme Toggle -->
      <div v-if="!isSidebar" class="ms-lg-auto d-flex align-items-center gap-2 mt-3 mt-lg-0">
        <!-- Actions Prefix: Theme toggle first, then actions -->
        <template v-if="isThemePrefix">
          <ph-theme aria-label="Toggle theme"></ph-theme>
          <a
            v-for="(action, aIdx) in actions"
            :key="aIdx"
            :href="action.href || '#'"
            :class="['nav-link', { active: isRouteActive(action.href) }]"
            :aria-current="isRouteActive(action.href) ? 'page' : null"
            :data-no-spa="action.method && action.method !== 'GET' ? '' : null"
            :data-method="action.method && action.method !== 'GET' ? action.method : null"
            @click="onLinkClick($event, action)"
          >
            {{ action.label }}
          </a>
        </template>
        <!-- Actions Suffix: Actions first, then theme toggle -->
        <template v-else>
          <a
            v-for="(action, aIdx) in actions"
            :key="aIdx"
            :href="action.href || '#'"
            :class="['nav-link', { active: isRouteActive(action.href) }]"
            :aria-current="isRouteActive(action.href) ? 'page' : null"
            :data-no-spa="action.method && action.method !== 'GET' ? '' : null"
            :data-method="action.method && action.method !== 'GET' ? action.method : null"
            @click="onLinkClick($event, action)"
          >
            {{ action.label }}
          </a>
          <ph-theme aria-label="Toggle theme"></ph-theme>
        </template>
      </div>
</div>
</template>

<script>
import { createSSRApp, createApp, computed, onMounted, onBeforeUnmount, ref, watch } from 'vue';

/** Bootstrap's `lg` breakpoint minus a hair, so this matches `.navbar-expand-lg`. */
const MOBILE_QUERY = '(max-width: 991.98px)';

const options = {
  props: {
    items: { type: Array, default: () => [] },
    actions: { type: Array, default: () => [] },
    activeRoute: { type: String, default: '/' },
    orientation: { type: String, default: 'horizontal' },
    themeConfig: { type: Object, default: () => {} }
  },
  setup(props) {
    const isSidebar = computed(() => props.orientation === 'sidebar' || props.orientation === 'vertical');
    const navClasses = computed(() => isSidebar.value ? 'nav nav-pills flex-column gap-1' : 'navbar-nav me-auto mb-2 mb-lg-0');

    const rootClasses = 'd-flex flex-column flex-lg-row align-items-lg-center w-100';

    const collapseId = 'nav';
    const expanded = ref(false);

    const isMobile = ref(false);
    let mobileQuery = null;

        const openDropdown = ref(null);

    function toggleDropdown(name) {
      openDropdown.value = openDropdown.value === name ? null : name;
    }

    function closeDropdown() {
      openDropdown.value = null;
    }

    function onDocumentPointerDown(event) {
      if (openDropdown.value === null) return;

      // Scoped to the `.dropdown` item itself rather than to a component ref: the
      // ref was never bound to a template element, so the check silently never
      // fired and outside clicks left the menu open.
      const target = event.target;
      if (target && target.closest && target.closest('.dropdown')) return;

      closeDropdown();
    }

    function applyCollapseState() {
      if (typeof document === 'undefined') return;

      const panel = document.getElementById('nav');
      if (panel) {
        panel.classList.toggle('show', expanded.value);
      }

      // The trigger is server-rendered markup in AppLayout, so its state is
      // written here rather than bound in a template.
      for (const trigger of document.querySelectorAll('[data-bs-toggle="collapse"][data-bs-target="#nav"]')) {
        trigger.setAttribute('aria-expanded', expanded.value ? 'true' : 'false');
      }
    }

    /** The one piece of Bootstrap JS this pattern needs, which the shell lacks. */
    function onCollapseTriggerClick(event) {
      const trigger = event.target
        && event.target.closest
        && event.target.closest('[data-bs-toggle="collapse"][data-bs-target="#nav"]');

      if (!trigger) return;

      const panel = document.getElementById('nav');
      if (!panel) return;

      event.preventDefault();
      expanded.value = !panel.classList.contains('show');
    }

    function toggle() {
      expanded.value = !expanded.value;
    }

    function onNavClick(event) {
      if (!expanded.value) return;
      const link = event.target && event.target.closest && event.target.closest('a');
      if (!link) return;

      if (link.getAttribute('role') === 'button' || link.getAttribute('href') === '#') {
        return;
      }

      expanded.value = false;
      closeDropdown();
      applyCollapseState();
    }

    function onKeydown(event) {
      if (event.key !== 'Escape') return;

      if (openDropdown.value !== null) {
        closeDropdown();
        return;
      }

      if (expanded.value) {
        expanded.value = false;
        applyCollapseState();
      }
    }

    function onBreakpointChange(event) {
      isMobile.value = event.matches;
      if (!event.matches) {
        expanded.value = false;
        closeDropdown();
      }
    }

    watch(expanded, applyCollapseState);

    onMounted(() => {
      if (typeof window.matchMedia !== 'function') return;

      mobileQuery = window.matchMedia(MOBILE_QUERY);
      isMobile.value = mobileQuery.matches;
      applyCollapseState();

      if (typeof mobileQuery.addEventListener === 'function') {
        mobileQuery.addEventListener('change', onBreakpointChange);
      } else if (typeof mobileQuery.addListener === 'function') {
        // Safari < 14.
        mobileQuery.addListener(onBreakpointChange);
      }

      document.addEventListener('keydown', onKeydown);
      document.addEventListener('click', onDocumentPointerDown);
      document.addEventListener('click', onCollapseTriggerClick);
    });

    onBeforeUnmount(() => {
      document.removeEventListener('keydown', onKeydown);
      document.removeEventListener('click', onDocumentPointerDown);
      document.removeEventListener('click', onCollapseTriggerClick);

      if (mobileQuery) {
        if (typeof mobileQuery.removeEventListener === 'function') {
          mobileQuery.removeEventListener('change', onBreakpointChange);
        } else if (typeof mobileQuery.removeListener === 'function') {
          mobileQuery.removeListener(onBreakpointChange);
        }
      }
    });

    const isThemePrefix = computed(() => {
      const pos = props.themeConfig?.position || 'actions_prefix';
      return pos === 'actions_prefix';
    });

    const normalize = (path) => '/' + (path || '').replace(/^\/+|\/+$/g, '');

    const isRouteActive = (href) => {
      const active = normalize(props.activeRoute);
      const target = normalize(href);
      return target === '/' ? active === '/' : (active === target || active.startsWith(target + '/'));
    };

    const groupedNodes = computed(() => {
      const nodes = [];
      (props.items || []).forEach((item) => {
        const group = item.group;
        if (!group) {
          nodes.push({ type: 'single', item });
        } else {
          const last = nodes[nodes.length - 1];
          if (last && last.type === 'group' && last.name === group) {
            last.items.push(item);
          } else {
            nodes.push({ type: 'group', name: group, items: [item] });
          }
        }
      });
      return nodes;
    });

    function onLinkClick(event, item, isDropdown = false) {
      if (isDropdown) {
        closeDropdown();
      }
      if (!item || !item.method || item.method === 'GET') {
        return;
      }
      event.preventDefault();
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = item.href || '#';
      form.style.display = 'none';

      if (item.method !== 'POST') {
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = item.method;
        form.appendChild(methodInput);
      }

      let csrf = '';
      if (typeof document !== 'undefined') {
        const m = document.cookie.match(/(?:^|;\s*)phue_csrf=([^;]*)/);
        if (m) {
          csrf = decodeURIComponent(m[1]);
        } else {
          const meta = document.querySelector('meta[name="csrf-token"]') || document.querySelector('meta[name="_csrf"]');
          if (meta) {
            csrf = meta.getAttribute('content') || '';
          }
        }
      }

      if (csrf) {
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_csrf';
        csrfInput.value = csrf;
        form.appendChild(csrfInput);
      }

      document.body.appendChild(form);
      form.submit();
    }

    return {
      isSidebar,
      navClasses,
      rootClasses,
      collapseId,
      expanded,
      isMobile,
      openDropdown,
      toggleDropdown,
      closeDropdown,
      toggle,
      onNavClick,
      onLinkClick,
      isThemePrefix,
      isRouteActive,
      groupedNodes
    };
  }
};

export default options;

if (typeof window !== 'undefined') {
  const mountNav = (navState) => {
    const el = document.getElementById('nav');
    if (!el) return;

    // Unmount the previous app FIRST — Vue clears #nav AND deletes
    // __vue_app__, so the next mount starts from a clean container.
    const previous = window.__phueNavApp;
    window.__phueNavApp = null;
    if (previous && typeof previous.unmount === 'function') {
      previous.unmount();
    }

    const initialState = navState || window.__NAV_STATE__ || {};
    // First mount hydrates the server-rendered nav; re-mounts (SPA
    // navigations) do a full client render so they never hydrate an
    // empty container.
    const AppCtor = previous ? createApp : createSSRApp;
    const app = AppCtor(options, initialState);
    app.mount(el);
    window.__phueNavApp = app;
  };

  document.addEventListener('DOMContentLoaded', () => {
    mountNav();
  });

  // Listen to Phue SPA navigation events to update nav dynamically
  window.addEventListener('phue:navigate', (e) => {
    if (e.detail && e.detail.navState) {
      mountNav(e.detail.navState);
    }
  });
}
</script>

<php>
/**
 * Metadata provider block for PhNavigation
 */
return [
    'title' => 'Navigation',
    'state' => [
        'items'       => $items ?? [],
        'actions'     => $actions ?? [],
        'activeRoute' => $activeRoute ?? '/',
        'orientation' => $orientation ?? 'horizontal',
        'themeConfig' => $themeConfig ?? []
    ]
];
</php>