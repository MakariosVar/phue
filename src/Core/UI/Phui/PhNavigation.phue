<template>
  <!-- SSR Partial: Rendered via <php> block -->
</template>

<php>

/**
 * PhNavigation SSR Partial (HTML-first)
 *
 * @var array<int, array{label: string, href: string, disabled?: bool}> $items
 * @var string $activeRoute
 */
$items = is_array($items ?? null) ? $items : [];
$activeRoute = is_string($activeRoute ?? null) ? $activeRoute : '/';

$normalizedActive = '/' . trim($activeRoute, '/');
$linksHtml = [];

foreach ($items as $item) {
    $href = $item['href'] ?? '#';
    $label = htmlspecialchars($item['label'] ?? '', ENT_QUOTES, 'UTF-8');
    $isDisabled = !empty($item['disabled']);

    if ($isDisabled) {
        $linksHtml[] = sprintf(
            '<span class="ph-nav__link is-disabled" aria-disabled="true">%s</span>',
            $label
        );
        continue;
    }

    $normalizedHref = '/' . trim($href, '/');
    $isActive = ($normalizedHref === '/')
        ? ($normalizedActive === '/')
        : ($normalizedActive === $normalizedHref || str_starts_with($normalizedActive, $normalizedHref . '/'));

    $activeClass = $isActive ? ' is-active' : '';
    $ariaCurrent = $isActive ? ' aria-current="page"' : '';

    $linksHtml[] = sprintf(
        '<a href="%s" class="ph-nav__link%s"%s>%s</a>',
        htmlspecialchars($href, ENT_QUOTES, 'UTF-8'),
        $activeClass,
        $ariaCurrent,
        $label
    );
}

return [
    'html' => sprintf('<nav class="ph-nav">%s</nav>', implode("\n", $linksHtml)),
];

</php>