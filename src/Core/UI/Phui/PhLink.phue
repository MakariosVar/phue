<template>
  <a
    :href="hrefAttr"
    :target="targetAttr"
    :rel="computedRel"
    :class="linkClasses"
    :aria-disabled="disabled ? 'true' : undefined"
    @click="handleClick"
  >
    <slot>{{ label }}</slot>
  </a>
</template>

<script>
export default {
  name: 'PhLink',
  props: {
    href: {
      type: String,
      default: '#'
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (val) => ['primary', 'secondary', 'neutral', 'danger'].includes(val)
    },
    target: {
      type: String,
      default: null
    },
    rel: {
      type: String,
      default: null
    },
    underline: {
      type: Boolean,
      default: true
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['click'],
  computed: {
    /**
     * Navigation is a plain <a href>. The SPA handler in
     * storage/assets/js/phue-explorer.js is a delegated document listener
     * matching `a[href]`, so a real anchor is what makes a link both
     * crawlable (SEO) and interceptable (no full reload) — and it works
     * with JavaScript disabled, which no client router does.
     *
     * A disabled link drops the href altogether: an <a> without href is not
     * focusable, so it leaves the tab order and cannot be activated by
     * Enter — no aria-disabled-only trickery.
     */
    hrefAttr() {
      if (this.disabled) return undefined;
      return typeof this.href === 'string' && this.href !== '' ? this.href : undefined;
    },
    /**
     * `_self` is the HTML default: rendering it explicitly only adds an
     * attribute to every link and confuses the "opens where" reasoning.
     */
    targetAttr() {
      if (this.disabled || !this.target || this.target === '_self') return undefined;
      return this.target;
    },
    computedRel() {
      if (this.rel) return this.rel;
      return this.target === '_blank' ? 'noopener noreferrer' : undefined;
    },
    variantClass() {
      const map = {
        primary: 'link-primary',
        secondary: 'link-secondary',
        neutral: 'link-body-emphasis',
        danger: 'link-danger'
      };
      return map[this.variant] || 'link-primary';
    },
    linkClasses() {
      return [
        this.underline ? 'text-decoration-underline' : 'text-decoration-none',
        this.variantClass,
        { 'disabled pe-none opacity-50': this.disabled }
      ];
    }
  },
  methods: {
    handleClick(event) {
      // The href is already gone when disabled, so the anchor is inert; this
      // guard covers what markup cannot — a synthetic click dispatched by a
      // parent, or an Enter keypress on a link that is still focused.
      if (this.disabled) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }

      this.$emit('click', event);
    }
  }
};
</script>