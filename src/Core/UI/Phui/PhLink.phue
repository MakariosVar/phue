<template>
  <component
    :is="componentType"
    :href="isAnchor ? href : undefined"
    :to="!isAnchor ? href : undefined"
    :target="target"
    :rel="computedRel"
    :class="['link-underline', variantClass, { 'link-underline-opacity-0': !underline, 'disabled pointer-events-none text-body-secondary': disabled }]"
    :aria-disabled="disabled ? 'true' : undefined"
    @click="handleClick"
  >
    <slot>{{ label }}</slot>
  </component>
</template>

<script>
export default {
  name: 'PhLink',
  props: {
    href: {
      type: [String, Object],
      default: '#'
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (val) => ['primary', 'secondary', 'neutral', 'danger'].includes(val)
    },
    target: {
      type: String,
      default: '_self'
    },
    rel: {
      type: String,
      default: null
    },
    underline: {
      type: Boolean,
      default: true
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['click'],
  computed: {
    isAnchor() {
      if (typeof this.href !== 'string') {
        return false;
      }
      return this.href.startsWith('http')
        || this.href.startsWith('mailto:')
        || this.href.startsWith('#')
        || this.href.startsWith('/');
    },
    componentType() {
      return this.isAnchor ? 'a' : 'router-link';
    },
    variantClass() {
      const map = {
        primary: 'link-primary',
        secondary: 'link-secondary',
        neutral: 'link-body-emphasis',
        danger: 'link-danger'
      };
      return map[this.variant] || 'link-primary';
    },
    computedRel() {
      if (this.rel) return this.rel;
      return this.target === '_blank' ? 'noopener noreferrer' : undefined;
    }
  },
  methods: {
    handleClick(event) {
      if (this.disabled) {
        event.preventDefault();
        return;
      }
      this.$emit('click', event);
    }
  }
};
</script>