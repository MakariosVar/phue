<template>
  <teleport to="body" v-if="mounted && visible">
    <div
      class="modal fade show d-block"
      data-phui="confirm-dialog"
      tabindex="-1"
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="ph-confirm-title"
      aria-describedby="ph-confirm-message"
      @click="onBackdropClick"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div ref="panel" class="modal-content" @click.stop>
          <div class="modal-header">
            <h5 id="ph-confirm-title" class="modal-title d-flex align-items-center">
              <ph-icon
                v-if="options.icon"
                :name="options.icon"
                class="me-2"
                :variant="options.variant === 'danger' ? 'danger' : 'primary'"
              />
              {{ options.title }}
            </h5>
            <button
              v-if="!options.loading"
              type="button"
              class="btn-close"
              aria-label="Close"
              @click="close(false)"
            ></button>
          </div>

          <div class="modal-body">
            <p id="ph-confirm-message" class="mb-0">{{ options.message }}</p>
          </div>

          <div class="modal-footer">
            <ph-button
              variant="secondary"
              :disabled="options.loading"
              @click="close(false)"
            >
              {{ options.cancelText }}
            </ph-button>
            <ph-button
              :variant="options.variant === 'danger' ? 'danger' : 'primary'"
              :loading="options.loading"
              @click="close(true)"
            >
              {{ options.confirmText }}
            </ph-button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-backdrop fade show"></div>
  </teleport>
</template>

<script>
export default {
  name: 'PhConfirmDialog',
  ssr: false,
  emits: ['confirm', 'cancel'],
  data() {
    return {
      mounted: false,
      visible: false,
      previousActive: null,
      resolver: null,
      options: {
        title: '',
        message: '',
        confirmText: 'Confirm',
        cancelText: 'Cancel',
        variant: 'primary',
        icon: '',
        loading: false,
        closeOnBackdrop: false
      }
    };
  },
  mounted() {
    this.mounted = true;
    if (typeof window !== 'undefined') {
      window.__phueConfirm = this;
    }
    document.addEventListener('keydown', this.onKeydown);
  },
  beforeUnmount() {
    document.removeEventListener('keydown', this.onKeydown);
    if (typeof window !== 'undefined' && window.__phueConfirm === this) {
      window.__phueConfirm = null;
    }
  },
  methods: {
    confirm(options) {
      const opts = options || {};
      this.options = {
        title: opts.title || 'Are you sure?',
        message: opts.message || '',
        confirmText: opts.confirmText || 'Confirm',
        cancelText: opts.cancelText || 'Cancel',
        variant: opts.variant || 'primary',
        icon: opts.icon || '',
        loading: !!opts.loading,
        closeOnBackdrop: opts.closeOnBackdrop === true
      };
      this.visible = true;
      this.$nextTick(this.focusInitial);
      return new Promise((resolve) => {
        this.resolver = resolve;
      });
    },
    setLoading(value) {
      this.options = { ...this.options, loading: !!value };
    },
    close(result) {
      if (this.options.loading && result === false) {
        return;
      }
      const resolver = this.resolver;
      this.resolver = null;
      this.visible = false;
      this.$emit(result ? 'confirm' : 'cancel');
      if (resolver) {
        resolver(!!result);
      }
      this.restoreFocus();
    },
    onBackdropClick() {
      if (this.options.closeOnBackdrop && !this.options.loading) {
        this.close(false);
      }
    },
    focusInitial() {
      this.previousActive = document.activeElement;
      const panel = this.$refs.panel;
      if (!panel) return;
      const cancel = panel.querySelector('.modal-footer .btn');
      if (cancel) {
        cancel.focus();
      }
    },
    restoreFocus() {
      if (this.previousActive && typeof this.previousActive.focus === 'function') {
        this.previousActive.focus();
      }
      this.previousActive = null;
    },
    focusableElements() {
      const panel = this.$refs.panel;
      if (!panel) return [];
      const selector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
      return Array.prototype.slice.call(panel.querySelectorAll(selector));
    },
    onKeydown(event) {
      if (!this.visible) return;
      if (event.key === 'Escape') {
        if (!this.options.loading) {
          this.close(false);
        }
        return;
      }
      if (event.key === 'Tab') {
        const focusable = this.focusableElements();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }
  }
};
</script>
