<template>
  <div data-phui="otp-input" class="d-inline-block">
    <label
      v-if="label"
      :id="labelId"
      :for="inputId"
      class="form-label"
    >
      {{ label }}<span v-if="required" aria-hidden="true"> *</span>
    </label>

    <!--
      ONE input, `visually-hidden`, plus `length` presentational cells.

      The obvious shape — `length` real <input> elements — is unusable with a
      screen reader (six anonymous single-character textboxes) and turns every
      paste, Backspace and caret move into a cell-navigation state machine. A
      single field is one textbox, so the browser's own editing model does the
      work, autofill on iOS/Android works because the field carries
      `autocomplete="one-time-code"`, and the cells stay pure presentation.
    -->
    <input
      :id="inputId"
      ref="field"
      type="text"
      class="visually-hidden"
      :name="name"
      :value="modelValue"
      :disabled="disabled"
      :maxlength="length"
      :inputmode="type === 'numeric' ? 'numeric' : 'text'"
      :autocapitalize="type === 'numeric' ? 'off' : 'none'"
      :autocomplete="autocomplete ? 'one-time-code' : 'off'"
      :aria-label="label ? null : ariaLabel"
      :aria-labelledby="label ? labelId : null"
      :aria-describedby="describedBy"
      :aria-invalid="hasError ? 'true' : null"
      :aria-required="required ? 'true' : null"
      @input="onInput"
      @paste="onPaste"
      @focus="onFocus"
      @blur="onBlur"
    />

    <!--
      The cells carry the caret AND the pointer target.

      The real field is `visually-hidden` — a 1px box at the origin — so a click on
      any of these cells used to hit nothing at all: the control looked like an input,
      took the click, and silently did not focus. Sighted mouse users had to Tab into
      it. `focus()` is therefore wired to the cells, and the group says so with a text
      cursor, which is the same affordance the real field would have given.
    -->
    <div
      class="d-flex align-items-center"
      :style="groupStyle"
      :aria-hidden="true"
      @click="focus"
    >
      <span
        v-for="index in length"
        :key="index"
        class="d-inline-flex align-items-center justify-content-center"
        :style="cellStyle(index)"
      >{{ masked ? maskFor(index) : charAt(index) }}</span>
    </div>

    <div
      v-if="hasError || helperText"
      :id="describedBy"
      class="form-text"
      :class="hasError ? 'text-danger' : ''"
      :role="hasError ? 'alert' : null"
    >
      {{ hasError ? error : helperText }}
    </div>
  </div>
</template>

<script>
import { useId } from "vue";

/** Cell box, per control size. Pairs with the `*-sm` / default / `*-lg` scale. */
const CELL_SIZES = {
  sm: { box: '2rem', font: '0.875rem' },
  md: { box: '2.5rem', font: '1.125rem' },
  lg: { box: '3rem', font: '1.375rem' }
};

export default {
  name: 'PhOtpInput',
  props: {
    modelValue: {
      type: String,
      default: ''
    },
    length: {
      type: Number,
      default: 6
    },
    /** `numeric` accepts digits only; `alphanumeric` also accepts letters. */
    type: {
      type: String,
      default: 'numeric',
      validator: (val) => ['numeric', 'alphanumeric'].includes(val)
    },
    /** Render dots instead of the characters — for a secret the reader must not see. */
    masked: {
      type: Boolean,
      default: false
    },
    /** `autocomplete="one-time-code"` is what makes platform autofill work. Turn it off for a code that is not one. */
    autocomplete: {
      type: Boolean,
      default: true
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    id: {
      type: String,
      default: ''
    },
    /** Forwarded to the real input, so `<ph-form>` can validate and submit it. */
    name: {
      type: String,
      default: ''
    },
    label: {
      type: String,
      default: ''
    },
    /** Accessible name, used only when no visible `label` is rendered. */
    ariaLabel: {
      type: String,
      default: 'Verification code'
    },
    helperText: {
      type: String,
      default: ''
    },
    error: {
      type: String,
      default: ''
    },
    required: {
      type: Boolean,
      default: false
    },
    disabled: {
      type: Boolean,
      default: false
    },
    autofocus: {
      type: Boolean,
      default: false
    }
  },
  emits: ['update:modelValue', 'complete', 'paste-rejected', 'focus', 'blur'],
  setup() {
    return { uid: 'ph-otp-' + useId() };
  },
  data() {
    return {
      focused: false,
      // `complete` is edge-triggered: it must fire on the transition into a full
      // value, not on every render of a full value, or a parent that re-emits
      // `update:modelValue` back gets a second `complete` for the same code.
      completed: false
    };
  },
  computed: {
    inputId() {
      return this.id || `${this.uid}-field`;
    },
    labelId() {
      return `${this.uid}-label`;
    },
    describedBy() {
      return `${this.uid}-message`;
    },
    hasError() {
      return this.error !== '';
    },
    groupStyle() {
      return {
        gap: '0.375rem',
        // Without this the cells read as static content, and clicking them looks
        // broken even once the focus is wired up.
        cursor: this.disabled ? 'default' : 'text'
      };
    },
    metrics() {
      return CELL_SIZES[this.size] || CELL_SIZES.md;
    }
  },
  watch: {
    modelValue(value) {
      const next = typeof value === 'string' ? value : '';
      if (next.length >= this.length) {
        if (!this.completed) {
          this.completed = true;
          this.$emit('complete', next.slice(0, this.length));
        }
      } else {
        this.completed = false;
      }
    }
  },
  mounted() {
    if (this.autofocus && !this.disabled) {
      this.focus();
    }
  },
  methods: {
    /**
     * Keeps only the characters this field accepts.
     *
     * Anything else is dropped rather than rejected, which is what makes a paste
     * of `123 456` or `123-456` land correctly — the separators are removed and
     * the digits fill the cells. It is also the only validation there is: there
     * is no keydown handler, because with a single field the browser already owns
     * Backspace and caret movement, and stripping on `input` covers a desktop
     * user typing letters into a numeric code.
     */
    sanitize(raw) {
      const text = String(raw ?? '');
      const allowed = this.type === 'numeric' ? /[^0-9]/g : /[^0-9A-Za-z]/g;
      return text.replace(allowed, '').slice(0, this.length);
    },
    charAt(index) {
      const value = String(this.modelValue ?? '');
      return index <= value.length ? value.charAt(index - 1) : '';
    },
    maskFor(index) {
      return index <= String(this.modelValue ?? '').length ? '•' : '';
    },
    cellStyle(index) {
      const isCaret = this.focused && index === String(this.modelValue ?? '').length + 1;
      const style = {
        width: this.metrics.box,
        height: this.metrics.box,
        fontSize: this.metrics.font,
        fontFamily: 'var(--bs-font-monospace)',
        lineHeight: '1',
        color: 'var(--bs-body-color)',
        background: 'var(--bs-body-bg)',
        border: '1px solid var(--bs-border-color)',
        borderRadius: 'var(--bs-border-radius)'
      };

      if (isCaret) {
        // The focus position, drawn as a border: the real input is invisible, so
        // without it there is nothing telling a keyboard user where they are.
        style.borderColor = 'var(--bs-primary)';
        style.borderWidth = '2px';
      }

      return style;
    },
    /** Writes the value back to the DOM, so what is typed and what is emitted agree. */
    write(value) {
      const field = this.$refs.field;
      if (field && field.value !== value) {
        field.value = value;
      }
    },
    onInput(event) {
      const cleaned = this.sanitize(event.target.value);
      this.write(cleaned);
      this.$emit('update:modelValue', cleaned);
    },
    onPaste(event) {
      const clipboard = event.clipboardData;
      const pasted = clipboard ? String(clipboard.getData('text') ?? '') : '';

      // Handled explicitly rather than left to the native paste: a value pasted
      // into a `maxlength` input is truncated by the browser *after* the invalid
      // characters are in, so "12ab34" would land as "12" and the rest would be
      // silently discarded.
      event.preventDefault();

      const cleaned = this.sanitize(pasted);
      if (cleaned === '' && pasted.replace(/\s+/g, '') !== '') {
        this.$emit('paste-rejected', pasted);
        return;
      }

      const field = this.$refs.field;
      const current = String(this.modelValue ?? '');
      const caret = field && typeof field.selectionStart === 'number'
        ? field.selectionStart
        : current.length;

      const next = (current.slice(0, caret) + cleaned + current.slice(caret))
        .slice(0, this.length);

      this.write(next);
      this.$emit('update:modelValue', next);
    },
    onFocus(event) {
      this.focused = true;
      this.$emit('focus', event);
    },
    onBlur(event) {
      this.focused = false;
      this.$emit('blur', event);
    },
    /**
     * Focuses the real field with the caret at the end.
     *
     * The end matters: the user clicked the code, and a caret sitting at position 0
     * means their next keystroke edits the first digit rather than appending — the
     * exact opposite of what clicking a code field means everywhere else.
     */
    focus() {
      const field = this.$refs.field;
      if (!field || this.disabled) {
        return;
      }

      field.focus();

      const end = String(this.modelValue ?? '').length;
      if (typeof field.setSelectionRange === 'function' && end > 0) {
        try {
          field.setSelectionRange(end, end);
        } catch (error) {
          // Not every engine accepts it on every input type; the focus still landed.
        }
      }
    },
    clear() {
      this.write('');
      this.completed = false;
      this.$emit('update:modelValue', '');
    }
  }
};
</script>
