<template>
  <div 
    :class="[
      'avatar',
      'd-inline-flex align-items-center justify-content-center',
      'bg-body-secondary text-body fw-bold overflow-hidden user-select-none',
      shapeClass,
      sizeClasses[size] || sizeClasses.md
    ]"
    :style="sizeStyle"
  >
    <img 
      v-if="src && !hasError" 
      :src="src" 
      :alt="alt" 
      class="w-100 h-100 object-fit-cover" 
      @error="hasError = true" 
    />
    <span v-else class="lh-1">{{ computedInitials }}</span>
  </div>
</template>

<script>
export default {
  name: 'PhAvatar',
  props: {
    src: {
      type: String,
      default: ''
    },
    name: {
      type: String,
      default: ''
    },
    alt: {
      type: String,
      default: 'Avatar'
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['xs', 'sm', 'md', 'lg', 'xl'].includes(val)
    },
    shape: {
      type: String,
      default: 'circle',
      validator: (val) => ['circle', 'square', 'rounded'].includes(val)
    }
  },
  data() {
    return {
      hasError: false
    };
  },
  computed: {
    shapeClass() {
      const map = {
        circle: 'rounded-circle',
        square: 'rounded-0',
        rounded: 'rounded'
      };
      return map[this.shape] || 'rounded-circle';
    },
    sizeClasses() {
      // Inline sizing using Bootstrap width/height (w-*, h-*) and font size (fs-*) utilities
      return {
        xs: 'fs-6',
        sm: 'fs-6',
        md: 'fs-5',
        lg: 'fs-4',
        xl: 'fs-2'
      };
    },
    sizeStyle() {
      const px = { xs: 24, sm: 32, md: 40, lg: 56, xl: 80 }[this.size] || 40;
      return { width: px + 'px', height: px + 'px' };
    },
    computedInitials() {
      if (!this.name) return '?';
      const parts = this.name.trim().split(/\s+/);
      if (parts.length >= 2) {
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      }
      return parts[0].substring(0, 2).toUpperCase();
    }
  }
};
</script>