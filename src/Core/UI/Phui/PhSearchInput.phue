<template>
  <div data-phui="search-input">
    <label v-if="label" :for="inputId" class="form-label">
      {{ label }}
      <span v-if="required" class="text-danger" aria-hidden="true">*</span>
    </label>

    <ph-input-shell
      ref="shell"
      :size="size"
      :disabled="disabled"
      :invalid="!!error"
    >
      <template #prefix>
        <span
          class="d-inline-flex align-items-center"
          :style="affixStyle"
          aria-hidden="true"
          @click="focus"
        >
          <ph-icon name="search" size="sm" variant="muted" />
        </span>
      </template>

      <template #default="{ controlStyle }">
        <input
          :id="inputId"
          ref="input"
          :name="name || null"
          type="search"
          class="form-control"
          :style="controlStyle"
          :placeholder="placeholder"
          :value="modelValue"
          :disabled="disabled"
          :required="required"
          :aria-required="required ? 'true' : null"
          :aria-invalid="error ? 'true' : null"
          :aria-label="label ? null : ariaLabel"
          :aria-describedby="describedBy"
          autocomplete="off"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
          @input="onInput"
          @focus="$emit('focus', $event)"
          @blur="onBlur"
          @keydown.enter.prevent="submit"
          @keydown.esc="clear"
        />
      </template>

      <template #suffix>
        <button
          v-if="clearable && modelValue"
          type="button"
          class="btn btn-sm"
          :style="clearButtonStyle"
          :disabled="disabled"
          aria-label="Clear search"
          @click="clear"
          @mouseenter="clearHovered = true"
          @mouseleave="clearHovered = false"
        >
          <ph-icon name="x" size="sm" />
        </button>
      </template>
    </ph-input-shell>

    <p v-if="error" :id="`${inputId}-error`" class="form-text text-danger mb-0" role="alert">{{ error }}</p>
    <p v-else-if="helperText" :id="`${inputId}-help`" class="form-text mb-0">{{ helperText }}</p>
  </div>
</template>

<script>
import { useId } from "vue";

export default {
  name: 'PhSearchInput',
  props: {
    modelValue: {
      type: String,
      default: ''
    },
    id: {
      type: String,
      default: null
    },
    name: {
      type: String,
      default: ''
    },
    placeholder: {
      type: String,
      default: 'Search…'
    },
    debounce: {
      type: Number,
      default: 300,
      validator: (v) => Number.isFinite(v) && v >= 0
    },
    clearable: {
      type: Boolean,
      default: true
    },
    label: {
      type: String,
      default: ''
    },
    /** Accessible name used only when no visible `label` is rendered. */
    ariaLabel: {
      type: String,
      default: 'Search'
    },
    helperText: {
      type: String,
      default: ''
    },
    error: {
      type: String,
      default: ''
    },
    disabled: {
      type: Boolean,
      default: false
    },
    required: {
      type: Boolean,
      default: false
    },
    size: {
      type: String,
      default: 'md'
      // No validator on purpose: <ph-input-shell> owns the token table and is the
      // single place a size is validated. A duplicated ['sm','md','lg'] list here
      // would silently go stale the moment the shell grows a size.
    }
  },
  emits: ['update:modelValue', 'search', 'clear', 'focus', 'blur'],
  setup() {
    const HashID = useId();
    return { HashID };
  },
  computed: {
    inputId() {
      return this.id || `ph-search-${this.HashID}`;
    },
    describedBy() {
      if (this.error) return `${this.inputId}-error`;
      if (this.helperText) return `${this.inputId}-help`;
      return undefined;
    },
    affixStyle() {
      return {
        cursor: this.disabled ? 'default' : 'pointer',
        color: 'var(--bs-secondary-color)'
      };
    },
    clearButtonStyle() {
      return {
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        width: '1.5rem',
        height: '1.5rem',
        padding: '0',
        margin: '0',
        borderWidth: '0',
        borderStyle: 'none',
        lineHeight: '1',
        color: this.clearHovered ? 'var(--bs-body-color)' : 'var(--bs-secondary-color)',
        background: 'transparent'
      };
    }
  },
  data() {
    return {
      searchTimer: null,
      clearHovered: false
    };
  },
  beforeUnmount() {
    this.cancelPendingSearch();
  },
  methods: {
    onInput(event) {
      const value = event.target.value;
      this.$emit('update:modelValue', value);
      this.scheduleSearch(value);
    },
    onBlur(event) {
      this.$emit('blur', event);
    },
    scheduleSearch(value) {
      this.cancelPendingSearch();

      if (this.debounce <= 0) {
        this.emitSearch(value);
        return;
      }

      this.searchTimer = setTimeout(() => {
        this.searchTimer = null;
        this.emitSearch(value);
      }, this.debounce);
    },
    cancelPendingSearch() {
      if (this.searchTimer === null) return;
      clearTimeout(this.searchTimer);
      this.searchTimer = null;
    },
    emitSearch(value) {
      this.$emit('search', value);
    },
    /** Enter flushes the pending debounce instead of waiting out the full delay. */
    submit() {
      this.cancelPendingSearch();
      this.emitSearch(this.modelValue);
    },
    clear() {
      this.cancelPendingSearch();
      this.$emit('update:modelValue', '');
      this.$emit('clear');
      this.$nextTick(() => this.focus());
    },
    focus() {
      if (this.disabled) return;
      if (this.$refs.input) {
        this.$refs.input.focus();
        return;
      }
      this.$refs.shell?.focus();
    }
  }
};
</script>
