<template>
  <div>
    <div v-if="showValue || label" class="d-flex justify-content-between mb-1">
      <span v-if="label" >{{ label }}</span>
      <span v-if="showValue" >{{ normalizedValue }}%</span>
    </div>
    <div :class="['progress', sizeClass]" :style="trackStyles">
      <div
        :class="['progress-bar', variantClass, { 'progress-bar-striped progress-bar-animated': animated }]"
        :style="{ width: `${normalizedValue}%` }"
        role="progressbar"
        :aria-valuenow="normalizedValue"
        aria-valuemin="0"
        aria-valuemax="100"
      ></div>
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhProgressBar',
  props: {
    value: {
      type: Number,
      default: 0
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    showValue: {
      type: Boolean,
      default: false
    },
    animated: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    normalizedValue() {
      return Math.min(100, Math.max(0, this.value));
    },
    variantClass() {
      const map = {
        primary: '',
        secondary: 'bg-secondary',
        success: 'bg-success',
        warning: 'bg-warning',
        error: 'bg-danger'
      };
      return map[this.variant] || '';
    },
    sizeClass() {
      return this.size === 'sm' ? 'progress-sm' : this.size === 'lg' ? 'progress-lg' : '';
    },
    /**
     * The vendored Bootstrap build ships no `.progress-sm` / `.progress-lg`, so
     * those classes match nothing and every size rendered identically. The
     * mechanism Bootstrap 5.3 actually uses is this variable, so drive it
     * directly and keep the class for builds that do define it.
     */
    trackStyles() {
      const heights = { sm: '0.5rem', md: '1rem', lg: '1.5rem' };
      const height = heights[this.size] || heights.md;
      return height === heights.md ? null : { '--bs-progress-height': height };
    }
  }
};
</script>