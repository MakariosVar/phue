<template>
  <div class="ph-progress">
    <div v-if="showValue || label" class="ph-progress__header">
      <span v-if="label" class="ph-progress__label">{{ label }}</span>
      <span v-if="showValue" class="ph-progress__value">{{ normalizedValue }}%</span>
    </div>
    <div :class="['ph-progress__track', `ph-progress__track--${size}`]">
      <div
        :class="['ph-progress__fill', `ph-progress__fill--${variant}`, { 'ph-progress__fill--animated': animated }]"
        :style="{ width: `${normalizedValue}%` }"
        role="progressbar"
        :aria-valuenow="normalizedValue"
        aria-valuemin="0"
        aria-valuemax="100"
      ></div>
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhProgressBar',
  props: {
    value: {
      type: Number,
      default: 0
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    showValue: {
      type: Boolean,
      default: false
    },
    animated: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    normalizedValue() {
      return Math.min(100, Math.max(0, this.value));
    }
  }
};
</script>