<template>
  <div>
    <div v-if="showValue || label" class="d-flex justify-content-between mb-1">
      <span v-if="label" class="progress-label">{{ label }}</span>
      <span v-if="showValue" class="progress-value">{{ normalizedValue }}%</span>
    </div>
    <div :class="['progress', sizeClass]">
      <div
        :class="['progress-bar', variantClass, { 'progress-bar-striped progress-bar-animated': animated }]"
        :style="{ width: `${normalizedValue}%` }"
        role="progressbar"
        :aria-valuenow="normalizedValue"
        aria-valuemin="0"
        aria-valuemax="100"
      ></div>
    </div>
  </div>
</template>

<script>
export default {
  name: 'PhProgressBar',
  props: {
    value: {
      type: Number,
      default: 0
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'primary',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    showValue: {
      type: Boolean,
      default: false
    },
    animated: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    normalizedValue() {
      return Math.min(100, Math.max(0, this.value));
    },
    variantClass() {
      const map = {
        primary: '',
        secondary: 'bg-secondary',
        success: 'bg-success',
        warning: 'bg-warning',
        error: 'bg-danger'
      };
      return map[this.variant] || '';
    },
    sizeClass() {
      return this.size === 'sm' ? 'progress-sm' : this.size === 'lg' ? 'progress-lg' : '';
    }
  }
};
</script>