<php>
/**
 * PhFormField Component
 *
 * Pre-computes CSS field tokens in PHP block to ensure proper SSR output.
 *
 * @var string $label Field label text
 * @var string|null $error Error message to trigger error styling
 * @var string|null $helper Helper descriptive text
 */
$label = $label ?? '';
$error = $error ?? null;
$helper = $helper ?? null;

// Pre-compute CSS classes in PHP context (no raw short tags in template)
$fieldClass = 'ph-field' . ($error ? ' ph-field--error' : '');
</php>

<template>
    <div class="<?= $fieldClass ?>">
        <?php if ($label): ?>
            <label class="ph-field__label"><?= htmlspecialchars($label, ENT_QUOTES, 'UTF-8') ?></label>
        <?php endif; ?>

        <!-- Control slot or content injected here -->
        <slot></slot>

        <?php if ($error): ?>
            <span class="ph-field__error"><?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?></span>
        <?php elseif ($helper): ?>
            <span class="ph-field__helper"><?= htmlspecialchars($helper, ENT_QUOTES, 'UTF-8') ?></span>
        <?php endif; ?>
    </div>
</template>