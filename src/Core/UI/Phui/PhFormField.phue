<php>
/**
 * PhFormField Component
 *
 * Pre-computes CSS field tokens in PHP block to ensure proper SSR output.
 *
 * @var string $label Field label text
 * @var string|null $error Error message to trigger error styling
 * @var string|null $helper Helper descriptive text
 */
$label = $label ?? '';
$error = $error ?? null;
$helper = $helper ?? null;

// Pre-compute CSS classes in PHP context (no raw short tags in template)
$fieldClass = 'mb-3' . ($error ? ' was-validated' : '');
</php>

<template>
    <div class="<?= $fieldClass ?>">
        <?php if ($label): ?>
            <label class="form-label"><?= htmlspecialchars($label, ENT_QUOTES, 'UTF-8') ?></label>
        <?php endif; ?>

        <!-- Control slot or content injected here -->
        <slot></slot>

        <?php if ($error): ?>
            <div class="invalid-feedback d-block"><?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?></div>
        <?php elseif ($helper): ?>
            <div class="form-text"><?= htmlspecialchars($helper, ENT_QUOTES, 'UTF-8') ?></div>
        <?php endif; ?>
    </div>
</template>
