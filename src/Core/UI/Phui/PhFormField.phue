<template>
    <div :class="fieldClasses">
        <label v-if="label" class="form-label">{{ label }}</label>

        <slot></slot>

        <div v-if="error" class="invalid-feedback d-block">{{ error }}</div>
        <div v-else-if="helperText" class="form-text">{{ helperText }}</div>
    </div>
</template>

<script>
export default {
    name: 'PhFormField',
    props: {
        label: {
            type: String,
            default: ''
        },
        error: {
            type: String,
            default: ''
        },
        helperText: {
            type: String,
            default: ''
        }
    },
    computed: {
        fieldClasses() {
            return ['mb-3', this.error ? 'was-validated' : ''];
        }
    }
};
</script>