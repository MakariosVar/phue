<template>
  <component
    :is="tag"
    :class="[colorClass, alignClass]"
  >
    <slot />
  </component>
</template>

<script>
export default {
  name: 'PhHeading',
  props: {
    level: {
      type: [String, Number],
      default: 1,
      validator: (val) => [1, 2, 3, 4, 5, 6, '1', '2', '3', '4', '5', '6'].includes(val)
    },
    color: {
      type: String,
      default: 'default'
    },
    align: {
      type: String,
      default: 'left',
      validator: (val) => ['left', 'center', 'right', 'justify'].includes(val)
    }
  },
  computed: {
    tag() {
      return `h${this.level}`;
    },
    colorClass() {
      const map = {
        default: '',
        muted: 'text-body-secondary',
        primary: 'text-primary',
        secondary: 'text-secondary',
        danger: 'text-danger'
      };
      return map[this.color] || '';
    },
    alignClass() {
      const map = {
        left: 'text-start',
        center: 'text-center',
        right: 'text-end',
        justify: 'text-justify'
      };
      return map[this.align] || 'text-start';
    }
  }
};
</script>
