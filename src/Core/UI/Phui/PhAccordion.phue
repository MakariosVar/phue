<template>
  <div
    data-phui="accordion"
    class="accordion ph-accordion"
    :class="{ 'accordion-flush': flush }"
  >
    <div
      v-for="(item, index) in items"
      :key="itemKey(item, index)"
      class="accordion-item"
    >
      <h2 class="accordion-header" :id="headingId(index)">
        <button
          type="button"
          class="accordion-button"
          :class="buttonClasses(item, index)"
          :aria-expanded="isOpen(index) ? 'true' : 'false'"
          :aria-controls="panelId(index)"
          @click="toggle(index)"
        >
          <ph-icon v-if="item?.icon" :name="item.icon" size="sm" class="me-2" />
          {{ item?.label }}
        </button>
      </h2>

        <!-- No `collapse` class: Bootstrap's `.collapse:not(.show){display:none}` fights `v-show`. -->
      <Transition
        @enter="onEnter"
        @after-enter="onAfterEnter"
        @enter-cancelled="onEnterCancelled"
        @leave="onLeave"
        @after-leave="onAfterLeave"
        @leave-cancelled="onLeaveCancelled"
      >
        <div
          :id="panelId(index)"
          class="accordion-collapse"
          role="region"
          :aria-labelledby="headingId(index)"
          v-show="isOpen(index)"
        >
          <div class="accordion-body">
            <slot :name="`item-${itemKey(item, index)}`" :item="item" :index="index" :open="isOpen(index)">
              {{ item?.content }}
            </slot>
          </div>
        </div>
      </Transition>
    </div>
  </div>
</template>

<script>
import { useId } from "vue";

// A prop declared `Array` still gets whatever a caller passes; Vue only warns.
// `v-model="0"` here used to throw `value.slice is not a function` and take the
// whole SSR render down with it, so a wrong type must degrade to "nothing open".
function toKeys(value) {
  if (Array.isArray(value)) return value.slice();
  if (value === null || value === undefined || value === '') return [];
  return [value];
}

export default {
  name: 'PhAccordion',
  props: {
    items: {
      type: Array,
      default: () => []
    },
    /** Allow more than one panel open. */
    multiple: {
      type: Boolean,
      default: false
    },
    flush: {
      type: Boolean,
      default: false
    },
    /** Keys of the open panels; kept internally so it works unwired. */
    modelValue: {
      type: Array,
      default: () => []
    }
  },
  emits: ['update:modelValue'],
  setup() {
    // Hydration-stable per-instance prefix, so two accordions cannot emit
    // duplicate ids and aria-controls survives SSR.
    return { uid: 'ph-accordion-' + useId() };
  },
  data() {
    return {
      open: [],
      seeded: false
    };
  },
  watch: {
    modelValue: {
      immediate: true,
      deep: true,
      handler(value) {
        this.open = toKeys(value);
      }
    },
    items: {
      immediate: true,
      handler(list) {
        // `active` is the INITIAL state, read once — never mutated back.
        if (this.seeded) return;
        this.seeded = true;

        const initial = list
          .map((item, index) => (item && item.active ? this.itemKey(item, index) : null))
          .filter((key) => key !== null);

        if (initial.length) {
          this.open = initial;
        }
      }
    }
  },
  methods: {
    itemKey(item, index) {
      return (item && (item.key || item.id)) || index;
    },
    headingId(index) {
      return `ph-accordion-heading-${this.uid}-${index}`;
    },
    panelId(index) {
      return `ph-accordion-collapse-${this.uid}-${index}`;
    },
    isOpen(index) {
      return this.open.indexOf(this.itemKey(this.items[index], index)) !== -1;
    },
    toggle(index) {
      const key = this.itemKey(this.items[index], index);
      const isOpen = this.open.indexOf(key) !== -1;

      let next;
      if (isOpen) {
        next = this.open.filter((value) => value !== key);
      } else if (this.multiple) {
        next = this.open.concat([key]);
      } else {
        // Single mode replaces, it does not append.
        next = [key];
      }

      this.open = next;
      this.$emit('update:modelValue', next);
    },
    buttonClasses(item, index) {
      const open = this.isOpen(index);
      return {
        // Without `collapsed` the ::after chevron keeps the wrong direction.
        collapsed: !open,
        'bg-body-secondary': this.flush,
        'border-0': this.flush,
        'shadow-none': this.flush,
        'fw-semibold': open
      };
    },

    // Bootstrap's height transition, driven through Vue hooks.

    onEnter(el) {
      el.style.height = '0px';
      el.classList.remove('show');
      el.classList.add('collapsing');
      void el.offsetHeight; // reflow, so the 0px baseline is committed
      void el.offsetHeight;
      el.style.height = el.scrollHeight + 'px';
    },
    onAfterEnter(el) {
      el.classList.remove('collapsing');
      el.classList.add('show');
      el.style.height = '';
    },
    onEnterCancelled(el) {
      el.classList.remove('collapsing');
      el.style.height = '';
    },
    onLeave(el) {
      el.classList.add('show');
      el.style.height = el.scrollHeight + 'px';
      void el.offsetHeight;
      el.classList.add('collapsing');
      el.classList.remove('show');
      el.style.height = '0px';
    },
    onAfterLeave(el) {
      el.classList.remove('collapsing', 'show');
      el.style.height = '';
    },
    onLeaveCancelled(el) {
      el.classList.remove('collapsing', 'show');
      el.style.height = '';
    }
  }
};
</script>
