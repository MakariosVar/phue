<template>
  <label :class="['ph-radio', { 'ph-radio--disabled': disabled, 'ph-radio--checked': isChecked }]">
    <input
      type="radio"
      :name="name"
      :value="value"
      :checked="isChecked"
      :disabled="disabled"
      class="ph-radio__input"
      @change="$emit('update:modelValue', value)"
    />
    <span class="ph-radio__circle" aria-hidden="true">
      <span v-if="isChecked" class="ph-radio__dot"></span>
    </span>
    <span v-if="label || $slots.default" class="ph-radio__label">
      <slot>{{ label }}</slot>
    </span>
  </label>
</template>

<script>
export default {
  name: 'PhRadio',
  props: {
    modelValue: {
      type: [String, Number, Boolean],
      default: null
    },
    value: {
      type: [String, Number, Boolean],
      required: true
    },
    name: {
      type: String,
      default: ''
    },
    label: {
      type: String,
      default: ''
    },
    disabled: {
      type: Boolean,
      default: false
    }
  },
  emits: ['update:modelValue'],
  computed: {
    isChecked() {
      return $props.modelValue === $props.value;
    }
  }
};
</script>