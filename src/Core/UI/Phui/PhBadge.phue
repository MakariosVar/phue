<template>
  <span :class="['badge', variantClass, { 'rounded-pill': pill }]" :style="sizeStyle">
    <slot>{{ label }}</slot>
  </span>
</template>

<script>
export default {
  name: 'PhBadge',
  props: {
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'neutral',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error', 'info', 'neutral'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    pill: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    variantClass() {
      const map = {
        primary: 'text-bg-primary',
        secondary: 'text-bg-secondary',
        success: 'text-bg-success',
        warning: 'text-bg-warning',
        error: 'text-bg-danger',
        info: 'text-bg-info',
        neutral: 'text-bg-secondary'
      };
      return map[this.variant] || 'text-bg-secondary';
    },
    sizeStyle() {
      const map = {
        sm: {
          '--bs-badge-font-size': '0.7em',
          '--bs-badge-padding-y': '0.3em',
          '--bs-badge-padding-x': '0.5em'
        },
        md: {
          '--bs-badge-font-size': '0.85em',
          '--bs-badge-padding-y': '0.35em',
          '--bs-badge-padding-x': '0.65em'
        },
        lg: {
          '--bs-badge-font-size': '1em',
          '--bs-badge-padding-y': '0.45em',
          '--bs-badge-padding-x': '0.85em'
        }
      };
      return map[this.size] || {};
    }
  }
};
</script>