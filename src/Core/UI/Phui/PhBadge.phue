<template>
  <span :class="['badge', variantClass, sizeClass, { 'rounded-pill': pill }]">
    <slot>{{ label }}</slot>
  </span>
</template>

<script>
export default {
  name: 'PhBadge',
  props: {
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: 'neutral',
      validator: (val) => ['primary', 'secondary', 'success', 'warning', 'error', 'info', 'neutral'].includes(val)
    },
    size: {
      type: String,
      default: 'md',
      validator: (val) => ['sm', 'md', 'lg'].includes(val)
    },
    pill: {
      type: Boolean,
      default: false
    }
  },
  computed: {
    variantClass() {
      const map = {
        primary: 'text-bg-primary',
        secondary: 'text-bg-secondary',
        success: 'text-bg-success',
        warning: 'text-bg-warning',
        error: 'text-bg-danger',
        info: 'text-bg-info',
        neutral: 'text-bg-secondary'
      };
      return map[this.variant] || 'text-bg-secondary';
    },
    sizeClass() {
      return this.size === 'sm' ? 'badge-sm' : this.size === 'lg' ? 'badge-lg' : '';
    }
  }
};
</script>