<template>
  <div ref="root" data-phui="select3" class="position-relative">
    <label v-if="label" :id="labelId" class="form-label">
      {{ label }}
      <span v-if="required" class="text-danger">*</span>
    </label>

    <div
      ref="control"
      :id="controlId"
      class="form-control d-flex flex-wrap align-items-center gap-1"
      :class="{ 'is-invalid': !!error, 'bg-body-secondary opacity-75': disabled }"
      role="combobox"
      :aria-label="label ? null : (placeholder || null)"
      :aria-labelledby="label ? labelId : null"
      aria-haspopup="listbox"
      :aria-expanded="open ? 'true' : 'false'"
      :aria-controls="listId"
      :aria-activedescendant="activeDescendant"
      :tabindex="disabled ? -1 : 0"
      @click="onControlClick"
    >
      <template v-if="multiple">
        <span
          v-for="opt in selectedOptions"
          :key="opt.value"
          class="badge text-bg-secondary d-inline-flex align-items-center"
        >
          {{ opt.label }}
          <button
            v-if="!disabled"
            type="button"
            class="btn-close btn-close-white ms-1"
            style="font-size: 0.5rem;"
            aria-label="Remove"
            @click.stop="deselect(opt)"
          ></button>
        </span>
        <span v-if="selectedOptions.length === 0" class="text-body-secondary">
          {{ placeholder }}
        </span>
      </template>

      <template v-else>
        <span :class="{ 'text-body-secondary': !selectedLabel }">
          {{ selectedLabel || placeholder }}
        </span>
      </template>

      <span class="ms-auto d-flex align-items-center">
        <button
          v-if="clearable && hasValue && !disabled"
          type="button"
          class="btn-close me-1"
          aria-label="Clear"
          @click.stop="clear"
        ></button>
        <ph-icon
          name="chevron-down"
          size="sm"
          :style="{ transition: 'transform 0.15s ease', transform: open ? 'rotate(180deg)' : 'none' }"
        />
      </span>
    </div>

    <teleport to="body" v-if="open">
      <div
        :id="listId"
        ref="list"
        data-phui="select3-list"
        class="dropdown-menu show p-0"
        role="listbox"
        :style="listStyle"
      >
        <div v-if="searchable" class="px-2 pb-2">
          <input
            ref="search"
            type="text"
            class="form-control form-control-sm"
            :value="query"
            placeholder="Search…"
            @input="onSearchInput"
          />
        </div>

        <button
          v-for="(opt, index) in filteredOptions"
          :id="optionId(index)"
          :key="opt.value"
          ref="options"
          type="button"
          class="dropdown-item d-flex align-items-center"
          :class="{ active: index === activeIndex, disabled: opt.disabled }"
          role="option"
          :aria-selected="isSelected(opt.value) ? 'true' : 'false'"
          :disabled="opt.disabled"
          @click="select(opt)"
          @mouseenter="activeIndex = index"
        >
          <span class="me-2 d-inline-block" style="width: 1rem;">
            <ph-icon v-if="isSelected(opt.value)" name="check" size="sm" />
          </span>
          {{ opt.label }}
        </button>

        <div v-if="filteredOptions.length === 0" class="dropdown-item-text text-body-secondary">
          No results
        </div>

        <slot name="footer" :close="close" />
      </div>
    </teleport>

    <p v-if="error" class="form-text text-danger mb-0">{{ error }}</p>
    <p v-else-if="helperText" class="form-text mb-0">{{ helperText }}</p>
  </div>
</template>

<script>
import { useId } from "vue";

// Gap between the control and the list, on whichever side it opens.
const LIST_GAP = 4;

export default {
  name: 'PhSelect3',
  composables: ['position'],
  props: {
    modelValue: {
      type: [String, Number, Array, null],
      default: ''
    },
    options: {
      type: Array,
      default: () => []
    },
    id: {
      type: String,
      default: null
    },
    label: {
      type: String,
      default: ''
    },
    placeholder: {
      type: String,
      default: 'Select…'
    },
    helperText: {
      type: String,
      default: ''
    },
    error: {
      type: String,
      default: ''
    },
    multiple: {
      type: Boolean,
      default: false
    },
    searchable: {
      type: Boolean,
      default: true
    },
    clearable: {
      type: Boolean,
      default: false
    },
    disabled: {
      type: Boolean,
      default: false
    },
    required: {
      type: Boolean,
      default: false
    }
  },
  emits: ['update:modelValue', 'search', 'open', 'close', 'clear'],
  setup() {
    const HashID = useId();
    return { HashID };
  },
  data() {
    return {
      open: false,
      query: '',
      activeIndex: 0,
      /** Viewport-space control geometry; positionFor adds the scroll offset back. */
      anchorRect: null,
      /** Teleported list size. Its height decides the flip, so it is measured. */
      panelSize: { width: 0, height: 0 },
      /** Output of positionFor(), or null while the list is not yet placeable. */
      panelPos: null,
      viewportHandle: null
    };
  },
  computed: {
    controlId() {
      return this.id || `ph-select3-${this.HashID}`;
    },
    listId() {
      return `${this.controlId}-list`;
    },
    labelId() {
      return `${this.controlId}-label`;
    },
    normalizedOptions() {
      return this.options.map((opt) => {
        if (typeof opt === 'object' && opt !== null) {
          return {
            label: opt.label !== undefined ? opt.label : opt.value,
            value: opt.value,
            disabled: !!opt.disabled
          };
        }
        return { label: String(opt), value: opt, disabled: false };
      });
    },
    filteredOptions() {
      if (!this.searchable || !this.query) {
        return this.normalizedOptions;
      }
      const needle = this.query.toLowerCase();
      return this.normalizedOptions.filter((opt) =>
        String(opt.label).toLowerCase().includes(needle)
      );
    },
    selectedValues() {
      if (this.multiple) {
        return Array.isArray(this.modelValue) ? this.modelValue : [];
      }
      return this.modelValue === '' || this.modelValue === null || this.modelValue === undefined
        ? []
        : [this.modelValue];
    },
    selectedOptions() {
      return this.selectedValues.map((value) => {
        const match = this.normalizedOptions.find((opt) => opt.value === value);
        return match || { label: String(value), value };
      });
    },
    selectedLabel() {
      if (this.selectedOptions.length === 0) {
        return '';
      }
      return this.selectedOptions[0].label;
    },
    hasValue() {
      return this.selectedValues.length > 0;
    },
    activeDescendant() {
      if (!this.open || this.activeIndex < 0) {
        return null;
      }
      const option = this.filteredOptions[this.activeIndex];
      return option && !option.disabled ? this.optionId(this.activeIndex) : null;
    },
    listStyle() {
      const base = {
        position: 'absolute',
        display: 'block',
        maxHeight: '16rem',
        overflowY: 'auto',
        zIndex: 1040,
        // The layer of an anchored float: it opens over page content, and staying
        // under the modal layer is what keeps a select inside a modal in that modal.
        width: '0px'
      };

      const pos = this.panelPos;

      if (!pos || !pos.measured || typeof window === 'undefined') {
        // Unmeasured. Hidden rather than painted at 0,0 — the server never knows the
        // control's position, so claiming one would flash the list in the corner.
        return { ...base, visibility: 'hidden' };
      }

      return {
        ...base,
        width: `${pos.width}px`,
        left: `${pos.left}px`,
        top: `${pos.top}px`,
        visibility: 'visible'
      };
    }
  },
  watch: {
    open(value) {
      this.$emit(value ? 'open' : 'close');

      if (value) {
        this.activeIndex = this.firstEnabled();
        this.startTracking();

        // Two ticks: the first renders the teleported panel, the second measures it.
        // Measuring on the first tick reads a node that does not exist yet.
        this.$nextTick(() => {
          this.reposition();
          if (this.searchable && this.$refs.search) {
            this.$refs.search.focus();
          }
        });
      } else {
        this.query = '';
        this.stopTracking();
      }
    },
    filteredOptions() {
      if (this.activeIndex < 0) {
        return;
      }
      const option = this.filteredOptions[this.activeIndex];
      if (!option || option.disabled) {
        this.activeIndex = this.firstEnabled();
      }
    },
    query() {
      this.activeIndex = this.firstEnabled();
      this.$emit('search', this.query);
    }
  },
  mounted() {
    document.addEventListener('click', this.onDocumentClick);
    window.addEventListener('keydown', this.onKeydown, true);
  },
  beforeUnmount() {
    this.stopTracking();
    document.removeEventListener('click', this.onDocumentClick);
    window.removeEventListener('keydown', this.onKeydown, true);
  },
  methods: {
    optionId(index) {
      return `${this.listId}-opt-${index}`;
    },
    isSelected(value) {
      return this.selectedValues.includes(value);
    },
    toggleOpen() {
      if (this.disabled) return;
      this.open = !this.open;
    },
    close() {
      this.open = false;
    },
    onControlClick() {
      this.toggleOpen();
    },
    onSearchInput(event) {
      this.query = event.target.value;
    },
    firstEnabled() {
      return this.filteredOptions.findIndex((option) => !option.disabled);
    },
    lastEnabled() {
      const options = this.filteredOptions;
      for (let index = options.length - 1; index >= 0; index--) {
        if (!options[index].disabled) {
          return index;
        }
      }
      return -1;
    },
    moveActive(step) {
      const options = this.filteredOptions;
      if (options.length === 0) {
        this.activeIndex = -1;
        return;
      }
      let index = this.activeIndex;
      for (let attempt = 0; attempt < options.length; attempt++) {
        index = (index + step + options.length) % options.length;
        if (!options[index].disabled) {
          this.activeIndex = index;
          return;
        }
      }
      this.activeIndex = -1;
    },
    scrollActiveIntoView() {
      const nodes = this.$refs.options;
      const option = Array.isArray(nodes) ? nodes[this.activeIndex] : null;
      if (option && typeof option.scrollIntoView === 'function') {
        option.scrollIntoView({ block: 'nearest' });
      }
    },
    revealActive() {
      this.$nextTick(() => {
        this.scrollActiveIntoView();
      });
    },
    focusControl() {
      this.$nextTick(() => {
        if (this.$refs.control) {
          this.$refs.control.focus();
        }
      });
    },
    isOptionNode(node) {
      return !!node && node.nodeType === 1 && node.getAttribute('role') === 'option';
    },
    hasFocusWithin() {
      const root = this.$refs.root;
      const active = typeof document === 'undefined' ? null : document.activeElement;
      return !!(root && active && root !== active && root.contains(active));
    },
    removeLastChip() {
      if (!this.multiple || !this.searchable || this.query !== '') {
        return false;
      }
      const current = this.selectedValues;
      if (current.length === 0) {
        return false;
      }
      this.$emit('update:modelValue', current.slice(0, -1));
      return true;
    },
    onKeydown(event) {
      if (this.disabled) {
        return;
      }
      const key = event.key;

      if (key === 'Escape') {
        if (!this.open) {
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        this.close();
        this.focusControl();
        return;
      }

      if (key === 'Tab') {
        if (this.open) {
          this.close();
        }
        return;
      }

      if (key === 'ArrowDown' || key === 'ArrowUp') {
        if (!this.open && !this.hasFocusWithin()) {
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        if (!this.open) {
          this.open = true;
          this.activeIndex = key === 'ArrowDown' ? this.firstEnabled() : this.lastEnabled();
          this.revealActive();
          return;
        }
        this.moveActive(key === 'ArrowDown' ? 1 : -1);
        this.revealActive();
        return;
      }

      if (key === 'Home' || key === 'End') {
        if (!this.open) {
          return;
        }
        event.stopPropagation();
        event.preventDefault();
        this.activeIndex = key === 'Home' ? this.firstEnabled() : this.lastEnabled();
        this.revealActive();
        return;
      }

      if (key === 'Enter') {
        if (!this.open && !this.hasFocusWithin()) {
          return;
        }
        event.stopPropagation();
        if (this.isOptionNode(event.target)) {
          return;
        }
        event.preventDefault();
        if (!this.open) {
          this.open = true;
          this.activeIndex = this.firstEnabled();
          this.revealActive();
          return;
        }
        const option = this.filteredOptions[this.activeIndex];
        if (option) {
          this.select(option);
        }
        return;
      }

      if (key === 'Backspace' && this.hasFocusWithin() && this.removeLastChip()) {
        event.stopPropagation();
      }
    },
    select(option) {
      if (!option || option.disabled) return;
      if (this.multiple) {
        const current = this.selectedValues.slice();
        const index = current.indexOf(option.value);
        if (index >= 0) {
          current.splice(index, 1);
        } else {
          current.push(option.value);
        }
        this.$emit('update:modelValue', current);
        this.query = '';
      } else {
        this.$emit('update:modelValue', option.value);
        this.open = false;
      }
    },
    deselect(option) {
      if (!this.multiple) return;
      const current = this.selectedValues.filter((value) => value !== option.value);
      this.$emit('update:modelValue', current);
    },
    clear() {
      this.$emit('update:modelValue', this.multiple ? [] : '');
      this.$emit('clear');
    },
    /**
     * Outside-click has to test BOTH the control and the teleported panel.
     *
     * The panel is no longer a descendant of the root, so a click on an option, on
     * the search field or inside the `footer` slot all read as "outside" — which
     * closed the list before the click could do anything, and made the search input
     * unusable the moment you clicked it.
     */
    onDocumentClick(event) {
      if (!this.open) return;

      const target = event.target;
      if (this.$refs.root && this.$refs.root.contains(target)) return;
      if (this.$refs.list && this.$refs.list.contains(target)) return;

      this.close();
    },

    /**
     * Viewport-space geometry of the control.
     *
     * Kept in viewport space on purpose: the scroll offset is passed to
     * positionFor() instead of being folded in here, so one arithmetic identity
     * owns the document-space conversion.
     */
    measureAnchor() {
      this.anchorRect = measureAnchor(this.$refs.control);
    },
    measurePanel() {
      const list = this.$refs.list;
      if (!list || typeof list.getBoundingClientRect !== 'function') {
        this.panelSize = { width: 0, height: 0 };
        return;
      }

      const rect = list.getBoundingClientRect();
      this.panelSize = { width: rect.width, height: rect.height };
    },
    /**
     * Recomputes the list position from freshly measured geometry.
     *
     * Both the control and the list are re-measured: a nested scroller moves the
     * control, and the list's own height decides which side it opens on.
     */
    reposition() {
      this.measureAnchor();
      this.measurePanel();

      if (!this.anchorRect || typeof window === 'undefined') {
        this.panelPos = null;
        return;
      }

      this.panelPos = positionFor(this.anchorRect, {
        placement: 'bottom',
        align: 'start',
        size: this.panelSize,
        viewport: {
          width: document.documentElement.clientWidth,
          height: document.documentElement.clientHeight
        },
        scroll: {
          x: window.scrollX || window.pageXOffset || 0,
          y: window.scrollY || window.pageYOffset || 0
        },
        offset: LIST_GAP,
        allowFlip: true,
        // Deliberately not clamped. The list is exactly as wide as the control and
        // left-aligned to it, so it cannot overflow horizontally — and clamping
        // vertically would drag it up over the very control it belongs to when
        // neither side has room. Overflowing the bottom is the lesser evil: the
        // list caps itself at 16rem and scrolls internally.
        clamp: false,
        margin: 0
      });
    },
    /**
     * Subscribes to viewport changes through the shared composable.
     *
     * trackViewport() listens on scroll in the capture phase, which is what
     * makes *nested* scrollers (a scrolling form column around the control)
     * visible to it — scroll events do not bubble, so a bubbling listener would
     * miss them. It also coalesces bursts into one rAF callback.
     */
    startTracking() {
      if (this.viewportHandle) return;

      this.measureAnchor();
      this.viewportHandle = trackViewport(this.reposition);

      // The list is teleported, so it does not exist until Vue has flushed the
      // open state. Measure it on the next tick, then place it.
      this.$nextTick(() => {
        this.reposition();
      });
    },
    stopTracking() {
      if (this.viewportHandle) {
        releaseViewport(this.viewportHandle);
        this.viewportHandle = null;
      }
      this.panelPos = null;
    }
  }
};
</script>
