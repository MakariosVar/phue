<template>
  <div
    data-phui="divider"
    :class="[spacingClass, rootClass]"
  >
    <span
      v-if="showLabel"
      class="flex-grow-1 border-top"
      :class="borderClass"
    ></span>
    <span
      v-if="showLabel"
      class="text-body-secondary text-nowrap"
      :class="colorClass"
    >{{ label }}</span>
    <span
      v-if="showLabel"
      class="flex-grow-1 border-top"
      :class="borderClass"
    ></span>
  </div>
</template>

<script>
export default {
  name: 'PhDivider',
  props: {
    orientation: {
      type: String,
      default: 'horizontal',
      validator: (v) => ['horizontal', 'vertical'].includes(v)
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: '',
      validator: (v) => ['', 'primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark'].includes(v)
    },
    spacing: {
      type: [String, Number],
      default: 'md'
    }
  },
  computed: {
    showLabel() {
      return this.orientation === 'horizontal' && this.label !== '';
    },
    // One root for all three shapes: the renderer's template compiler assumes a
    // single top-level element, so branching on sibling roots silently drops
    // every branch but the first and the v-else.
    rootClass() {
      if (this.orientation === 'vertical') return 'vr';
      if (this.showLabel) return 'd-flex align-items-center gap-2';
      return 'border-top';
    },
    // .vr paints with currentcolor, so a vertical rule needs a *color* class.
    colorClass() {
      return this.variant ? `text-${this.variant}` : '';
    },
    // Horizontal rules are real borders, so they take the border-color utilities.
    borderClass() {
      return this.variant ? `border-${this.variant}` : '';
    },
    spacingClass() {
      const map = { none: 0, xs: 1, sm: 2, md: 3, lg: 4, xl: 5 };
      const step = typeof this.spacing === 'number' ? this.spacing : map[this.spacing];
      // A vertical rule is sized by its flex parent (align-self: stretch), so
      // vertical margins would shrink it and offset it away from the text it
      // is supposed to divide. Only the inline axis is ours to space.
      if (step === undefined) return this.spacing;
      if (this.orientation === 'vertical') return `mx-${step}`;
      return `my-${step}`;
    }
  }
};
</script>
