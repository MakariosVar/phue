<template>
  <span
    v-if="orientation === 'vertical'"
    data-phui="divider"
    class="vr"
    :class="[spacingClass, colorClass]"
  ></span>

  <div
    v-else-if="label"
    data-phui="divider"
    class="d-flex align-items-center gap-2"
    :class="spacingClass"
  >
    <span class="flex-grow-1 border-top" :class="borderClass"></span>
    <span class="text-body-secondary text-nowrap" :class="colorClass">{{ label }}</span>
    <span class="flex-grow-1 border-top" :class="borderClass"></span>
  </div>

  <div
    v-else
    data-phui="divider"
    class="border-top"
    :class="[spacingClass, borderClass]"
  ></div>
</template>

<script>
export default {
  name: 'PhDivider',
  props: {
    orientation: {
      type: String,
      default: 'horizontal',
      validator: (v) => ['horizontal', 'vertical'].includes(v)
    },
    label: {
      type: String,
      default: ''
    },
    variant: {
      type: String,
      default: '',
      validator: (v) => ['', 'primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark'].includes(v)
    },
    spacing: {
      type: [String, Number],
      default: 'md'
    }
  },
  computed: {
    // .vr paints with currentcolor, so a vertical rule needs a *color* class.
    colorClass() {
      return this.variant ? `text-${this.variant}` : '';
    },
    // Horizontal rules are real borders, so they take the border-color utilities.
    borderClass() {
      return this.variant ? `border-${this.variant}` : '';
    },
    spacingClass() {
      const map = { none: 'my-0', xs: 'my-1', sm: 'my-2', md: 'my-3', lg: 'my-4', xl: 'my-5' };
      if (typeof this.spacing === 'number') return `my-${this.spacing}`;
      return map[this.spacing] ?? this.spacing;
    }
  }
};
</script>
