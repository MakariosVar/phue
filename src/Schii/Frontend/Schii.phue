<php>
$title = 'Schii Console';

return [
    'title' => $title,
    'state' => [
        'apiPrefix' => $apiPrefix ?? '/api/schii',
    ],
    'scripts' => [],
];
</php>

<template>
<div class="schii-console p-4" v-cloak>
    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="lg" class="mb-4">
        <div>
            <ph-heading :level="1" class="mb-0">Schii Console</ph-heading>
            <ph-text color="muted">Zero-Controller Dynamic REST Management Interface</ph-text>
        </div>
        <ph-button v-if="currentEntity" variant="primary" @click="openCreateModal">
            + New {{ currentEntity }}
        </ph-button>
    </ph-flex>

    <ph-alert
        v-if="errorMsg"
        variant="error"
        :message="errorMsg"
        dismissible
        class="mb-3"
        @dismiss="errorMsg = null"
    />

    <ph-row gutter="3">
        <ph-col span="12" md="4" lg="3">
            <ph-card title="Entities" :bordered="false">
                <div v-if="loadingEntities">
                    <ph-skeleton v-for="n in 4" :key="n" variant="text" width="100%" height="18" class="d-block mb-3" />
                </div>
                <ph-stack v-else-if="entities.length" gap="xs">
                    <ph-button
                        v-for="entity in entities"
                        :key="entity"
                        :variant="currentEntity === entity ? 'primary' : 'ghost'"
                        block
                        @click="selectEntity(entity)"
                    >{{ entity }}</ph-button>
                </ph-stack>
                <ph-text v-else color="muted" size="sm">No entities discovered.</ph-text>
            </ph-card>
        </ph-col>

        <ph-col span="12" md="8" lg="9">
            <ph-card>
                <template #header>
                    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="md">
                        <div>
                            <ph-text weight="semibold" size="lg" class="mb-0">
                                {{ currentEntity || 'Data Browser' }}
                            </ph-text>
                            <ph-text v-if="!loading && currentEntity" size="sm" color="muted" class="mb-0">
                                {{ total }} record(s) &middot; page {{ page }} of {{ lastPage }}
                            </ph-text>
                        </div>
                        <ph-badge v-if="currentEntity" label="REST" variant="info" pill />
                    </ph-flex>
                </template>

                <template v-if="!currentEntity">
                    <ph-text color="muted">Select an entity from the sidebar to inspect schema and records.</ph-text>
                </template>

                <template v-else-if="loading">
                    <ph-skeleton v-for="n in 4" :key="n" variant="text" width="100%" height="18" class="d-block mb-3" />
                </template>

                <template v-else>
                    <ph-input
                        v-model="query"
                        type="search"
                        placeholder="Search records..."
                        @keyup.enter="search"
                    />

                    <ph-data-table :columns="columns" :items="rows">
                        <template #empty>
                            <ph-text color="muted">
                                No records found{{ query ? ' for your search term.' : '.' }}
                            </ph-text>
                        </template>

                        <template v-for="field in boolFields" :key="field.name"
                                  v-slot:[`cell(${field.name})`]="{ value }">
                            <ph-badge :label="value ? 'Yes' : 'No'"
                                      :variant="value ? 'success' : 'secondary'" />
                        </template>

                        <template #cell(__actions)="{ row }">
                            <div class="d-flex gap-2">
                                <ph-button variant="outline" size="sm" @click="openEditModal(row)">Edit</ph-button>
                                <ph-button variant="danger" size="sm" @click="askDelete(row.id)">Delete</ph-button>
                            </div>
                        </template>
                    </ph-data-table>

                    <div v-if="lastPage > 1" class="d-flex justify-content-center mt-3">
                        <ph-pagination :current-page="page" :total-pages="lastPage" @page-change="onPageChange" />
                    </div>
                </template>
            </ph-card>
        </ph-col>
    </ph-row>

    <ph-modal v-model="showModal"
              :title="isEditing ? 'Edit ' + currentEntity : 'Create ' + currentEntity"
              size="lg">
        <ph-alert v-if="formError" variant="error" :message="formError" class="mb-3" />

        <form id="schii-record-form" novalidate @submit.prevent="submitForm">
            <ph-row gutter="3">
                <ph-col v-for="field in writableFields" :key="field.name" span="12" md="6">
                    <ph-input
                        v-if="isTextWidget(field)"
                        v-model="form[field.name]"
                        :type="inputType(field)"
                        :label="field.label || field.name"
                        :required="field.required"
                        :disabled="isEditing && field.name === 'id'"
                    />
                    <ph-select
                        v-else-if="field.type === 'select'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                        :options="selectOptions(field)"
                        :required="field.required"
                    />
                    <ph-textarea
                        v-else-if="field.widget === 'textarea'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                        :rows="3"
                        :required="field.required"
                    />
                    <ph-checkbox
                        v-else-if="field.type === 'boolean' || field.widget === 'checkbox'"
                        v-model="form[field.name]"
                        :label="field.label || field.name"
                    />
                </ph-col>
            </ph-row>
        </form>

        <template #footer>
            <ph-button variant="ghost" @click="closeModal">Cancel</ph-button>
            <ph-button variant="primary" :loading="submitting" @click="submitForm">Save</ph-button>
        </template>
    </ph-modal>

    <ph-modal v-model="confirmOpen" title="Confirm delete" size="sm">
        <ph-text>Are you sure you want to delete record #{{ pendingDeleteId }}? This cannot be undone.</ph-text>
        <template #footer>
            <ph-button variant="ghost" @click="confirmOpen = false">Cancel</ph-button>
            <ph-button variant="danger" @click="confirmDelete">Delete</ph-button>
        </template>
    </ph-modal>
</div>
</template>

<script type="module">
import { createApp, ref, reactive, computed, onMounted } from 'vue';

export default function mountApp() {
    window.__phueApp?.unmount?.();

    window.__phueApp = createApp({
        setup() {
            const PAGE_SIZE = 10;
            const apiPrefix = window.__INITIAL_STATE__?.apiPrefix || '/api/schii';

            const entities = ref([]);
            const loadingEntities = ref(true);
            const currentEntity = ref(null);
            const fields = ref([]);
            const rows = ref([]);
            const loading = ref(false);
            const errorMsg = ref(null);

            const page = ref(1);
            const lastPage = ref(1);
            const total = ref(0);
            const query = ref('');

            const columns = computed(() => [
                ...fields.value.map(f => ({ key: f.name, label: f.label || f.name })),
                { key: '__actions', label: 'Actions' },
            ]);

            const boolFields = computed(() =>
                fields.value.filter(f =>
                    f.type === 'boolean' || f.type === 'bool' || f.widget === 'checkbox'
                )
            );

            const writableFields = computed(() =>
                fields.value.filter(f => f.name !== 'id' && f.writable !== false)
            );

            const showModal = ref(false);
            const isEditing = ref(false);
            const activeId = ref(null);
            const submitting = ref(false);
            const formError = ref(null);
            const form = reactive({});

            const confirmOpen = ref(false);
            const pendingDeleteId = ref(null);

            const fetchEntities = async () => {
                loadingEntities.value = true;
                try {
                    const res = await fetch(`${apiPrefix}/schema`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    entities.value = Array.isArray(data) ? data : (data.entities || []);
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to discover entity schemas.';
                } finally {
                    loadingEntities.value = false;
                }
            };

            const loadSchema = async () => {
                try {
                    const res = await fetch(`${apiPrefix}/schema/${currentEntity.value}`);
                    if (res.ok) {
                        const data = await res.json();
                        fields.value = data.fields || [];
                    }
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to load schema.';
                }
            };

            const loadRows = async () => {
                if (!currentEntity.value) return;
                loading.value = true;
                try {
                    const params = new URLSearchParams({
                        page: String(page.value),
                        limit: String(PAGE_SIZE),
                    });
                    if (query.value.trim()) params.set('q', query.value.trim());

                    const res = await fetch(`${apiPrefix}/${currentEntity.value}?${params.toString()}`);
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || `HTTP ${res.status}`);
                    }
                    const data = await res.json();
                    rows.value = Array.isArray(data) ? data : (data.data || []);
                    const meta = data.meta || {};
                    total.value = typeof meta.total === 'number' ? meta.total : rows.value.length;
                    lastPage.value = Math.max(
                        1,
                        meta.last_page ?? meta.pages ?? Math.ceil(total.value / PAGE_SIZE)
                    );
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to load records.';
                    rows.value = [];
                } finally {
                    loading.value = false;
                }
            };

            const selectEntity = async (entity) => {
                if (currentEntity.value === entity) return;
                currentEntity.value = entity;
                page.value = 1;
                query.value = '';
                rows.value = [];
                fields.value = [];
                await Promise.all([loadSchema(), loadRows()]);
            };

            const onPageChange = (p) => {
                page.value = p;
                loadRows();
            };

            const search = () => {
                page.value = 1;
                loadRows();
            };

            const resetForm = () => {
                writableFields.value.forEach(f => {
                    if (f.type === 'boolean' || f.widget === 'checkbox') {
                        form[f.name] = false;
                    } else if (f.type === 'select' && Array.isArray(f.options) && f.options.length) {
                        const first = f.options[0];
                        form[f.name] = typeof first === 'object' ? (first.value ?? first) : first;
                    } else {
                        form[f.name] = '';
                    }
                });
                formError.value = null;
            };

            const openCreateModal = () => {
                isEditing.value = false;
                activeId.value = null;
                resetForm();
                showModal.value = true;
            };

            const openEditModal = (row) => {
                isEditing.value = true;
                activeId.value = row.id;
                resetForm();
                writableFields.value.forEach(f => {
                    form[f.name] = row[f.name] ?? '';
                });
                showModal.value = true;
            };

            const closeModal = () => {
                showModal.value = false;
            };

            const submitForm = async () => {
                submitting.value = true;
                formError.value = null;
                try {
                    const url = isEditing.value
                        ? `${apiPrefix}/${currentEntity.value}/${activeId.value}`
                        : `${apiPrefix}/${currentEntity.value}`;
                    const res = await fetch(url, {
                        method: isEditing.value ? 'PUT' : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(form),
                    });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || 'Failed to save record.');
                    }
                    closeModal();
                    await loadRows();
                } catch (err) {
                    formError.value = err?.message || 'Failed to save record.';
                } finally {
                    submitting.value = false;
                }
            };

            const askDelete = (id) => {
                pendingDeleteId.value = id;
                confirmOpen.value = true;
            };

            const confirmDelete = async () => {
                confirmOpen.value = false;
                if (pendingDeleteId.value == null) return;
                const id = pendingDeleteId.value;
                pendingDeleteId.value = null;
                try {
                    const res = await fetch(`${apiPrefix}/${currentEntity.value}/${id}`, { method: 'DELETE' });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.error || errData.message || 'Failed to delete record.');
                    }
                    await loadRows();
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to delete record.';
                }
            };

            const isTextWidget = (f) => !(f.type === 'select' || f.type === 'boolean' || f.type === 'bool' || f.widget === 'checkbox' || f.widget === 'textarea');

            const inputType = (f) =>
                f.type === 'integer' || f.type === 'int' || f.type === 'number' || f.type === 'float'
                    ? 'number'
                    : (f.type === 'email' ? 'email' : 'text');

            const selectOptions = (f) => {
                if (!Array.isArray(f.options)) return [];
                return f.options.map(o =>
                    typeof o === 'object'
                        ? { label: o.label ?? o.value, value: o.value, disabled: !!o.disabled }
                        : { label: String(o), value: o }
                );
            };

            onMounted(fetchEntities);

            return {
                entities,
                loadingEntities,
                currentEntity,
                fields,
                columns,
                boolFields,
                writableFields,
                rows,
                loading,
                errorMsg,
                page,
                lastPage,
                total,
                query,
                showModal,
                isEditing,
                submitting,
                formError,
                form,
                confirmOpen,
                pendingDeleteId,
                selectEntity,
                onPageChange,
                search,
                openCreateModal,
                openEditModal,
                closeModal,
                submitForm,
                askDelete,
                confirmDelete,
                isTextWidget,
                inputType,
                selectOptions,
            };
        }
    });

    window.__phueApp.mount('#app');
}

mountApp();
</script>