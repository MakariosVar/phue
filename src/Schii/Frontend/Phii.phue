<php>
$phiiState = $state ?? [];

return [
    'title' => 'Phii Console',
    'state' => [
        'apiPrefix' => $phiiState['apiPrefix'] ?? '/api/schii',
        'phiiPrefix' => $phiiState['phiiPrefix'] ?? '/phii',
        'phiiNamespace' => $phiiState['phiiNamespace'] ?? 'Phue\\Phii',
        'module' => $phiiState['module'] ?? 'admin',
    ],
    'scripts' => [],
];
</php>

<template>
<div class="phii-console p-4" v-cloak>
    <ph-flex direction="row" justify="space-between" align="center" wrap="wrap" gap="lg" class="mb-4">
        <div>
            <ph-heading :level="1" class="mb-0">Phii Generator Console</ph-heading>
            <ph-text color="muted">Generate CRUD, Models, Controllers, and Migrations</ph-text>
        </div>
        <ph-badge label="Schema-powered codegen" variant="info" pill />
    </ph-flex>

    <ph-alert
        v-if="errorMsg"
        variant="error"
        :message="errorMsg"
        dismissible
        class="mb-3"
        @dismiss="errorMsg = null"
    />
    <ph-alert
        v-if="successMsg"
        variant="success"
        :message="successMsg"
        dismissible
        class="mb-3"
        @dismiss="successMsg = null"
    />

    <ph-row gutter="3">
        <ph-col span="12" lg="6">
            <ph-card title="Generate" subtitle="Pick a generator and scaffold application code from your schema." hoverable>
                <form id="phii-generate-form" novalidate @submit.prevent="submitGenerate">
                    <ph-select
                        v-model="form.generator"
                        label="Generator Type"
                        :options="generatorOptions"
                        helper-text="Pick the artifact to scaffold."
                        required
                    />

                    <ph-input
                        v-model="form.entity"
                        label="Entity / Model Name"
                        placeholder="e.g. Profile"
                        helper-text="Resolved against the registered entity namespaces."
                        required
                    />

                    <ph-row gutter="3">
                        <ph-col span="12" md="6">
                            <ph-input v-model="form.module" label="Module" placeholder="admin" />
                        </ph-col>
                        <ph-col span="12" md="6">
                            <ph-input v-model="form.options" label="Options (JSON)" placeholder='{"driver": "sqlite"}' />
                        </ph-col>
                    </ph-row>

                    <div class="d-flex justify-content-end mt-2">
                        <ph-button type="submit" variant="primary" :loading="submitting">
                            Generate
                        </ph-button>
                    </div>
                </form>
            </ph-card>
        </ph-col>

        <ph-col span="12" lg="6">
            <ph-card title="Result" subtitle="Files generated by the last run." hoverable>
                <template v-if="resultPaths.length">
                    <ph-stack gap="xs">
                        <div
                            v-for="(path, i) in resultPaths"
                            :key="i"
                            class="d-flex align-items-start gap-2 border rounded p-2"
                        >
                            <ph-badge variant="success" label="OK" />
                            <ph-text size="sm" as="code" class="mb-0 text-break">{{ path }}</ph-text>
                        </div>
                    </ph-stack>
                </template>
                <ph-text v-else color="muted">
                    Generated file paths will appear here after a successful run.
                </ph-text>
            </ph-card>
        </ph-col>
    </ph-row>
</div>
</template>

<script type="module">
import { createApp, ref, reactive, computed } from 'vue';

export default function mountApp() {
    window.__phueApp?.unmount?.();

    window.__phueApp = createApp({
        setup() {
            const initialState = window.__INITIAL_STATE__ || {};
            const phiiPrefix = initialState.phiiPrefix || '/phii';

            const generators = ref(['crud', 'model', 'controller', 'migration', 'module']);
            const submitting = ref(false);
            const errorMsg = ref(null);
            const successMsg = ref(null);
            const resultPaths = ref([]);

            const form = reactive({
                generator: 'crud',
                entity: '',
                module: initialState.module || 'admin',
                options: '',
            });

            const generatorOptions = computed(() =>
                generators.value.map(g => ({ label: g.toUpperCase(), value: g }))
            );

            const parseOptions = () => {
                const raw = (form.options || '').trim();
                if (!raw) return {};
                try {
                    const parsed = JSON.parse(raw);
                    return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
                        ? parsed
                        : {};
                } catch {
                    errorMsg.value = 'Options must be valid JSON, e.g. {"auth": true}.';
                    return null;
                }
            };

            const submitGenerate = async () => {
                submitting.value = true;
                errorMsg.value = null;
                successMsg.value = null;

                const options = parseOptions();
                if (options === null) {
                    submitting.value = false;
                    return;
                }

                try {
                    const res = await fetch(`${phiiPrefix}/generate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            generator: form.generator,
                            entity: form.entity.trim(),
                            module: form.module.trim() || 'admin',
                            options,
                        }),
                    });

                    const data = await res.json().catch(() => ({}));

                    if (!res.ok) {
                        throw new Error(data.error || data.message || `HTTP ${res.status}`);
                    }

                    resultPaths.value = Array.isArray(data.paths)
                        ? data.paths
                        : (data.paths ? [data.paths] : []);
                    successMsg.value = resultPaths.value.length
                        ? `Generated ${resultPaths.value.length} file(s) successfully.`
                        : 'Generation completed successfully!';
                } catch (err) {
                    errorMsg.value = err?.message || 'Failed to execute generate action.';
                    resultPaths.value = [];
                } finally {
                    submitting.value = false;
                }
            };

            return {
                generators,
                generatorOptions,
                form,
                submitting,
                errorMsg,
                successMsg,
                resultPaths,
                submitGenerate,
            };
        }
    });

    window.__phueApp.mount('#app');
}

mountApp();
</script>