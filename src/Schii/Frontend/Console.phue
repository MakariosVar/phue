<php>
/**
 * Schii Console Server-Authoritative Logic & State
 *
 * @var string|null $apiPrefix Dynamic API route prefix passed from shell router.
 */
$title = 'Schii Console';

return [
    'title' => $title,
    'state' => [
        'apiPrefix' => $apiPrefix ?? '/api/schii',
        'entities'  => [],
    ],
    'scripts' => [],
];
</php>

<template>
    <div v-cloak class="schii-console">
        <header class="schii-header p-4 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="m-0">Schii Console</h1>
                <p class="m-0 text-body-secondary">Zero-Controller Dynamic REST Management Interface</p>
            </div>
            <button v-if="currentEntity" @click="openCreateModal" class="btn btn-primary">
                + New {{ currentEntity }}
            </button>
        </header>

        <main class="d-flex schii-content">
            <aside class="schii-sidebar p-4">
                <h3 class="m-0 p-2">Entities</h3>
                <div v-if="loadingEntities" class="schii-loading-sidebar p-2">
                    Discovering schemas...
                </div>
                <ul v-else class="m-0 p-0 d-flex flex-column gap-1 schii-entity-list">
                    <li
                        v-for="entity in entities"
                        :key="entity"
                        :class="{ active: currentEntity === entity }"
                        class="p-2 d-flex justify-content-between align-items-center"
                        style="cursor: pointer;"
                        @click="selectEntity(entity)"
                    >
                        {{ entity }}
                    </li>
                </ul>
            </aside>

            <section class="schii-main p-4">
                <div v-if="loading" class="schii-loading p-4">
                    Loading data...
                </div>

                <div v-else-if="currentEntity" class="schii-entity-view p-4">
                    <h2>{{ currentEntity }} Management</h2>

                    <div class="schii-table-container p-2">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th v-for="field in fields" :key="field.name">
                                            {{ field.label || field.name }}
                                        </th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="row in rows" :key="row.id || JSON.stringify(row)">
                                        <td v-for="field in fields" :key="field.name">
                                            {{ row[field.name] }}
                                        </td>
                                        <td class="d-flex gap-2">
                                            <button @click="openEditModal(row)" class="btn btn-sm btn-outline-secondary">Edit</button>
                                            <button @click="deleteRecord(row.id)" class="btn btn-sm btn-danger">Delete</button>
                                        </td>
                                    </tr>
                                    <tr v-if="rows.length === 0">
                                        <td :colspan="(fields.length || 1) + 1" class="text-center text-body-secondary p-4">
                                            No records found.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div v-else class="schii-placeholder p-4">
                    Select an entity from the sidebar to inspect schema and records.
                </div>
            </section>
        </main>

        <!-- Dynamic Modal for Form Store/Update -->
        <div v-if="showModal" class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3 class="modal-title">{{ isEditing ? 'Edit ' + currentEntity : 'Create ' + currentEntity }}</h3>
                        <button type="button" class="btn-close" @click="closeModal" aria-label="Close"></button>
                    </div>

                    <form @submit.prevent="submitForm">
                        <div class="modal-body">
                            <div v-for="field in writableFields" :key="field.name" class="mb-3">
                                <label class="form-label">{{ field.label || field.name }}</label>

                                <select
                                    v-if="field.type === 'select'"
                                    v-model="form[field.name]"
                                    class="form-select"
                                >
                                    <option v-for="(lbl, val) in field.options" :key="val" :value="val">{{ lbl }}</option>
                                </select>

                                <textarea
                                    v-else-if="field.type === 'textarea'"
                                    v-model="form[field.name]"
                                    class="form-control"
                                ></textarea>

                                <input
                                    v-else
                                    :type="field.type || 'text'"
                                    v-model="form[field.name]"
                                    class="form-control"
                                />
                            </div>

                            <div v-if="formError" class="alert alert-danger">{{ formError }}</div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" @click="closeModal" class="btn btn-outline-secondary">Cancel</button>
                            <button type="submit" :disabled="submitting" class="btn btn-primary">
                                {{ submitting ? 'Saving...' : 'Save' }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-backdrop fade show"></div>
        </div>
    </div>
</template>

<script type="module">
import { createApp, ref, computed, onMounted } from 'vue';

/**
 * Custom inline composable for managing dynamic entity reactive state & operations
 */
function useForm(initialFields = []) {
    const form = ref({});
    const submitting = ref(false);
    const formError = ref(null);

    const resetForm = (fields = [], initialData = {}) => {
        const formData = {};
        fields.forEach(field => {
            formData[field.name] = initialData[field.name] !== undefined ? initialData[field.name] : '';
        });
        form.value = formData;
        formError.value = null;
    };

    return { form, submitting, formError, resetForm };
}

export default function mountApp() {
    window.__phueApp?.unmount?.();

    window.__phueApp = createApp({
        setup() {
            const title = ref('Schii Console');
            const initialState = window.__INITIAL_STATE__ || {};
            const apiPrefix = initialState.apiPrefix || '/api/schii';

            const entities = ref([]);
            const loadingEntities = ref(true);
            const currentEntity = ref(null);
            const fields = ref([]);
            const rows = ref([]);
            const loading = ref(false);

            // Modal and form state
            const showModal = ref(false);
            const isEditing = ref(false);
            const activeId = ref(null);
            const { form, submitting, formError, resetForm } = useForm();

            const writableFields = computed(() => fields.value.filter(f => f.name !== 'id' && f.writable !== false));

            const fetchEntities = async () => {
                loadingEntities.value = true;
                try {
                    const res = await fetch(`${apiPrefix}/schema`);
                    if (res.ok) {
                        const data = await res.json();
                        entities.value = data.entities || [];
                    }
                } catch (err) {
                    console.error('Failed to discover entity schemas:', err);
                } finally {
                    loadingEntities.value = false;
                }
            };

            const selectEntity = async (entity) => {
                currentEntity.value = entity;
                loading.value = true;
                fields.value = [];
                rows.value = [];

                try {
                    const [schemaRes, dataRes] = await Promise.all([
                        fetch(`${apiPrefix}/schema/${entity}`),
                        fetch(`${apiPrefix}/${entity}`)
                    ]);

                    if (schemaRes.ok) {
                        const schemaData = await schemaRes.json();
                        fields.value = schemaData.fields || [];
                    }

                    if (dataRes.ok) {
                        const data = await dataRes.json();
                        rows.value = Array.isArray(data) ? data : (data.data || []);
                    }
                } catch (err) {
                    console.error(`Failed to fetch schema/data for ${entity}:`, err);
                } finally {
                    loading.value = false;
                }
            };

            const openCreateModal = () => {
                isEditing.value = false;
                activeId.value = null;
                resetForm(writableFields.value);
                showModal.value = true;
            };

            const openEditModal = (row) => {
                isEditing.value = true;
                activeId.value = row.id;
                resetForm(writableFields.value, row);
                showModal.value = true;
            };

            const closeModal = () => {
                showModal.value = false;
                formError.value = null;
            };

            const submitForm = async () => {
                submitting.value = true;
                formError.value = null;

                const url = isEditing.value
                    ? `${apiPrefix}/${currentEntity.value}/${activeId.value}`
                    : `${apiPrefix}/${currentEntity.value}`;

                const method = isEditing.value ? 'PUT' : 'POST';

                try {
                    const res = await fetch(url, {
                        method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(form.value)
                    });

                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        throw new Error(errData.message || 'Failed to save record.');
                    }

                    closeModal();
                    await selectEntity(currentEntity.value);
                } catch (err) {
                    formError.value = err.message;
                } finally {
                    submitting.value = false;
                }
            };

            const deleteRecord = async (id) => {
                if (!confirm(`Are you sure you want to delete this record?`)) return;

                try {
                    const res = await fetch(`${apiPrefix}/${currentEntity.value}/${id}`, { method: 'DELETE' });
                    if (!res.ok) {
                        const errData = await res.json().catch(() => ({}));
                        alert(errData.message || 'Failed to delete record.');
                        return;
                    }
                    await selectEntity(currentEntity.value);
                } catch (err) {
                    console.error('Delete error:', err);
                }
            };

            onMounted(() => {
                fetchEntities();
            });

            return {
                title,
                entities,
                loadingEntities,
                currentEntity,
                fields,
                writableFields,
                rows,
                loading,
                showModal,
                isEditing,
                form,
                submitting,
                formError,
                selectEntity,
                openCreateModal,
                openEditModal,
                closeModal,
                submitForm,
                deleteRecord,
            };
        }
    });

    window.__phueApp.mount('#app');
}

mountApp();
</script>