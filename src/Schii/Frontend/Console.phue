<php>
/**
 * Schii Console Server-Authoritative Logic & State
 */
$title = 'Schii Console';

$state = [
    'apiPrefix' => '/api/schii',
    'entities'  => [], // Dynamic discovery via GET /api/schii/schema
];

return [
    'title'   => $title,
    'state'   => $state,
    'scripts' => [],
];
</php>

<template>
    <div class="schii-console" id="app">
        <header class="schii-header p-4">
            <h1 v-text="title" class="m-0">Schii Console</h1>
            <p class="m-0">Zero-Controller Dynamic REST Management Interface</p>
        </header>

        <main class="d-flex schii-content">
            <aside class="schii-sidebar p-4">
                <h3 class="m-0 p-2">Entities</h3>
                <div v-if="loadingEntities" class="schii-loading-sidebar p-2">
                    Discovering schemas...
                </div>
                <ul v-else class="m-0 p-0 d-flex flex-column gap-1 schii-entity-list">
                    <li
                        v-for="entity in entities"
                        :key="entity"
                        :class="{ active: currentEntity === entity }"
                        class="p-2 d-flex justify-between items-center"
                        @click="selectEntity(entity)"
                    >
                        {{ entity }}
                    </li>
                </ul>
            </aside>

            <section class="schii-main p-4">
                <div v-if="loading" class="schii-loading p-4">
                    Loading data...
                </div>

                <div v-else-if="currentEntity" class="schii-entity-view p-4">
                    <h2>{{ currentEntity }} Management</h2>

                    <div class="schii-table-container p-2">
                        <table class="schii-table">
                            <thead>
                                <tr>
                                    <th v-for="field in fields" :key="field.name">
                                        {{ field.label || field.name }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="row in rows" :key="row.id || JSON.stringify(row)">
                                    <td v-for="field in fields" :key="field.name">
                                        {{ row[field.name] }}
                                    </td>
                                </tr>
                                <tr v-if="rows.length === 0">
                                    <td :colspan="fields.length || 1" class="schii-empty p-4">
                                        No records found.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div v-else class="schii-placeholder p-4">
                    Select an entity from the sidebar to inspect schema and records.
                </div>
            </section>
        </main>
    </div>
</template>

<script type="module">
import { createApp, ref, reactive, onMounted } from '/assets/vendor/vue3/vue.esm-browser.js';

createApp({
    setup() {
        const title = ref('Schii Console');

        // Read shell-injected initial state
        const initialState = window.__INITIAL_STATE__ || {};
        const apiPrefix = initialState.apiPrefix || '/api/schii';

        const entities = ref([]);
        const loadingEntities = ref(true);
        const currentEntity = ref(null);
        const fields = ref([]);
        const rows = ref([]);
        const loading = ref(false);

        // Fetch dynamic entity schemas from server on mount
        const fetchEntities = async () => {
            loadingEntities.value = true;
            try {
                const res = await fetch(`${apiPrefix}/schema`);
                if (res.ok) {
                    const data = await res.json();
                    entities.value = data.entities || [];
                }
            } catch (err) {
                console.error('Failed to discover entity schemas:', err);
            } finally {
                loadingEntities.value = false;
            }
        };

        // Select entity & fetch schema + rows concurrently
        const selectEntity = async (entity) => {
            currentEntity.value = entity;
            loading.value = true;
            fields.value = [];
            rows.value = [];

            try {
                const [schemaRes, dataRes] = await Promise.all([
                    fetch(`${apiPrefix}/schema/${entity}`),
                    fetch(`${apiPrefix}/${entity}`)
                ]);

                if (schemaRes.ok) {
                    const schemaData = await schemaRes.json();
                    fields.value = schemaData.fields || [];
                }

                if (dataRes.ok) {
                    const data = await dataRes.json();
                    rows.value = Array.isArray(data) ? data : (data.data || []);
                }
            } catch (err) {
                console.error(`Failed to fetch schema or data for ${entity}:`, err);
            } finally {
                loading.value = false;
            }
        };

        onMounted(() => {
            fetchEntities();
        });

        return {
            title,
            entities,
            loadingEntities,
            currentEntity,
            fields,
            rows,
            loading,
            selectEntity,
        };
    }
}).mount('#app');
</script>