<php>
use App\Config\NavigationConfig;

/**
 * @var string $content
 * @var string $uri
 * @var array $items
 * @var string $cacheKey
 * @var array $cache
 * @var \Phue\Core\UI\PhuePartialRenderer $partialRenderer
 * @var array|null $items
 */
$content = $content ?? '';
$uri = $uri ?? '/schii';
$items = $items ?? (class_exists(NavigationConfig::class) ? NavigationConfig::getSchiiItems() : []);
static $cache = [];
$cacheKey = 'nav_html_' . md5(serialize($items) . $uri);
    
if (isset($cache[$cacheKey])) {
    $navHtml = $cache[$cacheKey];
} else {
    $navHtml = $partialRenderer->renderPartial('PhNavigation', [
        'items' => $items,
        'uri'   => $uri
    ]);
    $cache[$cacheKey] = $navHtml;
}


return [
    'html' => sprintf(
        '<div class="schii-layout">%s<main class="schii-content">%s</main></div>',
        $navHtml,
        $content
    ),
];
</php>
<template>
<!-- Console.phue -->
</template>
