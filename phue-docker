#!/usr/bin/env bash

set -euo pipefail

COMPOSE_FILE="docker/dev/docker-compose.yml"
SERVICE_NAME="app"

# Usage helper
usage() {
    echo "Phue - Docker Compose Wrapper"
    echo ""
    echo "Usage: phue {up|start|down|build|restart|shell|logs|status|clean} [options]"
    echo ""
    echo "Commands:"
    echo "  up      : Safely start containers in detached mode"
    echo "  start   : Start containers and run Phue HTTP + Bun SSR servers"
    echo "  down    : Safely stop and remove containers"
    echo "  build   : Rebuild images without cache and recreate containers"
    echo "  restart : Safely stop containers (down) and start them back up"
    echo "  shell   : Attach to interactive bash shell inside '$SERVICE_NAME' container"
    echo "  logs    : Stream live logs (tail 100)"
    echo "  status  : View current container states"
    echo "  clean   : Stop containers AND purge associated volumes (destructive)"
    echo ""
    echo "Options (for start/restart):"
    echo "  -c, --clear-cache    Clear all caches once Bun is up"
    echo "  -o, --optimize       Warm all caches once Bun is up (skipped with a warning if it never starts)"
    echo "  -co, -oc             Both clear cache and optimize"
    exit 0
}

# Show help if no arguments are provided or if -h/--help is passed
if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
fi

# Pre-flight checks
if ! docker info > /dev/null 2>&1; then
    echo "❌ Error: Docker daemon is not running or permission denied."
    exit 1
fi

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "❌ Error: $COMPOSE_FILE not found at $COMPOSE_FILE"
    exit 1
fi

ACTION="$1"
shift || true

# Parse cache/optimize flags into CLEAR_CACHE / OPTIMIZE.
# Shared by start and restart — the two copies drifted apart once already.
parse_cache_flags() {
    CLEAR_CACHE=false
    OPTIMIZE=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--clear-cache)
                CLEAR_CACHE=true
                shift
                ;;
            -o|--optimize)
                OPTIMIZE=true
                shift
                ;;
            -co|-oc)
                CLEAR_CACHE=true
                OPTIMIZE=true
                shift
                ;;
            *)
                break
                ;;
        esac
    done
}

run_start() {
    # Defaulted here as well as in parse_cache_flags: `up` calls run_start
    # straight, and without these the -e flags below would expand to empty and
    # the subshell would compare "" against "true" and silently skip both steps.
    : "${CLEAR_CACHE:=false}"
    : "${OPTIMIZE:=false}"

    echo "🚀 Starting containers..."
    docker compose -f "$COMPOSE_FILE" up -d --remove-orphans

    # Pre-clean stale socket inside container before starting servers
    docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" rm -f /tmp/phue-ssr.sock

    # Optimization runs INSIDE the server subshell, after Bun is up.
    #
    # It used to run here, before the servers launched. Two problems: `optimize`
    # warms caches for a system whose SSR sidecar is not listening yet, so the
    # very first thing it measured was a cold path; and this function blocks on
    # the foreground `phue serve` below, so nothing scheduled after this point
    # could ever run within the same invocation.
    #
    # Passing the flags through the environment keeps the ordering explicit: the
    # subshell knows to warm the cache only once the socket is live.
    echo "⚡ Launching Phue HTTP & Bun SSR dev servers..."

    # CWD fix: run bun inside /app/ssr subshell
    # Export root environment variables to prevent relying on hardcoded fallbacks like SOCKET_PATH
    # Added grep -v to filter out Vue warnings from Bun SSR logs
    docker compose -f "$COMPOSE_FILE" exec \
        -e "PHUE_CLEAR_CACHE=$CLEAR_CACHE" \
        -e "PHUE_OPTIMIZE=$OPTIMIZE" \
        "$SERVICE_NAME" bash -c '
        trap "kill 0" EXIT SIGINT SIGTERM

        # Bring up Bun first: it is the sidecar the HTTP server depends on, and
        # the cache warm-up below is only meaningful once it answers.
        (
            cd /app/ssr && \
            [ -f /app/.env ] && set -o allexport && source /app/.env && set +o allexport
            NODE_ENV=production bun server.ts
        ) 2>&1 | grep --line-buffered -v "\[Vue warn\]" | sed "s/^/[BUN SSR]    /" &
        BUN_PID=$!

        if [[ "$PHUE_CLEAR_CACHE" == "true" ]]; then
            echo "🧹 Clearing cache..."
            php /app/phue cache:clear --type=all
        fi

        # Wait for the sidecar socket rather than sleeping a fixed interval: a
        # fixed sleep is either too short (optimize runs mid-boot, warming
        # nothing) or needlessly long on a fast host.
        SOCKET_PATH="${SSR_SOCKET:-/tmp/phue-ssr.sock}"
        for _ in $(seq 1 100); do
            [ -S "$SOCKET_PATH" ] && break
            sleep 0.1
        done

        if [[ "$PHUE_OPTIMIZE" == "true" ]]; then
            if [ -S "$SOCKET_PATH" ]; then
                echo "⚡ Optimizing caches..."
                php /app/phue optimize --type=all
            else
                echo "⚠️  Bun sidecar socket $SOCKET_PATH never appeared; skipping optimize."
                echo "   The servers keep running — start them and re-run with -o once Bun is up."
            fi
        fi

        ./phue serve 2>&1 | sed "s/^/[PHUE SERVE] /" &
        wait -n
    '
}

case "$ACTION" in
    up)
        echo "🚀 Starting containers..."
        docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
        echo "✅ Containers started successfully."
        ;;

    start)
        parse_cache_flags "$@"
        run_start "$@"
        ;;

    down)
        echo "🛑 Stopping containers..."
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        echo "✅ Containers stopped safely."
        ;;

    build)
        echo "🛠️ Rebuilding images and starting..."
        docker compose -f "$COMPOSE_FILE" build
        docker compose -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans
        echo "✅ Rebuild complete."
        ;;

    restart)
        parse_cache_flags "$@"
        echo "🔄 Stopping containers..."
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        echo "✅ Containers stopped."
        run_start "$@"
        ;;

    shell)
        echo "💻 Connecting to shell in '$SERVICE_NAME' container..."
        docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" bash
        ;;

    logs)
        echo "📜 Streaming logs (Press Ctrl+C to exit)..."
        docker compose -f "$COMPOSE_FILE" logs -f --tail=100
        ;;

    status)
        docker compose -f "$COMPOSE_FILE" ps
        ;;

    clean)
        read -p "⚠️ Are you sure you want to delete containers AND volumes? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            echo "🧹 Cleaning up containers, networks, and volumes..."
            docker compose -f "$COMPOSE_FILE" down -v --remove-orphans
            echo "✅ Cleanup complete."
        else
            echo "❌ Action cancelled."
        fi
        ;;

    *)
        echo "❌ Unknown command: $ACTION"
        echo ""
        usage
        ;;
esac