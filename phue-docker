#!/usr/bin/env bash

set -euo pipefail

COMPOSE_FILE="docker/dev/docker-compose.yml"
SERVICE_NAME="app"

# Usage helper
usage() {
    echo "Phue - Docker Compose Wrapper"
    echo ""
    echo "Usage: phue {up|start|down|build|restart|shell|logs|status|clean}"
    echo ""
    echo "Commands:"
    echo "  up      : Safely start containers in detached mode"
    echo "  start   : Start containers and run Phue HTTP + Bun SSR servers"
    echo "  down    : Safely stop and remove containers"
    echo "  build   : Rebuild images without cache and recreate containers"
    echo "  restart : Safely stop containers (down) and start them back up"
    echo "  shell   : Attach to interactive bash shell inside '$SERVICE_NAME' container"
    echo "  logs    : Stream live logs (tail 100)"
    echo "  status  : View current container states"
    echo "  clean   : Stop containers AND purge associated volumes (destructive)"
    exit 0
}

# Show help if no arguments are provided or if -h/--help is passed
if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
fi

# Pre-flight checks
if ! docker info > /dev/null 2>&1; then
    echo "❌ Error: Docker daemon is not running or permission denied."
    exit 1
fi

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "❌ Error: $COMPOSE_FILE not found at $COMPOSE_FILE"
    exit 1
fi

ACTION="$1"
shift || true

run_start() {
    echo "🚀 Starting containers..."
    docker compose -f "$COMPOSE_FILE" up -d --remove-orphans

    # Pre-clean stale socket inside container before starting servers
    docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" rm -f /tmp/phue-ssr.sock

    echo "⚡ Launching Phue HTTP & Bun SSR dev servers..."

    # CWD fix: run bun inside /app/ssr subshell
    # Added grep -v to filter out Vue warnings from Bun SSR logs
    docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" bash -c '
        trap "kill 0" EXIT SIGINT SIGTERM
        ./bin/phue serve 2>&1 | sed "s/^/[PHUE SERVE] /" &
        (cd /app/ssr && NODE_ENV=production bun server.ts) 2>&1 | grep --line-buffered -v "\[Vue warn\]" | sed "s/^/[BUN SSR]    /" &
        wait -n
    '
}

case "$ACTION" in
    up)
        echo "🚀 Starting containers..."
        docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
        echo "✅ Containers started successfully."
        ;;

    start)
        run_start "$@"
        ;;

    down)
        echo "🛑 Stopping containers..."
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        echo "✅ Containers stopped safely."
        ;;

    build)
        echo "🛠️ Rebuilding images and starting..."
        docker compose -f "$COMPOSE_FILE" build
        docker compose -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans
        echo "✅ Rebuild complete."
        ;;

    restart)
        echo "🔄 Stopping containers..."
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        echo "✅ Containers stopped."
        run_start "$@"
        ;;

    shell)
        echo "💻 Connecting to shell in '$SERVICE_NAME' container..."
        docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" bash
        ;;

    logs)
        echo "📜 Streaming logs (Press Ctrl+C to exit)..."
        docker compose -f "$COMPOSE_FILE" logs -f --tail=100
        ;;

    status)
        docker compose -f "$COMPOSE_FILE" ps
        ;;

    clean)
        read -p "⚠️ Are you sure you want to delete containers AND volumes? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            echo "🧹 Cleaning up containers, networks, and volumes..."
            docker compose -f "$COMPOSE_FILE" down -v --remove-orphans
            echo "✅ Cleanup complete."
        else
            echo "❌ Action cancelled."
        fi
        ;;

    *)
        echo "❌ Unknown command: $ACTION"
        echo ""
        usage
        ;;
esac