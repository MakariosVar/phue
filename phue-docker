#!/usr/bin/env bash

set -euo pipefail

COMPOSE_FILE="docker/dev/docker-compose.yml"
SERVICE_NAME="app"

# Usage helper
usage() {
    echo "Phue - Docker Compose Wrapper"
    echo ""
    echo "Usage: phue {up|start|down|build|restart|shell|exec|logs|watcher|status|clean} [options]"
    echo ""
    echo "Commands:"
    echo "  up      : Safely start containers in detached mode"
    echo "  start   : Start containers and run Phue HTTP + Bun SSR servers"
    echo "  down    : Safely stop and remove containers"
    echo "  build   : Rebuild images without cache and recreate containers"
    echo "  restart : Safely stop containers (down) and start them back up"
    echo "  shell   : Attach to interactive bash shell inside '$SERVICE_NAME' container"
    echo "  exec    : Execute a command inside the 'phue_app' container"
    echo "  logs    : Stream container logs (tail 100)"
    echo "  watcher : Stream Phue HTTP & Bun SSR server logs (tail 100)"
    echo "  status  : View current container states"
    echo "  clean   : Stop containers AND purge associated volumes (never your vendor/)"
    echo ""
    echo "Options (for start/restart):"
    echo "  -d, --detach         Run servers in detached mode (background)"
    echo "  -c, --clear-cache    Clear all caches once Bun is up"
    echo "  -o, --optimize       Warm all caches once Bun is up (skipped with a warning if it never starts)"
    echo "  Short options can be combined, e.g. -cod, -co, -d"
    exit 0
}

# Show help if no arguments are provided or if -h/--help is passed
# Only when executed directly, not sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        usage
    fi
fi

# Only run main logic when executed directly, not sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    # Pre-flight checks
    if ! docker info > /dev/null 2>&1; then
        echo "❌ Error: Docker daemon is not running or permission denied."
        exit 1
    fi

    if [ ! -f "$COMPOSE_FILE" ]; then
        echo "❌ Error: $COMPOSE_FILE not found at $COMPOSE_FILE"
        exit 1
    fi

    ACTION="$1"
    shift || true

# Parse flags (detach, cache, optimize) into CLEAR_CACHE / OPTIMIZE / DETACH.
# Shared by start and restart — supports combinations like -cod, -do, etc.
parse_flags() {
    CLEAR_CACHE=false
    OPTIMIZE=false
    DETACH=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clear-cache)
                CLEAR_CACHE=true
                shift
                ;;
            --optimize)
                OPTIMIZE=true
                shift
                ;;
            -d|--detach|--detached)
                DETACH=true
                shift
                ;;
            -[a-zA-Z]*)
                local flags="${1#-}"
                for (( i=0; i<${#flags}; i++ )); do
                    case "${flags:i:1}" in
                        c) CLEAR_CACHE=true ;;
                        o) OPTIMIZE=true ;;
                        d) DETACH=true ;;
                        *)
                            echo "❌ Unknown option: -${flags:i:1}"
                            exit 1
                            ;;
                    esac
                done
                shift
                ;;
            *)
                break
                ;;
        esac
    done
}

run_start() {
    # Defaulted here as well as in parse_flags: `up` calls run_start
    # straight, and without these the -e flags below would expand to empty.
    : "${CLEAR_CACHE:=false}"
    : "${OPTIMIZE:=false}"
    : "${DETACH:=false}"

    echo "🚀 Starting containers..."
    docker compose -f "$COMPOSE_FILE" up -d --remove-orphans

    # Pre-clean stale socket inside container before starting servers
    docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" rm -f /tmp/phue-ssr.sock

    # Ensure log directory and log file exist on host
    mkdir -p storage/logs
    touch storage/logs/servers.log

    local EXEC_DETACH_FLAG=""
    if [[ "$DETACH" == "true" ]]; then
        EXEC_DETACH_FLAG="-d"
        echo "⚡ Launching Phue HTTP & Bun SSR dev servers (detached)..."
    else
        echo "⚡ Launching Phue HTTP & Bun SSR dev servers..."
    fi

    # Optimization runs INSIDE the server subshell, after Bun is up.
    # Passing the flags through the environment keeps the ordering explicit.
    #
    # When DETACH is true, output redirects to /app/storage/logs/servers.log.
    # When false, output is displayed live in the terminal and tee'd to servers.log.
    docker compose -f "$COMPOSE_FILE" exec \
        $EXEC_DETACH_FLAG \
        -e "PHUE_CLEAR_CACHE=$CLEAR_CACHE" \
        -e "PHUE_OPTIMIZE=$OPTIMIZE" \
        -e "PHUE_DETACH=$DETACH" \
        "$SERVICE_NAME" bash -c '
        trap "kill 0" EXIT SIGINT SIGTERM
        LOG_FILE="/app/storage/logs/servers.log"

        run_bun() {
            (
                cd /app/ssr && \
                [ -f /app/.env ] && set -o allexport && source /app/.env && set +o allexport
                NODE_ENV=production bun server.ts
            ) 2>&1 | grep --line-buffered -v "\[Vue warn\]" | sed "s/^/[BUN SSR]    /"
        }

        run_serve() {
            ./phue serve 2>&1 | sed "s/^/[PHUE SERVE] /"
        }

        if [[ "$PHUE_DETACH" == "true" ]]; then
            run_bun >> "$LOG_FILE" 2>&1 &
            BUN_PID=$!

            if [[ "$PHUE_CLEAR_CACHE" == "true" ]]; then
                echo "🧹 Clearing cache..." >> "$LOG_FILE"
                php /app/phue cache:clear --type=all >> "$LOG_FILE" 2>&1
            fi

            SOCKET_PATH="${SSR_SOCKET:-/tmp/phue-ssr.sock}"
            for _ in $(seq 1 100); do
                [ -S "$SOCKET_PATH" ] && break
                sleep 0.1
            done

            if [[ "$PHUE_OPTIMIZE" == "true" ]]; then
                if [ -S "$SOCKET_PATH" ]; then
                    echo "⚡ Optimizing caches..." >> "$LOG_FILE"
                    php /app/phue optimize --type=all >> "$LOG_FILE" 2>&1
                else
                    echo "⚠️  Bun sidecar socket $SOCKET_PATH never appeared; skipping optimize." >> "$LOG_FILE"
                fi
            fi

            run_serve >> "$LOG_FILE" 2>&1 &
            wait -n
        else
            run_bun | tee -a "$LOG_FILE" &
            BUN_PID=$!

            if [[ "$PHUE_CLEAR_CACHE" == "true" ]]; then
                echo "🧹 Clearing cache..." | tee -a "$LOG_FILE"
                php /app/phue cache:clear --type=all 2>&1 | tee -a "$LOG_FILE"
            fi

            SOCKET_PATH="${SSR_SOCKET:-/tmp/phue-ssr.sock}"
            for _ in $(seq 1 100); do
                [ -S "$SOCKET_PATH" ] && break
                sleep 0.1
            done

            if [[ "$PHUE_OPTIMIZE" == "true" ]]; then
                if [ -S "$SOCKET_PATH" ]; then
                    echo "⚡ Optimizing caches..." | tee -a "$LOG_FILE"
                    php /app/phue optimize --type=all 2>&1 | tee -a "$LOG_FILE"
                else
                    echo "⚠️  Bun sidecar socket $SOCKET_PATH never appeared; skipping optimize." | tee -a "$LOG_FILE"
                    echo "   The servers keep running — start them and re-run with -o once Bun is up." | tee -a "$LOG_FILE"
                fi
            fi

            run_serve | tee -a "$LOG_FILE" &
            wait -n
        fi
    '

    if [[ "$DETACH" == "true" ]]; then
        echo "✅ Servers running in detached mode."
        echo "💡 Run './phue-docker watcher' to inspect logs."
    fi
}

case "$ACTION" in
    up)
        echo "🚀 Starting containers..."
        docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
        echo "✅ Containers started successfully."
        ;;

    start)
        parse_flags "$@"
        run_start "$@"
        ;;

    down)
        echo "🛑 Stopping containers..."
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        echo "✅ Containers stopped safely."
        ;;

    build)
        echo "🛠️ Rebuilding images and starting..."
        # Dependencies are not in a volume any more: /app is the host's working
        # tree, so vendor/ and ssr/node_modules/ are the host's own directories
        # and the IDE indexes exactly what the container runs. Nothing to purge
        # before a rebuild, and nothing here may delete them — `down -v` would be
        # aimed at a directory the developer works in, not at scratch state.
        #
        # What the volumes used to guarantee is kept by installing after the
        # build instead: add a dependency to composer.json, rebuild, and the
        # container serves the tree the build just wrote. That write lands on the
        # host tree through the bind mount, which is the point — one copy.
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        docker compose -f "$COMPOSE_FILE" build
        docker compose -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans
        docker compose -f "$COMPOSE_FILE" exec -T "$SERVICE_NAME" bash -c '
            set -e
            composer install --no-interaction --no-progress
            cd /app/ssr && bun install
        '
        echo "✅ Rebuild complete."
        # Reload completions on host and in container after rebuild
        if [[ -f "$(dirname "${BASH_SOURCE[0]}")/phue-source" ]]; then
            source "$(dirname "${BASH_SOURCE[0]}")/phue-source"
            echo "  ✓ Host completions reloaded"
        fi
        docker exec phue_app bash -c "source /app/phue-source" 2>/dev/null && echo "  ✓ Container completions reloaded"
        ;;

    restart)
        parse_flags "$@"
        echo "🔄 Stopping containers..."
        docker compose -f "$COMPOSE_FILE" down --remove-orphans
        echo "✅ Containers stopped."
        run_start "$@"
        ;;

    shell)
        echo "💻 Connecting to shell in '$SERVICE_NAME' container..."
        docker compose -f "$COMPOSE_FILE" exec "$SERVICE_NAME" bash
        ;;

    exec)
        if [[ $# -eq 0 ]]; then
            echo "❌ Error: No command specified."
            echo "Usage: ./phue-docker exec {command}"
            exit 1
        fi

        docker exec phue_app "$@"
        ;;

    logs)
        echo "📜 Streaming logs (Press Ctrl+C to exit)..."
        docker compose -f "$COMPOSE_FILE" logs -f --tail=100
        ;;

    watcher)
        echo "📜 Streaming servers logs (Press Ctrl+C to exit)..."
        mkdir -p storage/logs
        touch storage/logs/servers.log
        tail -f -n 100 storage/logs/servers.log
        ;;

    status)
        docker compose -f "$COMPOSE_FILE" ps
        ;;

    clean)
        read -p "⚠️ Are you sure you want to delete containers AND volumes? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            echo "🧹 Cleaning up containers, networks, and volumes..."
            # `down -v` still runs: it clears any volume left behind by an older
            # checkout. It cannot reach vendor/ or node_modules/ — those are the
            # working tree now, mounted from the host, and no volume in this
            # project is mounted over them.
            docker compose -f "$COMPOSE_FILE" down -v --remove-orphans
            echo "✅ Cleanup complete. Your vendor/ and node_modules/ are untouched."
        else
            echo "❌ Action cancelled."
        fi
        ;;
*)

        echo "❌ Unknown command: $ACTION"
        echo ""
        usage
        ;;
esac
fi

# Auto-completion for bash/zsh
# Usage: source ./phue-docker && complete -F _phue_docker_complete phue-docker
# Or add to .bashrc: source /path/to/phue-docker
if [[ "${BASH_SOURCE[0]}" != "${0}" ]] || [[ -n "${ZSH_VERSION:-}" ]]; then
    _phue_docker_complete() {
        local cur prev opts
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        opts="up start down build restart shell exec logs watcher status clean"

        # Sub-command options
        if [[ "$prev" == "exec" ]]; then
            # Could complete with docker commands, but keep simple
            return 0
        fi

        if [[ "$prev" == "start" || "$prev" == "restart" ]]; then
            local subopts="--detach --clear-cache --optimize -d -c -o"
            COMPREPLY=( $(compgen -W "${subopts}" -- "${cur}") )
            return 0
        fi

        if [[ "${cur}" == -* ]]; then
            local flagopts="--detach --clear-cache --optimize --help -d -c -o -h"
            COMPREPLY=( $(compgen -W "${flagopts}" -- "${cur}") )
            return 0
        fi

        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    }

    if [[ -n "${ZSH_VERSION:-}" ]]; then
        compdef _phue_docker_complete phue-docker
        compdef _phue_docker_complete ./phue-docker
    else
        complete -F _phue_docker_complete phue-docker
        complete -F _phue_docker_complete ./phue-docker
    fi
fi