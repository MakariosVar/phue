  },
  "ph-script": {
    "prefix": "ph-script",
    "body": [
      "<script>",
      "  export default {",
      "    setup() {",
      "      $1",
      "    }",
      "  };",
      "</script>"
    ],
    "description": "Insert a <script> block with a Vue Options/Composition wrapper"
  },
  "ph-script-composition": {
    "prefix": "ph-script-comp",
    "body": [
      "<script>",
      "import { ref, computed, onMounted } from 'vue';",
      "export default {",
      "  setup() {",
      "    const $1 = ref($2);",
      "    ",
      "    onMounted(() => {",
      "      $3",
      "    });",
      "    ",
      "    return {",
      "      $1",
      "    };",
      "  }",
      "};",
      "</script>"
    ],
    "description": "Insert a <script> block with Vue Composition API"
  },
