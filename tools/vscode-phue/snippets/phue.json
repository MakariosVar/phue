{
  "phue": {
    "prefix": "phue",
    "body": [
      "<template>",
      "  ${1:<!-- page content -->}",
      "</template>",
      "",
      "<script>",
      "  ${2:export default { setup() {} }}",
      "</script>",
      "",
      "<php>",
      "  return [",
      "      'state' => [",
      "          $1",
      "      ],",
      "  ];",
      "</php>"
    ],
    "description": "Create a new .phue single-file component"
  },
  "phue-page": {
    "prefix": "phue-page",
    "body": [
      "<php>",
      "use App\\Config\\NavigationConfig;",
      "use Phue\\Modules\\Auth\\IdentityInterface;",
      "",
      "/**",
      " * ${1:PageName} Page",
      " *",
      " * @var string \$content",
      " * @var IdentityInterface|null \$user",
      " * @var string \$uri",
      " * @return array{html: string}",
      " */",
      "",
      "\$title = \$title ?? '${1:Page Title}';",
      "\$content = \$content ?? '';",
      "\$user = \$user ?? null;",
      "\$uri = \$uri ?? '/';",
      "",
      "return [",
      "    'title' => \$title,",
      "    'state' => [",
      "        'content' => \$content,",
      "        'user' => \$user,",
      "        'uri' => \$uri,",
      "    ],",
      "    'scripts' => [],",
      "];",
      "</php>",
      "<template>",
      "  <div class=\"container py-4\">",
      "    <ph-heading :level=\"2\">{{ title }}</ph-heading>",
      "    <div v-html=\"content\" />",
      "  </div>",
      "</template>",
      "<script>",
      "export default {",
      "  name: '${1:PageName}',",
      "  props: ['title', 'content', 'user', 'uri'],",
      "  setup() {",
      "    return {};",
      "  }",
      "};",
      "</script>"
    ],
    "description": "Create a new Phue page component with layout"
  },
  "ph-template": {
    "prefix": "ph-template",
