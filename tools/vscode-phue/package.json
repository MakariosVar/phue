{
  "name": "phue-vscode",
  "displayName": "Phue Language Support",
  "description": "Syntax highlighting, snippets, PHP linting, and Vue/Volar autodiscovery for .phue single-file components.",
  "version": "0.2.0",
  "publisher": "phue",
  "license": "MIT",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:phue",
    "workspaceContains:**/*.phue"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "phue",
    "vue",
    "php",
    "volar",
    "single-file-component"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "phue",
        "aliases": [
          "Phue",
          "phue"
        ],
        "extensions": [
          ".phue"
        ],
        "icon": {
          "light": "./media/Phue.svg",
          "dark": "./media/Phue.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phue",
        "scopeName": "source.phue",
        "path": "./syntaxes/phue.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.vue": "html",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.php": "php",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "phue",
        "path": "./snippets/phue.json"
      }
    ],
    "html": {
      "customData": [
        "./custom-data/phui-custom-data.json"
      ]
    },
    "commands": [
      {
        "command": "phue.generateTypes",
        "title": "Phue: Generate Component Type Definitions for Volar",
        "category": "Phue"
      },
      {
        "command": "phue.configureVolar",
        "title": "Phue: Configure Workspace for Vue Volar",
        "category": "Phue"
      },
      {
        "command": "phue.refreshComponents",
        "title": "Phue: Refresh Auto-discovered Components",
        "category": "Phue"
      }
    ],
    "configuration": {
      "title": "Phue",
      "properties": {
        "phue.volar.autoGenerateTypes": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate .phue/phue-components.d.ts for Vue Volar autodiscovery support."
        },
        "phue.php.validate": {
          "type": "boolean",
          "default": true,
          "description": "Lint PHP syntax inside <php> blocks."
        },
        "phue.php.maxPhpBlocks": {
          "type": "number",
          "default": 1,
          "description": "Maximum number of <php> blocks allowed per .phue file (default: 1)."
        },
        "phue.components.autoDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan and index PhUI and App .phue components in workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "generate-data": "php scripts/generate-custom-data.php"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.8.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
