APP_NAME="Phue App"
APP_ENV=development
APP_DEBUG=true
APP_DEV_TOOL=false

SSR_ENABLED=true
SCHII_ENABLED=true
META_DESCRIPTION="Almost a framework"
SSR_MAX_PAYLOAD_KB=512

# MYSQL
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=phue_sql
DB_USERNAME=root
DB_PASSWORD=

