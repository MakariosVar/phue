APP_NAME="Phue App"
APP_ENV=development
APP_VERSION=0.0.1
APP_DEBUG=true
APP_DEV_TOOL=false
APP_WEBSOCKET=true

# Application secret. Signs CSRF tokens (and any future secret-derived value).
# Generate with: ./phue generate:key
# Rotating it invalidates every token issued under the old key.
APP_KEY=

SSR_ENABLED=true
SCHII_ENABLED=true
META_DESCRIPTION="Almost a framework"
SSR_MAX_PAYLOAD_KB=2048

# MYSQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=phue_sql
DB_USERNAME=root
DB_PASSWORD=

# SQLITE
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=/app/database/phue.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0