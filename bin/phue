#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Phue\Core\Console\Application;
use Phue\Core\Console\Commands\ServeCommand;
use Phue\Core\Console\Commands\MakeControllerCommand;
use Phue\Core\Console\Commands\MakeModelCommand;

$app = new Application('1.0.0');

// Register Framework Commands
$app->add(new ServeCommand())
    ->add(new MakeControllerCommand())
    ->add(new MakeModelCommand());

exit($app->run($_SERVER['argv']));