#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Phue Framework CLI Launcher
 */

require __DIR__ . '/../vendor/autoload.php';

use Phue\Core\Console\Application;
use Phue\Core\Config;
use Phue\Core\Module;
use Phue\Core\Console\Commands\DeployCommand;
use Phue\Core\Console\Commands\MakeControllerCommand;
use Phue\Core\Console\Commands\MakeMigrationCommand;
use Phue\Core\Console\Commands\MakeModelCommand;
use Phue\Core\Console\Commands\MigrateCommand;
use Phue\Core\Console\Commands\MigrateRollbackCommand;
use Phue\Core\Console\Commands\SchiiMigrateCommand;
use Phue\Core\Console\Commands\ServeCommand;
use Phue\Core\Console\Commands\SwooleServeCommand;
use Phue\Modules\Schii\Commands\SchiiExportCommand;
use Phue\Modules\Schii\Commands\SchiiServeCommand;
use Phue\Modules\Schii\SchiiModule;
use Phue\Core\Console\Commands\NpmInstallCommand;
use Phue\Core\Console\Commands\NpmRemoveCommand;
use Phue\Core\Console\Commands\NpmListCommand;

$basePath = dirname(__DIR__);
$config = new Config($basePath . '/config');
$modules = (array) $config->get('app.modules', []);

$app = new Application('1.0.0');

/**
 * Register framework CLI commands into application engine container.
 */
$app
    ->add(new ServeCommand())
    ->add(new MakeControllerCommand())
    ->add(new MakeModelCommand())
    ->add(new MakeMigrationCommand())
    ->add(new MigrateCommand())
    ->add(new MigrateRollbackCommand())
    ->add(new DeployCommand())
    ->add(new NpmInstallCommand())
    ->add(new NpmRemoveCommand())
    ->add(new NpmListCommand());

// SwooleServeCommand
$app->add(new SwooleServeCommand());

// Module-specific commands
foreach ($modules as $moduleClass) {
    if (!class_exists($moduleClass)) {
        fwrite(STDERR, "Module $moduleClass not found" . PHP_EOL);
        continue;
    }
    /** @var Module $module */
    $module = new $moduleClass();
    $module->registerCommands($app);
}

exit($app->run($_SERVER['argv']));