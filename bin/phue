#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Phue Framework CLI Launcher
 */

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];
$autoloadPath = null;
if (isset($_composer_autoload_path) && file_exists($_composer_autoload_path)) {
    $autoloadPath = $_composer_autoload_path;
} else {
    foreach ($autoloadCandidates as $candidate) {
        if (file_exists($candidate)) {
            $autoloadPath = $candidate;
            break;
        }
    }
}

if ($autoloadPath === null) {
    fwrite(STDERR, "Unable to find composer autoloader." . PHP_EOL);
    exit(1);
}

require $autoloadPath;

use Phue\Core\Console\Application;
use Phue\Core\Console\PathResolver;
use Phue\Core\Config;
use Phue\Core\Env;
use Phue\Core\Module;
use Phue\Core\Console\Commands\NewProjectCommand;
use Phue\Core\Console\Commands\NewAppCommand;
use Phue\Core\Console\Commands\DeployCommand;
use Phue\Core\Console\Commands\ModuleListCommand;
use Phue\Core\Console\Commands\ModuleNewCommand;
use Phue\Core\Console\Commands\MakeControllerCommand;
use Phue\Core\Console\Commands\MakeMigrationCommand;
use Phue\Core\Console\Commands\MakeModelCommand;
use Phue\Core\Console\Commands\MigrateCommand;
use Phue\Core\Console\Commands\MigrateRollbackCommand;
use Phue\Core\Console\Commands\ServeCommand;
use Phue\Core\Console\Commands\NpmInstallCommand;
use Phue\Core\Console\Commands\NpmRemoveCommand;
use Phue\Core\Console\Commands\NpmListCommand;
use Phue\Core\Console\Commands\CacheClearCommand;
use Phue\Core\Console\Commands\OptimizeCommand;
use Phue\Core\Console\Commands\GenerateKeyCommand;
use Phue\Core\Console\Commands\RouteCacheCommand;
use Phue\Core\Console\Commands\RouteClearCommand;
use Phue\Core\Console\CommandInterface;

$basePath = PathResolver::resolveBasePath();
if (file_exists($basePath . '/.env')) {
    Env::load($basePath);
}
$config = new Config($basePath . '/config');
$modules = (array) $config->get('app.modules', []);

$app = new Application('1.0.0');

/**
 * Register framework CLI commands into application engine container.
 */
$app
    ->add(new NewProjectCommand())
    ->add(new NewAppCommand())
    ->add(new ServeCommand())
    ->add(new MakeControllerCommand())
    ->add(new MakeModelCommand())
    ->add(new MakeMigrationCommand())
    ->add(new MigrateCommand())
    ->add(new MigrateRollbackCommand())
    ->add(new DeployCommand())
    ->add(new ModuleListCommand())
    ->add(new ModuleNewCommand())
    ->add(new NpmInstallCommand())
    ->add(new NpmRemoveCommand())
    ->add(new NpmListCommand())
    ->add(new CacheClearCommand())
    ->add(new OptimizeCommand())
    ->add(new RouteCacheCommand())
    ->add(new RouteClearCommand())
    ->add(new GenerateKeyCommand());

// Module-specific commands
foreach ($modules as $moduleClass) {
    if (!class_exists($moduleClass)) {
        fwrite(STDERR, "Module $moduleClass not found" . PHP_EOL);
        continue;
    }
    /** @var Module $module */
    $module = new $moduleClass();
    $module->registerCommands($app);
}

// Auto-discover user commands from configured commands directory or App/Commands/
$commandsDir = (string) $config->get('app.commands_path', $basePath . '/App/Commands');
if (is_dir($commandsDir)) {
    $commandsNamespace = (string) $config->get('app.commands_namespace', 'App\\Commands');
    foreach (glob($commandsDir . '/*.php') ?: [] as $file) {
        $className = rtrim($commandsNamespace, '\\') . '\\' . basename($file, '.php');
        if (class_exists($className) && is_subclass_of($className, CommandInterface::class)) {
            $app->add(new $className());
        }
    }
}

exit($app->run($_SERVER['argv']));