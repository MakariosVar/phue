<template>
  <example-factory
    tag="<ph-breadcrumb />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Crumbs; the last item is <code>active</code> with <code>aria-current="page"</code>.
        Only non-active items with an <code>href</code> render as links.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-breadcrumb
          :items="[
            { label: 'Home', href: '/' },
            { label: 'PhUI', href: '/phui' },
            { label: 'Navigation' },
          ]" 
        />
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhBreadcrumb",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-breadcrumb
  :items="[
    { label: 'Home', href: '/' },
    { label: 'PhUI', href: '/phui' },
    { label: 'Navigation' },
  ]" 
/>`,
      propsData: [
        {
          name: "items",
          type: "Array",
          default: "[]",
          notes: "<code>{ label }</code> (required) + optional <code>href</code>",
        },
      ],
    };
  }
};
</script>
