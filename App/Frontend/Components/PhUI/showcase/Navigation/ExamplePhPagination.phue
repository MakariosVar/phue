<template>
  <example-factory
    tag="<ph-pagination />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Ellipsised pager (<code>…</code>) when <code>totalPages > maxVisible</code>.
        </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h5 class="text-center">{{ page }} of {{ lastPage }}</h5>
        <ph-pagination v-model:current-page="page" :total-pages="lastPage" :max-visible="6" />
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhPagination",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      page: 1,
      lastPage: 10,
      snippet: `<ph-pagination v-model:current-page="page" :total-pages="lastPage" :max-visible="6" />`,
      propsData: [
        {
          name: "currentPage",
          type: "Number",
          default: "1",
          notes: "",
        },
        {
          name: "totalPages",
          type: "Number",
          default: "required",
          notes: "",
        },
        {
          name: "maxVisible",
          type: "Number",
          default: "5",
          notes: "Window of page buttons around current",
        }
      ]
    };
  }
};
</script>
