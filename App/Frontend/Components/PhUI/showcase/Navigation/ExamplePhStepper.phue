<template>
  <example-factory
    tag="<ph-stepper />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Step wizard with horizontal/vertical layout, linear/non-linear, clickable steps.
      </p>
      <p>
        The component renders the indicators only — the panel body is the caller's, through the
        scoped <code>default</code> slot. Steps are real
        <code>&lt;button type="button"&gt;</code>s, so they are reachable by Tab and activate with
        Enter/Space; a <code>disabled</code> step leaves the tab order entirely.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <div class="mb-4">
          <ph-stepper
            v-model="step"
            :steps="steps"
            clickable
          >
            <!-- The panel body is yours: the slot hands over the active step. -->
            <template #default="{ activeStep, steps: allSteps }">
              <div class="p-3 rounded border bg-body-tertiary">
                <h5 class="mb-1">{{ allSteps[activeStep].label }}</h5>
                <p class="small text-body-secondary mb-3">{{ allSteps[activeStep].description }}</p>
                <div class="d-flex gap-2">
                  <ph-button size="sm" variant="outline-secondary" :disabled="activeStep === 0" @click="go(activeStep - 1)">
                    Back
                  </ph-button>
                  <ph-button
                    size="sm"
                    :disabled="activeStep === allSteps.length - 1"
                    @click="go(activeStep + 1)"
                  >
                    Next
                  </ph-button>
                </div>
              </div>
            </template>
          </ph-stepper>
        </div>

        <ph-divider variant="primary" />

        <h6 class="fw-semibold mt-4 mb-2">Vertical &amp; non-linear</h6>
        <p class="small text-body-secondary">
          <code>linear</code> is on by default, so only the next step is reachable. Turn it off and
          any completed step can be jumped back to; <code>disabled</code> still refuses.
        </p>
        <ph-stepper
          v-model="freeStep"
          :steps="steps"
          orientation="vertical"
          :linear="false"
          clickable
        />
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="my-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <h4>Emits</h4>
        <ul>
          <li><code>update:modelValue</code></li>
          <li><code>change</code></li>
        </ul>
        <h4>Slots</h4>
        <ul>
          <li><code>default</code> — scoped <code>{ activeStep, steps, goToStep }</code></li>
        </ul>
        <h5>
          Nothing here needs an external stylesheet: the indicator geometry and the connector are
          bound inline styles, and the rest is Bootstrap utilities.
        </h5>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhStepper",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      step: 0,
      freeStep: 1,
      steps: [
        { key: "account", label: "Account", description: "Email and password" },
        { key: "profile", label: "Profile", description: "Name, avatar, bio" },
        { key: "review", label: "Review", description: "Check and confirm" },
        { key: "done", label: "Done", description: "Back to the dashboard", disabled: true }
      ],
      snippet: `<ph-stepper
    v-model="step"
    :steps="steps"
    clickable
  >
    <!-- The panel body is yours: the slot hands over the active step. -->
    <template #default="{ activeStep, steps: allSteps }">
      <div class="p-3 rounded border bg-body-tertiary">
        <h5 class="mb-1">{{ allSteps[activeStep].label }}</h5>
        <p class="small text-body-secondary mb-3">{{ allSteps[activeStep].description }}</p>
        <div class="d-flex gap-2">
          <ph-button size="sm" variant="outline-secondary" :disabled="activeStep === 0" @click="go(activeStep - 1)">
            Back
          </ph-button>
          <ph-button
            size="sm"
            :disabled="activeStep === allSteps.length - 1"
            @click="go(activeStep + 1)"
          >
            Next
          </ph-button>
        </div>
      </div>
    </template>
  </ph-stepper>
</div>

<ph-divider variant="primary" />

<h6 class="fw-semibold mt-4 mb-2">Vertical &amp; non-linear</h6>
<p class="small text-body-secondary">
  <code>linear</code> is on by default, so only the next step is reachable. Turn it off and
  any completed step can be jumped back to; <code>disabled</code> still refuses.
</p>
<ph-stepper
  v-model="freeStep"
  :steps="steps"
  orientation="vertical"
  :linear="false"
  clickable
/>

// methods: {
//   // The slot's 'goToStep' is the component's own gate, but the panel buttons
//   // here drive the demo directly, so they go through the same rules.
//   go(index) {
//     if (index < 0 || index >= this.steps.length) return;
//     if (this.steps[index]?.disabled) return;
//     if (index > this.step + 1) return;
//     this.step = index;
//   }
// }`,
      propsData: [
        {
          name: "steps",
          type: "Array",
          default: "[]",
          notes: "{label, description?, disabled?, key?}",
        },
        {
          name: "modelValue",
          type: "Number",
          default: "0",
          notes: "Active step index",
        },
        {
          name: "orientation",
          type: "String",
          default: "'horizontal'",
          notes: "horizontal | vertical",
        },
        {
          name: "clickable",
          type: "Boolean",
          default: "false",
          notes: "Allow moving between steps from the indicators",
        },
        {
          name: "linear",
          type: "Boolean",
          default: "true",
          notes: "Only the next step is reachable; false allows jumping back",
        },
        {
          name: "indicatorSize",
          type: "String | Number",
          default: "'2rem'",
          notes: "Indicator diameter; a bare number means px",
        },
        {
          name: "connectorWidth",
          type: "String | Number",
          default: "'2px'",
          notes: "Connector thickness; a bare number means px",
        },
        {
          name: "activeColor",
          type: "String",
          default: "'var(--bs-primary)'",
          notes: "Active indicator fill",
        },
        {
          name: "completedColor",
          type: "String",
          default: "'var(--bs-success)'",
          notes: "Completed indicator and connector fill",
        },
        {
          name: "inactiveBorder",
          type: "String",
          default: "'var(--bs-border-color)'",
          notes: "Upcoming indicator border and connector",
        }
      ]
    };
  },
  methods: {
    // The slot's `goToStep` is the component's own gate, but the panel buttons
    // here drive the demo directly, so they go through the same rules.
    go(index) {
      if (index < 0 || index >= this.steps.length) return;
      if (this.steps[index]?.disabled) return;
      if (index > this.step + 1) return;
      this.step = index;
    }
  }
};
</script>