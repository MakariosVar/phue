<template>
  <example-factory
    tag="<ph-tabs />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Tab headers + a scoped-slot panel where you render content for the active tab.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-tabs v-model="active" :items="items">
          <template #default="{ activeTab }">
            <p v-if="activeTab === 'overview'">Overview…</p>
            <p v-else-if="activeTab === 'settings'">Settings…</p>
          </template>
        </ph-tabs>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="my-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
      <h4>Emits</h4>
      <ul>
        <li><code>update:modelValue</code></li>
        <li><code>change</code> — Both with the tab value</li>
      </ul>
      <h4>Slots</h4>
      <ul>
        <li>default — scoped <code>{ activeTab }</code>, rendered inside <code>.tab-content</code></li>
      </ul>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhTabs",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      active: "overview",
      items: [
        { label: "Overview", value: "overview" },
        { label: "Settings", value: "settings" },
        { label: "Update", value: "update", disabled: true }
      ],
      snippet: `<ph-tabs v-model="active" :items="items">
  <template #default="{ activeTab }">
    <p v-if="activeTab === 'overview'">Overview…</p>
    <p v-else-if="activeTab === 'settings'">Settings…</p>
  </template>
</ph-tabs>

// // State // //
// active: "overview",
// items: [
//   { label: "Overview", value: "overview" },
//   { label: "Settings", value: "settings" },
//   { label: "Update", value: "update", disabled: true }
// ]`,
      propsData: [
        {
          name: "modelValue",
          type: "String | Number",
          default: "<b>required</b>",
          notes: "Active tab <code>value</code>",
        },
        {
          name: "items",
          type: "Array",
          default: "<b>required</b>",
          notes: "<code>{ label, value, disabled? }</code>",
        },
      ],
    };
  }
};
</script>
