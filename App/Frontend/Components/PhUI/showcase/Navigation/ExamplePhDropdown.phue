<template>
  <example-factory
    tag="<ph-dropdown />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Action menu with self-managed open state (no Bootstrap JS/Popper).
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-dropdown
          label="Actions"
          variant="outline"
          size="sm"
          align="start"
          :items="[
            { label: 'Edit',   icon: 'pencil' },
            { label: 'Archive', icon: 'archive' },
            { divider: true },
            { label: 'Delete', icon: 'trash' },
            { label: 'Purge',  disabled: true }
          ]"
        >
          <template #trigger="{ toggle }">
            <ph-button variant="link" @click="toggle">
              <ph-icon name="three-dots" />
            </ph-button>
          </template>
        </ph-dropdown>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="my-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <h4>Emits</h4>
        <ul>
          <li><code>select(item)</code></li>
          <li><code>open</code></li>
          <li><code>close</code></li>
        </ul>
        <h4>Slots</h4>
        <ul>
          <li><code>trigger</code> — scoped <code>{ open, toggle }</code></li>
          <li>default (menu content)</li>
        </ul>
        <p class="text-muted">
          <code>{header: '…'}</code> renders a non-interactive group label and
          <code>{disabled: true}</code> blocks selection, so no item needs its
          own markup. With <code>closeOnSelect</code> (the default) the menu
          collapses after every emit.  
        </p>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhDropdown",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-dropdown
  label="Actions"
  variant="outline"
  size="sm"
  align="start"
  :items="[
    { label: 'Edit',   icon: 'pencil' },
    { label: 'Archive', icon: 'archive' },
    { divider: true },
    { label: 'Delete', icon: 'trash' },
    { label: 'Purge',  disabled: true }
  ]"
>
  <template #trigger="{ toggle }">
    <ph-button variant="link" @click="toggle">
      <ph-icon name="three-dots" />
    </ph-button>
  </template>
</ph-dropdown>`,
      propsData: [
        {
          name: "label",
          type: "String",
          default: "'Menu'",
          notes: "Default trigger label",
        },
        {
          name: "items",
          type: "Array",
          default: "[]",
          notes: "{label,href,icon,disabled,divider,header}",
        },
        {
          name: "variant",
          type: "String",
          default: "'secondary'",
          notes: "Trigger button variant",
        },
        {
          name: "size",
          type: "String",
          default: "'md'",
          notes: "sm | md | lg",
        },
        {
          name: "align",
          type: "String",
          default: "'start'",
          notes: "start | end",
        },
        {
          name: "closeOnSelect",
          type: "Boolean",
          default: "true",
          notes: "",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "",
        }
      ]
    };
  }
};
</script>
