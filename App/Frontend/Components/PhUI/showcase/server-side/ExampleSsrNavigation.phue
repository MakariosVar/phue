<template>
  <example-factory
    tag="&lt;ph-navigation&gt;"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        The hybrid navigation: a <b>partial</b> whose HTML is rendered on the
        server into the layout placeholder, then taken over by the client on
        mount — no flash of unstyled content.
      </p>
      <p class="mb-0">
        It is <b>not</b> a nested component: its script mounts into
        <code>#nav</code> from <code>window.__NAV_STATE__</code>, so writing
        <code>&lt;ph-navigation&gt;</code> inside a template does nothing.
        <b>You are looking at a live one</b> — the sidebar on your left is this
        very component.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">orientation="sidebar" — what it emits</ph-text>
        <ph-code class="mt-2" language="html" :code="sidebarMarkup" />

        <ph-text class="mt-3" size="xs" weight="semibold" color="muted">orientation="horizontal" — what it emits</ph-text>
        <ph-code class="mt-2" language="html" :code="topbarMarkup" />

        <ph-text class="mt-3" size="xs" weight="semibold" color="muted">Active detection</ph-text>
        <ph-text size="sm" color="muted" class="mt-1">
          The item whose normalised href equals <code>activeRoute</code> — or is a
          prefix of it — gets <code>.active</code> and
          <code>aria-current="page"</code>; the root <code>/</code> matches only
          when <code>activeRoute === '/'</code>. Group headings render in sidebar
          mode only and are keyed to <em>consecutive</em> items, so a group split
          by an unrelated item renders two headings. Disabled items render as
          <code>span.nav-link.disabled</code>, not links.
        </ph-text>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="php" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <ph-text>
          Values are escaped with
          <code>htmlspecialchars(…, ENT_QUOTES, 'UTF-8')</code> on the SSR path.
        </ph-text>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExampleZzzSimple",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      sidebarMarkup: `<!-- orientation="sidebar" -->
<div class="d-flex flex-column flex-lg-row align-items-lg-center w-100">
  <nav class="nav nav-pills flex-column gap-1">
    <h6 class="phue-nav-group sidebar-heading">Components</h6>
    <a href="/phui" class="nav-link active" aria-current="page">Overview</a>
    <a href="/docs"  class="nav-link">Docs</a>
    <span class="nav-link disabled" aria-disabled="true">Coming soon</span>
  </nav>
</div>`,
      topbarMarkup: `<!-- orientation="horizontal" -->
<div class="d-flex flex-column flex-lg-row align-items-lg-center w-100">
  <ul class="navbar-nav me-auto mb-2 mb-lg-0">
    <li class="nav-item"><a href="/phui" class="nav-link">Overview</a></li>
    <li class="nav-item dropdown">
      <a href="#" class="nav-link dropdown-toggle" role="button"
         aria-haspopup="true" aria-expanded="false">Components</a>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="/phui?section=forms">Form Controls</a></li>
      </ul>
    </li>
  </ul>
  <div class="ms-lg-auto d-flex align-items-center gap-2">…actions…</div>
</div>`,
      snippet: `// In a layout PHP block — AppLayout.phue does exactly this:
$navHtml = $partialRenderer->renderPartial('PhNavigation', [
    'items'       => $navItems,     // { label, href, disabled?, group? }
    'actions'     => $actions,
    'activeRoute' => $uri,
    'orientation' => 'sidebar',      // or 'horizontal'
]);

// The partial seeds window.__NAV_STATE__; the client takes over the
// same markup on mount, so there is no FOUC and no duplicate DOM.`,
      propsData: [
        {
          name: "items",
          type: "Array",
          default: "[]",
          notes: "{ label, href, disabled?, group? }",
        },
        {
          name: "actions",
          type: "Array",
          default: "[]",
          notes: "Right-slot topbar links (horizontal mode)",
        },
        {
          name: "activeRoute",
          type: "String",
          default: "'/'",
          notes: "Current request URI; matched exactly or as a prefix",
        },
        {
          name: "orientation",
          type: "String",
          default: "'horizontal'",
          notes: "horizontal | sidebar | vertical",
        },
        {
          name: "themeConfig",
          type: "Object",
          default: "{}",
          notes: "{ position: 'actions_prefix' | 'actions_suffix' }",
        }
      ]
    };
  },
};
</script>
