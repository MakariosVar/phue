<template>
  <example-factory
    tag="<ph-tooltip />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>
        CSS-positioned hint — no Popper, so nothing to measure. The default
        slot is the trigger, and <code>hover</code> is the default trigger with a
        short delay so a tooltip does not flash on the way past the cursor.
      </p>
      <p class="text-muted small mb-0">
        The tip is linked with <code>aria-describedby</code> only while it is
        visible, so assistive tech reads the label, not the description, until
        the description is actually there.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Placements
        </h6>
        <div class="d-flex flex-wrap gap-3 align-items-center py-4">
          <ph-tooltip v-for="p in ['top', 'bottom', 'start', 'end']" :key="p" :placement="p" :content="`Anchored ${p} of the trigger.`">
            <ph-button variant="outline-secondary" size="sm">{{ p }}</ph-button>
          </ph-tooltip>
        </div>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Triggers
        </h6>
        <div class="d-flex flex-wrap gap-3 align-items-center">
          <ph-tooltip trigger="hover" content="Hover. Default, with a 120ms delay.">
            <ph-button variant="outline-primary" size="sm">hover</ph-button>
          </ph-tooltip>

          <ph-tooltip trigger="focus" content="Focus — the keyboard route.">
            <ph-button variant="outline-primary" size="sm">focus</ph-button>
          </ph-tooltip>

          <ph-tooltip trigger="click" content="Click toggles it open and shut.">
            <ph-button variant="outline-primary" size="sm">click</ph-button>
          </ph-tooltip>

          <ph-tooltip :delay="0" content="delay=0 shows it synchronously, with no timer.">
            <ph-button variant="outline-primary" size="sm">no delay</ph-button>
          </ph-tooltip>

          <ph-tooltip disabled content="Never appears.">
            <ph-button variant="outline-secondary" size="sm" disabled>disabled</ph-button>
          </ph-tooltip>
        </div>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Variants, and a rich tip
        </h6>
        <div class="d-flex flex-wrap gap-3 align-items-center">
          <ph-tooltip variant="dark" content="dark (default)">
            <ph-button variant="outline-secondary" size="sm">dark</ph-button>
          </ph-tooltip>
          <ph-tooltip variant="light" content="light">
            <ph-button variant="outline-secondary" size="sm">light</ph-button>
          </ph-tooltip>
          <ph-tooltip max-width="360px" content="max-width accepts any CSS length, so a wider tip for longer text.">
            <ph-button variant="outline-secondary" size="sm">wide</ph-button>
          </ph-tooltip>
          <ph-tooltip content="The content slot wins over the prop.">
            <template #content>
              <strong>Rich tip</strong> — the content slot can hold markup.
            </template>
            <ph-button variant="outline-secondary" size="sm">slot</ph-button>
          </ph-tooltip>
          <ph-tooltip content="Wrap any element, not just a button.">
            <span class="badge bg-secondary">a badge</span>
          </ph-tooltip>
        </div>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li><em>None</em> — it is a pure visual hint</li>
        </ul>

        <strong>Slots</strong>
        <ul>
          <li><code>default</code> — the trigger. Any element, not just a button</li>
          <li><code>content</code> — the tip body. Wins over <code>content</code></li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhTooltip",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<!-- Default slot is the trigger; hover with a 120ms delay by default -->
<ph-tooltip content="Explain the thing.">
  <ph-button variant="outline-secondary" size="sm">Hover me</ph-button>
</ph-tooltip>

<!-- placement: top | bottom | start | end -->
<ph-tooltip placement="end" content="Anchored to the end.">
  <span class="badge bg-secondary">a badge</span>
</ph-tooltip>

<!-- trigger: hover | focus | click -->
<ph-tooltip trigger="click" content="Click toggles it.">
  <ph-button size="sm">click</ph-button>
</ph-tooltip>

<!-- delay=0 shows it synchronously, with no timer -->
<ph-tooltip :delay="0" content="No timer at all.">
  <ph-button size="sm">no delay</ph-button>
</ph-tooltip>

<!-- variant: dark | light. max-width is any CSS length. -->
<ph-tooltip variant="light" max-width="360px" content="A wider tip.">
  <ph-button size="sm">light</ph-button>
</ph-tooltip>

<!-- The content slot can hold markup; it wins over the prop -->
<ph-tooltip content="ignored">
  <template #content><strong>Rich tip</strong> — markup is fine.</template>
  <ph-button size="sm">slot</ph-button>
</ph-tooltip>`,
      propsData: [
        {
          name: "content",
          type: "String",
          default: "''",
          notes: "Tip text. The <code>content</code> slot wins over it",
        },
        {
          name: "placement",
          type: "String",
          default: "'top'",
          notes: "top | bottom | start | end",
        },
        {
          name: "trigger",
          type: "String",
          default: "'hover'",
          notes: "hover | focus | click",
        },
        {
          name: "delay",
          type: "Number",
          default: "120",
          notes: "Show delay in ms. <code>0</code> shows it <strong>synchronously</strong>, with no timer",
        },
        {
          name: "variant",
          type: "String",
          default: "'dark'",
          notes: "dark | light",
        },
        {
          name: "maxWidth",
          type: "String",
          default: "'260px'",
          notes: "Any CSS length",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "Suppresses the tip entirely",
        },
      ],
    };
  },
};
</script>
