<template>
  <example-factory
    tag="<ph-confirm-dialog />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Promise-based confirmation dialog. It takes over
        <code>window.confirm</code>, so the call reads as ordinary control flow
        and a caller can <code>await</code> the answer. Focus is trapped, focus
        starts on Cancel, and it is restored to the trigger on close.
      </p>
      <p class="text-muted small mb-0">
        <strong>One per page.</strong> This page already mounts
        <code>&lt;ph-confirm-dialog /&gt;</code> globally, so this example does
        <em>not</em> render a second one — a second instance would overwrite
        <code>window.confirm</code> and then null it on unmount, breaking the
        host's.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <div class="d-flex flex-wrap gap-2">
          <ph-button size="sm" variant="primary" @click="askSimple">Simple</ph-button>
          <ph-button size="sm" variant="danger" @click="askDanger">Destructive</ph-button>
          <ph-button size="sm" variant="warning" @click="askWithIcon">With icon</ph-button>
          <ph-button size="sm" variant="info" @click="askBlocking">Blocking (setLoading)</ph-button>
        </div>
        <p class="text-muted small mt-3 mb-0">
          Last answer: <code>{{ lastAnswer }}</code>
        </p>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <p class="text-muted">
          <strong>None.</strong> The component takes no props — everything is an
          option to <code>confirm()</code>, which is the only way to open it.
        </p>

        <h4 class="mt-4">Options for <code>window.confirm(options)</code></h4>
        <ph-data-table
          :columns="[
            {key: 'field', label: 'Option', sortable: true},
            {key: 'type', label: 'Type'},
            {key: 'default', label: 'Default'},
            {key: 'notes', label: 'Notes'}
          ]"
          :items="optionProps"
        >
          <template #cell(field)="{ value }"><strong v-html="value"></strong></template>
          <template #cell(type)="{ value }"><span v-html="value"></span></template>
          <template #cell(default)="{ value }"><span v-html="value"></span></template>
          <template #cell(notes)="{ value }"><span v-html="value"></span></template>
        </ph-data-table>

        <h4 class="mt-4">Emits</h4>
        <ul>
          <li><code>confirm</code> — the confirm button was pressed</li>
          <li><code>cancel</code> — cancelled, dismissed, or <code>Esc</code></li>
        </ul>

        <h4 class="mt-4">Methods, on <code>window.confirm</code></h4>
        <ul>
          <li>
            <code>confirm(options)</code> — returns a
            <code>Promise&lt;boolean&gt;</code>
          </li>
          <li>
            <code>setLoading(true)</code> — puts the dialog in a busy state and
            blocks closing until it is released
          </li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhConfirmDialog",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      lastAnswer: "—",
      snippet: `<!-- Once per page. It takes over window.confirm. -->
<ph-confirm-dialog />

<!-- Ordinary control flow: the answer is a boolean. -->
async function remove(id) {
  const ok = await window.confirm({
    title: 'Delete this project?',
    message: 'It also deletes its deployments. This cannot be undone.',
    confirmText: 'Delete',
    cancelText: 'Keep it',
    variant: 'danger',
    icon: 'exclamation-triangle',
  });

  if (!ok) return;
  await api.delete(id);
}

// Hold it open while the server works, so the user cannot dismiss mid-flight.
async function save() {
  const ok = await window.confirm({ title: 'Save changes?', message: 'Drafts are included.' });
  if (!ok) return;

  window.confirm.setLoading(true);
  try {
    await api.save();
  } finally {
    window.confirm.setLoading(false);
  }
}`,
      optionProps: [
        {
          field: "title",
          type: "String",
          default: "'Are you sure?'",
          notes: "Header text",
        },
        {
          field: "message",
          type: "String",
          default: "''",
          notes: "Body text",
        },
        {
          field: "confirmText",
          type: "String",
          default: "'Confirm'",
          notes: "Label of the confirm button",
        },
        {
          field: "cancelText",
          type: "String",
          default: "'Cancel'",
          notes: "Label of the cancel button. Focus starts here, so the safe choice is under the cursor",
        },
        {
          field: "variant",
          type: "String",
          default: "'primary'",
          notes: "primary | danger. <code>danger</code> also tints the icon red",
        },
        {
          field: "icon",
          type: "String",
          default: "''",
          notes: "Bootstrap Icons name in the header, e.g. <code>'exclamation-triangle'</code>",
        },
        {
          field: "loading",
          type: "Boolean",
          default: "false",
          notes: "Busy state: disables both buttons and blocks closing. Usually driven by <code>setLoading()</code> rather than set up front",
        },
        {
          field: "closeOnBackdrop",
          type: "Boolean",
          default: "false",
          notes: "Backdrop click confirms. <strong>Off by default</strong> — a stray click should not answer a destructive prompt",
        },
      ],
    };
  },
  methods: {
    async record(options) {
      const ok = await window.confirm(options);
      this.lastAnswer = ok ? "confirmed" : "cancelled";
      return ok;
    },
    askSimple() {
      return this.record({
        title: 'Publish this page?',
        message: 'It becomes visible to everyone immediately.',
        confirmText: 'Publish',
      });
    },
    askDanger() {
      return this.record({
        title: 'Delete this project?',
        message: 'It also deletes its deployments. This cannot be undone.',
        confirmText: 'Delete',
        cancelText: 'Keep it',
        variant: 'danger',
      });
    },
    askWithIcon() {
      return this.record({
        title: 'Discard your changes?',
        message: 'Unsaved edits are lost.',
        icon: 'exclamation-triangle',
        confirmText: 'Discard',
        cancelText: 'Go back',
      });
    },
    async askBlocking() {
      const ok = await this.record({
        title: 'Save changes?',
        message: 'Drafts are included.',
        confirmText: 'Save',
      });
      if (!ok) return;

      // Held open until released, so it cannot be dismissed mid-flight.
      window.confirm.setLoading(true);
      await new Promise((resolve) => setTimeout(resolve, 1200));
      window.confirm.setLoading(false);
      this.lastAnswer = "saved (was held busy)";
    },
  },
};
</script>
