<template>
  <example-factory
    tag="<ph-alert />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>
        Dismissible alert with an optional title. The <code>message</code> prop
        and the default slot are interchangeable — whichever you use wins.
      </p>
      <p class="text-muted small mb-0">
        Visibility is <strong>internal</strong>: the component hides itself on
        <code>dismiss</code> and there is no prop to bring it back. To re-show
        it, re-mount it — the <code>key</code> bump below is the cheapest way.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Variants
        </h6>
        <ph-alert variant="info" title="Heads up">Something worth knowing.</ph-alert>
        <ph-alert variant="success" title="Deployed">v2.4.0 is now live.</ph-alert>
        <ph-alert variant="warning" title="Quota at 80%">Billing resets on the 1st.</ph-alert>
        <ph-alert variant="error" title="Build failed">2 lint errors.</ph-alert>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Dismissible, and how to bring it back
        </h6>
        <ph-alert
          v-if="alertMounted"
          variant="success"
          title="Deployed"
          dismissible
          @dismiss="onDismiss"
        >
          v2.4.0 is now live.
        </ph-alert>

        <button
          v-else
          type="button"
          class="btn btn-outline-primary btn-sm"
          @click="alertMounted = true"
        >
          Show the alert again
        </button>
        <p class="text-muted small mt-2 mb-0">
          <code>v-if</code> is the whole mechanism: setting it back to
          <code>true</code> mounts a fresh instance, so it is open again.
        </p>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li>
            <code>dismiss</code> — the ✕ was pressed. The alert is already
            hidden by then; this is your signal to unmount it for good
          </li>
        </ul>

        <strong>Slots</strong>
        <ul>
          <li>
            <code>default</code> — the body. <strong>Wins over the
            <code>message</code> prop</strong>
          </li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhAlert",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,

      alertMounted: true,

      snippet: `<!-- message prop -->
<ph-alert variant="success" title="Deployed" message="v2.4.0 is now live." />

<!-- default slot wins over the prop -->
<ph-alert variant="error" title="Build failed">2 lint errors.</ph-alert>

<!-- Dismissible. There is no v-model: visibility is internal, and
     v-if is how you unmount it for good. -->
<ph-alert
  v-if="alertMounted"
  variant="success"
  title="Deployed"
  dismissible
  @dismiss="alertMounted = false"
>
  v2.4.0 is now live.
</ph-alert>

<!-- v-if alone is enough to bring it back: going false unmounts the
     component, so true mounts a fresh instance with its own open state.
     No key bump needed. -->
<button v-if="!alertMounted" @click="alertMounted = true">Show again</button>`,

      propsData: [
        {
          name: "title",
          type: "String",
          default: "''",
          notes: "Bold <code>alert-heading</code> above the body",
        },
        {
          name: "message",
          type: "String",
          default: "''",
          notes: "Body text. The <strong>default slot wins</strong> when both are given",
        },
        {
          name: "variant",
          type: "String",
          default: "'info'",
          notes: "info | success | warning | error. Mapped to <code>alert-info</code> / <code>-success</code> / <code>-warning</code> / <code>-danger</code>",
        },
        {
          name: "dismissible",
          type: "Boolean",
          default: "false",
          notes: "Renders the <code>btn-close</code> and adds <code>alert-dismissible</code>",
        },
      ],
    };
  },
  methods: {
    onDismiss() {
      this.alertMounted = false;
    },
  },
};
</script>
