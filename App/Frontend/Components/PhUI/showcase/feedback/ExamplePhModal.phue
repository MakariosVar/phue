<template>
  <example-factory
    tag="<ph-modal />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>
        Dialog teleported to <code>body</code>, shown while
        <code>modelValue</code> is true. Closable by the ✕, by the backdrop (if
        <code>closeOnBackdrop</code>), or by a parent flipping the model.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <div class="d-flex flex-wrap gap-2">
          <ph-button
            v-for="s in ['sm', 'md', 'lg', 'xl', 'full']"
            :key="s"
            size="sm"
            variant="outline-primary"
            @click="open(s)"
          >
            {{ s }}
          </ph-button>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2">
          <ph-button size="sm" variant="outline-secondary" @click="open('md', { closable: false, closeOnBackdrop: false })">
            Not closable
          </ph-button>
          <ph-button size="sm" variant="ghost" @click="openChrome('lg')">
            Custom header + footer
          </ph-button>
        </div>
      </ph-card>

      <ph-modal
        v-model="open_"
        :title="title"
        :size="size"
        :closable="closable"
        :close-on-backdrop="closeOnBackdrop"
        @close="lastClose = 'close'"
      >
        <template v-if="customChrome" #header>
          <h3 class="modal-title d-flex align-items-center gap-2">
            <span class="badge bg-primary">{{ size }}</span>
            Custom header slot
          </h3>
        </template>

        <p class="mb-0">
          A <code>modal-{{ size === 'md' ? '' : size }}</code> dialog. The
          <code>footer</code> slot only renders when provided, so this body is
          the whole content when it is omitted.
        </p>
        <hr class="my-3" />
        <p class="text-body-secondary small mb-0">
          Last event: <code>{{ lastClose }}</code>
        </p>

        <template v-if="customChrome" #footer>
          <ph-button variant="ghost" @click="open_ = false">Cancel</ph-button>
          <ph-button variant="primary" @click="open_ = false">Confirm</ph-button>
        </template>
      </ph-modal>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li><code>update:modelValue(false)</code> — wire with <code>v-model</code></li>
          <li><code>close</code> — after the model was already set to false</li>
        </ul>

        <strong>Slots</strong>
        <ul>
          <li><code>default</code> — the body</li>
          <li><code>header</code> — replaces the <code>&lt;h3&gt;</code>; the ✕ stays</li>
          <li><code>footer</code> — the footer row. <strong>Rendered only if the slot is provided</strong></li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhModal",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      open_: false,
      size: "md",
      title: "Confirm",
      closable: true,
      closeOnBackdrop: true,
      customChrome: false,
      lastClose: "—",
      snippet: `<!-- v-model is the visibility flag. size: sm | md | lg | xl | full -->
<ph-button @click="open = true">Open</ph-button>

<ph-modal v-model="open" title="Confirm" size="lg" @close="onClose">
  Are you sure you want to continue?

  <template #footer>
    <ph-button variant="ghost" @click="open = false">Cancel</ph-button>
    <ph-button variant="primary" @click="save">Confirm</ph-button>
  </template>
</ph-modal>

<!-- The ✕ and the backdrop are separate switches -->
<ph-modal v-model="open" :closable="false" :close-on-backdrop="false" />`,
      propsData: [
        {
          name: "modelValue",
          type: "Boolean",
          default: "false",
          notes: "Visibility. Wire it with <code>v-model</code>",
        },
        {
          name: "title",
          type: "String",
          default: "''",
          notes: "Rendered as an <code>&lt;h3 class=modal-title&gt;</code> unless the <code>header</code> slot is used",
        },
        {
          name: "size",
          type: "String",
          default: "'md'",
          notes: "sm | md | lg | xl | full — maps to <code>modal-sm</code> / default / <code>-lg</code> / <code>-xl</code> / <code>-fullscreen</code>",
        },
        {
          name: "closable",
          type: "Boolean",
          default: "true",
          notes: "Shows the ✕. When false it also disables backdrop closing",
        },
        {
          name: "closeOnBackdrop",
          type: "Boolean",
          default: "true",
          notes: "Backdrop click closes. Only takes effect while <code>closable</code> is also true",
        },
      ],
    };
  },
  methods: {
    // Default parameters only fire for `undefined`, so this must never be
    // called with an explicit `null` — that is what made `options.closable`
    // throw on the "Custom header + footer" button.
    open(size, options = {}, customChrome = false) {
      this.size = size;
      this.closable = options.closable ?? true;
      this.closeOnBackdrop = options.closeOnBackdrop ?? true;
      this.customChrome = customChrome;
      this.title = customChrome ? "" : `${size} dialog`;
      this.lastClose = "—";
      this.open_ = true;
    },
    openChrome(size) {
      this.open(size, {}, true);
    },
  },
};
</script>
