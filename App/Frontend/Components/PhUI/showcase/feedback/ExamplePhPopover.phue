<template>
  <example-factory
    tag="<ph-popover />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>
        Rich overlay anchored to a trigger, teleported to <code>body</code> and
        positioned from the trigger's own rect, so it is not clipped by a
        scrolling parent. <code>Esc</code> closes it, and a click on the
        backdrop closes it too.
      </p>
      <p class="text-muted small mb-0">
        Bind <code>modelValue</code> to own the open state. That is what keeps
        several popovers mutually exclusive below: one key, so opening one makes
        every other one's <code>modelValue</code> false. Left unbound, each
        popover keeps its own state and they will happily stack up.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Triggers
        </h6>
        <div class="d-flex flex-wrap gap-3 align-items-center">
          <ph-popover
            :model-value="openKey === 'click'"
            trigger="click"
            title="Click me"
            content="Opened by a click. The default trigger is a small outline button."
            @update:model-value="onToggle('click', $event)"
          >
            <template #trigger>
              <ph-button variant="outline-secondary" size="sm">
                Click
              </ph-button>
            </template>
          </ph-popover>

          <ph-popover
            :model-value="openKey === 'hover'"
            trigger="hover"
            title="Hover me"
            content="Opened on hover. Leaving the trigger closes it again."
            @update:model-value="onToggle('hover', $event)"
          >
           <template #trigger>
              <ph-button variant="outline-secondary" size="sm">
                Hover me
              </ph-button>
            </template>
          </ph-popover>

          <ph-popover
            :model-value="openKey === 'focus'"
            trigger="focus"
            title="Focus me"
            content="Opened on focus — the keyboard route into the same content."
            @update:model-value="onToggle('focus', $event)"
          >
           <template #trigger>
              <ph-button variant="outline-secondary" size="sm">
                Focus me
              </ph-button>
            </template>
          </ph-popover>

          <ph-popover
            disabled
            trigger-label="Disabled"
            content="Never opens: `disabled` short-circuits every trigger."
          />
        </div>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Custom trigger
        </h6>
        <ph-popover
          :model-value="openKey === 'custom'"
          variant="info"
          title="Custom trigger"
          content="The #trigger slot replaces the default button entirely."
          @update:model-value="onToggle('custom', $event)"
        >
          <template #trigger>
            <ph-button variant="primary" size="sm">
              <ph-icon name="question-circle" size="sm" class="me-1" />
              Help
            </ph-button>
          </template>
        </ph-popover>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Placements
        </h6>
        <div class="d-flex flex-wrap gap-2">
          <ph-popover
            v-for="p in placements"
            :key="p"
            :model-value="openKey === p"
            :placement="p"
            :trigger-label="p"
            :title="p"
            :content="`Anchored ${p} of the trigger.`"
            @update:model-value="onToggle(p, $event)"
          />
        </div>

        <p class="text-muted small mt-3 mb-0">
          Last event: <code>{{ lastEvent }}</code>
        </p>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li><code>show</code> — opened</li>
          <li><code>hide</code> — closed</li>
          <li><code>update:modelValue(open)</code> — wire with <code>v-model</code></li>
        </ul>

        <strong>Slots</strong>
        <ul>
          <li><code>trigger</code> — replaces the default button. The slot content is wrapped in a focusable element</li>
          <li><code>content</code> — replaces the <code>content</code> prop</li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhPopover",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      lastEvent: "—",
      openKey: null,
      placements: ["top", "bottom", "start", "end"],
      snippet: `<!-- Default trigger is a small outline button labelled by triggerLabel -->
<ph-popover title="Click me" content="Opened by a click." trigger="click" />

<!-- Replace the trigger; the slot content is wrapped in a focusable element -->
<ph-popover title="Help" content="…">
  <template #trigger>
    <ph-button variant="primary" size="sm">
      <ph-icon name="question-circle" size="sm" class="me-1" />
      Help
    </ph-button>
  </template>
</ph-popover>

<!-- placement: top | bottom | start | end, plus the -start/-end variants
     (top-start, top-end, bottom-start, bottom-end,
      start-top, start-bottom, end-top, end-bottom) -->
<ph-popover placement="bottom-start" trigger-label="Anchored" content="…" />

<!-- trigger: click | hover | focus. Esc always closes. -->
<!-- disabled short-circuits every trigger. -->
<ph-popover disabled trigger-label="Disabled" content="…" />`,
      propsData: [
        {
          name: "modelValue",
          type: "Boolean",
          default: "null",
          notes: "Open state. <strong>Null (unbound) = the popover keeps its own</strong>; bind it to own the flag, which is how several popovers stay mutually exclusive",
        },
        {
          name: "title",
          type: "String",
          default: "''",
          notes: "Header text. Omit it for a body-only popover",
        },
        {
          name: "content",
          type: "String",
          default: "''",
          notes: "Body text. The <code>content</code> slot wins over it",
        },
        {
          name: "triggerLabel",
          type: "String",
          default: "'Popover'",
          notes: "Label of the default trigger button. Ignored when the <code>trigger</code> slot is used",
        },
        {
          name: "placement",
          type: "String",
          default: "'top'",
          notes: "top, bottom, start, end, plus <code>-start</code>/<code>-end</code> variants: top-start, top-end, bottom-start, bottom-end, start-top, start-bottom, end-top, end-bottom",
        },
        {
          name: "trigger",
          type: "String",
          default: "'click'",
          notes: "click | hover | focus",
        },
        {
          name: "variant",
          type: "String",
          default: "''",
          notes: "Border colour: primary | secondary | success | danger | warning | info. Empty means no tint",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "Short-circuits every trigger — the popover never opens",
        },
      ],
    };
  },
  methods: {
    // One key, so at most one popover in the demo can be open: opening any of
    // them makes every other popover's modelValue false, which closes it.
    onToggle(key, open) {
      this.openKey = open ? key : null;
      this.lastEvent = open ? "show" : "hide";
    },
  },
};
</script>
