<template>
  <example-factory
    tag="<ph-description-list />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Description list (<code>&lt;dl&gt;</code>) with responsive columns.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <ph-description-list
            :items="[
              { label: 'Status', value: 'Active' },
              { label: 'Name', value: 'Barry Foom' },
              { label: 'Created', value: '2024-01-15' },
              { label: 'Updated', value: '2024-01-16' }
            ]"
            :columns="2"
          />
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Slots</strong>
        <ul>
          <li><code>item-&lt;key&gt;</code> - scoped</li>
        </ul>

      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhDescriptionList",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      model: null,
      snippet: ` <ph-description-list
  :items="[
    { label: 'Status', value: 'Active' },
    { label: 'Name', value: 'Barry Foom' },
    { label: 'Created', value: '2024-01-15' },
    { label: 'Updated', value: '2024-01-16' }
  ]"
  :columns="2"
/>`,
      propsData: [
        {
          name: "items",
          type: "Array",
          default: "[]",
          notes: "<code>{label, value, key?}</code>",
        },
        {
          name: "columns",
          type: "Number",
          default: "2",
          notes: "1 | 2 | 3",
        }
      ]
    };
  },
};
</script>
