<template>
  <example-factory
    tag="<ph-carousel />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Slideshow. <strong>There is no Bootstrap JS behind it</strong> — Bootstrap's
        carousel is 100% JavaScript, so every behaviour here is the component's own.
      </p>
      <p class="text-muted small mb-0">
        Autoplay is off under <code>prefers-reduced-motion</code> rather than merely
        slowed, and it stops on hover, on keyboard focus inside, and while the tab is
        hidden.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Slides, autoplay
        </h6>
        <ph-carousel v-model="active" :slides="slides" height="260px" :interval="5000" />
        <code class="d-block small mt-2">
          active = {{ active }} — last change: {{ lastChange }}
        </code>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Fade, no indicators, no loop
        </h6>
        <ph-carousel
          :slides="slides"
          :fade="true"
          :indicators="false"
          :loop="false"
          height="200px"
        />

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          A custom <code>slide</code> slot
        </h6>
        <ph-carousel :slides="slides" height="180px" :indicators="true" :controls="true">
          <template #slide="{ item, active }">
            <div class="p-4 h-100" :class="active ? 'bg-primary text-white' : 'bg-body-tertiary'">
              <h5 class="mb-1">{{ item.title }}</h5>
              <p class="mb-0">{{ item.text }}</p>
            </div>
          </template>
        </ph-carousel>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li><code>update:modelValue(index)</code>, <code>change(index)</code></li>
          <li><code>next</code>, <code>prev</code> — only on a real move</li>
        </ul>

        <strong>Slots</strong>
        <ul>
          <li><code>slide</code> — scoped <code>{ item, index, active }</code></li>
        </ul>

        <strong>Slide shape</strong>
        <ul>
          <li><code>src</code>, <code>alt</code> — rendered through <code>&lt;ph-image&gt;</code></li>
          <li><code>caption</code> — the indicator and screen-reader label</li>
          <li><code>title</code> — wins over <code>caption</code> in the caption band</li>
          <li><code>text</code> — the caption body</li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhCarousel",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,

      active: 0,
      lastChange: "—",

      slides: [
        {
          src: "/Phue.svg",
          alt: "A hero illustration",
          caption: "First slide",
          title: "First",
          text: "The caption band and the accessible name both come from caption/title.",
        },
        {
          src: "/Phue.svg",
          alt: "A second illustration",
          caption: "Second slide",
          title: "Second",
          text: "Swipe on a touch device, or use the chevrons and the indicator bars.",
        },
        {
          src: "/Phue.svg",
          alt: "A third illustration",
          caption: "Third slide",
          title: "Third",
          text: "Swap these for PhImage sources of any size.",
        },
      ],

      snippet: `<!-- Slides with autoplay. The active index is bound like any v-model. -->
<ph-carousel v-model="active" :slides="slides" height="260px" :interval="5000" />

<!-- Crossfade, no indicator bars, and the ends are dead instead of wrapping -->
<ph-carousel :slides="slides" fade :indicators="false" :loop="false" height="200px" />

<!-- The slide rendering is the caller's -->
<ph-carousel :slides="slides" height="180px">
  <template #slide="{ item, active }">
    <div class="p-4 h-100" :class="active ? 'bg-primary text-white' : 'bg-body-tertiary'">
      <h5 class="mb-1">{{ item.title }}</h5>
      <p class="mb-0">{{ item.text }}</p>
    </div>
  </template>
</ph-carousel>

// Example state
// active: 0
// slides: [
//   { src: "/Phue.svg", alt: "A hero illustration",
//     caption: "First slide", title: "First", text: "…" },
//   { src: "/Phue.svg", alt: "A second illustration",
//     caption: "Second slide", title: "Second", text: "…" },
// ]`,

      propsData: [
        { name: "modelValue", type: "Number", default: "0", notes: "Active index. Out-of-range and negative values are <strong>wrapped</strong>, not trusted" },
        { name: "slides", type: "Array", default: "[]", notes: "<code>{ src, alt, caption?, title?, text? }</code>. The <code>slide</code> slot overrides the rendering" },
        { name: "height", type: "String | Number", default: "0", notes: "Frame height; a number is px, a string is raw CSS" },
        { name: "fit", type: "String", default: "'cover'", notes: "Passed to <code>&lt;ph-image&gt;</code>" },
        { name: "interval", type: "Number", default: "0", notes: "Autoplay in ms. <code>0</code> disables it" },
        { name: "indicators", type: "Boolean", default: "true", notes: "Indicator bars (30×3px, not v4's dots)" },
        { name: "controls", type: "Boolean", default: "true", notes: "Prev/next chevrons" },
        { name: "loop", type: "Boolean", default: "true", notes: "<code>false</code> makes the ends dead rather than wrapping" },
        { name: "fade", type: "Boolean", default: "false", notes: "Crossfade instead of a horizontal slide" },
        { name: "pauseOnHover", type: "Boolean", default: "true", notes: "Stop the timer on pointer <strong>or focus</strong> inside" },
        { name: "variant", type: "String", default: "'light'", notes: "Glyph polarity: <code>light</code> = dark chevrons, <code>dark</code> = white, for dark slides" },
        { name: "label", type: "String", default: "'Carousel'", notes: "Accessible name of the region" },
        { name: "duration", type: "Number", default: "600", notes: "Ms of the transition" },
      ],
    };
  },
  watch: {
    active(index) {
      this.lastChange = 'v-model ' + index;
    },
  },
};
</script>