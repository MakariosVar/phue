<template>
  <example-factory
    tag="&lt;ph-sortable&gt;"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Drag &amp; drop reordering on native HTML5 DnD — no library, no build
        step. Controlled with <code>v-model</code> or left to its own state, with
        full keyboard parity: <kbd>Tab</kbd> to a row, the arrows to move it,
        <kbd>Esc</kbd> to put the list back.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Controlled — v-model</ph-text>
        <ph-sortable v-model="fields" removable label="Form fields" class="my-2" />

        <ph-text size="xs" weight="semibold" color="muted">Uncontrolled — no v-model, order arrives via @reorder</ph-text>
        <ph-sortable :items="folders" class="my-2" @reorder="onReorder" />

        <ph-text size="xs" weight="semibold" color="muted">Custom row slot</ph-text>
        <ph-sortable v-model="lanes" class="my-2">
          <template #item="{ item, index }">
            <div class="d-flex align-items-center gap-2">
              <span class="badge text-bg-secondary">{{ index + 1 }}</span>
              <strong>{{ item.label }}</strong>
              <span class="small text-body-secondary ms-auto">{{ item.weight }}</span>
            </div>
          </template>
        </ph-sortable>

        <ph-text size="xs" weight="semibold" color="muted">Disabled</ph-text>
        <ph-sortable :items="locked" disabled class="my-2" />
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <ph-text>
          Drag is a pointer-only affordance, so the component ships a keyboard
          equivalent: the arrows move the focused row straight away, with no
          "grab" step first. Requiring <kbd>Space</kbd> before the arrows did
          anything looked deliberate but was invisible, and an arrow key that is
          silently swallowed is indistinguishable from a broken list.
          <kbd>Esc</kbd> restores the order from before the first move.
        </ph-text>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhSortable",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      // One array per demo. Sharing a single array made dragging in one list
      // silently reorder the two below it, which looked like a component bug.
      // Each list is writable: an uncontrolled demo that never handles @reorder
      // has a read-only `items` prop, so the order could never change.
      fields: [
        { id: 'title', label: 'Title' },
        { id: 'slug', label: 'Slug' },
        { id: 'body', label: 'Body' },
        { id: 'tags', label: 'Tags' }
      ],
      folders: [
        { id: 'inbox', label: 'Inbox' },
        { id: 'drafts', label: 'Drafts' },
        { id: 'sent', label: 'Sent' }
      ],
      lanes: [
        { id: 'todo', label: 'To do', weight: '3' },
        { id: 'doing', label: 'Doing', weight: '2' },
        { id: 'done', label: 'Done', weight: '9' }
      ],
      locked: [
        { id: 'a', label: 'Fixed first' },
        { id: 'b', label: 'Fixed second' }
      ],
      snippet: `<ph-text class="mt-2" size="xs" weight="semibold" color="muted">Controlled — v-model</ph-text>
<ph-sortable v-model="fields" removable label="Form fields" class="my-2" />

<ph-text size="xs" weight="semibold" color="muted">Uncontrolled — no v-model, order arrives via @reorder</ph-text>
<ph-sortable :items="folders" class="my-2" @reorder="onReorder" />

<ph-text size="xs" weight="semibold" color="muted">Custom row slot</ph-text>
<ph-sortable v-model="lanes" class="my-2">
  <template #item="{ item, index }">
    <div class="d-flex align-items-center gap-2">
      <span class="badge text-bg-secondary">{{ index + 1 }}</span>
      <strong>{{ item.label }}</strong>
      <span class="small text-body-secondary ms-auto">{{ item.weight }}</span>
    </div>`,
      propsData: [
        {
          name: "modelValue",
          type: "Array",
          default: "null",
          notes: "v-model; null = uncontrolled",
        },
        {
          name: "items",
          type: "Array",
          default: "null",
          notes: "Read-only list when uncontrolled",
        },
        {
          name: "labelKey",
          type: "String",
          default: "'label'",
          notes: "Property read for the default row text",
        },
        {
          name: "itemKey",
          type: "String",
          default: "'id'",
          notes: "Stable identity for the v-for key",
        },
        {
          name: "handle",
          type: "Boolean",
          default: "true",
          notes: "Show the grip affordance",
        },
        {
          name: "removable",
          type: "Boolean",
          default: "false",
          notes: "Per-row ✕ button",
        },
        {
          name: "tag",
          type: "String",
          default: "'ul'",
          notes: "List element; rows become <li> for ul/ol",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "helperText",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "emptyText",
          type: "String",
          default: "'Nothing to sort.'",
          notes: "Shown when the list is empty",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "No drag, no keyboard reorder",
        }
      ]
    };
  },
  methods: {
    onReorder({ items }) {
      // The component is uncontrolled here, so it only reports the new order.
      this.folders = items;
    }
  }
};
</script>
