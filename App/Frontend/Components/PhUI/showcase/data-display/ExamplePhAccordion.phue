<template>
  <example-factory
    tag="<ph-accordion />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>
        Collapsible panels. Works unwired — opening and closing is internal — or
        controlled with <code>v-model</code>, which is an array of open keys.
      </p>
      <p class="text-muted small mb-0">
        Give every item a <code>key</code> and it identifies the panel; without
        one, the array position is used, so reordering the items changes what
        <code>v-model</code> refers to.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Single open (default)
        </h6>
        <ph-accordion v-model="open" :items="items" />

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Multiple open, flush
        </h6>
        <ph-accordion v-model="multiOpen" :items="items" multiple flush />

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          The model
        </h6>
        <code class="d-block small mb-3">open = {{ JSON.stringify(open) }}</code>
        <code class="d-block small">multiOpen = {{ JSON.stringify(multiOpen) }}</code>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li>
            <code>update:modelValue(keys)</code> — wire it with
            <code>v-model</code>. The payload is the full new array of open keys
          </li>
        </ul>

        <strong>Slots</strong>
        <ul>
          <li>
            <code>item-&lt;key&gt;</code> — scoped
            <code>{ item, index, open }</code>. Falls back to
            <code>item.content</code>
          </li>
        </ul>

        <hr />
        <h4>Item shape</h4>
        <ph-data-table
          :columns="[
            {key: 'field', label: 'Field', sortable: true},
            {key: 'type', label: 'Type'},
            {key: 'notes', label: 'Notes'}
          ]"
          :items="itemProps"
        >
          <template #cell(field)="{ value }"><strong v-html="value"></strong></template>
          <template #cell(type)="{ value }"><span v-html="value"></span></template>
          <template #cell(notes)="{ value }"><span v-html="value"></span></template>
        </ph-data-table>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhAccordion",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,

      open: ['s1'],
      multiOpen: [],

      items: [
        { key: "s1", label: "Section 1", content: "Details…", icon: "chevron-right" },
        { key: "s2", label: "Section 2", content: "More details…", icon: "chevron-right" },
        { key: "s3", label: "Section 3", content: "Even more details…", icon: "chevron-right" },
      ],

      snippet: `<!-- Works unwired: opening/closing is internal -->
<ph-accordion :items="items" />

<!-- Controlled. v-model is an ARRAY of open keys, not an index -->
<ph-accordion v-model="open" :items="items" />

<!-- Several panels at once, borderless -->
<ph-accordion v-model="multiOpen" :items="items" multiple flush />

<!-- Per-item override; falls back to item.content -->
<ph-accordion :items="items">
  <template #item-deploy="{ item, open }">
    <ph-card v-if="!open">Closed</ph-card>
    <p v-else>{{ item.content }}</p>
  </template>
</ph-accordion>`,

      propsData: [
        {
          name: "items",
          type: "Array",
          default: "[]",
          notes: "Panels — see the <strong>Item shape</strong> table below",
        },
        {
          name: "modelValue",
          type: "Array",
          default: "[]",
          notes: "Keys of the open panels. A wrong type degrades to “nothing open” rather than throwing",
        },
        {
          name: "multiple",
          type: "Boolean",
          default: "false",
          notes: "Allow more than one panel open. When false, opening one closes the others",
        },
        {
          name: "flush",
          type: "Boolean",
          default: "false",
          notes: "Borderless, full-bleed variant (Bootstrap <code>accordion-flush</code>)",
        },
      ],

      itemProps: [
        {
          field: "key",
          type: "String | Number",
          notes: "Identity for the panel. It is what <code>modelValue</code> holds; falls back to the array index",
        },
        {
          field: "label",
          type: "String",
          notes: "Text on the toggle button",
        },
        {
          field: "content",
          type: "String",
          notes: "Body text, used when the <code>item-&lt;key&gt;</code> slot is not provided",
        },
        {
          field: "icon",
          type: "String",
          notes: "Bootstrap Icons name in front of the label",
        },
        {
          field: "active",
          type: "Boolean",
          notes: "Opens the panel on first render. Read <strong>once</strong> — later changes are ignored; use <code>v-model</code> to drive state",
        },
      ],
    };
  },
};
</script>
