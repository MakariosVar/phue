<template>
  <example-factory
    tag="<ph-card />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Content card. Header (title/subtitle or custom), body (default slot), footer.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <div class="d-flex gap-2">
            <ph-card title="Weekly Report" subtitle="Last 7 days" hoverable>
              Hoverable card
              <template #footer>
                <ph-button variant="outline-secondary" size="sm">View details</ph-button>
              </template>
            </ph-card>
            <ph-card title="Monthly Report" subtitle="Last month">
              Default card
              <template #footer>
                <ph-button variant="outline-secondary" size="sm">View details</ph-button>
              </template>
            </ph-card>
          </div>
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Slots</strong>
        <ul>
          <li><code>header</code> - default: title + subtitle</li>
          <li><code>default</code> - body</li>
          <li><code>footer</code> - rendered only if provided</li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhCard",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-card title="Weekly Report" subtitle="Last 7 days" hoverable>
  Revenue grew 12% week over week.
  <template #footer>
    <ph-button variant="outline-secondary" size="sm">View details</ph-button>
  </template>
</ph-card>`,
      propsData: [
        {
          name: "title",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "subtitle",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "bordered",
          type: "Boolean",
          default: "true",
          notes: "false → border-0",
        },
        {
          name: "hoverable",
          type: "Boolean",
          default: "false",
          notes: "Adds the card-hoverable class",
        }
      ]
    };
  },
};
</script>
