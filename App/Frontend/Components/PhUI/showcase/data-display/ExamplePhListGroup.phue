<template>
  <example-factory
    tag="<ph-list-group />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Flexible list group with headers, dividers, badges, actions and slots.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
            <ph-list-group
              :items="[
                { label: 'Star', icon: 'star', speratedValue: 3 },
                { divider: true },
                { label: 'Action', icon: 'gear', action: true },
                { label: 'Favorite', icon: 'heart', action: true },
                { label: 'Unfavorite', icon: 'heart-pulse', action: false }
              ]"
              @select="model = $event"
            />
          <p class="mt-3">Selected: <code>{{ model ?? 'null' }}</code></p>
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits</strong>
        <ul>
          <li><code>select(item)</code></li>
        </ul>
        <strong>Slots</strong>
        <ul>
          <li><code>item-&lt;key&gt;</code> - scoped</li>
        </ul>

      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhListGroup",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      model: null,
      snippet: `<ph-list-group
  :items="[
    { label: 'Star', icon: 'star', speratedValue: 3 },
    { divider: true },
    { label: 'Action', icon: 'gear', action: true },
    { label: 'Favorite', icon: 'heart', action: true },
    { label: 'Unfavorite', icon: 'heart-pulse', action: false }
  ]"
  @select="model = $event"
/>`,
      propsData: [
        {
          name: "items",
          type: "Array",
          default: "[]",
          notes: "<code>{ label, href?, to?, icon?, badge?, disabled?, active?, header?, divider?, action? }</code>",
        },
        {
          name: "flush",
          type: "Boolean",
          default: "false",
          notes: "Remove borders",
        },
        {
          name: "numbered",
          type: "Boolean",
          default: "false",
          notes: "(reserved)",
        },
        {
          name: "horizontal",
          type: "Boolean | String",
          default: "false",
          notes: "true or breakpoint (sm..xxl)",
        }
      ]
    };
  },
};
</script>
