    />
  </div>
  <div class="col-md-4">
    <ph-stat
      label="Revenue"
      value="€12,345"
      delta="+12%"
      trend="up"
      icon="graph-up"
      variant="success"
    />
  </div>
</div>`,
      propsData: [
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "value",
          type: "String | Number",
          default: "''",
          notes: "",
        },
        {
          name: "delta",
          type: "String | Number",
          default: "null",
          notes: "Change amount",
        },
        {
          name: "trend",
          type: "String",
          default: "'neutral'",
          notes: "up | down | neutral",
        },
        {
          name: "icon",
          type: "String",
          default: "''",
          notes: "Bootstrap icon name",
        },
        {
          name: "iconSize",
          type: "String | Number",
          default: "'lg'",
          notes: "Size of the leading icon",
        },
        {
          name: "size",
          type: "String",
          default: "'md'",
          notes: "sm | md | lg — card scale; sizes the trend glyph",
        },
        {
          name: "iconVariant",
          type: "String",
