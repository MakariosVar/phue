<template>
  <example-factory
    tag="<ph-chip />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>
        Pill-shaped removable tag, built on <code>badge rounded-pill</code>.
        Disabled chips are visually dimmed <code>(opacity-50)</code> and non-interactive <code>(pe-none)</code>.
      </p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <div class="d-flex flex-wrap gap-2">
            <ph-chip
              v-for="(chip, i) in chips"
              :key="chip.label"
              :label="chip.label"
              :variant="chip.variant"
              :disabled="chip.disabled"
              :removable="chip.removable"
              @remove="chips.splice(i, 1)"
            />
          </div> 
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhBadge",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      chips: [
        { label: "PHP", variant: "primary", removable: false },
        { label: "JavaScript", variant: "secondary", disabled: true },
        { label: "Vue", variant: "success", removable: true },
        { label: "HTML", variant: "warning", removable: true },
        { label: "Phue", variant: "info", removable: true }
      ],
      snippet: `<ph-chip
  v-for="(chip, i) in chips"
  :key="chip.label"
  :label="chip.label"
  :variant="chip.variant"
  :disabled="chip.disabled"
  :removable="chip.removable"
  @remove="chips.splice(i, 1)"
/>`,
      propsData: [
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "Or default slot",
        },
        {
          name: "variant",
          type: "String",
          default: "'neutral'",
          notes: "primary | secondary | success | warning | error | info | neutral",
        },
        {
          name: "removable",
          type: "Boolean",
          default: "false",
          notes: "Renders the close button",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "Hides remove button, dims chip",
        },
      ]
    };
  },
};
</script>
