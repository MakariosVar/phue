<template>
  <example-factory
    tag="<ph-data-badge />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Small status label.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <strong class="mt-2"><small>Variants</small></strong>
          <div class="d-flex align-items-center gap-2">
            <ph-badge variant="primary" label="Primary" />
            <ph-badge variant="secondary" label="Secondary" />
            <ph-badge variant="success" label="Success" />
            <ph-badge variant="warning" label="Warning" />
            <ph-badge variant="error" label="Error" />
            <ph-badge variant="info" label="Info" />
            <ph-badge variant="neutral" label="Neutral" />
          </div>
          <strong class="mt-2"><small>Sizes</small></strong>
          <div class="d-flex align-items-center gap-2 my-1">
            <ph-badge :size="'lg'" variant="error" label="lg" />
            <ph-badge :size="'md'" variant="error" label="md" />
            <ph-badge :size="'sm'" variant="error" label="sm" />
          </div>
          <strong class="mt-2"><small>Pill</small></strong>
          <div class="d-flex align-items-center gap-2 my-1">
            <ph-badge :size="'lg'" variant="success" pill label="lg" />
            <ph-badge :size="'md'" variant="success" pill label="md" />
            <ph-badge :size="'sm'" variant="success" pill label="sm" />
          </div>
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhBadge",
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-badge variant="success" pill label="Deployed" />`,
      propsData: [
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "Or default slot",
        },
        {
          name: "variant",
          type: "String",
          default: "'neutral'",
          notes: "primary | secondary | success | warning | error | info | neutral",
        },
        {
          name: "size",
          type: "String",
          default: "'md'",
          notes: "sm | md | lg",
        },
        {
          name: "pill",
          type: "Boolean",
          default: "false",
          notes: "rounded-pill",
        },
      ]
    };
  },
};
</script>
