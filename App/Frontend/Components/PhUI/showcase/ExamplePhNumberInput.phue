          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "readonly",
          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "required",
          type: "Boolean",
          default: "false",
          notes: "",
        }
      ]
    };
  },
};
