      counter4: 40.323,
      snippet: `// Initial state
// counter1: 10
// counter2: 20.064
// counter3: 30
// counter4: 40.323

<div class="row">
  <div class="col-md-6">
    // Numeric input with increment/decrement controls
    <ph-number-input
      v-model="counter1"
      label="Counter 1"
      :min="0"
      :max="100"
      :step="5"
    />
  </div>
  <div class="col-md-6">
