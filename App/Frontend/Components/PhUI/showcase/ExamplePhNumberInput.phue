<template>
  <example-factory
    tag="<ph-number-input />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Numeric input with increment/decrement controls, min/max, step, precision.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <div class="row">
            <div class="col-md-6">
              <ph-number-input
                v-model="counter1"
                label="Counter 1"
                :min="0"
                :max="100"
                :step="5"
              />
            </div>
            <div class="col-md-6">
              <ph-number-input
                v-model="counter2"
