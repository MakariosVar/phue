    <ph-number-input
      v-model="counter2"
      label="Counter 2"
      :min="0"
      :max="100"
      :step="0.04"
      precision="2"
    />
  </div>
  <div class="col-md-6">
    // Disabled numeric input
    <ph-number-input
      v-model="counter3"
      label="Counter 3"
      disabled
      :min="0"
      :max="100"
      :step="5"
    />
  </div>
  <div class="col-md-6">
    // Read-only numeric input with error
    <ph-number-input
      v-model="counter4"
      label="Counter 4"
      error="Invalid Input"
      :controls="false"
      readonly
      :min="0"
      :max="100"
      :step="0.04"
    />
  </div>
</div>`,
      propsData: [
        {
          name: "modelValue",
          type: "String | Number",
          default: "''",
          notes: "",
        },
        {
          name: "id",
          type: "String",
          default: "null",
          notes: "",
        },
        {
          name: "min",
          type: "Number",
          default: "0",
          notes: "",
        },
        {
          name: "max",
          type: "Number",
          default: "100",
          notes: "",
        },
        {
          name: "step",
          type: "Number",
          default: "1",
          notes: "",
        },
        {
          name: "precision",
          type: "Number",
          default: "0",
          notes: "Decimal places",
        },
        {
          name: "controls",
          type: "Boolean",
          default: "true",
          notes: "Show ± buttons",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "placeholder",
          type: "String",
          default: "''",
