      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
          <ul>
            <li><code>update:modelValue</code></li>
            <li><code>blur</code></li>
            <li><code>focus</code></li>
          </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhNumberInput",
