<template>
  <example-factory
    tag="<ph-rich-text />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Rich-text editor with a formatting toolbar and <strong>two output
        modes</strong>: a sanitised HTML string, or Markdown. No editor library and
        no sanitizer library — the allow-list sanitizer and the Markdown converter
        are part of the component.
      </p>
      <p class="text-muted small mb-0">
        Only <code>p div br hr strong em u s code pre blockquote a ul ol li
        h1</code>–<code>h6</code> survive, with no attributes at all except
        <code>href</code>/<code>target</code>/<code>rel</code> on a link.
        <code>class</code> and <code>style</code> never do, and a
        <code>target="_blank"</code> is forced to carry
        <code>rel="noopener noreferrer"</code>.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          HTML mode
        </h6>
        <ph-rich-text v-model="htmlValue" name="description" label="Description" :min-height="140" />
        <code class="d-block small mt-2" style="white-space: pre-wrap;">{{ htmlValue }}</code>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Markdown mode
        </h6>
        <ph-rich-text
          v-model="markdownValue"
          mode="markdown"
          label="Release notes"
          :min-height="140"
          :toolbar-items="['bold', 'italic', 'link', 'ul', 'ol', 'quote', 'clear']"
        />
        <code class="d-block small mt-2" style="white-space: pre-wrap;">{{ markdownValue }}</code>
        <p class="text-body-secondary small mt-2 mb-0">
          Switching the mode in the toolbar converts the content — it never
          reinterprets the old value. Try toggling the switch above.
        </p>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Read-only render of the Markdown
        </h6>
        <ph-rich-text :model-value="markdownValue" mode="markdown" readonly />

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Sanitiser
        </h6>
        <p class="small text-body-secondary">
          The sanitizer is a method, so the guarantee is available to a caller too.
          This value is the one below with the payload appended.
        </p>
        <ph-rich-text v-model="dirty" label="Try pasting a payload" :min-height="90" />
        <code class="d-block small mt-2" style="white-space: pre-wrap;">{{ dirty }}</code>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li><code>update:modelValue(value)</code> — always sanitised, in the current mode</li>
          <li><code>change(value)</code>, <code>focus</code>, <code>blur</code></li>
          <li><code>mode-change(next)</code></li>
        </ul>

        <strong>Methods</strong>
        <ul>
          <li><code>sanitize(html)</code> — the allow-list sanitizer</li>
          <li><code>toMarkdown(html)</code>, <code>fromMarkdown(md)</code></li>
          <li><code>setMode(next)</code></li>
        </ul>

        <strong>Toolbar keys</strong>
        <p class="mb-0">
          <code>bold</code>, <code>italic</code>, <code>underline</code>,
          <code>strike</code>, <code>inline-code</code>, <code>divider</code>,
          <code>p</code>, <code>h2</code>, <code>h3</code>, <code>ul</code>,
          <code>ol</code>, <code>quote</code>, <code>pre</code>,
          <code>link</code>, <code>hr</code>, <code>clear</code>.
        </p>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhRichText",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,

      htmlValue: "<p>Revenue grew <strong>12%</strong> week over week, driven by " +
        "<em>annual plans</em>. See the <a href=\"https://example.test/report\">full report</a>.</p>",
      markdownValue: "# Release 4.2\n\nAdds the new editor and a lot of bug fixes.\n\n- carousel\n- otp input",
      dirty: "<p>Plain text.</p>",

      snippet: `<!-- HTML value -->
<ph-rich-text v-model="body" name="description" label="Description" />

<!-- Markdown value: store it as source, diff it, review it -->
<ph-rich-text v-model="notes" name="notes" mode="markdown" label="Release notes" />

<!-- A shorter toolbar, no mode switch -->
<ph-rich-text v-model="comment"
              :toolbar-items="['bold', 'italic', 'link']"
              :show-mode-toggle="false"
              :min-height="120" />

<!-- Render only: the toolbar and the editing surface are gone -->
<ph-rich-text :model-value="notes" mode="markdown" readonly />

// The sanitizer is a method, so the guarantee is available to a caller too
// <ph-rich-text ref="editor" />
// this.$refs.editor.sanitize(untrustedHtml)`,

      propsData: [
        { name: "modelValue", type: "String", default: "''", notes: "The document, <strong>in the current mode</strong>" },
        { name: "mode", type: "String", default: "'html'", notes: "<code>html</code> | <code>markdown</code>. Switching it <strong>converts</strong> the content" },
        { name: "label", type: "String", default: "''", notes: "" },
        { name: "name", type: "String", default: "''", notes: "Forwarded to a hidden input, so <code>&lt;ph-form&gt;</code> can validate and submit it. The editing surface is a <code>contenteditable</code> div, which is not labelable" },
        { name: "ariaLabel", type: "String", default: "'Rich text'", notes: "Accessible name, used only when no visible <code>label</code> is rendered" },
        { name: "placeholder", type: "String", default: "''", notes: "Drawn on the first cell while the document is empty" },
        { name: "helperText", type: "String", default: "''", notes: "" },
        { name: "error", type: "String", default: "''", notes: "" },
        { name: "readonly", type: "Boolean", default: "false", notes: "Renders the content with no toolbar and no editing surface" },
        { name: "disabled", type: "Boolean", default: "false", notes: "" },
        { name: "required", type: "Boolean", default: "false", notes: "" },
        { name: "spellcheck", type: "Boolean", default: "true", notes: "" },
        { name: "toolbar", type: "Boolean", default: "true", notes: "" },
        { name: "toolbarItems", type: "Array", default: "null", notes: "Command keys to show, in order. Omit for the full default surface" },
        { name: "showModeToggle", type: "Boolean", default: "true", notes: "The HTML/Markdown switch" },
        { name: "minHeight", type: "String | Number", default: "0", notes: "Editing surface height; a number is px" },
        { name: "maxWidth", type: "String | Number", default: "0", notes: "" },
      ],
    };
  },
};
</script>