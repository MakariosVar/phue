<template>
  <example-factory
    tag="<ph-otp-input />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        One-time-code entry: N visible cells backed by a <strong>single</strong>
        input. Platform autofill works because the real field carries
        <code>autocomplete="one-time-code"</code>.
      </p>
      <p class="text-muted small mb-0">
        N real inputs would be N anonymous single-character textboxes to a screen
        reader, and would turn every paste and caret move into a cell-navigation
        state machine. Here the browser's own editing model does the work.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Six digits, plain
        </h6>
        <ph-otp-input
          v-model="code"
          label="Verification code"
          helper-text="Paste it — separators are dropped, not rejected."
          @complete="onComplete"
        />
        <code class="d-block small mt-2">code = "{{ code }}" ({{ code.length }} / 6)</code>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          Alphanumeric, masked
        </h6>
        <ph-otp-input
          v-model="recovery"
          :length="8"
          type="alphanumeric"
          masked
          size="sm"
          label="Recovery key"
          :autocomplete="false"
        />
        <code class="d-block small mt-2">recovery = "{{ recovery }}"</code>

        <hr class="my-4" />

        <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">
          With an error
        </h6>
        <ph-otp-input v-model="pin" :length="4" label="PIN" :error="pinError" />
        <p class="text-body-secondary small mt-2 mb-0">
          {{ pinError }}
        </p>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="520px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />

        <strong>Emits</strong>
        <ul>
          <li><code>update:modelValue(code)</code></li>
          <li><code>complete(code)</code> — <strong>once</strong>, on the transition into a full value</li>
          <li><code>paste-rejected(original)</code> — a paste with nothing usable in it</li>
        </ul>

        <strong>Methods</strong>
        <ul>
          <li><code>focus()</code>, <code>clear()</code></li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhOtpInput",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,

      code: "",
      recovery: "",
      pin: "",
      pinError: "That PIN is not 1234.",
      lastComplete: "",

      snippet: `<!-- The common case: verify as soon as the code is complete -->
<ph-otp-input v-model="code" @complete="verify(code)" />

<ph-otp-input v-model="pin" :length="4" label="PIN" :error="pinError" />

<!-- Alphanumeric and masked; no platform autofill for a recovery key -->
<ph-otp-input
  v-model="recovery"
  :length="8"
  type="alphanumeric"
  masked
  :autocomplete="false"
/>`,

      propsData: [
        { name: "modelValue", type: "String", default: "''", notes: "The code, as a <strong>string</strong> — so <code>007</code> survives" },
        { name: "length", type: "Number", default: "6", notes: "Number of cells" },
        { name: "type", type: "String", default: "'numeric'", notes: "<code>numeric</code> \\| <code>alphanumeric</code>" },
        { name: "masked", type: "Boolean", default: "false", notes: "Dots instead of characters" },
        { name: "autocomplete", type: "Boolean", default: "true", notes: "Sets <code>autocomplete=\"one-time-code\"</code>, which is what makes platform autofill work" },
        { name: "size", type: "String", default: "'md'", notes: "<code>sm</code> \\| <code>md</code> \\| <code>lg</code> — the cell box" },
        { name: "id", type: "String", default: "''", notes: "Falls back to a generated id" },
        { name: "name", type: "String", default: "''", notes: "Forwarded to the real input, so <code>&lt;ph-form&gt;</code> can validate and submit it" },
        { name: "label", type: "String", default: "''", notes: "" },
        { name: "ariaLabel", type: "String", default: "'Verification code'", notes: "Accessible name, used only when no visible <code>label</code> is rendered" },
        { name: "helperText", type: "String", default: "''", notes: "" },
        { name: "error", type: "String", default: "''", notes: "" },
        { name: "required", type: "Boolean", default: "false", notes: "" },
        { name: "disabled", type: "Boolean", default: "false", notes: "" },
        { name: "autofocus", type: "Boolean", default: "false", notes: "" },
      ],
    };
  },
  methods: {
    onComplete(value) {
      this.lastComplete = value;
    },
  },
};
</script>