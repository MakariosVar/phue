<template>
  <example-factory
    tag="<ph-range />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>Range slider (single or dual) with optional value display.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <ph-range v-model="priceRange" :min="0" :max="1000" show-value label="Price" />
          <ph-range v-model="priceRangeDual" :min="0" :max="1000" dual show-value label="Price" />
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
        <ul>
          <li><code>update:modelValue</code> on <code>change</code></li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhRange",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      priceRange: 300,
      priceRangeDual: [200, 800],
      snippet: `<ph-range v-model="priceRange" :min="0" :max="1000" dual show-value label="Price" />`,
      propsData: [
        {
          name: "modelValue",
          type: "Number | Array",
          default: "0",
          notes: "Array <code>[min, max]</code> when <code>dual</code>",
        },
        {
          name: "id",
          type: "String",
          default: "null",
          notes: "",
        },
        {
          name: "name",
          type: "String",
          default: "''",
          notes: "Forwarded to the inner control, so <code>&lt;ph-form&gt;</code> can validate and submit it",
        },
        {
          name: "min",
          type: "Number",
          default: "0",
          notes: "",
        },
        {
          name: "max",
          type: "Number",
          default: "100",
          notes: "",
        },
        {
          name: "step",
          type: "Number",
          default: "1",
          notes: "",
        },
        {
          name: "dual",
          type: "Boolean",
          default: "false",
          notes: "Dual thumb",
        },
        {
          name: "showValue",
          type: "Boolean",
          default: "false",
          notes: "Display value",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "",
        }
      ]
    };
  },
};
</script>
