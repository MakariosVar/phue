<template>
  <example-factory
    tag="<ph-checkbox />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Boolean checkbox with optional indeterminate visual state.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
            <ph-checkbox v-model="accepted" label="I agree to the terms" />
            <ph-checkbox v-model="partial" indeterminate>Parent has children</ph-checkbox>
            <ph-checkbox v-model="acceptAll" disabled indeterminate>Accept all options</ph-checkbox>
            <ph-checkbox v-model="blocked" disabled>I read the terms</ph-checkbox>
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
          <ul>
            <li><code>update:modelValue</code> on <code>change</code></li>
            <li><code>blur</code></li>
            <li><code>focus</code></li>
          </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhCheckbox",
  data() {
    return {
      loading: false,
      disabled: false,
      showCode: false,
      showDemo: true,
      showProps: true,
      accepted: false,
      partial: false,
      acceptAll: true,
      blocked: false,
      snippet: `<ph-checkbox v-model="accepted" label="I agree to the terms" />
<ph-checkbox v-model="partial" indeterminate>Parent has children</ph-checkbox>
<ph-checkbox v-model="acceptAll" disabled indeterminate>Accept all options</ph-checkbox>
<ph-checkbox v-model="blocked" disabled>I read the terms</ph-checkbox>`,
      propsData: [
        {
          name: "name",
          type: "String",
          default: "''",
          notes: "Forwarded to the inner control, so <code>&lt;ph-form&gt;</code> can validate and submit it",
        },
        {
          name: "modelValue",
          type: "Boolean",
          default: `false`,
          notes: "Bound via <strong>v-model</strong>",
        },
        {
            name: "label",
            type: "String",
            default: "''",
            notes: "Falls back to default slot",
        },
        {
          name: "indeterminate",
          type: "Boolean",
          default: "false",
          notes:'Applied live via the DOM property',
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes:'',
        },


      ],
    };
  },
};
</script>
