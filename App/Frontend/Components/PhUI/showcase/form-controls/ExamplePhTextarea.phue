<template>
  <example-factory
    tag="<ph-textarea />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Native select bound to modelValue. Options accept either objects <code>{ label, value, disabled? }</code> or plain primitives (normalized internally).</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
            <ph-textarea
                v-model="message"
                label="Message"
                :rows="5"
                resize="vertical"
                :helper-text="(message ? message.length : 0) + '/500'"
            />
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
          <ul>
            <li><code>update:modelValue</code> on <code>change</code></li>
            <li><code>blur</code></li>
            <li><code>focus</code></li>
          </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhTextarea",
  data() {
    return {
      loading: false,
      disabled: false,
      showCode: false,
      showDemo: true,
      showProps: true,
      message: "",
      snippet: `<ph-textarea
    v-model="message"
    label="Message"
    :rows="5"
    resize="vertical"
    :helper-text="(message ? message.length : 0) + '/500'"
/>`,
      propsData: [
        {
          name: "modelValue",
          type: "String | Number",
          default: `''`,
          notes: "Bound via <strong>v-model</strong>",
        },
        {
            name: "id",
            type: "String",
            default: 'null',
            notes: "Falls back to <strong>ph-textarea-<_id></strong>",
        },
        {
            name: "name",
            type: "String",
            default: "''",
            notes: "Forwarded to the inner control, so <code>&lt;ph-form&gt;</code> can validate and submit it",
        },
        {
            name: "rows",
            type: "Number",
            default: '4',
            notes: "",
        },
        {
          name: "resize",
          type: "String",
          default: "'vertical'",
          notes: "none | both | horizontal | vertical",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: '<strong>*</strong> marker when required',
        },
        {
          name: "placeholder",
          type: "String",
          default: "''",
          notes: '',
        },
        {
          name: "helperText",
          type: "String",
          default: "''",
          notes: '',
        },
        {
            name: "error",
            type: "String",
            default: "''",
            notes: 'Non-empty -> is-invalid + red `form-text`',
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes:'',
        },
        {
          name: "readonly",
          type: "Boolean",
          default: "false",
          notes:'',
        },
        {
          name: "required",
          type: "Boolean",
          default: "false",
          notes:'Visual only',
        },


      ],
    };
  },
};
</script>
