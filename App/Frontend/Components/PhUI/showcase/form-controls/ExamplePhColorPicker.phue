<template>
  <example-factory
    tag="&lt;ph-color-picker&gt;"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Swatches plus a hex field. The default palette is <b>Bootstrap's own</b>,
        so a swatch and a <code>text-primary</code> element are the same colour —
        and both follow the theme in dark mode.
      </p>
      <p class="mb-0">
        Input is normalised on the way in: <code>#abc</code> expands to
        <code>#aabbcc</code>, a missing <code>#</code> is added, and anything
        unparseable is passed through untouched so the field keeps showing what
        you are typing.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-row gutter="4">
          <ph-col span="12" md="6">
            <ph-color-picker v-model="brand" label="Brand colour" />
          </ph-col>
          <ph-col span="12" md="6">
            <ph-color-picker v-model="accent" label="With alpha" alpha />
          </ph-col>
          <ph-col span="12" md="6">
            <ph-color-picker v-model="swatch" label="Swatches only" swatches-only />
          </ph-col>
          <ph-col span="12" md="6">
            <ph-color-picker v-model="disabledOne" label="Disabled" disabled />
          </ph-col>
        </ph-row>

        <ph-text size="sm" color="muted" class="mt-3">
          brand=<strong>{{ brand || '—' }}</strong> ·
          accent=<strong>{{ accent || '—' }}</strong> ·
          swatch=<strong>{{ swatch || '—' }}</strong>
        </ph-text>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <ph-text>
          <code>alpha</code> emits an 8-digit hex
          (<code>#rrggbbaa</code>), so the value stays a plain string and
          round-trips through a form payload without a colour object. A swatch
          counts as selected when the RGB matches, so picking one clears a stale
          alpha instead of looking unselected.
        </ph-text>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhColorPicker",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      brand: '#0d6efd',
      accent: '#198754',
      swatch: '#dc3545',
      disabledOne: '',
      snippet: `<ph-row gutter="4">
  <ph-col span="12" md="6">
    <ph-color-picker v-model="brand" label="Brand colour" />
  </ph-col>
  <ph-col span="12" md="6">
    <ph-color-picker v-model="accent" label="With alpha" alpha />
  </ph-col>
  <ph-col span="12" md="6">
    <ph-color-picker v-model="swatch" label="Swatches only" swatches-only />
  </ph-col>
  <ph-col span="12" md="6">
    <ph-color-picker v-model="disabledOne" label="Disabled" disabled />
  </ph-col>
</ph-row>

<ph-text size="sm" color="muted" class="mt-3">
  brand=<strong>{{ brand || '—' }}</strong> ·
  accent=<strong>{{ accent || '—' }}</strong> ·
  swatch=<strong>{{ swatch || '—' }}</strong>
</ph-text>`,
      propsData: [
        {
          name: "modelValue",
          type: "String",
          default: "''",
          notes: "v-model; #rrggbb or #rrggbbaa",
        },
        {
          name: "palette",
          type: "Array",
          default: "Bootstrap's 12",
          notes: "Swatch colours; any CSS colour",
        },
        {
          name: "swatchesOnly",
          type: "Boolean",
          default: "false",
          notes: "Hide the hex field",
        },
        {
          name: "hex",
          type: "Boolean",
          default: "true",
          notes: "Show the inline hex input",
        },
        {
          name: "alpha",
          type: "Boolean",
          default: "false",
          notes: "Alpha slider; 8-digit output",
        },
        {
          name: "maxRecent",
          type: "Number",
          default: "6",
          notes: "Recently used swatches kept",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "helperText",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "error",
          type: "String",
          default: "''",
          notes: "Red message under the control",
        },
        {
          name: "placeholder",
          type: "String",
          default: "'#000000'",
          notes: "Hex-field placeholder",
        },
        {
          name: "id",
          type: "String",
          default: "null",
          notes: "Auto-generated when omitted",
        },
        {
          name: "name",
          type: "String",
          default: "''",
          notes: "Forwarded to the hex field, so <ph-form> submits it",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "required",
          type: "Boolean",
          default: "false",
          notes: "Marks the label with *",
        }
      ]
    };
  }
};
</script>
