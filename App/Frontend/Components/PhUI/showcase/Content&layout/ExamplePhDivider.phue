<template>
  <example-factory
    tag="<ph-divider />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Horizontal or vertical divider with optional label and variant.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-divider label="Section" variant="primary" />
        <ph-flex align="center" justify="center" gap="sm">
          <ph-text as="span" size="lg">Filters</ph-text>
          <ph-divider orientation="vertical"/>
          <ph-text as="span" size="lg">Export</ph-text>
        </ph-flex>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhDivider",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-divider label="Section" variant="primary" />
<ph-flex align="center" justify="center" gap="sm">
  <ph-text as="span" size="lg">Filters</ph-text>
  <ph-divider orientation="vertical"/>
  <ph-text as="span" size="lg">Export</ph-text>
</ph-flex>`,
      propsData: [
        {
          name: "orientation",
          type: "String",
          default: "'horizontal'",
          notes: "horizontal | vertical",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "Centered label",
        },
        {
          name: "variant",
          type: "String",
          default: "''",
          notes: "Color variant",
        },
        {
          name: "spacing",
          type: "String | Number",
          default: "'md'",
          notes: "Margin around",
        }
      ]
    };
  }
};
</script>
