<template>
  <example-factory
    tag="<ph-spacer />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Tiny non-collapsing spacer (<code>flex-shrink-0</code>, <code>aria-hidden</code>).
        <code>horizontal</code> swaps the dominant axis.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-row>
          <ph-col span="6">
            <ph-stack gap="none">
              <span>Above the gap</span>
              <ph-spacer size="lg" class="bg-secondary" />
              <span>Below the gap</span>
            </ph-stack>
          </ph-col>
          <ph-col span="6">
            <ph-flex justify="center" align="center" class="h-100">
              <span>Left from gap</span>
              <ph-spacer size="sm" class="bg-secondary" horizontal />
              <span>Right from gap</span>
            </ph-flex>
          </ph-col>
        </ph-row>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhSpacer",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-spacer size="lg" class="bg-secondary" />
<ph-spacer size="sm" class="bg-secondary" horizontal />`,
      propsData: [
        {
          name: "size",
          type: "String | Number",
          default: "'md'",
          notes: "Scale / px / raw CSS",
        },
        {
          name: "horizontal",
          type: "Boolean",
          default: "false",
          notes: "Width vs height",
        }
      ]
    };
  }
};
</script>
