<template>
  <example-factory
    tag="<ph-stack />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Vertical flex flow.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-stack gap="lg" align="center">
          <div>A</div><div>B</div><div>C</div>
        </ph-stack>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhStack",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      snippet: `<ph-stack gap="lg" align="center">
  <div>A</div><div>B</div><div>C</div>
</ph-stack>`,
      propsData: [
        {
          name: "gap",
          type: "String | Number",
          default: "'md'",
          notes: "Scale / px / raw CSS",
        },
        {
          name: "align",
          type: "String",
          default: "'stretch'",
          notes: "stretch | flex-start | center | flex-end | baseline",
        }
      ]
    };
  }
};
</script>
