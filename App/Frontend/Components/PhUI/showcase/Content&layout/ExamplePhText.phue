          <ph-text align="right" class="m-0">align="right"</ph-text>
        </div>
        <div class="my-2" style="max-width: 380px;">
          <ph-text align="justify" size="sm">align="justify" — this copy fills every line edge to edge, so both margins stay flush all the way down.</ph-text>
        </div>
        <hr />

        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Tag (as)</ph-text>
        <div class="my-2 d-flex flex-wrap align-items-baseline gap-3">
          <ph-text as="span" size="sm" color="muted">as="span"</ph-text>
          <ph-text as="label" size="sm" color="main">as="label"</ph-text>
          <ph-text as="div" size="sm" color="muted">as="div"</ph-text>
          <ph-text as="h4" weight="bold">as="h4"</ph-text>
        </div>
        <hr />

        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Truncate</ph-text>
        <div class="my-2" style="max-width: 260px;">
          <ph-text truncate weight="medium">reports/2026/quarterly-revenue-forecast-final.xlsx</ph-text>
        </div>
        <div class="my-2" style="max-width: 260px;">
          <ph-text size="sm" color="muted">This same string without truncate — it wraps onto several lines instead of clipping, because the element keeps its natural flow.</ph-text>
        </div>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
      </ph-card>
    </template>
  </example-factory>
</template>

