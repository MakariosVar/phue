    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        Typography via props instead of utility classes.
        Renders a dynamic element (<code>:is="as"</code>, default <code>p</code>).
      </p>
    </template>

