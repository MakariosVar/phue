<template>
  <example-factory
    tag="&lt;ph-icon&gt;"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
    @scrollToTag="$emit('setAnchor', $event)"
  >
    <template #description>
      <p>
        The icon primitive — every other PhUI component with an <code>icon</code>
        prop renders through it. Maps <code>name</code> to a
        <code>bi-&lt;name&gt;</code> Bootstrap Icons glyph.
      </p>
    </template>

    <template #demo>
      <ph-card v-if="showDemo">
        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Size</ph-text>
        <div class="my-2 d-flex align-items-center gap-3">
          <ph-icon v-for="s in sizes" :key="s" name="star-fill" :size="s" />
          <ph-text size="xs" color="muted">xs → 2xl</ph-text>
        </div>
        <div class="mt-2 d-flex align-items-center gap-3">
          <ph-icon name="chevron-down" :size="16" />
          <ph-icon name="chevron-down" :size="'2.5rem'" />
        </div>
        <ph-text size="xs" color="muted">a number is pixels, a string is raw CSS</ph-text>

        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Variant</ph-text>
        <div class="my-2 d-flex align-items-center gap-3">
          <ph-icon v-for="v in variants" :key="v" name="circle-fill" :variant="v" size="lg" />
        </div>

        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Spin</ph-text>
        <div class="my-2 d-flex align-items-center gap-3">
          <ph-icon name="arrow-repeat" spin size="lg" label="Refreshing" />
        </div>
        <ph-text size="xs" color="muted">reuses Bootstrap's spinner animation</ph-text>

        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Accessibility</ph-text>
        <ph-text size="xs" color="muted" class="mt-1 mb-2">
          With no <code>label</code> the icon is <code>aria-hidden</code> — a decorative
          glyph next to real text. Pass <code>label</code> when the icon is the only
          content of a control, or the control has no accessible name.
        </ph-text>
        <div class="my-2 d-flex align-items-center gap-3">
          <ph-button variant="primary" size="sm" aria-label="Save">
            <ph-icon name="check-lg" />
          </ph-button>
          <ph-text size="xs" color="muted">label="Save" → role="img" + aria-label</ph-text>
        </div>
        <div class="my-2 d-flex align-items-center gap-3">
          <ph-button variant="primary" size="sm">
            <ph-icon name="download" class="me-1" />
            Download
          </ph-button>
          <ph-text size="xs" color="muted">no label → hidden from the a11y tree</ph-text>
        </div>

        <ph-text class="mt-2" size="xs" weight="semibold" color="muted">Color — raw CSS override</ph-text>
        <div class="my-2 d-flex align-items-center gap-3">
          <ph-icon name="gem" size="xl" color="#6f42c1" />
          <ph-text size="xs" color="muted">color="#6f42c1" beats variant</ph-text>
        </div>
      </ph-card>
    </template>

    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>

    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <ph-text>
          An unknown <code>name</code> emits <code>bi-&lt;name&gt;</code> anyway, so a
          typo renders an empty box rather than throwing. <code>error</code> and
          <code>neutral</code> are aliases onto <code>danger</code> and
          <code>secondary</code>, so a variant name is never silently dropped.
        </ph-text>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhIcon",
  emits: ['setAnchor'],
  data() {
    return {
      showCode: false,
      showDemo: true,
      showProps: true,
      sizes: ['xs', 'sm', 'md', 'lg', 'xl', '2xl'],
      variants: ['primary', 'secondary', 'success', 'warning', 'danger', 'info', 'muted', 'light', 'dark'],
      snippet: `<ph-text class="mt-2" size="xs" weight="semibold" color="muted">Size</ph-text>
<div class="my-2 d-flex align-items-center gap-3">
  <ph-icon v-for="s in sizes" :key="s" name="star-fill" :size="s" />
  <ph-text size="xs" color="muted">xs → 2xl</ph-text>
</div>
<div class="mt-2 d-flex align-items-center gap-3">
  <ph-icon name="chevron-down" :size="16" />
  <ph-icon name="chevron-down" :size="'2.5rem'" />
</div>
<ph-text size="xs" color="muted">a number is pixels, a string is raw CSS</ph-text>

<ph-text class="mt-2" size="xs" weight="semibold" color="muted">Variant</ph-text>
<div class="my-2 d-flex align-items-center gap-3">
  <ph-icon v-for="v in variants" :key="v" name="circle-fill" :variant="v" size="lg" />
</div>

<ph-text class="mt-2" size="xs" weight="semibold" color="muted">Spin</ph-text>
<div class="my-2 d-flex align-items-center gap-3">
  <ph-icon name="arrow-repeat" spin size="lg" label="Refreshing" />
</div>
<ph-text size="xs" color="muted">reuses Bootstrap's spinner animation</ph-text>

<ph-text class="mt-2" size="xs" weight="semibold" color="muted">Accessibility</ph-text>
<ph-text size="xs" color="muted" class="mt-1 mb-2">
  With no <code>label</code> the icon is <code>aria-hidden</code> — a decorative
  glyph next to real text. Pass <code>label</code> when the icon is the only
  content of a control, or the control has no accessible name.
</ph-text>
<div class="my-2 d-flex align-items-center gap-3">
  <ph-button variant="primary" size="sm" aria-label="Save">
    <ph-icon name="check-lg" />
  </ph-button>
  <ph-text size="xs" color="muted">label="Save" → role="img" + aria-label</ph-text>
</div>
<div class="my-2 d-flex align-items-center gap-3">
  <ph-button variant="primary" size="sm">
    <ph-icon name="download" class="me-1" />
    Download
  </ph-button>
  <ph-text size="xs" color="muted">no label → hidden from the a11y tree</ph-text>
</div>

<ph-text class="mt-2" size="xs" weight="semibold" color="muted">Color — raw CSS override</ph-text>
<div class="my-2 d-flex align-items-center gap-3">
  <ph-icon name="gem" size="xl" color="#6f42c1" />
  <ph-text size="xs" color="muted">color="#6f42c1" beats variant</ph-text>
</div>`,
      propsData: [
        {
          name: "name",
          type: "String",
          default: "required",
          notes: "Bootstrap Icons name, e.g. check, trash",
        },
        {
          name: "size",
          type: "String | Number",
          default: "'md'",
          notes: "xs..2xl | px number | raw CSS",
        },
        {
          name: "variant",
          type: "String",
          default: "''",
          notes: "primary | secondary | success | warning | danger | error | info | muted | neutral | light | dark",
        },
        {
          name: "color",
          type: "String",
          default: "''",
          notes: "Raw CSS color; overrides variant",
        },
        {
          name: "spin",
          type: "Boolean",
          default: "false",
          notes: "Animated rotation",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "role=img + aria-label; otherwise aria-hidden",
        }
      ]
    };
  },
};
</script>
