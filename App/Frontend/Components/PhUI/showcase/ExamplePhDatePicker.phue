<template>
  <example-factory
    tag="<ph-date-picker />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Date / datetime picker with a self-contained calendar popover, or a native input via <code>native</code> prop.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <!-- Date only, bounded -->
          <ph-date-picker
            v-model="dueOn"
            :label="`Due date` + (dueOn ? ` (${dueOn})` : '')"
            mode="date" 
            in="2026-01-01"
            max="2026-12-31"
            helper-text="Within the current year."
            class="mb-3"
          />

          <!-- Date + time + Sunday first -->
          <ph-date-picker
            v-model="startsAt"
            :label="`Starts at` + (startsAt ? ` (${startsAt})` : '')"
            class="mb-3"
            :week-start="0"
            mode="datetime"
          />

          <!-- Native input -->
          <ph-date-picker
            v-model="publishedOn"
            :label="`Native Picker` + (publishedOn ? ` (${publishedOn})` : '')"
            class="mb-3"
            native
          />

          <!-- Disabled and invalid input, -->
          <ph-date-picker
            v-model="publishedAt"
            :label="`Native Picker` + (publishedAt ? ` (${publishedAt})` : '')"
            disabled
            :error="`Invalid date`"
          />
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
        <ul>
          <li><code>update:modelValue</code></li>
          <li><code>change</code></li>
          <li><code>open</code></li>
          <li><code>close</code></li>
          <li><code>clear</code></li>
        </ul>
        <p>
          <code>modelValue</code> is always an ISO string (<code>YYYY-MM-DD</code>, or <code>YYYY-MM-DDTHH:mm</code> in <code>datetime</code> mode)
          — never a Date — so it round-trips through <code>v-model</code> into a form payload without a serialisation step.
        </p>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhDatePicker",
  data() {
    return {
      showCode: false,
      showDemo: false,
      showProps: true,
      dueOn: null,
      startsAt: null,
      publishedOn: null,
      publishedAt: '2023-29-02',
      snippet: `<!-- Date only, bounded -->
<ph-date-picker
  v-model="dueOn"
  :label="\`Due date\` + (dueOn ? \` (\${dueOn})\` : '')"
  mode="date" 
  in="2026-01-01"
  max="2026-12-31"
  helper-text="Within the current year."
  class="mb-3"
/>

<!-- Date + time + Sunday first -->
<ph-date-picker
  v-model="startsAt"
  :label="\`Starts at\` + (startsAt ? \` (\${startsAt})\` : '')"
  class="mb-3"
  :week-start="0"
  mode="datetime"
/>

<!-- Native input -->
<ph-date-picker
  v-model="publishedOn"
  :label="\`Native Picker\` + (publishedOn ? \` (\${publishedOn})\` : '')"
  class="mb-3"
  native
/>

<!-- Disabled and invalid input, -->
<ph-date-picker
  v-model="publishedAt"
  :label="\`Native Picker\` + (publishedAt ? \` (\${publishedAt})\` : '')"
  disabled
  :error="\`Invalid date\`"
/>`,
      propsData: [
        {
          name: "modelValue",
          type: "String",
          default: "''",
          notes: "ISO <code>YYYY-MM-DD</code> or <code>YYYY-MM-DDTHH:mm</code>",
        },
        {
          name: "mode",
          type: "String",
          default: "'date'",
          notes: "date | datetime",
        },
        {
          name: "min",
          type: "String",
          default: "''",
          notes: "ISO lower bound",
        },
        {
          name: "max",
          type: "String",
          default: "''",
          notes: "ISO upper bound",
        },
        {
          name: "native",
          type: "Boolean",
          default: "false",
          notes: "Use native <code>&lt;input type=\"date\"&gt;</code>",
        },
        {
          name: "weekStart",
          type: "Number",
          default: "1",
          notes: "0 = Sunday. Not working with <code>native</code>",
        },
        {
          name: "id",
          type: "String",
          default: "null",
          notes: "Falls back to ph-date-picker-&lt;id&gt;",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "placeholder",
          type: "String",
          default: "'Select date…'",
          notes: "",
        },
        {
          name: "helperText",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "error",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "required",
          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "clearable",
          type: "Boolean",
          default: "true",
          notes: "",
        }
      ]
    };
  },
};
</script>
