<template>
  <example-factory
    tag="<ph-file-input />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>File picker with drag & drop, <code>accept</code> and <code>maxSize</code> validation and image previews.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
          <!-- Images only, 2 MB cap, with thumbnails -->
          <ph-file-input
            v-model="attachments"
            multiple
            accept="image/*"
            :max-size="2097152"
            label="Screenshots"
            helper-text="PNG or JPG, up to 2 MB each."
            @error="onUploadError"
          />

          <!-- Any file, drop zone off, no previews -->
          <ph-file-input
            v-model="contract"
            accept=".pdf,.docx"
            :drag-drop="false"
            :preview="false"
          />
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
        <ul>
          <li><code>update:modelValue</code></li>
          <li><code>change(files)</code></li>
          <li><code>remove(files)</code></li>
          <li><code>error(reason)</code></li>
        </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhFileInput",
  data() {
    return {
      showCode: false,
      showDemo: false,
      showProps: true,
      attachments: [],
      contract: [],
      snippet: `<!-- Images only, 2 MB cap, with thumbnails -->
<ph-file-input
  v-model="attachments"
  multiple
  accept="image/*"
  :max-size="2097152"
  label="Screenshots"
  helper-text="PNG or JPG, up to 2 MB each."
  @error="onUploadError"
/>

<!-- Any file, drop zone off, no previews -->
<ph-file-input
  v-model="contract"
  accept=".pdf,.docx"
  :drag-drop="false"
  :preview="false"
/>`,
      propsData: [
        {
          name: "modelValue",
          type: "Array",
          default: "[]",
          notes: "File[]",
        },
        {
          name: "multiple",
          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "accept",
          type: "String",
          default: "''",
          notes: "Comma list of mime types / extensions",
        },
        {
          name: "maxSize",
          type: "Number",
          default: "0",
          notes: "Max bytes (0 = unlimited)",
        },
        {
          name: "dragDrop",
          type: "Boolean",
          default: "true",
          notes: "",
        },
        {
          name: "preview",
          type: "Boolean",
          default: "true",
          notes: "Image thumbnails",
        },
        {
          name: "label",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "helperText",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "error",
          type: "String",
          default: "''",
          notes: "",
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes: "",
        },
        {
          name: "required",
          type: "Boolean",
          default: "false",
          notes: "",
        }
      ]
    };
  },
};
</script>
