<template>
  <example-factory
    tag="<ph-radio />"
    :showCode="showCode"
    :showDemo="showDemo"
    :showProps="showProps"
    @toggleCode="showCode = !showCode"
    @toggleDemo="showDemo = !showDemo"
    @toggleProps="showProps = !showProps"
  >
    <template #description>
      <p>Radio input. A group is created by sharing the same <code>name</code>; equality with the group's  <code>modelValue</code> drives <code>checked</code>.</p>
    </template>
    <template #demo>
        <ph-card v-if="showDemo">
            <ph-radio v-model="plan" name="plan" value="free" label="Free" />
            <ph-radio v-model="plan" name="plan" value="pro">Pro</ph-radio>
            <ph-radio v-model="plan" disabled name="plan" value="enterprise" label="Enterprise" />
            <p>Plan: <code>{{ plan }}</code></p>
        </ph-card>
    </template>
    <template #snippet>
      <div v-if="showCode" class="mt-3">
        <ph-code language="vue" :code="snippet" maxHeight="450px" />
      </div>
    </template>
    <template #props>
      <ph-card class="mt-3" v-if="showProps">
        <h4>Props</h4>
        <props-table :items="propsData" />
        <strong>Emits:</strong>
          <ul>
            <li><code>update:modelValue</code> (Emits the radio's <code>value</code>).</li>
          </ul>
      </ph-card>
    </template>
  </example-factory>
</template>

<script>
export default {
  name: "ExamplePhInput",
  data() {
    return {
      showCode: false,
      showDemo: false,
      showProps: true,
      plan: 'free',
      snippet: `<ph-radio v-model="plan" name="plan" value="free" label="Free" />
<ph-radio v-model="plan" name="plan" value="pro">Pro</ph-radio>
<ph-radio v-model="plan" disabled name="plan" value="enterprise" label="Enterprise" />`,
      propsData: [
        {
          name: "modelValue",
          type: "String | Number | Boolean",
          default: `null`,
          notes: "Bound via <strong>v-model</strong>",
        },
        {
            name: "value",
            type: "String | Number | Boolean",
            default: "<strong>required</strong>",
            notes: "Emitted value; <code>checked</code> when <code>modelValue === value</code>",
        },
        {
          name: "name",
          type: "String",
          default: "''",
          notes:'Grouping',
        },
        {
          name: "disabled",
          type: "Boolean",
          default: "false",
          notes:'',
        },
      ],
    };
  },
};
</script>
