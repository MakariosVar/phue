<template>
    <ph-data-table :columns="columns"
        :items="items"
    >
        <template #cell(name)="{ value }"><strong>{{ value }}</strong></template>
        <template #cell(type)="{ value }"><span v-html="value"></span></template>
        <template #cell(default)="{ value }"><span v-html="value"></span></template>
        <template #cell(notes)="{ value }"><span v-html="value"></span></template>
    </ph-data-table>
</template>

<script>
export default {
  name: 'PropsTable',
  props: {
    items: {
      type: Array,
      required: true
    }
  },
  data() {
    return {
        columns:[
            { key: 'name', label: 'Name' },
            { key: 'type', label: 'Type' },
            { key: 'default', label: 'Default' },
            { key: 'notes', label: 'Notes' }
        ],
    };
  },
  methods: {
  }
};
</script>