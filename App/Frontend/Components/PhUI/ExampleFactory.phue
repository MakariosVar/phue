<template>
    <ph-card>
      <div class="d-flex align-items-center justify-content-between mb-2">
        <h4>
          <ph-link
            variant="secondary"
            :underlined="false"
            :title="tag"
            :href="`#${tag}`"
            @click.prevent="scrollToTag"
          >
            <ph-icon name="hash" size="40" class="text-muted" />
          </ph-link>
          <code>{{ tag }}</code>
        </h4>
        <div class="d-flex gap-2">
          <ph-tooltip content="Toggle Code.">
            <ph-button
              @click="toggleCode"
              size="sm"
              :variant="showCode ? 'secondary' : 'outline-secondary'"
            >
              <ph-icon name="code-slash" size="40" />
            </ph-button>
          </ph-tooltip>
        </div>
      </div>
      <slot name="description"></slot>
      <slot name="demo"></slot>
      <slot name="snippet"></slot>
      <slot name="props"></slot>
    </ph-card>
</template>

<script>
export default {
  name: 'ExampleFactory',
  props: {
    tag: {
      type: String,
      required: true
    },
    showDemo: {
      type: Boolean,
      default: true
    },
    showCode: {
      type: Boolean,
      default: false
    },
    showProps: {
      type: Boolean,
      default: false
    }
  },
  emits: ['toggleCode', 'toggleDemo', 'toggleProps', 'scrollToTag'],
  computed: {
    /**
     * The anchor this example scrolls to, derived from its own tag.
     *
     * `tag="<ph-number-input />"` → `number-input`, which is exactly the id the
     * showcase page puts on the wrapping element and the id its nav links to.
     * Emitting it means a page can write `@setAnchor="scrollTo"` once, instead
     * of repeating the component's own name as a string literal in every
     * usage — a literal that cannot drift away from the tag it names.
     */
    anchorId() {
      return String(this.tag || '')
        .replace(/^<\/?ph-/, '')
        .replace(/\s*\/?>$/, '')
        .trim();
    }
  },
  data() {
    return {
    };
  },
  methods: {
    toggleCode() {      
      this.$emit('toggleCode');
    },
    toggleDemo() {
      this.$emit('toggleDemo');
    },
    toggleProps() {
      this.$emit('toggleProps');
    },
    scrollToTag() {
      this.$emit('scrollToTag', this.anchorId);
    }
  }
};
</script>