      <span class="code-block-title text-white-50 small">{{ title }}</span>
      <span v-if="language" class="badge text-bg-secondary">{{ language }}</span>
    </div>
    <pre class="mb-0 p-3 bg-dark text-light"><code class="code-block-code">{{ code }}</code></pre>
  </div>
