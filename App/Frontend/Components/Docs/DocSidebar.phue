<template>
  <nav class="doc-sidebar d-flex flex-column gap-1" aria-label="Documentation sections">
    <div class="doc-search position-relative mb-2">
      <input
        v-model="query"
        type="search"
        class="form-control form-control-sm"
        placeholder="Search docs…"
        aria-label="Search documentation"
        autocomplete="off"
        @keydown.esc="query = ''"
      >
      <div
        v-if="isSearching"
        class="doc-search-panel position-absolute start-0 end-0 bg-body border rounded-2 shadow-sm mt-1 overflow-hidden"
        style="z-index: 1050;"
      >
        <div class="list-group list-group-flush" style="max-height: 22rem; overflow-y: auto;">
          <p v-if="!results.length" class="text-body-secondary small mb-0 px-3 py-2">
            No matches for “{{ query }}”.
          </p>
          <a
            v-for="result in results"
            :key="result.href + result.heading"
            :href="result.href"
            class="list-group-item list-group-item-action py-2 px-3"
            @click="collapseAfterClick"
          >
            <span class="d-flex align-items-center justify-content-between gap-2">
              <span class="small fw-semibold text-body text-truncate" v-html="result.headingHtml"></span>
              <span class="badge text-bg-light flex-shrink-0">{{ result.doc }}</span>
            </span>
            <span
              v-if="result.text"
              class="d-block text-body-secondary text-truncate mt-1"
              style="font-size: .72rem;"
              v-html="result.textHtml"
            ></span>
          </a>
        </div>
      </div>
    </div>

    <h6 class="phue-nav-group sidebar-heading text-body-secondary text-uppercase mb-2">Guides</h6>
    <a v-for="item in items" :key="item.href" :href="item.href"
       class="doc-sidebar-link d-flex align-items-center gap-2 text-decoration-none px-3 py-2 rounded-2"
       :style="item.href.endsWith('?doc=' + active) ? 'background-color: var(--bs-tertiary-bg); font-weight: 600;' : ''">
      <span v-if="item.icon" class="doc-sidebar-icon">{{ item.icon }}</span>
      <span class="doc-sidebar-label">{{ item.label }}</span>
    </a>
  </nav>
</template>

<script>
export default {
  name: 'DocSidebar',
  props: {
    items: {
      type: Array,
      default: () => []
    },
    active: {
      type: String,
      default: ''
    },
    searchIndex: {
      type: Array,
      default: () => []
    }
  },
  data() {
    return {
      query: ''
    };
  },
  computed: {
    isSearching() {
      return this.query.trim().length >= 2;
    },
    results() {
      if (!this.isSearching) {
        return [];
      }

      const needle = this.query.trim().toLowerCase();
      const ranked = [];

      for (const entry of this.searchIndex) {
        const heading = (entry.heading || '').toLowerCase();
        const text = (entry.text || '').toLowerCase();
        const doc = (entry.doc || '').toLowerCase();

        let rank = -1;
        if (heading.includes(needle)) {
          rank = 0;
        } else if (doc.includes(needle)) {
          rank = 1;
        } else if (text.includes(needle)) {
          rank = 2;
        }

        if (rank === -1) {
          continue;
        }

        ranked.push({ rank, entry });
      }

      ranked.sort((a, b) => a.rank - b.rank);

      return ranked.slice(0, 10).map(({ entry }) => ({
        href: entry.href,
        heading: entry.heading,
        doc: entry.doc,
        headingHtml: this.highlight(entry.heading),
        textHtml: this.highlight(entry.text)
      }));
    }
  },
  methods: {
    collapseAfterClick() {
      // Let the browser start navigation first, then collapse the panel so it
      // cannot cover the focused section on same-document (#hash) jumps.
      setTimeout(() => {
        this.query = '';
      }, 0);
    },
    escapeHtml(text) {
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    },
    highlight(text) {
      const escaped = this.escapeHtml(text);
      const needle = this.query.trim();

      if (needle === '') {
        return escaped;
      }

      const pattern = needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return escaped.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
    }
  }
};
</script>
