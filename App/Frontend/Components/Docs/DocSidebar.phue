<template>
  <nav class="doc-sidebar d-flex flex-column gap-1" aria-label="Documentation sections">
    <!-- The search field this replaced was a second, weaker way into the same
         index: its own ranking, its own highlighting, and a shortcut that only
         worked from this page. The palette does all of that and works everywhere,
         so what is left here is the affordance — a real button, because a readonly
         input that swallows keystrokes is a lie about what it does. -->
    <button
      type="button"
      class="btn btn-sm w-100 d-flex align-items-center justify-content-between text-body-secondary mb-2"
      @click="$emit('open-search')"
    >
      <span>Search (Ctrl+K)</span>
    </button>

    <h6 class="phue-nav-group sidebar-heading text-body-secondary text-uppercase mb-2">Guides</h6>
    <a v-for="item in items" :key="item.href" :href="item.href"
       class="doc-sidebar-link d-flex align-items-center gap-2 text-decoration-none px-3 py-2 rounded-2"
       :style="item.href.endsWith('?doc=' + active) ? 'background-color: var(--bs-tertiary-bg); font-weight: 600;' : ''">
      <span v-if="item.icon" class="doc-sidebar-icon">{{ item.icon }}</span>
      <span class="doc-sidebar-label">{{ item.label }}</span>
    </a>
  </nav>
</template>

<script>
export default {
  name: 'DocSidebar',
  emits: ['open-search'],
  props: {
    items: {
      type: Array,
      default: () => []
    },
    active: {
      type: String,
      default: ''
    }
  }
};
</script>
