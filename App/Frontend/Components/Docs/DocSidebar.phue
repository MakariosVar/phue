<template>
  <nav
    class="doc-sidebar d-flex flex-column"
    style="max-height: calc(100vh - 6rem); overflow-y: auto;"
    aria-label="Documentation sections"
  >
    <!-- Sidebar Header -->
    <div class="px-2 mb-2 pt-1">
      <h1 class="h5 fw-semibold mb-0">{{ title }}</h1>
      <p class="text-body-secondary mb-0" style="font-size: 0.8rem;">{{ description }}</p>
    </div>

    <!-- Search affordance button (triggers command palette) -->
    <div class="px-1 mb-2">
      <button
        type="button"
        class="btn btn-sm w-100 d-flex align-items-center justify-content-between text-body-secondary border"
        style="background: var(--bs-body-bg); border-color: var(--bs-border-color); font-size: 0.8rem; padding: 0.3rem 0.5rem;"
        @click="$emit('open-search')"
      >
        <span>Search (Ctrl+K)</span>
        <kbd class="text-body-secondary bg-body-tertiary px-1 rounded border" style="font-size: 0.7rem;">⌘K</kbd>
      </button>
    </div>

    <!-- Collapsible Sections -->
    <div class="d-flex flex-column px-1 pb-3" style="gap: 0.1rem; min-height: 0;">
      <div v-for="(groupedItems, group) in groupedItems" :key="group" class="mb-1">
        <!-- Section Toggle Button -->
        <button
          type="button"
          class="phue-nav-link nav-link d-flex align-items-center w-100"
          :class="{ 'phue-nav-link--active': isGroupActive(group) }"
          :style="{
            border: '0',
            borderLeft: '3px solid ' + (isGroupActive(group) ? 'var(--bs-primary)' : 'transparent'),
            padding: '0.35rem 0.5rem',
            borderRadius: '0.375rem',
            textAlign: 'left',
            fontSize: '0.825rem',
            fontWeight: isGroupActive(group) ? '600' : '500',
            color: isGroupActive(group) ? 'var(--bs-emphasis-color)' : 'var(--bs-body-color)',
            background: isGroupActive(group) ? 'var(--bs-secondary-bg)' : 'transparent',
            textDecoration: 'none',
            transition: 'all 0.15s ease',
            cursor: 'pointer'
          }"
          :aria-expanded="openSections.includes(group) ? 'true' : 'false'"
          @click.stop="toggleSection(group)"
        >
          <span style="flex: 1;">{{ formatGroup(group) }}</span>
          <span
            class="small d-inline-flex align-items-center"
            :style="{
              transform: openSections.includes(group) ? 'none' : 'rotate(-90deg)',
              transition: 'transform 0.15s ease',
              cursor: 'pointer'
            }"
          >▾</span>
        </button>

        <!-- Sub Links (Items in this section) -->
        <div
          v-if="openSections.includes(group)"
          class="d-flex flex-column mt-1"
          style="gap: 0.05rem;"
        >
          <a
            v-for="item in groupedItems"
            :key="item.href"
            :href="item.href"
            class="phue-nav-sub-link d-flex align-items-center ms-2 p-1 px-2 text-decoration-none"
            :class="{ 'phue-nav-link--active': isActive(item) }"
            :style="{
              color: isActive(item) ? 'var(--bs-primary)' : 'var(--bs-secondary-color)',
              fontWeight: isActive(item) ? '600' : '400',
              background: isActive(item) ? 'var(--bs-secondary-bg)' : 'transparent',
              borderRadius: '0.25rem',
              fontSize: '0.8rem',
              transition: 'all 0.15s ease',
              cursor: 'pointer'
            }"
            :aria-current="isActive(item) ? 'true' : null"
          >
            <span v-if="item.icon" class="me-2">{{ item.icon }}</span>
            <span>{{ item.label }}</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</template>

<script>
export default {
  name: 'DocSidebar',
  emits: ['open-search'],
  props: {
    items: {
      type: Array,
      default: () => []
    },
    active: {
      type: String,
      default: ''
    },
    title: {
      type: String,
      default: 'Phue Docs'
    },
    description: {
      type: String,
      default: 'Documentation (v0.0.1)'
    }
  },
  data() {
    let initialOpen = [];
    if (Array.isArray(this.items)) {
      const activeItem = this.items.find((item) =>
        this.active && (
          (item.href && (item.href.endsWith('?doc=' + this.active) || item.href.includes('doc=' + this.active))) ||
          item.id === this.active
        )
      );
      if (activeItem && activeItem.group) {
        initialOpen = [activeItem.group];
      } else if (this.items.length > 0 && this.items[0].group) {
        initialOpen = [this.items[0].group];
      }
    }
    return {
      openSections: initialOpen
    };
  },
  computed: {
    groupedItems() {
      return this.items.reduce((acc, item) => {
        const group = item.group || 'General';
        if (!acc[group]) {
          acc[group] = [];
        }
        acc[group].push(item);
        return acc;
      }, {});
    }
  },
  watch: {
    active(newActive) {
      if (!newActive) return;
      const activeItem = this.items.find((item) =>
        (item.href && (item.href.endsWith('?doc=' + newActive) || item.href.includes('doc=' + newActive))) ||
        item.id === newActive
      );
      if (activeItem && activeItem.group && !this.openSections.includes(activeItem.group)) {
        this.openSections.push(activeItem.group);
      }
    }
  },
  methods: {
    formatGroup(group) {
      const labels = {
        start: 'Getting Started',
        core: 'Core',
        module: 'Modules',
        frontend: 'Frontend'
      };
      return labels[group.toLowerCase()] || (group.charAt(0).toUpperCase() + group.slice(1));
    },
    isActive(item) {
      if (!this.active) return false;
      return (
        (item.href && (item.href.endsWith('?doc=' + this.active) || item.href.includes('doc=' + this.active))) ||
        item.id === this.active
      );
    },
    isGroupActive(group) {
      const items = this.groupedItems[group] || [];
      return items.some((item) => this.isActive(item));
    },
    toggleSection(group) {
      this.openSections = this.openSections.includes(group)
        ? this.openSections.filter((g) => g !== group)
        : [...this.openSections, group];
    }
  }
};
</script>
