                    </div>
                    <div class="ph-progress">
                        <div class="ph-progress__header"><span class="ph-text ph-text--sm">Animated</span><span class="ph-text ph-text--sm">45%</span></div>
                        <div class="ph-progress__track ph-progress__track--lg"><div class="ph-progress__fill ph-progress__fill--animated ph-progress__fill--success" style="width: 45%;"></div></div>
                    </div>
                    <div class="d-flex items-center gap-2">
                        <button type="button" class="ph-btn ph-btn--outline ph-btn--sm" @click="progressValue = Math.max(0, progressValue - 10)">-10</button>
