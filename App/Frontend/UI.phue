                            <button type="button" class="ph-tabs__item" :class="{ 'ph-tabs__item--active': activeTab === 'components' }" @click="activeTab = 'components'">Components</button>
                            <button type="button" class="ph-tabs__item" :class="{ 'ph-tabs__item--active': activeTab === 'examples' }" @click="activeTab = 'examples'">Examples</button>
