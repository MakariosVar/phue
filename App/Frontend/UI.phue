<php>
    $phuiDir = '/app/src/Core/UI/Phui';
    $urls = [];
    if (is_dir($phuiDir)) {
        foreach (glob($phuiDir . '/*.phue') as $f) {
            $name = basename($f, '.phue');
            $urls[$name] = "/assets/phue/{$name}." . substr(sha1(file_get_contents($f)), 0, 8) . ".phue.js";
        }
    }
    return [
        'title' => 'Phue PhUI — Component System',
        'state' => [
            'phuiUrls'       => $urls,
            'checked'        => $checked ?? true,
            'radioValue'     => $radioValue ?? 'option1',
            'loading'        => $loading ?? false,
            'currentPage'    => $currentPage ?? 2,
            'totalPages'     => $totalPages ?? 8,
            'activeTab'      => $activeTab ?? 'tokens',
            'activeSection'  => $activeSection ?? 'overview',
            'alertDismissed' => $alertDismissed ?? false,
            'inputValue'     => $inputValue ?? '',
            'selectValue'    => $selectValue ?? '',
            'modalOpen'      => $modalOpen ?? false,
            'progressValue'  => $progressValue ?? 65,
        ],
    ];
</php>

