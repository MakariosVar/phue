                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-avatar&gt;</code></h5>
                        <p class="small text-body-secondary">Image with initials fallback, sizes and shapes.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-avatar name="Makarios Varoutsos" size="xs" />
