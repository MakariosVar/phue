                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-flex&gt;</code></h5>
                        <p class="small text-body-secondary">Flex layout through props (<code>direction</code>, <code>justify</code>…).</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-flex direction="row" justify="space-between" align="center" gap="lg" wrap="wrap">
                                <ph-button variant="primary">Primary</ph-button>
                                <ph-button variant="outline">Outline</ph-button>
