<ph-skeleton variant="circular" width="48" />
<ph-skeleton variant="rectangular" width="200" height="120" />
SNP,
    'PhTabs' => <<<'SNP'
<ph-tabs v-model="activeTab" :items="tabsItems">
  <template #default="{ activeTab }">
    <p v-if="activeTab === 'overview'">Overview content here.</p>
    <p v-else-if="activeTab === 'settings'">Settings content here.</p>
  </template>
</ph-tabs>
SNP,
    'PhPagination' => <<<'SNP'
