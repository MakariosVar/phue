<php>
/**
 * UI.phue — Built-in PhUI Component Showcase.
 *
 * Renders ONLY the framework's built-in Phui components, each with a live demo
 * and a usage snippet.
 */

$registry = null;
$phuiDir = '/app/src/Core/UI/Phui';
if (is_dir($phuiDir)) {
    $loader = new \Phue\Core\UI\PhueComponentLoader($phuiDir);
    $loaderRegistry = new \Phue\Core\Frontend\ComponentLoaderRegistry();
    $loaderRegistry->addLoader($loader);
    $registry = $loaderRegistry;
}

// Server-side rendered (HTML-first) component demo.
$ssrDemos = [];
if ($registry !== null) {
    try {
        $ssrNav = $registry->load('PhNavigation', [
            'items'       => [
                ['label' => 'Home', 'href' => '/'],
                ['label' => 'Docs', 'href' => '/docs'],
                ['label' => 'UI Components', 'href' => '/ui'],
                ['label' => 'Products', 'href' => '/products'],
                ['label' => 'Disabled', 'href' => '/disabled', 'disabled' => true],
            ],
            'activeRoute' => '/ui',
        ]);
        $ssrDemos['PhNavigation'] = $ssrNav->view->getHtml();
    } catch (\Throwable) {
        $ssrDemos['PhNavigation'] = '';
    }
}

$code = [
    'PhButton' => <<<'SNP'
<ph-button variant="primary" :loading="loading" @click="onSave">
  Save changes
</ph-button>
SNP,
    'PhInput' => <<<'SNP'
<ph-input
  v-model="inputValue"
  label="Email"
  placeholder="you@example.com"
  helper-text="We never share your email."
  :error="inputError"
/>
SNP,
    'PhTheme' => <<<'SNP'
<ph-theme aria-label="Toggle theme" />
SNP,
    'PhSelect' => <<<'SNP'
