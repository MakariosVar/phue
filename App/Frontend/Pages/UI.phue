            ['id' => 6, 'name' => 'Phue Cache', 'price' => 25, 'status' => 'Archived'],
            ['id' => 7, 'name' => 'Phue Auth', 'price' => 45, 'status' => 'Active'],
            ['id' => 8, 'name' => 'Phue Explorer', 'price' => 15, 'status' => 'Active'],
            ['id' => 9, 'name' => 'Phue SPA', 'price' => 35, 'status' => 'Beta'],
