                                         variant="primary" removable @remove="chips.splice(i, 1)" />
                            </div>
                            <ph-button v-if="chips.length === 0" variant="outline" size="sm" class="mt-3"
                                       @click="chips = ['Vue 3', 'PHP 8.5', 'Docker', 'Swoole']">
                                Reset chips
