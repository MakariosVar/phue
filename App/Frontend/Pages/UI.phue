                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-checkbox v-model="checked" label="I agree to the terms" />
                            <ph-checkbox v-model="checked">Custom <b>slot</b> label</ph-checkbox>
                            <p class="small text-body-secondary mt-2 mb-0">Checked: <code>{{ checked }}</code></p>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhCheckbox }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
