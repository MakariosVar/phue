        'modalOpen'       => $modalOpen ?? false,
        'alertVisible'    => !($alertDismissed ?? false),
        'inputValue'      => $inputValue ?? 'Sample text',
        'selectValue'     => $selectValue ?? 'vue',
        'progressValue'   => $progressValue ?? 65,
        'toastPosition'   => $toastPosition ?? 'top-right',
        'message'         => '',
        'inputError'      => '',
        'savedAt'         => '',
        'chips'           => ['Vue 3', 'PHP 8.5', 'Docker', 'Swoole'],
        'selectOptions'   => [
            ['label' => 'Vue 3', 'value' => 'vue'],
            ['label' => 'React', 'value' => 'react', 'disabled' => true],
