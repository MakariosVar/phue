                            <p class="small text-body-secondary mt-2 mb-0">
                                Single: <code>{{ select3Single }}</code> · Multiple: <code>{{ select3Multi.join(', ') }}</code>
                            </p>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhSelect3 }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-file-input&gt;</code></h5>
                        <p class="small text-body-secondary">Drag &amp; drop, <code>accept</code>/<code>max-size</code> validation and image previews.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-file-input v-model="fileList" multiple accept="image/*" :max-size="2097152"
                                           label="Attachments" helper-text="PNG or JPG up to 2 MB." />
                            <p class="small text-body-secondary mt-2 mb-0">Files: <code>{{ fileList.length }}</code></p>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhFileInput }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-date-picker&gt;</code></h5>
                        <p class="small text-body-secondary">Calendar popover, <code>min</code>/<code>max</code> bounds and optional native input.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-date-picker v-model="dateValue" label="Start date" min="2024-01-01"
                                            helper-text="Pick any date from 2024 onwards." />
                            <ph-date-picker v-model="dateTimeValue" mode="datetime" label="Scheduled at" class="mt-3" />
                            <p class="small text-body-secondary mt-2 mb-0">
                                Date: <code>{{ dateValue || '—' }}</code> · Datetime: <code>{{ dateTimeValue || '—' }}</code>
                            </p>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhDatePicker }}</code></pre>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card p-3">
                        <h5 class="mb-1"><code>&lt;ph-form-field&gt;</code></h5>
                        <p class="small text-body-secondary">Wrapper around a control — provides label, error/helper text and error styling via slot composition.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-form-field label="Email" helper-text="We never share your email.">
                                <ph-input v-model="inputValue" placeholder="you@example.com" />
                            </ph-form-field>
                            <ph-form-field label="Billing email" :error="inputError">
                                <ph-input v-model="inputValue" />
                            </ph-form-field>
                            <ph-button variant="outline" size="sm" @click="toggleInputError">
                                {{ inputError ? 'Clear error' : 'Show error' }}
                            </ph-button>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhFormField }}</code></pre>
                    </div>
                </div>
            </div>
        </section>

        <!-- Data Display -->
        <section id="data" class="mb-5">
            <h2 class="h4 fw-semibold mb-3">Data Display</h2>

            <div class="row g-4">
                <div class="col-12">
                    <div class="card p-3">
                        <h5 class="mb-1"><code>&lt;ph-data-table&gt;</code></h5>
                        <p class="small text-body-secondary">Sortable columns, pagination and per-cell slots.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-data-table :columns="tableCols" :items="tableRows" paginated :page-size="4" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhDataTable }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-badge&gt;</code></h5>
                        <p class="small text-body-secondary">Variants, sizes and pill shape.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-2">
                            <ph-badge label="Primary" variant="primary" />
                            <ph-badge label="Success" variant="success" />
                            <ph-badge label="Warning" variant="warning" />
                            <ph-badge label="Error" variant="error" />
                            <ph-badge label="Info" variant="info" />
                            <ph-badge label="Pill" variant="primary" pill />
                            <ph-badge label="Small" variant="secondary" size="sm" />
                            <ph-badge label="Large" variant="primary" size="lg" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhBadge }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-avatar&gt;</code></h5>
                        <p class="small text-body-secondary">Image with initials fallback, sizes and shapes.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-avatar name="Makarios Varoutsos" size="xs" />
                            <ph-avatar name="Makarios Varoutsos" size="sm" shape="rounded" />
                            <ph-avatar name="Makarios Varoutsos" size="md" />
                            <ph-avatar name="Makarios Varoutsos" size="lg" shape="square" />
                            <ph-avatar name="Ada Lovelace" size="xl" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhAvatar }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-card&gt;</code></h5>
                        <p class="small text-body-secondary">Header, body and footer slots; hoverable variant.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-card title="Weekly Report" subtitle="Last 7 days" hoverable>
                                Revenue grew 12% week over week across all gateways.
                                <div class="mt-3 text-end">
                                    <ph-button variant="outline" size="sm" @click="savedAt = 'card'">
                                        View details
                                    </ph-button>
                                </div>
                            </ph-card>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhCard }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-chip&gt;</code></h5>
                        <p class="small text-body-secondary">Removable pills bound to a reactive list.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap gap-2">
                                <ph-chip v-for="(chip, i) in chips" :key="chip" :label="chip"
                                         variant="primary" removable @remove="chips.splice(i, 1)" />
                            </div>
                            <ph-button v-if="chips.length === 0" variant="outline" size="sm" class="mt-3"
                                       @click="chips = ['Vue 3', 'PHP 8.5', 'Docker', 'Swoole']">
                                Reset chips
                            </ph-button>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhChip }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-icon&gt;</code></h5>
                        <p class="small text-body-secondary">Bootstrap Icons wrapper with size, color, spin and accessible labels.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-icon name="check-circle" variant="success" size="lg" />
                            <ph-icon name="exclamation-triangle" variant="warning" size="lg" />
                            <ph-icon name="trash" variant="danger" size="lg" />
                            <ph-icon name="arrow-clockwise" spin size="lg" />
                            <ph-icon name="star-fill" color="gold" size="xl" />
                            <ph-icon name="info-circle" label="Information" size="lg" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhIcon }}</code></pre>
                    </div>
                </div>
            </div>
        </section>

        <!-- Feedback -->
        <section id="feedback" class="mb-5">
            <h2 class="h4 fw-semibold mb-3">Feedback</h2>

            <div class="row g-4">
                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-alert&gt;</code></h5>
                        <p class="small text-body-secondary">Variants and a dismissible example.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-alert variant="info" message="This is an informational alert." />
                            <ph-alert variant="success" title="Deployed" message="v2.4.0 is live." />
                            <ph-alert variant="warning" message="Disk usage is above 80%." />
                            <ph-alert variant="error" message="Payment method requires attention." />
                            <ph-alert v-if="alertVisible" variant="success" title="Dismissible"
                                      dismissible @dismiss="alertVisible = false">
                                Click the <kbd>&times;</kbd> to hide me.
                            </ph-alert>
                            <ph-button v-else variant="outline" size="sm" class="mt-2"
                                       @click="alertVisible = true">
                                Show again
                            </ph-button>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhAlert }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-modal&gt;</code></h5>
                        <p class="small text-body-secondary"><code>v-model</code> visibility, header/footer slots.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-button variant="primary" @click="modalOpen = true">Open modal</ph-button>
                            <ph-modal v-model="modalOpen" title="Confirm action" size="md" closable>
                                Are you sure you want to continue? This action cannot be undone.
                                <div class="mt-4 d-flex justify-content-end gap-2">
                                    <ph-button variant="ghost" @click="modalOpen = false">Cancel</ph-button>
                                    <ph-button variant="primary" @click="modalOpen = false">Confirm</ph-button>
                                </div>
                            </ph-modal>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhModal }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-progress-bar&gt;</code></h5>
                        <p class="small text-body-secondary">Value clamping, variants, label and animation.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <ph-button variant="outline" size="sm" @click="progressValue = Math.max(0, progressValue - 10)">-10</ph-button>
                                <ph-button variant="outline" size="sm" @click="progressValue = Math.min(100, progressValue + 10)">+10</ph-button>
                            </div>
                            <ph-progress-bar :value="progressValue" label="Syncing" variant="success" show-value />
                            <ph-progress-bar :value="progressValue" variant="primary" animated class="mt-2" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhProgressBar }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-skeleton&gt;</code></h5>
                        <p class="small text-body-secondary">Loading placeholders for text, circles and rectangles.</p>
                        <div class="phue-demo border rounded p-3 mb-3" style="min-height: 140px;">
                            <ph-skeleton variant="text" width="60%" height="14" class="d-block mb-2" />
                            <ph-skeleton variant="text" width="40%" height="14" class="d-block mb-2" />
                            <div class="d-flex align-items-center gap-3 mt-3">
                                <ph-skeleton variant="circular" width="48" />
                                <ph-skeleton variant="rectangular" width="220" height="80" />
                            </div>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhSkeleton }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-spinner&gt;</code></h5>
                        <p class="small text-body-secondary">Border/grow spinners in multiple sizes and colors.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-spinner size="sm" color="primary" />
                            <ph-spinner color="secondary" />
                            <ph-spinner size="lg" color="success" />
                            <ph-spinner variant="grow" color="danger" />
                            <ph-spinner variant="grow" color="warning" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhSpinner }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-tooltip&gt;</code></h5>
                        <p class="small text-body-secondary">CSS-positioned tooltip on hover, focus or click.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-tooltip content="Tooltip on top" placement="top">
                                <ph-button variant="outline" size="sm">Top</ph-button>
                            </ph-tooltip>
                            <ph-tooltip content="Tooltip on the right" placement="end">
                                <ph-button variant="outline" size="sm">End</ph-button>
                            </ph-tooltip>
                            <ph-tooltip content="Tooltip on the left" placement="start">
                                <ph-button variant="outline" size="sm">Start</ph-button>
                            </ph-tooltip>
                            <ph-tooltip content="Click-triggered tooltip" trigger="click" placement="bottom">
                                <ph-button variant="outline" size="sm">Click</ph-button>
                            </ph-tooltip>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhTooltip }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-toast&gt;</code></h5>
                        <p class="small text-body-secondary">Programmatic notifications. Hovering pauses a toast; picking a position re-renders the stack.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                <ph-button size="sm" :variant="toastPosition === 'top-right' ? 'primary' : 'outline'"
                                           @click="toastPosition = 'top-right'">top-right</ph-button>
                                <ph-button size="sm" :variant="toastPosition === 'top-left' ? 'primary' : 'outline'"
                                           @click="toastPosition = 'top-left'">top-left</ph-button>
                                <ph-button size="sm" :variant="toastPosition === 'top-center' ? 'primary' : 'outline'"
                                           @click="toastPosition = 'top-center'">top-center</ph-button>
                                <ph-button size="sm" :variant="toastPosition === 'bottom-right' ? 'primary' : 'outline'"
                                           @click="toastPosition = 'bottom-right'">bottom-right</ph-button>
                                <ph-button size="sm" :variant="toastPosition === 'bottom-center' ? 'primary' : 'outline'"
                                           @click="toastPosition = 'bottom-center'">bottom-center</ph-button>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
<ph-button size="sm" :style="{ color: 'var(--bs-info)', borderColor: 'var(--bs-info)', backgroundColor: 'transparent' }" @click="toastPush('info')">Info</ph-button>
                                 <ph-button size="sm" :style="{ color: 'var(--bs-success)', borderColor: 'var(--bs-success)', backgroundColor: 'transparent' }" @click="toastPush('success')">Success</ph-button>
                                 <ph-button size="sm" :style="{ color: 'var(--bs-warning)', borderColor: 'var(--bs-warning)', backgroundColor: 'transparent' }" @click="toastPush('warning')">Warning</ph-button>
                                 <ph-button size="sm" :style="{ color: 'var(--bs-danger)', borderColor: 'var(--bs-danger)', backgroundColor: 'transparent' }" @click="toastPush('error')">Error</ph-button>
                                <ph-button variant="ghost" size="sm" @click="toast.clear()">Clear all</ph-button>
                                <ph-button variant="outline" size="sm" @click="toastServicePush">via service</ph-button>
                            </div>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhToast }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-drawer&gt;</code></h5>
                        <p class="small text-body-secondary">Teleported side panel with focus trap, <code>Esc</code> and footer slot.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-2">
                            <ph-button variant="primary" size="sm" @click="drawerOpen = true">Open drawer</ph-button>
                            <ph-button variant="outline" size="sm" @click="drawerOpen = true">Same panel</ph-button>
                            <ph-drawer v-model="drawerOpen" title="Filters" position="end">
                                <p>Drawer body content. Focus is trapped here while open.</p>
                                <template #footer>
                                    <ph-button variant="ghost" @click="drawerOpen = false">Cancel</ph-button>
                                    <ph-button variant="primary" @click="drawerOpen = false">Apply</ph-button>
                                </template>
                            </ph-drawer>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhDrawer }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-confirm-dialog&gt;</code></h5>
                        <p class="small text-body-secondary">Promise-based confirmation via template ref (<code>confirm.value.confirm()</code>).</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-2">
                            <ph-button variant="danger" size="sm" @click="confirmDemo">Delete…</ph-button>
                            <span v-if="confirmResult" class="small text-body-secondary">
                                Result: <code>{{ confirmResult }}</code>
                            </span>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhConfirmDialog }}</code></pre>
                    </div>
                </div>
            </div>
        </section>

        <!-- Navigation -->
        <section id="navigation" class="mb-5">
            <h2 class="h4 fw-semibold mb-3">Navigation</h2>

            <div class="row g-4">
                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-theme&gt;</code></h5>
                        <p class="small text-body-secondary">Light/Dark mode toggle with local storage persistence and SSR hydration safety.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex align-items-center gap-2">
                            <ph-theme aria-label="Toggle theme" />
                            <span class="text-body-secondary small">Click to toggle color scheme</span>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhTheme }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-tabs&gt;</code></h5>
                        <p class="small text-body-secondary"><code>v-model</code> active tab, disabled tabs, scoped slot.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-tabs v-model="activeTab" :items="tabsItems" />
                            <div class="pt-3">
                                <p v-if="activeTab === 'overview'" class="mb-0">Overview content goes here.</p>
                                <p v-else-if="activeTab === 'settings'" class="mb-0">Settings content goes here.</p>
                                <p v-else class="mb-0 text-body-secondary">Select another tab.</p>
                            </div>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhTabs }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-pagination&gt;</code></h5>
                        <p class="small text-body-secondary"><code>v-model:current-page</code> with auto ellipsis.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-pagination v-model:current-page="currentPage" :total-pages="totalPages" />
                            <p class="small text-body-secondary mt-3 mb-0">Current page: <code>{{ currentPage }}</code> of {{ totalPages }}</p>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhPagination }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-breadcrumb&gt;</code></h5>
                        <p class="small text-body-secondary">Items with optional <code>href</code> on non-active crumbs.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-breadcrumb :items="breadcrumbItems" />
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhBreadcrumb }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-link&gt;</code></h5>
                        <p class="small text-body-secondary">Variants, underline control, disabled state and click events.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-link href="#overview" variant="primary">Primary</ph-link>
                            <ph-link href="#overview" variant="secondary">Secondary</ph-link>
                            <ph-link href="#overview" variant="danger">Danger</ph-link>
                            <ph-link href="#overview" :underline="false">No underline</ph-link>
                            <ph-link href="#overview" disabled>Disabled</ph-link>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhLink }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-dropdown&gt;</code></h5>
                        <p class="small text-body-secondary">Action menu with headers, dividers, icons and disabled items.</p>
                        <div class="phue-demo border rounded p-3 mb-3 d-flex flex-wrap align-items-center gap-3">
                            <ph-dropdown label="Actions" variant="primary" :items="dropdownItems"
                                         @select="dropdownLast = $event.label" />
                            <ph-dropdown label="Right aligned" align="end" :items="dropdownItems" />
                            <span v-if="dropdownLast" class="small text-body-secondary">
                                Selected: <code>{{ dropdownLast }}</code>
                            </span>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhDropdown }}</code></pre>
                    </div>
                </div>
            </div>
        </section>

        <!-- Content & Layout -->
        <section id="content" class="mb-5">
            <h2 class="h4 fw-semibold mb-3">Content &amp; Layout</h2>

            <div class="row g-4">
                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-text&gt;</code></h5>
                        <p class="small text-body-secondary">Typography through props instead of utility classes.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-text size="xl" weight="bold" color="main">Hero line</ph-text>
                            <ph-text size="lg" weight="semibold" color="primary" class="d-block">Accent</ph-text>
                            <ph-text size="md" color="muted" class="d-block">Body copy in muted color.</ph-text>
                            <ph-text size="sm" weight="light" align="right" class="d-block">Small right-aligned.</ph-text>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhText }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-heading&gt;</code></h5>
                        <p class="small text-body-secondary">Semantic <code>h1&ndash;h6</code> via the <code>level</code> prop.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-heading :level="1">Display 1</ph-heading>
                            <ph-heading :level="2" color="primary">Section title</ph-heading>
                            <ph-heading :level="3" color="secondary">Subsection</ph-heading>
                            <ph-heading :level="4" color="muted" align="right">Caption</ph-heading>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhHeading }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-box&gt;</code></h5>
                        <p class="small text-body-secondary">Themed spacing, radius, border and background wrapper.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-box padding="lg" radius="lg" border bg="surface">
                                <p class="mb-0">Surfaced, rounded box.</p>
                            </ph-box>
                            <ph-box padding="sm" radius="sm" bg="primary" class="mt-2">
                                <p class="mb-0">Primary-tinted box.</p>
                            </ph-box>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhBox }}</code></pre>
