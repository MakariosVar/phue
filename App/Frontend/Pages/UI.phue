<script>
import { createApp, reactive, toRefs } from '/assets/vendor/vue3/vue.esm-browser.js';

const styleText = `
    .phue-docs code.phue-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        background: var(--bs-tertiary-bg);
        padding: 0.125rem 0.375rem;
        border-radius: var(--bs-border-radius-sm);
    }
    .phue-code-block {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        background: #1e293b;
        color: #e2e8f0;
        padding: 1rem;
        border-radius: var(--bs-border-radius-lg);
        overflow-x: auto;
        line-height: 1.6;
        margin: 0.5rem 0;
    }
    .phue-code-block code { color: inherit; }
    .phue-nav-link:hover {
        color: var(--bs-body-color) !important;
        background: var(--bs-tertiary-bg);
    }
    .phue-nav-link--active {
        color: var(--bs-primary) !important;
        border-left-color: var(--bs-primary) !important;
        background: rgba(13, 110, 253, 0.06);
        font-weight: 500;
    }
    .phue-sidebar::-webkit-scrollbar { width: 4px; }
    .phue-sidebar::-webkit-scrollbar-track { background: transparent; }
    .phue-sidebar::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 4px; }
`;
const styleEl = document.createElement('style');
styleEl.textContent = styleText;
document.head.appendChild(styleEl);

export default function mountApp() {
    window.__phueApp = createApp({
        setup() {
            const state = reactive({
                ...window.__INITIAL_STATE__,
                navItems: [
                    { id: 'overview', label: 'Overview' },
                    { id: 'tokens', label: 'Design Tokens' },
                    { id: 'buttons', label: 'Buttons' },
                    { id: 'forms', label: 'Form Controls' },
                    { id: 'data', label: 'Data Display' },
                    { id: 'feedback', label: 'Feedback' },
                    { id: 'navigation', label: 'Navigation' },
                    { id: 'layout', label: 'Layout Utilities' },
                    { id: 'typography', label: 'Typography' },
                ],
                colorTokens: [
                    { name: '--bs-primary', value: '#0d6efd' },
                    { name: '--bs-secondary', value: '#6c757d' },
                    { name: '--bs-success', value: '#198754' },
                    { name: '--bs-danger', value: '#dc3545' },
                    { name: '--bs-warning', value: '#ffc107' },
                    { name: '--bs-info', value: '#0dcaf0' },
                    { name: '--bs-body-bg', value: '#ffffff' },
                    { name: '--bs-body-color', value: '#212529' },
                    { name: '--bs-tertiary-bg', value: '#f8f9fa' },
                    { name: '--bs-border-color', value: '#dee2e6' },
                ],
                spacingTokens: [
                    { name: '0', value: '0' },
                    { name: '1', value: '0.25rem' },
                    { name: '2', value: '0.5rem' },
                    { name: '3', value: '1rem' },
                    { name: '4', value: '1.5rem' },
                    { name: '5', value: '3rem' },
                ],
                tableUsers: [
                    { id: 1, name: 'Jane Doe', role: 'Admin', active: true },
                    { id: 2, name: 'John Smith', role: 'Editor', active: true },
                    { id: 3, name: 'Alice Wang', role: 'User', active: false },
                ],
            });

            function scrollTo(id) {
                state.activeSection = id;
                const el = document.getElementById(id);
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            return { ...toRefs(state), scrollTo };
        }
    });
    window.__phueApp.mount('#app');
}
</script>
