                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-col&gt;</code></h5>
                        <p class="small text-body-secondary">Responsive grid column — cumulative base <code>span</code> plus breakpoints.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-row gutter="2">
                                <ph-col span="12" md="6" lg="4"><div class="border rounded p-2 bg-body-secondary text-center">Full → half → third</div></ph-col>
                                <ph-col span="12" md="6" lg="4"><div class="border rounded p-2 bg-body-secondary text-center">Full → half → third</div></ph-col>
                                <ph-col span="12" lg="4"><div class="border rounded p-2 bg-body-secondary text-center">Full → full → third</div></ph-col>
                            </ph-row>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhCol }}</code></pre>
                    </div>
                </div>
