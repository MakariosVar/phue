    { label: 'Vue 3', value: 'vue' },
    { label: 'React', value: 'react', disabled: true },
    { label: 'Svelte', value: 'svelte' }
  ]"
/>
SNP,
    'PhTextarea' => <<<'SNP'
<ph-textarea
  v-model="message"
  label="Message"
  :rows="5"
  resize="vertical"
  helper-text="Max 500 characters."
/>
SNP,
    'PhCheckbox' => <<<'SNP'
