        <!-- Server-Side -->
        <section id="ssr" class="mb-5">
            <h2 class="h4 fw-semibold mb-3">Server-Side (HTML-first)</h2>

            <div class="card p-3">
                <h5 class="mb-1"><code>&lt;ph-navigation&gt;</code></h5>
                <p class="small text-body-secondary">
                    HTML-first components render in PHP and need no client import. The markup below
                    was produced server-side by <code>ComponentLoaderRegistry::load()</code> and
                    injected into the page.
                </p>
                <div class="phue-demo border rounded p-3 mb-3" style="max-width: 280px;">
                    <div v-html="ssrDemos.PhNavigation"></div>
                </div>
                <pre class="phue-code-block mb-0"><code>{{ code.PhNavigation }}</code></pre>
            </div>
        </section>

        <!-- Footer -->
        <footer style="padding: 1.5rem 0; border-top: 1px solid var(--bs-border-color); text-align: center;">
            <p class="small text-body-secondary mb-0">
                Phue PhUI &mdash; built-in components, zero build step, selective lazy imports.
            </p>
        </footer>

    </main>
</div>
</template>

<script>
import { createSSRApp, reactive, toRefs, ref } from 'vue';

const styleText = `
    [v-cloak] { display: none; }
    .phue-code-block {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.72rem;
        background: #1e293b;
        color: #e2e8f0;
        padding: 1rem;
        border-radius: var(--bs-border-radius-lg);
        overflow-x: auto;
        line-height: 1.6;
        margin: 0.5rem 0;
    }
    .phue-code-block code { color: inherit; }
    .phue-demo .placeholder-glow { display: block; }
    .phue-nav-link:hover {
        color: var(--bs-body-color) !important;
        background: var(--bs-tertiary-bg);
    }
    .phue-nav-link--active {
        color: var(--bs-primary) !important;
        border-left-color: var(--bs-primary) !important;
        background: rgba(13, 110, 253, 0.06);
        font-weight: 500;
    }
    .phue-sidebar::-webkit-scrollbar { width: 4px; }
    .phue-sidebar::-webkit-scrollbar-track { background: transparent; }
    .phue-sidebar::-webkit-scrollbar-thumb { background: var(--bs-border-color); border-radius: 4px; }
`;

export default async function mountApp() {
    if (typeof document !== 'undefined') {
        if (!document.querySelector('style[data-phue-ui]')) {
            const styleEl = document.createElement('style');
            styleEl.dataset.phueUi = '1';
            styleEl.textContent = styleText;
            document.head.appendChild(styleEl);
        }
    }

    let initialState = {};
    if (typeof window !== 'undefined') {
        initialState = window.__INITIAL_STATE__ || {};
    }

    const app = createSSRApp({
        setup() {
            const state = reactive({
                ...initialState,
                disabled: false
            });

            function scrollTo(id) {
                state.activeSection = id;
                if (typeof document !== 'undefined') {
                    const el = document.getElementById(id);
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }

            function onSave() {
                state.savedAt = new Date().toISOString();
                state.loading = true;
                setTimeout(() => { state.loading = false; }, 900);
            }

            function toggleInputError() {
                state.inputError = state.inputError
                    ? ''
                    : 'Please enter a valid email address.';
            }

            const toast = ref(null);
            const confirm = ref(null);

            function toastPush(variant) {
                const messages = {
                    info: 'An informational notification.',
                    success: 'Saved. Changes persisted.',
                    warning: 'Disk usage is above 80%.',
                    error: 'The request could not be completed.'
                };
                toast.value?.push({
                    variant,
                    title: variant[0].toUpperCase() + variant.slice(1),
                    message: messages[variant],
                    duration: variant === 'error' ? 8000 : 5000
                });
            }

async function confirmDemo() {
                if (!confirm.value) return;
                const ok = await confirm.value.confirm({
                    title: 'Delete product?',
                    message: 'This action cannot be undone.',
                    variant: 'danger',
                    icon: 'exclamation-triangle',
                    confirmText: 'Delete'
                });
                state.confirmResult = ok ? 'confirmed' : 'cancelled';
            }


            return { ...toRefs(state), toast, confirm, onSave, toggleInputError, scrollTo, toastPush, confirmDemo };
        }
    });

    if (typeof window !== 'undefined') {
        window.__phueApp = app;
        app.mount('#app');
    }

    return app;
}
</script>