<php>
/**
 * UI.phue — Built-in PhUI Component Showcase.
 *
 * Renders ONLY the framework's built-in Phui components, each with a live demo
 * and a usage snippet. The page whitelists the components it showcases and the
 * server exposes module URLs ("phuiUrls") solely for that whitelist — the client
 * imports eactly those modules and nothing else.
 */

// Components this page actually uses (imported lazily, one ESM module each).
$whitelist = [
    'PhButton', 'PhInput', 'PhSelect', 'PhTextarea', 'PhCheckbox', 'PhRadio', 'PhFormField',
    'PhDataTable', 'PhBadge', 'PhAvatar', 'PhCard', 'PhChip',
    'PhAlert', 'PhModal', 'PhProgressBar', 'PhSkeleton',
    'PhTabs', 'PhPagination', 'PhBreadcrumb', 'PhLink',
    'PhText', 'PhHeading', 'PhBox', 'Spacer', 'PhStack', 'PhFlex',
];

$urls = [];
$registry = null;
$phuiDir = '/app/src/Core/UI/Phui';
if (is_dir($phuiDir)) {
    $loader = new \Phue\Core\UI\PhueComponentLoader($phuiDir);
    $loaderRegistry = new \Phue\Core\Frontend\ComponentLoaderRegistry();
    $loaderRegistry->addLoader($loader);
    $registry = $loaderRegistry;

    foreach ($whitelist as $name) {
        $moduleUrl = $loaderRegistry->moduleUrl($name);
        if ($moduleUrl !== null) {
            $urls[$name] = $moduleUrl;
        }
    }
}

// Server-side rendered (HTML-first) component demo.
$ssrDemos = [];
if ($registry !== null) {
    try {
        $ssrNav = $registry->load('PhNavigation', [
            'items'       => [
                ['label' => 'Home', 'href' => '/'],
                ['label' => 'Docs', 'href' => '/docs'],
                ['label' => 'UI Components', 'href' => '/ui'],
                ['label' => 'Products', 'href' => '/products'],
                ['label' => 'Disabled', 'href' => '/disabled', 'disabled' => true],
            ],
            'activeRoute' => '/ui',
        ]);
        $ssrDemos['PhNavigation'] = $ssrNav->view->getHtml();
    } catch (\Throwable) {
        $ssrDemos['PhNavigation'] = '';
    }
}

$code = [
    'Overview' => <<<'SNP'
// The page whitelist drives the ONLY modules the client fetches:
const used = ['PhButton', 'PhModal', 'PhDataTable'];

// phuiUrls = server-side module URLs for exactly this whitelist
const components = await loadPhueWhitelist(phuiUrls);

createApp({ components }).mount('#app');
SNP,
    'PhButton' => <<<'SNP'
<ph-button variant="primary" :loading="loading" @click="onSave">
  Save changes
</ph-button>
SNP,
    'PhInput' => <<<'SNP'
<ph-input
  v-model="inputValue"
  label="Email"
  placeholder="you@example.com"
  helper-text="We never share your email."
  :error="inputError"
/>
SNP,
    'PhSelect' => <<<'SNP'
<ph-select
  v-model="selectValue"
  label="Framework"
  :options="[
    { label: 'Vue 3', value: 'vue' },
    { label: 'React', value: 'react', disabled: true },
    { label: 'Svelte', value: 'svelte' }
  ]"
/>
SNP,
    'PhTextarea' => <<<'SNP'
<ph-textarea
  v-model="message"
  label="Message"
  :rows="5"
  resize="vertical"
  helper-text="Max 500 characters."
/>
SNP,
    'PhCheckbox' => <<<'SNP'
<ph-checkbox v-model="checked" label="I agree to the terms" />
SNP,
    'PhRadio' => <<<'SNP'
<ph-radio v-model="radioValue" name="plan" value="free" label="Free" />
<ph-radio v-model="radioValue" name="plan" value="pro" label="Pro" />
<ph-radio v-model="radioValue" name="plan" value="team" label="Team" />
SNP,
    'PhFormField' => <<<'SNP'
<ph-form-field label="Email" helper-text="Required for login."
               :error="inputError">
  <ph-input v-model="inputValue" placeholder="you@example.com" />
</ph-form-field>
SNP,
    'PhDataTable' => <<<'SNP'
<ph-data-table
  :columns="tableCols"
  :items="tableRows"
  paginated
  :page-size="4"
/>
SNP,
    'PhBadge' => <<<'SNP'
<ph-badge variant="success" pill label="Deployed" />
SNP,
    'PhAvatar' => <<<'SNP'
<ph-avatar name="Makarios Varoutsos" size="md" shape="circle" />
SNP,
    'PhCard' => <<<'SNP'
<ph-card title="Weekly Report" subtitle="Last 7 days" hoverable>
  Revenue grew 12% week over week.
  <template #footer>
    <ph-button variant="outline" size="sm">View details</ph-button>
  </template>
</ph-card>
SNP,
    'PhChip' => <<<'SNP'
<ph-chip
  v-for="(chip, i) in chips"
  :key="chip"
  label="chip"
  variant="primary"
  removable
  @remove="chips.splice(i, 1)"
/>
SNP,
    'PhAlert' => <<<'SNP'
<ph-alert variant="success" title="Deployed"
         dismissible @dismiss="alertVisible = false">
  v2.4.0 is now live.
</ph-alert>
SNP,
    'PhModal' => <<<'SNP'
<ph-button variant="primary" @click="modalOpen = true">
  Open modal
</ph-button>

<ph-modal v-model="modalOpen" title="Confirm" size="md" closable>
  Are you sure you want to continue?
  <template #footer>
    <ph-button variant="ghost" @click="modalOpen = false">Cancel</ph-button>
    <ph-button variant="primary" @click="modalOpen = false">Confirm</ph-button>
  </template>
</ph-modal>
SNP,
    'PhProgressBar' => <<<'SNP'
<ph-progress-bar :value="progressValue" label="Syncing"
                 variant="success" show-value animated />
SNP,
    'PhSkeleton' => <<<'SNP'
