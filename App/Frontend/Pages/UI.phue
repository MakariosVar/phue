  v-model:current-page="currentPage"
  :total-pages="totalPages"
/>
SNP,
    'PhBreadcrumb' => <<<'SNP'
<ph-breadcrumb :items="[
  { label: 'Home', href: '/' },
  { label: 'Docs', href: '/docs' },
  { label: 'UI Components' }
]" />
SNP,
    'PhLink' => <<<'SNP'
<ph-link href="#overview" variant="primary" underline>Docs</ph-link>
SNP,
    'PhText' => <<<'SNP'
<ph-text size="lg" weight="semibold" color="main">
  Build once, style everywhere.
</ph-text>
SNP,
    'PhHeading' => <<<'SNP'
<ph-heading :level="2" color="primary">Section title</ph-heading>
SNP,
    'PhBox' => <<<'SNP'
<ph-box padding="lg" radius="lg" border bg="surface">
  <p class="mb-0">Surfaced, rounded box.</p>
</ph-box>
SNP,
    'Spacer' => <<<'SNP'
<ph-stack gap="none">
  <span>Above the gap</span>
  <spacer size="lg" />
  <span>Below the gap</span>
</ph-stack>
SNP,
    'PhStack' => <<<'SNP'
<ph-stack gap="lg" align="center">
  <div class="p-3 border rounded">A</div>
  <div class="p-3 border rounded">B</div>
  <div class="p-3 border rounded">C</div>
</ph-stack>
SNP,
    'PhFlex' => <<<'SNP'
<ph-flex direction="row" justify="space-between" gap="lg" wrap="wrap">
  <ph-button variant="primary">Primary</ph-button>
  <ph-button variant="outline">Outline</ph-button>
  <ph-button variant="ghost">Ghost</ph-button>
</ph-flex>
SNP,
    'PhNavigation' => <<<'SNP'
<?php
// HTML-first components need no client import:
$navHtml = $partialRenderer->renderPartial('PhNavigation', [
    'items'       => NavigationConfig::getAppItems(),
    'activeRoute' => $uri,
]);
?>
<div v-html="navHtml"></div>
SNP,
];

return [
    'title' => 'Phue PhUI — Built-in Components',
    'state' => [
        // Only whitelisted components get a module URL; the client imports none else.
        'activeSection'   => $activeSection ?? 'overview',
        'phuiUrls'        => $urls,
        'code'            => $code,
        'ssrDemos'        => $ssrDemos,
        'navItems'        => [
            ['id' => 'overview',   'label' => 'Overview'],
            ['id' => 'forms',      'label' => 'Form Controls'],
            ['id' => 'data',       'label' => 'Data Display'],
            ['id' => 'feedback',   'label' => 'Feedback'],
            ['id' => 'navigation', 'label' => 'Navigation'],
            ['id' => 'content',    'label' => 'Content & Layout'],
            ['id' => 'ssr',        'label' => 'Server-Side'],
        ],
        'checked'         => $checked ?? true,
        'radioValue'      => $radioValue ?? 'option1',
        'loading'         => $loading ?? false,
        'currentPage'     => $currentPage ?? 3,
        'totalPages'      => $totalPages ?? 10,
        'activeTab'       => $activeTab ?? 'overview',
        'modalOpen'       => $modalOpen ?? false,
        'alertVisible'    => !($alertDismissed ?? false),
        'inputValue'      => $inputValue ?? 'Sample text',
        'selectValue'     => $selectValue ?? 'vue',
        'progressValue'   => $progressValue ?? 65,
        'message'         => '',
        'inputError'      => '',
        'savedAt'         => '',
        'chips'           => ['Vue 3', 'PHP 8.5', 'Docker', 'Swoole'],
        'selectOptions'   => [
            ['label' => 'Vue 3', 'value' => 'vue'],
            ['label' => 'React', 'value' => 'react', 'disabled' => true],
            ['label' => 'Svelte', 'value' => 'svelte'],
        ],
        'tabsItems'       => [
            ['label' => 'Overview', 'value' => 'overview'],
            ['label' => 'Settings', 'value' => 'settings'],
            ['label' => 'Advanced', 'value' => 'advanced', 'disabled' => true],
        ],
        'breadcrumbItems' => [
            ['label' => 'Home', 'href' => '/'],
            ['label' => 'Docs', 'href' => '/docs'],
            ['label' => 'UI Components'],
        ],
        'tableCols'       => [
            ['key' => 'id', 'label' => 'ID'],
            ['key' => 'name', 'label' => 'Product', 'sortable' => true],
            ['key' => 'price', 'label' => 'Price', 'sortable' => true],
            ['key' => 'status', 'label' => 'Status'],
        ],
        'tableRows'       => [
            ['id' => 1, 'name' => 'Phue Runtime', 'price' => 49, 'status' => 'Active'],
            ['id' => 2, 'name' => 'Phue Router', 'price' => 39, 'status' => 'Active'],
            ['id' => 3, 'name' => 'Phue Console', 'price' => 59, 'status' => 'Beta'],
            ['id' => 4, 'name' => 'Phue Phii', 'price' => 29, 'status' => 'Beta'],
