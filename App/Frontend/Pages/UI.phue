                            <ph-button :loading="loading" @click="loading = !loading">
                                {{ loading ? 'Saving…' : 'Save' }}
                            </ph-button>
                            <ph-button :disabled="disabled" @click="disabled = !disabled">Toggle</ph-button>
                            <footer v-if="savedAt" class="small text-body-secondary">
                                Saved at {{ savedAt }}.
                            </footer>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhButton }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-input&gt;</code></h5>
                        <p class="small text-body-secondary"><code>v-model</code>, labels, helper/error text, disabled &amp; readonly.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-input v-model="inputValue" label="Email" placeholder="you@example.com"
