                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;spacer&gt;</code></h5>
                        <p class="small text-body-secondary">Tiny flex-gap helper for precise spacing.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-stack gap="none">
                                <span>Above the gap</span>
                                <spacer size="lg" />
                                <span>Below the gap</span>
                            </ph-stack>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.Spacer }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-stack&gt;</code></h5>
                        <p class="small text-body-secondary">Vertical flow with typed <code>gap</code> and <code>align</code>.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-stack gap="lg" align="center">
                                <div class="border rounded p-2 px-3 bg-body-secondary">Item A</div>
                                <div class="border rounded p-2 px-3 bg-body-secondary">Item B</div>
                                <div class="border rounded p-2 px-3 bg-body-secondary">Item C</div>
                            </ph-stack>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhStack }}</code></pre>
                    </div>
