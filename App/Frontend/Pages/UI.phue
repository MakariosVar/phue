                            <ph-switch v-model="switchOn" label="Enable notifications" />
                            <ph-switch v-model="switchNotif" size="lg" label="Larger switch" />
                            <ph-switch v-model="switchOn" disabled label="Disabled" />
                            <p class="small text-body-secondary mt-2 mb-0">Notifications: <code>{{ switchOn }}</code></p>
                        </div>
                        <pre class="phue-code-block mb-0"><code>{{ code.PhSwitch }}</code></pre>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card p-3 h-100">
                        <h5 class="mb-1"><code>&lt;ph-select3&gt;</code></h5>
                        <p class="small text-body-secondary">Searchable single/multiple select with removable chips.</p>
                        <div class="phue-demo border rounded p-3 mb-3">
                            <ph-select3 v-model="select3Single" label="Framework (single)"
