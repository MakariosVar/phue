<php>
$navItems = [
    [
        'id' => 'index',
        'label' => 'Overview',
        'components' => []
    ],
    [
        'id' => 'forms',
        'label' => 'Form Controls',
        'components' => [
            ['id' => 'button', 'label' => 'Button'],
            ['id' => 'input', 'label' => 'Input'],
            ['id' => 'number-input', 'label' => 'Number Input'],
            ['id' => 'select', 'label' => 'Select'],
            ['id' => 'select3', 'label' => 'Select3'],
            ['id' => 'textarea', 'label' => 'Textarea'],
            ['id' => 'checkbox', 'label' => 'Checkbox'],
            ['id' => 'radio', 'label' => 'Radio'],
            ['id' => 'switch', 'label' => 'Switch'],
            ['id' => 'search-input', 'label' => 'Search Input'],
            ['id' => 'range', 'label' => 'Range'],
            ['id' => 'file-input', 'label' => 'File Input'],
            ['id' => 'date-picker', 'label' => 'Date Picker'],
            ['id' => 'segmented-control', 'label' => 'Segmented Control'],
            ['id' => 'form', 'label' => 'Form'],
            ['id' => 'form-field', 'label' => 'Form Field'],
        ]
    ],
    [
        'id' => 'data',
        'label' => 'Data Display',
        'components' => [
            ['id' => 'table', 'label' => 'Table'],
            ['id' => 'badge', 'label' => 'Badge'],
            ['id' => 'chip', 'label' => 'Chip'],
            ['id' => 'avatar', 'label' => 'Avatar'],
        ]
    ],
    [
        'id' => 'feedback',
        'label' => 'Feedback',
        'components' => [
            ['id' => 'alert', 'label' => 'Alert'],
            ['id' => 'modal', 'label' => 'Modal'],
            ['id' => 'progress-bar', 'label' => 'Progress Bar'],
        ]
    ],
    [
        'id' => 'navigation',
        'label' => 'Navigation',
        'components' => []
    ],
    [
        'id' => 'content',
        'label' => 'Content & Layout',
        'components' => []
    ],
    [
        'id' => 'ssr',
        'label' => 'Server-Side',
        'components' => []
    ],
];

// ?section= is a location, not a section: it may name a component inside one
// ('segmented-control'), because that is what the nav writes when a component
// is picked. Resolve it to the section that has to be rendered, and keep the
// original id so the client can put the highlight on the component itself.
$location = is_string($section ?? null) ? $section : '';
$sectionId = null;

if ($location !== '') {
    foreach ($navItems as $group) {
        if ($group['id'] === $location) {
            $sectionId = $group['id'];
            break;
        }
        foreach ($group['components'] as $component) {
            if ($component['id'] === $location) {
                $sectionId = $group['id'];
                break 2;
            }
        }
    }
}

// An unknown id must not render an empty page, and it must not be handed to
// the client as an anchor either: there is no element for the scroll spy to
// find, so it would silently resolve to the first target and leave the URL
// claiming a location that does not exist. Both fall back together.
if ($sectionId === null) {
    $sectionId = 'index';
    $location = 'index';
}

return [
    'title' => 'Phue PhUI — Built-in Components',
    'state' => [
        'activeSection' => $sectionId,
        'activeAnchor' => $location,
        'searchQuery' => '',
        'shellHeight' => 'calc(100dvh - 4.75rem)',
        'navItems' => $navItems,
    ],
];
</php>

<template>
    <div ref="shellEl" class="d-flex overflow-hidden" v-cloak :style="{ height: shellHeight }">

        <ph-toast position="top-right" />
        <ph-confirm-dialog />

        <!-- Sidebar: fixed-height column, never scrolls with the page. -->
        <aside
            class="phue-sidebar border-end d-flex flex-column flex-shrink-0 overflow-y-auto"
            style="width: 260px; background: var(--bs-body-bg);"
        >
            <div class="px-4 mb-4 pt-1">
                <h1 class="h4 fw-semibold mb-1">Phue PhUI</h1>
                <p class="small text-body-secondary mb-0">Built-in components</p>
            </div>

            <div class="px-4 mb-3">
                <ph-search-input
                    v-model="searchQuery"
                    placeholder="Search…"
                    size="sm"
                    :clearable="true"
                />
            </div>

            <div class="flex-column px-3 pb-3" style="gap: 0.1rem; min-height: 0;" aria-label="PhUI components">
                <div style="display: contents;" v-for="nav in filteredNavItems" :key="nav.id">
                    <!-- Main Nav Link -->
                    <button
                        type="button"
                        class="phue-nav-link nav-link d-flex align-items-center"
                        :class="{ 'phue-nav-link--active': activeSection === nav.id }"
                        :style="{
                            border: '0',
                            borderLeft: '3px solid ' + (activeSection === nav.id ? 'var(--bs-primary)' : 'transparent'),
                            padding: '0.45rem 0.75rem',
                            borderRadius: '0.375rem',
                            width: '100%',
                            textAlign: 'left',
                            fontSize: '0.875rem',
                            fontWeight: activeSection === nav.id ? '600' : '500',
                            color: activeSection === nav.id ? 'var(--bs-emphasis-color)' : 'var(--bs-body-color)',
                            background: activeSection === nav.id ? 'var(--bs-secondary-bg)' : 'transparent',
                            textDecoration: 'none',
                            transition: 'all 0.15s ease',
                            cursor: 'pointer'
                        }"
                        :aria-current="activeSection === nav.id ? 'true' : null"
                        :aria-expanded="expandedSections[nav.id] ? 'true' : 'false'"
                        @click.stop="nav.components.length ? toggleSection(nav.id) : scrollTo(nav.id)"
                    >
                        <span style="flex: 1;">{{ nav.label }}</span>
                        <span
                            v-if="nav.components.length"
                            class="small d-inline-flex align-items-center"
                            :style="{
                                transform: expandedSections[nav.id] ? 'none' : 'rotate(-90deg)',
                                transition: 'transform 0.15s ease',
                                cursor: 'pointer'
                            }"
                        >▾</span>
                    </button>

                    <!-- Sub Links -->
                    <a
                        v-for="comp in (expandedSections[nav.id] ? nav.components : [])"
                        :key="comp.id"
                        :href="'#' + comp.id"
                        class="phue-nav-sub-link d-flex align-items-center ms-4 p-1"
                        :class="{ 'phue-nav-link--active': activeAnchor === comp.id }"
                        :style="{
                            color: activeAnchor === comp.id ? 'var(--bs-primary)' : 'var(--bs-secondary-color)',
                            fontWeight: activeAnchor === comp.id ? '600' : '400',
                            background: activeAnchor === comp.id ? 'var(--bs-secondary-bg)' : 'transparent',
                            borderRadius: '0.25rem',
                            transition: 'all 0.15s ease',
                            cursor: 'pointer'
                        }"
                        :aria-current="activeAnchor === comp.id ? 'true' : null"
                        @click.prevent="scrollTo(comp.id)"
                    >
                        {{ comp.label }}
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main: the only scroll container on the page. -->
        <main
            ref="mainEl"
            class="flex-grow-1 p-4 overflow-y-auto"
            style="min-width: 0; min-height: 0;"
        >
            <div ref="contentEl">
                <!-- One section in the DOM at a time. The server decides which
                     one for crawlers and for a deep link; the nav decides for
                     the reader. Both write activeSection, and nothing else. -->
                <section v-if="activeSection === 'index'" id="index" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Overview</h2>
                    <phui-overview />
                </section>

                <!-- Form Controls -->
                <section v-if="activeSection === 'forms'" id="forms" class="mb-5">
                    <ph-card title='Form Controls'>
                        <div class="d-flex flex-column gap-2">
                            <span id="button">
                                <example-ph-button />
                            </span>
                            <span id="input">
                                <example-ph-input />
                            </span>
                            <span id="number-input">
                                <example-ph-number-input />
                            </span>
                            <span id="select">
                                <example-ph-select />
                            </span>
                            <span id="select3">
                                <example-ph-select3 />
                            </span>
                            <span id="textarea">
                                <example-ph-textarea />
                            </span>
                            <span id="checkbox">
                                <example-ph-checkbox />
                            </span>
                            <span id="radio">
                                <example-ph-radio />
                            </span>
                            <span id="switch">
                                <example-ph-switch />
                            </span>
                            <span id="search-input">
                                <example-ph-search-input />
                            </span>
                            <span id="range">
                                <example-ph-range />
                            </span>
                            <span id="file-input">
                                <example-ph-file-input />
                            </span>
                            <span id="date-picker">
                                <example-ph-date-picker />
                            </span>
                            <span id="segmented-control">
                                <example-ph-segmented-control />
                            </span>
                            <span id="form">
                                <example-ph-form />
                            </span>
                            <span id="form-field">
                                <example-ph-form-field />
                            </span>
                            <span id="input-shell">
                                <example-ph-input-shell />
                            </span>
                        </div>
                    </ph-card>

                </section>

                <!-- Data Display -->
                <section v-if="activeSection === 'data'" id="data" class="mb-5">
                    <ph-card title='Data Display'>

                        <h2 class="h4 fw-semibold mb-3">Data Display</h2>
                        <div class="d-flex flex-column gap-2">
                            <span id="table">
                                <example-ph-data-table />
                            </span>
                            <span id="badge">
                                <example-ph-badge />
                            </span>
                            <span id="chip">
                                <example-ph-chip />
                            </span>
                            <span id="avatar">
                                <example-ph-avatar />
                            </span>
                        <!--
                            <ExamplePhCard />
                            <ExamplePhEmptyState />
                            <ExamplePhStat />
                            <ExamplePhListGroup />
                            <ExamplePhDescriptionList />
                            <ExamplePhTimeline />
                            <ExamplePhCode />
                            <ExamplePhTreeView />
                            <ExamplePhAccordion />
                            <ExamplePhIcon /> -->
                        </div>
                    </ph-card>
                    
                </section>

                <!-- Feedback -->
                <section v-if="activeSection === 'feedback'" id="feedback" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Feedback</h2>
                    <div class="row g-4">
                        <!-- <ExamplePhAlert />
                        <ExamplePhModal />
                        <ExamplePhProgressBar />
                        <ExamplePhSkeleton />
                        <ExamplePhSpinner />
                        <ExamplePhTooltip />
                        <ExamplePhToast />
                        <ExamplePhDrawer />
                        <ExamplePhConfirmDialog />
                        <ExamplePhPopover /> -->
                    </div>
                </section>

                <!-- Navigation -->
                <section v-if="activeSection === 'navigation'" id="navigation" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Navigation</h2>
                    <div class="row g-4">
                        <!-- <ExamplePhBreadcrumb />
                        <ExamplePhLink />
                        <ExamplePhPagination />
                        <ExamplePhTabs />
                        <ExamplePhTheme />
                        <ExamplePhDropdown />
                        <ExamplePhStepper /> -->
                    </div>
                </section>

                <!-- Content & Layout -->
                <section v-if="activeSection === 'content'" id="content" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Content & Layout</h2>
                    <div class="row g-4">
                        <!-- <ExamplePhText />
                        <ExamplePhHeading />
                        <ExamplePhBox />
                        <ExamplePhStack />
                        <ExamplePhFlex />
                        <ExamplePhRow />
                        <ExamplePhCol />
                        <ExamplePhDivider />
                        <ExampleSpacer /> -->
                    </div>
                </section>

                <!-- Server-Side -->
                <section v-if="activeSection === 'ssr'" id="ssr" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Server-Side</h2>
                    <div class="row g-4">
                        <!-- <ExamplePhNavigation />
                        <ExamplePhMarkdown /> -->
                    </div>
                </section>
            </div>
        </main>
    </div>
</template>

<script>
import { createSSRApp, reactive, toRefs, computed, watch, onMounted, onBeforeUnmount, nextTick, ref } from 'vue';

const SHELL_FALLBACK_HEIGHT = 'calc(100dvh - 4.75rem)';

/** Never collapse the shell below this, no matter how small the viewport gets. */
const SHELL_MIN_HEIGHT = 240;

/** Distance from the scroller's top edge where a target becomes the "current" one. */
const SPY_ACTIVATION_OFFSET = 32;

/** Breathing room kept above a target when scrolling it into view. */
const SPY_TARGET_PADDING = 8;

/**
 * The one URL parameter that says where the reader is.
 *
 * It holds a location id, which may be a section ('forms') or a component
 * inside one ('segmented-control'). The server resolves a component to its
 * parent section and renders that; the client only ever round-trips the id.
 */
const SECTION_PARAM = 'section';

/** Where the page opens when the URL says nothing. */
const DEFAULT_SECTION = 'index';

export default function mountApp(injectedContext = null) {
    if (typeof window !== 'undefined' && window.__phueApp?.unmount) {
        window.__phueApp.unmount();
    }

    // Safely retrieve state across all possible PHP/V8Js and Browser environments
    const getInitialState = () => {
        if (injectedContext) return injectedContext;
        if (typeof globalThis !== 'undefined' && globalThis.__INITIAL_STATE__) return globalThis.__INITIAL_STATE__;
        if (typeof window !== 'undefined' && window.__INITIAL_STATE__) return window.__INITIAL_STATE__;
        try { if (typeof __INITIAL_STATE__ !== 'undefined') return __INITIAL_STATE__; } catch (e) {}
        return {};
    };

    const app = createSSRApp({
        name: 'PhUI',
        setup() {
            const initState = getInitialState();

            // What the server actually asked for, before the 'index' fallback.
            // Kept separately so a plain visit to /phui is not treated as an
            // explicit "show me Overview" request and yanked back to the top
        // when the browser restores a scroll position on Back.
        const serverSection = initState.activeSection ?? '';

            // Initialize state. We start navItems as empty to safely manage hydration.
            //
            // activeSection and activeAnchor answer different questions and must
            // not share a variable. activeSection is "which section is in the
            // DOM" — it is section-level only, and it is what the v-if on each
            // <section> reads, so it is also what the server has to get right for
            // crawlers. activeAnchor is "which component inside it is in view",
            // and that is all the scroll spy is allowed to move. Folding the two
            // together makes the spy close the very section the reader is in: a
            // spy that reports 'button' fails an `activeSection === 'forms'`
            // test, and the section unmounts under the cursor.
            const state = reactive({
                activeSection: initState.activeSection ?? DEFAULT_SECTION,
                activeAnchor: initState.activeAnchor ?? '',
                searchQuery: initState.searchQuery ?? '',
                navItems: [],
            });

            const shellEl = ref(null);
            const mainEl = ref(null);
            const contentEl = ref(null);
            const shellHeight = ref(initState.shellHeight ?? SHELL_FALLBACK_HEIGHT);
            const expandedSections = reactive({});

            /** Flat, DOM-ordered list of every spy target (sections + their components). */
            const orderedSpyIds = computed(() => {
                const ids = [];
                for (const nav of state.navItems) {
                    ids.push(nav.id);
                    for (const comp of nav.components) ids.push(comp.id);
                }
                return ids;
            });

            // --- OPTIMIZED SPY CACHE (Eliminates Layout Thrashing) ---
            let targetsCache = null;

            function invalidateElementCache() {
                targetsCache = null;
            }

            /**
             * Batches all DOM reads in a single layout pass to prevent reflow during scrolling.
             */
            function getTargetPositions() {
                const main = mainEl.value;
                if (!main) return [];

                if (targetsCache === null) {
                    const mainTop = main.getBoundingClientRect().top;
                    const mainScrollTop = main.scrollTop;
                    const list = [];

                    // Single BATCH DOM READ pass
                    for (const id of orderedSpyIds.value) {
                        const el = document.getElementById(id);
                        if (el) {
                            const relativeTop = el.getBoundingClientRect().top - mainTop + mainScrollTop;
                            list.push({ id, top: relativeTop });
                        }
                    }
                    targetsCache = list;
                }
                return targetsCache;
            }

            /** Returns the nav group id owning the given target id, or null. */
            function parentGroupOf(id) {
                for (const nav of state.navItems) {
                    if (nav.id === id) return nav.id;
                    if (nav.components.some((comp) => comp.id === id)) return nav.id;
                }
                return null;
            }

            /** True when the id names a section rather than a component inside one. */
            function isSectionId(id) {
                return state.navItems.some((nav) => nav.id === id);
            }

            /**
             * Opens a section and reveals it in the nav.
             *
             * Section-level only. Changing it swaps the <section> in the DOM, so
             * callers that merely want to move the highlight inside the current
             * section must use markAnchor() instead.
             */
            function setActiveSection(id, expand = true) {
                if (!id || !isSectionId(id) || state.activeSection === id) return;
                state.activeSection = id;
                if (!expand) return;
                expandedSections[id] = true;
            }

            /**
             * Moves the highlight onto a component without disturbing which
             * section is rendered. This is the only thing the scroll spy writes.
             */
            function markAnchor(id) {
                if (!id) return;
                state.activeAnchor = id;
            }

            function prefersReducedMotion() {
                return typeof window.matchMedia === 'function'
                    && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            }

            /**
             * Scrolls the target to the top of the scroller. Deliberately does NOT use
             * scrollIntoView(): that walks up and scrolls every scrollable ancestor,
             * including the document, which would drag the whole layout.
             */
            function scrollTargetIntoView(id) {
                const el = document.getElementById(id);
                const main = mainEl.value;
                if (!el || !main) return;
                const delta = el.getBoundingClientRect().top - main.getBoundingClientRect().top;
                main.scrollTo({
                    top: Math.max(0, main.scrollTop + delta - SPY_TARGET_PADDING),
                    behavior: prefersReducedMotion() ? 'auto' : 'smooth',
                });
            }

            /**
             * Navigates to a section or a component inside it.
             *
             * The two need different handling now that only one section is
             * mounted: a section id swaps the DOM, so the section must open
             * first and the scroll can only happen after Vue has rendered it. A
             * component id is already on screen, so it just moves the highlight.
             */
            function scrollTo(id) {
                if (!id) return;

                if (isSectionId(id)) {
                    setActiveSection(id);
                    markAnchor(id);
                    nextTick(() => scrollTargetIntoView(id));
                } else {
                    const group = parentGroupOf(id);
                    if (group && group !== state.activeSection) {
                        // The component lives in a section that is not mounted.
                        setActiveSection(group);
                        nextTick(() => scrollTargetIntoView(id));
                    } else {
                        markAnchor(id);
                        scrollTargetIntoView(id);
                    }
                }

                syncUrl(id, { push: true });
            }

            function toggleSection(id) {
                expandedSections[id] = !expandedSections[id];
            }

            // ---------------------------------------------------------------
            // URL as the single source of truth for "where am I"
            // ---------------------------------------------------------------
            //
            // There used to be two: the server's ?section= and the client-written
            // #fragment. They disagreed — a reload dropped the anchor, a copy of
            // the URL lost the section, and a component click changed one while
            // leaving the other stale. One parameter fixes that, and it has to
            // accept both kinds of id, because a component is a perfectly good
            // destination: the server resolves it to its parent section and
            // renders that.

            /** The id in ?section=, or '' when absent. */
            function locationId() {
                try {
                    return new URL(window.location.href).searchParams.get(SECTION_PARAM) || '';
                } catch (e) {
                    return '';
                }
            }

            /**
             * Writes the current location into the URL.
             *
             * push for navigation, replace for the scroll spy. A spy that pushed
             * would put an entry in history for every target the reader passed
             * through, so Back would walk the scrollback one pixel at a time.
             */
            function syncUrl(id, { push = false } = {}) {
                if (!id || typeof history === 'undefined') return;

                const url = new URL(window.location.href);
                if (id === DEFAULT_SECTION) {
                    url.searchParams.delete(SECTION_PARAM);
                } else {
                    url.searchParams.set(SECTION_PARAM, id);
                }
                url.hash = '';

                const next = url.pathname + url.search;
                if (push) history.pushState({ [SECTION_PARAM]: id }, '', next);
                else history.replaceState({ [SECTION_PARAM]: id }, '', next);
            }

            /**
             * Applies a location id that arrived from outside the page: the server
             * on first paint, or the Back button afterwards.
             */
            function applyLocation(id) {
                if (!id) return;

                if (isSectionId(id)) {
                    setActiveSection(id);
                    markAnchor(id);
                } else {
                    const group = parentGroupOf(id);
                    if (group) setActiveSection(group);
                    markAnchor(id);
                }

                nextTick(() => {
                    invalidateElementCache();
                    scrollTargetIntoView(id);
                    observeSpyTargets();
                });
            }

            /**
             * Scroll spy driven by IntersectionObserver, with no scroll handler.
             *
             * The old version read main.scrollTop / clientHeight / scrollHeight on
             * every scroll frame, right after setActiveSection had mutated a class
             * and invalidated layout — so each frame forced a synchronous reflow
             * (Lighthouse: 84 ms of forced reflow in this module alone).
             *
             * The observer is used ONLY as a change trigger. It fires when a
             * target crosses the activation line — rootMargin insets the root by
             * SPY_ACTIVATION_OFFSET, so "isIntersecting" literally means "this
             * target has reached the line" — and inside that callback the layout
             * is already clean, so the batched position read below is free.
             *
             * A previous attempt cached each target's top from the entry itself
             * and compared those values. That was wrong twice over: entries only
             * arrive for targets whose intersection CHANGED, so a tall section
             * kept the top it had when it entered, and the whole map stayed empty
             * until the first callback. Positions come from getTargetPositions(),
             * the same source the proven scroll path used, with the cache dropped
             * before each read so it can never be stale.
             */
            let spyObserver = null;

            function observeSpyTargets() {
                spyObserver?.disconnect();
                spyObserver = null;

                const main = mainEl.value;
                if (!main || typeof IntersectionObserver === 'undefined') return;

                spyObserver = new IntersectionObserver(() => {
                    invalidateElementCache();
                    syncActiveFromScroll();
                }, {
                    root: main,
                    rootMargin: `-${SPY_ACTIVATION_OFFSET}px 0px 0px 0px`,
                    threshold: 0
                });

                for (const id of orderedSpyIds.value) {
                    const el = document.getElementById(id);
                    if (el) spyObserver.observe(el);
                }

                invalidateElementCache();
                syncActiveFromScroll();
            }

            /**
             * Picks the component the reader is on, from the cached positions.
             *
             * Only ever writes activeAnchor. A section-level update from here is
             * what broke the conditional render: the spy runs at mount with
             * scrollTop === 0, concludes the reader is on the first target, and
             * an unconditional setActiveSection() there unmounts whichever
             * section the server had rendered.
             *
             * When the server opened a section that is not the first one, the
             * first target IS that section, so the spy agrees with the server by
             * construction and marks it — no special case needed.
             */
            function syncActiveFromScroll() {
                const main = mainEl.value;
                if (!main) return;

                const positions = getTargetPositions();
                if (!positions.length) return;

                const scrollTop = main.scrollTop;
                const atBottom = scrollTop + main.clientHeight >= main.scrollHeight - 2;

                let current = null;

                if (atBottom) {
                    current = positions[positions.length - 1].id;
                } else {
                    for (const item of positions) {
                        if (item.top <= scrollTop + SPY_ACTIVATION_OFFSET) {
                            current = item.id;
                        } else {
                            break;
                        }
                    }
                }

                markAnchor(current || positions[0].id);
                syncUrl(state.activeAnchor, { push: false });
            }

            /** Fallback for engines without IntersectionObserver: poll on scroll. */
            let spyFrame = 0;
            function requestSpySync() {
                if (spyFrame || spyObserver) return;
                spyFrame = requestAnimationFrame(() => {
                    spyFrame = 0;
                    invalidateElementCache();
                    syncActiveFromScroll();
                });
            }

            /**
             * Pins the shell to exactly the space the layout leaves below the topbar,
             * so the page never scrolls as a whole and the sidebar cannot move.
             */
            function measureShell() {
                const shell = shellEl.value;
                if (!shell) return;
                const absoluteTop = shell.getBoundingClientRect().top + (window.scrollY || 0);
                const viewport = document.documentElement.clientHeight || window.innerHeight;
                shellHeight.value = `${Math.round(Math.max(SHELL_MIN_HEIGHT, viewport - absoluteTop))}px`;
            }

            function onResize() {
                invalidateElementCache();
                measureShell();
                if (spyObserver) {
                    // Positions are relative to the scroller's scrollTop, so a
                    // resize invalidates them; the observer re-fires on layout.
                    invalidateElementCache();
                    syncActiveFromScroll();
                } else {
                    requestSpySync();
                }
            }

            function syncExpandedSections() {
                const query = String(state.searchQuery || '').trim().toLowerCase();
                const activeGroup = parentGroupOf(state.activeSection);
                for (const nav of state.navItems) {
                    if (nav.id === activeGroup) {
                        expandedSections[nav.id] = true;
                        continue;
                    }
                    if (!query) continue;
                    expandedSections[nav.id] = nav.label.toLowerCase().includes(query)
                        || nav.components.some((comp) => comp.label.toLowerCase().includes(query));
                }
            }

            const filteredNavItems = computed(() => {
                const query = String(state.searchQuery || '').trim().toLowerCase();
                if (!query) return state.navItems;
                return state.navItems
                    .map((nav) => ({
                        ...nav,
                        components: nav.components.filter((comp) =>
                            comp.label.toLowerCase().includes(query),
                        ),
                    }))
                    .filter((nav) =>
                        nav.label.toLowerCase().includes(query) || nav.components.length > 0,
                    );
            });

            // Hydration mismatch avoider logic
            const hydrateNavData = () => {
                state.navItems = (initState.navItems ?? []).map((nav) => ({
                    ...nav,
                    components: nav.components ?? [],
                }));
                invalidateElementCache();
                syncExpandedSections();
            };

            if (typeof window === 'undefined') {
                // SERVER: Always try to populate data immediately
                hydrateNavData();
            } else {
                // CLIENT: Check if the server actually successfully rendered the sidebar elements
                const navEl = document.querySelector('.phue-sidebar nav');

                if (navEl && navEl.children.length > 0) {
                    // The server successfully rendered the HTML data. Safe to hydrate immediately.
                    hydrateNavData();
                } else {
                    // The server rendered an empty sidebar.
                    // We MUST wait until after mount to populate data, or Vue will throw a mismatch!
                    onMounted(() => {
                        hydrateNavData();
                        nextTick(() => observeSpyTargets());
                    });
                }
            }

            watch(() => state.searchQuery, () => {
                invalidateElementCache();
                syncExpandedSections();
            });

            watch(() => state.navItems.length, () => {
                invalidateElementCache();
                nextTick(() => observeSpyTargets());
            });

            // Swapping the section replaces every observed element inside it, so
            // the observer has to be rebuilt against the new DOM. Without this the
            // spy keeps reporting the anchors of the section that was just
            // unmounted, and the sub-nav highlight drifts to a component that is
            // no longer on the page.
            watch(() => state.activeSection, () => {
                invalidateElementCache();
                nextTick(() => observeSpyTargets());
            });

            let topbarObserver = null;
            let contentObserver = null;

            /**
             * Back/forward across the entries scrollTo() pushed.
             *
             * Without this the URL and the page disagree the moment anyone
             * presses Back: the address bar moves, the rendered section does not.
             * applyLocation() is reused rather than duplicated, so a history
             * entry and a nav click can never take different paths to the same
             * destination.
             */
            function onPopState() {
                applyLocation(locationId());
            }

            onMounted(() => {
                measureShell();
                window.addEventListener('resize', onResize);
                window.addEventListener('popstate', onPopState);

                // The topbar can wrap or grow, which moves the shell without resizing it.
                const topbar = document.querySelector('.app-topbar');
                if (topbar && typeof ResizeObserver !== 'undefined') {
                    topbarObserver = new ResizeObserver(onResize);
                    topbarObserver.observe(topbar);
                }

                // Late-growing content (async components, webfonts) changes target positions.
                if (contentEl.value && typeof ResizeObserver !== 'undefined') {
                    contentObserver = new ResizeObserver(() => {
                        invalidateElementCache();
                        if (spyObserver) syncActiveFromScroll();
                        else requestSpySync();
                    });
                    contentObserver.observe(contentEl.value);
                }

                observeSpyTargets();

                // First paint honours the server's answer. It arrives either as
                // ?section= (already in locationId(), the server put it there to
                // render this) or as the injected state, and the two always
                // agree because the same request produced both.
                //
                // This runs after observeSpyTargets() on purpose. The spy fires
                // once on mount and concludes the reader is on the first target;
                // because it only writes activeAnchor it cannot undo what is set
                // here, whichever order they end up running in.
                applyLocation(locationId() || serverSection);
            });

            onBeforeUnmount(() => {
                window.removeEventListener('resize', onResize);
                window.removeEventListener('popstate', onPopState);
                topbarObserver?.disconnect();
                contentObserver?.disconnect();
                spyObserver?.disconnect();
                if (spyFrame) cancelAnimationFrame(spyFrame);
            });

            return {
                ...toRefs(state),
                shellEl,
                mainEl,
                contentEl,
                shellHeight,
                filteredNavItems,
                expandedSections,
                toggleSection,
                scrollTo
            };
        }
    });

    // Ensure we only attach to window and mount if we are in the browser
    if (typeof window !== 'undefined') {
        window.__phueApp = app;
        window.__phueApp.mount('#app');
    }

    return app;
};
</script>
