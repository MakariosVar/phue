                            cursor: 'pointer'
                        }"
                        :aria-current="activeSection === nav.id ? 'true' : null"
                        @click.prevent="scrollTo(nav.id)"
                    >
                        <span style="flex: 1;">{{ nav.label }}</span>
                        <span
                            v-if="nav.components.length"
                            class="small d-inline-flex align-items-center"
                            :style="{
                                transform: expandedSections[nav.id] ? 'none' : 'rotate(-90deg)',
                                transition: 'transform 0.15s ease',
                                cursor: 'pointer'
                            }"
                            @click.stop.prevent="toggleSection(nav.id)"
                        >▾</span>
                    </a>

                    <!-- Sub Links -->
                    <a
                        v-for="comp in (expandedSections[nav.id] ? nav.components : [])"
                        :key="comp.id"
                        :href="'#' + comp.id"
                        class="phue-nav-sub-link d-flex align-items-center ms-4 p-1"
                        :class="{ 'phue-nav-link--active': activeSection === comp.id }"
                        :style="{
                            color: activeSection === comp.id ? 'var(--bs-primary)' : 'var(--bs-secondary-color)',
                            fontWeight: activeSection === comp.id ? '600' : '400',
                            background: activeSection === comp.id ? 'var(--bs-secondary-bg)' : 'transparent',
                            borderRadius: '0.25rem',
                            textDecoration: 'none',
                            transition: 'all 0.15s ease',
                            cursor: 'pointer'
                        }"
                        :aria-current="activeSection === comp.id ? 'true' : null"
                        @click.prevent="scrollTo(comp.id)"
                    >
                        {{ comp.label }}
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main: the only scroll container on the page. -->
        <main
            ref="mainEl"
            class="flex-grow-1 p-4 overflow-y-auto"
            style="min-width: 0; min-height: 0;"
            @scroll.passive="requestSpySync"
        >
