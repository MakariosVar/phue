            <nav class="nav flex-column px-3 pb-3 flex-grow-1 overflow-y-auto" style="gap: 0.1rem; min-height: 0;" aria-label="PhUI components">
                <div style="display: contents;" v-for="nav in filteredNavItems" :key="nav.id">
                    <!-- Main Nav Link -->
                    <a
                        :href="'#' + nav.id"
                        class="phue-nav-link nav-link d-flex align-items-center"
                        :class="{ 'phue-nav-link--active': activeSection === nav.id }"
                        :style="{
                            borderLeft: '3px solid ' + (activeSection === nav.id ? 'var(--bs-primary)' : 'transparent'),
                            padding: '0.45rem 0.75rem',
                            borderRadius: '0.375rem',
                            fontSize: '0.875rem',
                            fontWeight: activeSection === nav.id ? '600' : '500',
                            color: activeSection === nav.id ? 'var(--bs-emphasis-color)' : 'var(--bs-body-color)',
                            background: activeSection === nav.id ? 'var(--bs-secondary-bg)' : 'transparent',
                            textDecoration: 'none',
