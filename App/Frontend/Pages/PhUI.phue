<php>
$navItems = [
    [
        'id' => 'index',
        'label' => 'Overview',
        'components' => []
    ],
    [
        'id' => 'forms',
        'label' => 'Form Controls',
        'components' => [
            ['id' => 'button', 'label' => 'Button'],
            ['id' => 'input', 'label' => 'Input'],
            ['id' => 'number-input', 'label' => 'Number Input'],
            ['id' => 'select', 'label' => 'Select'],
            ['id' => 'select3', 'label' => 'Select3'],
            ['id' => 'textarea', 'label' => 'Textarea'],
            ['id' => 'checkbox', 'label' => 'Checkbox'],
            ['id' => 'radio', 'label' => 'Radio'],
            ['id' => 'switch', 'label' => 'Switch'],
            ['id' => 'search-input', 'label' => 'Search Input'],
            ['id' => 'range', 'label' => 'Range'],
            ['id' => 'file-input', 'label' => 'File Input'],
            ['id' => 'date-picker', 'label' => 'Date Picker'],
            ['id' => 'segmented-control', 'label' => 'Segmented Control'],
            ['id' => 'form', 'label' => 'Form'],
            ['id' => 'form-field', 'label' => 'Form Field'],
        ]
    ],
    [
        'id' => 'data',
        'label' => 'Data Display',
        'components' => [
            ['id' => 'table', 'label' => 'Table'],
            ['id' => 'badge', 'label' => 'Badge'],
            ['id' => 'chip', 'label' => 'Chip'],
            ['id' => 'avatar', 'label' => 'Avatar'],
            ['id' => 'card', 'label' => 'Card'],
            ['id' => 'empty-state', 'label' => 'Empty State'],
            ['id' => 'stat', 'label' => 'Stat'],
            ['id' => 'list-group', 'label' => 'List Group'],
            ['id' => 'description-list', 'label' => 'Description List'],
            ['id' => 'timeline', 'label' => 'Timeline'],
            ['id' => 'code', 'label' => 'Code'],
            ['id' => 'tree-view', 'label' => 'Tree View'],
            ['id' => 'accordion', 'label' => 'Accordion']
        ]
    ],
    [
        'id' => 'feedback',
        'label' => 'Feedback',
        'components' => [
            ['id' => 'alert', 'label' => 'Alert'],
            ['id' => 'modal', 'label' => 'Modal'],
            ['id' => 'progress-bar', 'label' => 'Progress Bar'],
            ['id' => 'skeleton', 'label' => 'Skeleton'],
            ['id' => 'spinner', 'label' => 'Spinner'],
            ['id' => 'toast', 'label' => 'Toast'],
            ['id' => 'popover', 'label' => 'Popover'],
            ['id' => 'tooltip', 'label' => 'Tooltip'],
            ['id' => 'drawer', 'label' => 'Drawer'],
            ['id' => 'confirm-dialog', 'label' => 'Confirm Dialog'],
        ]
    ],
    [
        'id' => 'navigation',
        'label' => 'Navigation',
        'components' => [
            ['id' => 'breadcrumb', 'label' => 'Breadcrumb'],
            ['id' => 'link', 'label' => 'Link'],
            ['id' => 'pagination', 'label' => 'Pagination'],
            ['id' => 'tabs', 'label' => 'Tabs'],
            ['id' => 'theme', 'label' => 'Theme'],
            ['id' => 'stepper', 'label' => 'Stepper'],
            ['id' => 'dropdown', 'label' => 'Dropdown']
        ]
    ],
    [
        'id' => 'content',
        'label' => 'Content & Layout',
        'components' => [
            ['id' => 'text', 'label' => 'Text'],
            ['id' => 'heading', 'label' => 'Heading'],
            ['id' => 'box', 'label' => 'Box'],
            ['id' => 'stack', 'label' => 'Stack'],
            ['id' => 'flex', 'label' => 'Flex'],
            ['id' => 'row', 'label' => 'Row'],
            ['id' => 'col', 'label' => 'Column'],
            ['id' => 'spacer', 'label' => 'Spacer'],
            ['id' => 'divider', 'label' => 'Divider'],
        ]
    ],
    [
        'id' => 'ssr',
        'label' => 'Server-Side',
        'components' => [
            ['id' => 'main_navigation', 'label' => 'Navigation'],
            ['id' => 'markdown', 'label' => 'Markdown'],
        ]
    ],
];

// ?section= is a location, not a section: it may name a component inside one.
// Resolve it to the section to render, keeping the id for the client's highlight.
$location = is_string($section ?? null) ? $section : '';
$sectionId = null;

if ($location !== '') {
    foreach ($navItems as $group) {
        if ($group['id'] === $location) {
            $sectionId = $group['id'];
            break;
        }
        foreach ($group['components'] as $component) {
            if ($component['id'] === $location) {
                $sectionId = $group['id'];
                break 2;
            }
        }
    }
}

// An unknown id must not render an empty page nor be handed to the client as an
// anchor: there is no element for the spy to find, so both fall back together.
if ($sectionId === null) {
    $sectionId = 'index';
    $location = 'index';
}

// The Server-Side section documents components that are NOT Vue components: they
// are partials rendered on the server into finished markup. The partial renderer
// is a service of the *layout*, not of a page, so a page must not render a
// partial from inside its own render — the showcase runs the markdown through
// the very same parser the partial uses instead, so the demo is real output
// without re-entering the renderer.
$markdownSource = <<<'MARKDOWN'
# Server-rendered

This block was parsed **on the server** and injected as static HTML — no client
JS ships for it.

- Headings, **bold**, _italic_ and `inline code`
- Fenced code blocks and [links](/phui)
- > Blockquotes

Content is escaped before formatting and `javascript:` / `data:` link schemes are
neutralised, so a `.md` file cannot inject script.
MARKDOWN;

$markdownHtml = (new \Phue\Core\Utils\MarkdownParser())->parse($markdownSource);

return [
    'title' => 'Phue PhUI — Built-in Components',
    'state' => [
        'activeSection' => $sectionId,
        'activeAnchor' => $location,
        'searchQuery' => '',
        'shellHeight' => 'calc(100dvh - 4.75rem)',
        'navItems' => $navItems,
        'markdownHtml' => $markdownHtml,
    ],
];
</php>

<template>
    <div ref="shellEl" class="d-flex overflow-hidden" v-cloak :style="{ height: shellHeight }">

        <ph-toast position="top-right" />
        <ph-confirm-dialog />

        <!-- Mobile scrim: only exists while the off-canvas sidebar is open. -->
        <div
            v-if="sidebarOpen"
            class="phue-sidebar-backdrop"
            style="position: fixed; inset: 0; z-index: 1054; background: rgba(0, 0, 0, 0.5);"
            aria-hidden="true"
            @click="sidebarOpen = false"
        ></div>

        <!-- Sidebar: a plain column from lg up, an off-canvas drawer below it. -->
        <aside
            id="phue-phui-sidebar"
            class="phue-sidebar border-end d-flex flex-column overflow-y-auto"
            :class="isMobile ? 'phue-sidebar--mobile' : 'phue-sidebar--static flex-shrink-0'"
            :style="isMobile
                ? (sidebarOpen
                    ? {
                        position: 'fixed', top: '0', left: '0', bottom: '0', zIndex: 1055,
                        width: 'min(300px, 85vw)', maxWidth: '100vw',
                        background: 'var(--bs-body-bg)',
                        boxShadow: '0 0.5rem 1.5rem rgba(0, 0, 0, 0.25)',
                        transition: 'transform 0.2s ease',
                        transform: 'translateX(0)'
                    }
                    : {
                        // Closed: a slim rail that stays IN the flex flow, so it
                        // never covers the page. A floating toggle over the content
                        // was the wrong shape for this.
                        width: '2.75rem', flexShrink: '0',
                        background: 'var(--bs-body-bg)',
                        borderRight: '1px solid var(--bs-border-color)'
                    })
                : { width: '260px', maxWidth: '85vw', background: 'var(--bs-body-bg)' }"
            :aria-hidden="isMobile && !sidebarOpen ? 'true' : null"
            aria-label="PhUI components"
        >
            <!-- Rail handle: the collapsed sidebar is 44px of this and nothing else. -->
            <button
                v-if="isMobile"
                type="button"
                class="btn btn-sm btn-link text-body-secondary d-flex align-items-center justify-content-start flex-shrink-0 py-2"
                style="width: 100%; padding-left: 0.6rem; padding-right: 0; color: var(--bs-body-color);"
                aria-haspopup="true"
                :aria-expanded="sidebarOpen ? 'true' : 'false'"
                aria-controls="phue-phui-sidebar-content"
                aria-label="Browse components"
                @click="sidebarOpen = !sidebarOpen"
            >☰</button>

            <div v-if="!isMobile || sidebarOpen" id="phue-phui-sidebar-content" class="px-4 mb-4 pt-1">
                <h1 class="h4 fw-semibold mb-1">Phue PhUI</h1>
                <p class="small text-body-secondary mb-0">Built-in components</p>
            </div>

            <div v-if="!isMobile || sidebarOpen" class="px-4 mb-3">
                <ph-search-input
                    id="phui-search-input"
                    v-model="searchQuery"
                    placeholder="Search… (Ctrl+K)"
                    size="sm"
                    :clearable="true"
                />
            </div>

            <div v-if="!isMobile || sidebarOpen" class="flex-column px-3 pb-3" style="gap: 0.1rem; min-height: 0;">
                <div style="display: contents;" v-for="nav in filteredNavItems" :key="nav.id">
                    <!-- Main Nav Link -->
                    <button
                        type="button"
                        class="phue-nav-link nav-link d-flex align-items-center"
                        :class="{ 'phue-nav-link--active': activeSection === nav.id }"
                        :style="{
                            border: '0',
                            borderLeft: '3px solid ' + (activeSection === nav.id ? 'var(--bs-primary)' : 'transparent'),
                            padding: '0.45rem 0.75rem',
                            borderRadius: '0.375rem',
                            width: '100%',
                            textAlign: 'left',
                            fontSize: '0.875rem',
                            fontWeight: activeSection === nav.id ? '600' : '500',
                            color: activeSection === nav.id ? 'var(--bs-emphasis-color)' : 'var(--bs-body-color)',
                            background: activeSection === nav.id ? 'var(--bs-secondary-bg)' : 'transparent',
                            textDecoration: 'none',
                            transition: 'all 0.15s ease',
                            cursor: 'pointer'
                        }"
                        :aria-current="activeSection === nav.id ? 'true' : null"
                        :aria-expanded="expandedSections[nav.id] ? 'true' : 'false'"
                        @click.stop="nav.components.length ? toggleSection(nav.id) : scrollTo(nav.id)"
                    >
                        <span style="flex: 1;">{{ nav.label }}</span>
                        <span
                            v-if="nav.components.length"
                            class="small d-inline-flex align-items-center"
                            :style="{
                                transform: expandedSections[nav.id] ? 'none' : 'rotate(-90deg)',
                                transition: 'transform 0.15s ease',
                                cursor: 'pointer'
                            }"
                        >▾</span>
                    </button>

                    <!-- Sub Links -->
                    <a
                        v-for="comp in (expandedSections[nav.id] ? nav.components : [])"
                        :key="comp.id"
                        :href="'#' + comp.id"
                        class="phue-nav-sub-link d-flex align-items-center ms-4 p-1"
                        :class="{ 'phue-nav-link--active': activeAnchor === comp.id }"
                        :style="{
                            color: activeAnchor === comp.id ? 'var(--bs-primary)' : 'var(--bs-secondary-color)',
                            fontWeight: activeAnchor === comp.id ? '600' : '400',
                            background: activeAnchor === comp.id ? 'var(--bs-secondary-bg)' : 'transparent',
                            borderRadius: '0.25rem',
                            transition: 'all 0.15s ease',
                            cursor: 'pointer'
                        }"
                        :aria-current="activeAnchor === comp.id ? 'true' : null"
                        @click.prevent="scrollTo(comp.id)"
                    >
                        {{ comp.label }}
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main: the only scroll container on the page. -->
        <main
            ref="mainEl"
            class="flex-grow-1 p-3 p-md-4 overflow-y-auto position-relative"
            style="min-width: 0; min-height: 0;"
        >
            <div ref="contentEl">
                <!-- One section in the DOM at a time: the server decides which one
                     for crawlers and deep links, the nav decides for the reader. -->
                <section v-if="activeSection === 'index'" id="index" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Overview</h2>
                    <phui-overview />
                </section>

                <!-- Form Controls -->
                <section v-if="activeSection === 'forms'" id="forms" class="mb-5">
                    <h3 class="fw-semibold mb-3">Form Controls</h3>
                    <div class="d-flex flex-column gap-2">
                        <span id="button">
                            <example-ph-button @setAnchor="scrollTo('button')"/>
                        </span>
                        <span id="input">
                            <example-ph-input @setAnchor="scrollTo('input')"/>
                        </span>
                        <span id="number-input">
                            <example-ph-number-input @setAnchor="scrollTo('number-input')"/>
                        </span>
                        <span id="select">
                            <example-ph-select @setAnchor="scrollTo('select')"/>
                        </span>
                        <span id="select3">
                            <example-ph-select3 @setAnchor="scrollTo('select3')"/>
                        </span>
                        <span id="textarea">
                            <example-ph-textarea @setAnchor="scrollTo('textarea')"/>
                        </span>
                        <span id="checkbox">
                            <example-ph-checkbox @setAnchor="scrollTo('checkbox')"/>
                        </span>
                        <span id="radio">
                            <example-ph-radio @setAnchor="scrollTo('radio')"/>
                        </span>
                        <span id="switch">
                            <example-ph-switch @setAnchor="scrollTo('switch')"/>
                        </span>
                        <span id="search-input">
                            <example-ph-search-input @setAnchor="scrollTo('search-input')"/>
                        </span>
                        <span id="range">
                            <example-ph-range @setAnchor="scrollTo('range')"/>
                        </span>
                        <span id="file-input">
                            <example-ph-file-input @setAnchor="scrollTo('file-input')"/>
                        </span>
                        <span id="date-picker">
                            <example-ph-date-picker @setAnchor="scrollTo('date-picker')"/>
                        </span>
                        <span id="segmented-control">
                            <example-ph-segmented-control @setAnchor="scrollTo('segmented-control')"/>
                        </span>
                        <span id="form">
                            <example-ph-form @setAnchor="scrollTo('form')"/>
                        </span>
                        <span id="form-field">
                            <example-ph-form-field @setAnchor="scrollTo('form-field')"/>
                        </span>
                        <span id="input-shell">
                            <example-ph-input-shell @setAnchor="scrollTo('input-shell')"/>
                        </span>
                    </div>
                </section>

                <!-- Data Display -->
                <section v-if="activeSection === 'data'" id="data" class="mb-5">
                    <h3 class="fw-semibold mb-3">Data Display</h3>
                    <div class="d-flex flex-column gap-2">
                        <span id="table">
                            <example-ph-data-table @setAnchor="scrollTo('table')"/>
                        </span>
                        <span id="badge">
                            <example-ph-badge @setAnchor="scrollTo('badge')"/>
                        </span>
                        <span id="chip">
                            <example-ph-chip @setAnchor="scrollTo('chip')"/>
                        </span>
                        <span id="avatar">
                            <example-ph-avatar @setAnchor="scrollTo('avatar')"/>
                        </span>
                        <span id="card">
                            <example-ph-card @setAnchor="scrollTo('card')"/>
                        </span>
                        <span id="empty-state">
                            <example-ph-empty-state @setAnchor="scrollTo('empty-state')"/>
                        </span>
                        <span id="stat">
                            <example-ph-stat @setAnchor="scrollTo('stat')"/>
                        </span>
                        <span id="list-group">
                            <example-ph-list-group @setAnchor="scrollTo('list-group')"/>
                        </span>
                        <span id="description-list">
                            <example-ph-description-list @setAnchor="scrollTo('description-list')"/>
                        </span>
                        <span id="timeline">
                            <example-ph-timeline @setAnchor="scrollTo('timeline')"/>
                        </span>
                        <span id="code">
                            <example-ph-code @setAnchor="scrollTo('code')"/>
                        </span>
                        <span id="tree-view">
                            <example-ph-tree-view @setAnchor="scrollTo('tree-view')"/>
                        </span>
                        <span id="accordion">
                            <example-ph-accordion @setAnchor="scrollTo('accordion')"/>
                        </span>
                    </div>
                    
                </section>

                <!-- Feedback -->
                <section v-if="activeSection === 'feedback'" id="feedback" class="mb-5">
                    <h3 class="fw-semibold mb-3">Feedback</h3>
                    <div class="d-flex flex-column gap-2">
                        <span id="alert">
                            <example-ph-alert @setAnchor="scrollTo('alert')"/>
                        </span>
                        <span id="modal">
                            <example-ph-modal @setAnchor="scrollTo('modal')"/>
                        </span>
                        <span id="progress-bar">
                            <example-ph-progress-bar @setAnchor="scrollTo('progress-bar')"/>
                        </span>
                        <span id="skeleton">
                            <example-ph-skeleton @setAnchor="scrollTo('skeleton')"/>
                        </span>
                        <span id="spinner">
                            <example-ph-spinner @setAnchor="scrollTo('spinner')"/>
                        </span>
                        <span id="toast">
                            <example-ph-toast @setAnchor="scrollTo('toast')"/>
                        </span>
                        <span id="popover">
                            <example-ph-popover @setAnchor="scrollTo('popover')"/>
                        </span>
                        <span id="tooltip">
                            <example-ph-tooltip @setAnchor="scrollTo('tooltip')"/>
                        </span>
                        <span id="drawer">
                            <example-ph-drawer @setAnchor="scrollTo('drawer')"/>
                        </span>
                        <span id="confirm-dialog">
                            <example-ph-confirm-dialog @setAnchor="scrollTo('confirm-dialog')"/>
                        </span>
                    </div>
                </section>

                <!-- Navigation -->
                <section v-if="activeSection === 'navigation'" id="navigation" class="mb-5">
                    <h3 class="fw-semibold mb-3">Navigation</h3>
                    <div class="row g-4">
                        <span id="breadcrumb">
                            <example-ph-breadcrumb @setAnchor="scrollTo('breadcrumb')"/>
                        </span>
                        <span id="link">
                            <example-ph-link @setAnchor="scrollTo('link')"/>
                        </span>
                        <span id="pagination">
                            <example-ph-pagination @setAnchor="scrollTo('pagination')"/>
                        </span>
                        <span id="tabs">
                            <example-ph-tabs @setAnchor="scrollTo('tabs')"/>
                        </span>
                        <span id="theme">
                            <example-ph-theme @setAnchor="scrollTo('theme')"/>
                        </span>
                        <span id="stepper">
                            <example-ph-stepper @setAnchor="scrollTo('stepper')"/>
                        </span>
                        <span id="dropdown">
                            <example-ph-dropdown @setAnchor="scrollTo('dropdown')"/>
                        </span>
                    </div>
                </section>

                <!-- Content & Layout -->
                <section v-if="activeSection === 'content'" id="content" class="mb-5">
                    <h3 class="fw-semibold mb-3">Content & Layout</h3>
                    <div class="row g-4">
                        <span id="text">
                            <example-ph-text @setAnchor="scrollTo('text')"/>
                        </span>
                        <span id="heading">
                            <example-ph-heading @setAnchor="scrollTo('heading')"/>
                        </span>
                        <span id="box">
                            <example-ph-box @setAnchor="scrollTo('box')"/>
                        </span>
                        <span id="stack">
                            <example-ph-stack @setAnchor="scrollTo('stack')"/>
                        </span>
                        <span id="flex">
                            <example-ph-flex @setAnchor="scrollTo('flex')"/>
                        </span>
                        <span id="row">
                            <example-ph-row @setAnchor="scrollTo('row')"/>
                        </span>
                        <span id="col">
                            <example-ph-col @setAnchor="scrollTo('col')"/>
                        </span>
                        <span id="spacer">
                            <example-ph-spacer @setAnchor="scrollTo('spacer')"/>
                        </span>
                        <span id="divider">
                            <example-ph-divider @setAnchor="scrollTo('divider')"/>
                        </span>
                    </div>
                </section>

                <!-- Server-Side -->
                <section v-if="activeSection === 'ssr'" id="ssr" class="mb-5">
                    <h2 class="h4 fw-semibold mb-3">Server-Side</h2>
                    <div class="d-flex flex-column gap-2">
                        <span id="main_navigation">
                            <example-ssr-navigation @setAnchor="scrollTo('main_navigation')" />
                        </span>
                        <span id="markdown">
                            <example-ph-markdown :html="markdownHtml" @setAnchor="scrollTo('markdown')" />
                        </span>
                    </div>
                </section>

                <!-- Footer: rendered once, after every section, because the v-if above
                     keeps only one of them mounted. scrollTo() already expands the nav
                     entry and rewrites ?section=, so it is the same trip as the sidebar. -->
                <nav
                    v-if="hasSectionNeighbours"
                    class="d-flex justify-content-between align-items-center gap-2 mt-4 pt-3 border-top"
                    aria-label="Section navigation"
                >
                    <a
                        v-if="sectionNeighbours.previous"
                        :href="'?section=' + sectionNeighbours.previous.id"
                        class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2 text-decoration-none"
                        data-no-spa
                        @click.prevent="scrollTo(sectionNeighbours.previous.id)"
                    >
                        <span aria-hidden="true">&larr;</span>
                        <span class="text-start">
                            <small class="d-block text-body-secondary">Previous</small>
                            {{ sectionNeighbours.previous.label }}
                        </span>
                    </a>
                    <span v-else></span>

                    <a
                        v-if="sectionNeighbours.next"
                        :href="'?section=' + sectionNeighbours.next.id"
                        class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2 text-decoration-none ms-auto"
                        data-no-spa
                        @click.prevent="scrollTo(sectionNeighbours.next.id)"
                    >
                        <span class="text-end">
                            <small class="d-block text-body-secondary">Next</small>
                            {{ sectionNeighbours.next.label }}
                        </span>
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                </nav>
            </div>
        </main>
    </div>
</template>

<script>
import { createSSRApp, reactive, toRefs, computed, watch, onMounted, onBeforeUnmount, nextTick, ref } from 'vue';

const SHELL_FALLBACK_HEIGHT = 'calc(100dvh - 4.75rem)';

/** Never collapse the shell below this, no matter how small the viewport gets. */
const SHELL_MIN_HEIGHT = 240;

/** Where the reader is looking, as a fraction of the scroller's height. */
const SPY_READING_RATIO = 0.35;

/** Breathing room kept above a target when scrolling it into view. */
const SPY_TARGET_PADDING = 8;

/** The one URL parameter that says where the reader is: a section id ('forms') or
 *  a component inside one ('segmented-control'), which the server maps to its parent. */
const SECTION_PARAM = 'section';

/** Where the page opens when the URL says nothing. */
const DEFAULT_SECTION = 'index';

/** Below this the sidebar cannot coexist with the content, so it becomes an
 *  off-canvas drawer. 991.98px is Bootstrap's `lg` breakpoint minus a hair, so the
 *  JS branch and the `d-lg-*` utilities flip on exactly the same pixel. */
const MOBILE_QUERY = '(max-width: 991.98px)';

/** The sidebar's width where it sits in the flow. */
const SIDEBAR_WIDTH = '260px';

/** ...and its width when it is an overlay: most of a phone, capped on tablets. */
const SIDEBAR_DRAWER_WIDTH = 'min(300px, 85vw)';

export default function mountApp(injectedContext = null) {
    if (typeof window !== 'undefined' && window.__phueApp?.unmount) {
        window.__phueApp.unmount();
    }

    // Safely retrieve state across all possible PHP/V8Js and Browser environments
    const getInitialState = () => {
        if (injectedContext) return injectedContext;
        if (typeof globalThis !== 'undefined' && globalThis.__INITIAL_STATE__) return globalThis.__INITIAL_STATE__;
        if (typeof window !== 'undefined' && window.__INITIAL_STATE__) return window.__INITIAL_STATE__;
        try { if (typeof __INITIAL_STATE__ !== 'undefined') return __INITIAL_STATE__; } catch (e) {}
        return {};
    };

    const app = createSSRApp({
        name: 'PhUI',
        setup() {
            const initState = getInitialState();

            // The server's answer before the 'index' fallback, kept apart so a plain
            // visit is not read as "show Overview" and yanked to the top on Back.
            const serverSection = initState.activeSection ?? '';

            // activeSection = which section is in the DOM (the v-if reads it, so the
            // server must get it right); activeAnchor = which component is in view.
            const state = reactive({
                activeSection: initState.activeSection ?? DEFAULT_SECTION,
                activeAnchor: initState.activeAnchor ?? '',
                searchQuery: initState.searchQuery ?? '',
                navItems: [],
                markdownHtml: initState.markdownHtml ?? '',
            });

            const shellEl = ref(null);
            const mainEl = ref(null);
            const contentEl = ref(null);
            const shellHeight = ref(initState.shellHeight ?? SHELL_FALLBACK_HEIGHT);
            const expandedSections = reactive({});

            // Below `lg` the sidebar is a drawer: it must be out of the flow, so it
            // cannot be laid out by CSS alone (there is no stylesheet to put a media
            // query in) — the breakpoint is mirrored in JS and drives an inline style.
            const isMobile = ref(false);
            const sidebarOpen = ref(false);

            /** Flat, DOM-ordered list of every spy target (sections + their components). */
            const orderedSpyIds = computed(() => {
                const ids = [];
                for (const nav of state.navItems) {
                    ids.push(nav.id);
                    for (const comp of nav.components) ids.push(comp.id);
                }
                return ids;
            });

            // --- OPTIMIZED SPY CACHE (Eliminates Layout Thrashing) ---
            let targetsCache = null;

            function invalidateElementCache() {
                targetsCache = null;
            }

            /** Batches all DOM reads into a single layout pass to prevent reflow. */
            function getTargetPositions() {
                const main = mainEl.value;
                if (!main) return [];

                if (targetsCache === null) {
                    const mainTop = main.getBoundingClientRect().top;
                    const mainScrollTop = main.scrollTop;
                    const list = [];

                    // Single BATCH DOM READ pass
                    for (const id of orderedSpyIds.value) {
                        const el = document.getElementById(id);
                        if (el) {
                            const rect = el.getBoundingClientRect();
                            const relativeTop = rect.top - mainTop + mainScrollTop;
                            list.push({ id, top: relativeTop, bottom: relativeTop + rect.height });
                        }
                    }
                    targetsCache = list;
                }
                return targetsCache;
            }

            /** Returns the nav group id owning the given target id, or null. */
            function parentGroupOf(id) {
                for (const nav of state.navItems) {
                    if (nav.id === id) return nav.id;
                    if (nav.components.some((comp) => comp.id === id)) return nav.id;
                }
                return null;
            }

            /** True when the id names a section rather than a component inside one. */
            function isSectionId(id) {
                return state.navItems.some((nav) => nav.id === id);
            }

            /** Opens a section and reveals it in the nav. Section-level only: it swaps
             *  the DOM, so moving a highlight inside the current one is markAnchor(). */
            function setActiveSection(id, expand = true) {
                if (!id || !isSectionId(id) || state.activeSection === id) return;
                state.activeSection = id;
                if (!expand) return;
                expandedSections[id] = true;
            }

            /** Moves the highlight onto a component. The only thing the spy writes. */
            function markAnchor(id) {
                if (!id) return;
                state.activeAnchor = id;
            }

            function prefersReducedMotion() {
                return typeof window.matchMedia === 'function'
                    && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            }

            /** Scrolls the target to the top of the scroller. Never scrollIntoView():
             *  it scrolls every scrollable ancestor and would drag the whole layout. */
            function scrollTargetIntoView(id) {
                const el = document.getElementById(id);
                const main = mainEl.value;
                if (!el || !main) return;
                const delta = el.getBoundingClientRect().top - main.getBoundingClientRect().top;
                main.scrollTo({
                    top: Math.max(0, main.scrollTop + delta - SPY_TARGET_PADDING),
                    behavior: prefersReducedMotion() ? 'auto' : 'smooth',
                });
            }

            /** Navigates to a section or a component. A section id swaps the DOM, so
             *  its scroll waits for nextTick; a component is already on screen. */
            function scrollTo(id) {
                if (!id) return;

                // Picking a destination on a phone should land on the destination,
                // not on the drawer the reader just touched.
                if (isMobile.value) {
                    sidebarOpen.value = false;
                }

                if (isSectionId(id)) {
                    setActiveSection(id);
                    markAnchor(id);
                    nextTick(() => scrollTargetIntoView(id));
                } else {
                    const group = parentGroupOf(id);
                    if (group && group !== state.activeSection) {
                        // The component lives in a section that is not mounted.
                        setActiveSection(group);
                        nextTick(() => scrollTargetIntoView(id));
                    } else {
                        markAnchor(id);
                        scrollTargetIntoView(id);
                    }
                }

                syncUrl(id, { push: true });
            }

            function toggleSection(id) {
                expandedSections[id] = !expandedSections[id];
            }

            // Only one section is mounted at a time, so the footer can live once,
            // after them all: it renders against whichever section is active. The
            // order comes from navItems, so the two can never disagree.
            /** The active section's neighbours, or null at either end. */
            const sectionNeighbours = computed(() => {
                // Every nav group is a section, including Overview, which has no
                // components of its own — filtering on `components` would drop it and
                // strand the reader on the first page.
                const sections = state.navItems;
                const index = sections.findIndex((nav) => nav.id === state.activeSection);
                if (index === -1) return { previous: null, next: null };

                const pick = (offset) => {
                    const target = sections[index + offset];
                    if (!target) return null;

                    // Land on the section's first component when it has one: arriving
                    // at "Form Controls" should put the reader in front of Button, not
                    // at a heading with nothing under it. A section with no components
                    // (Overview) is its own destination.
                    const first = target.components?.[0];
                    return { id: first ? first.id : target.id, label: target.label };
                };

                return { previous: pick(-1), next: pick(1) };
            });

            // Flat, not derived from sectionNeighbours: the SSR renderer evaluates a
            // v-if from setup's bindings only, and a computed that reads another
            // computed comes back undefined and the block is dropped.
            const hasSectionNeighbours = computed(() => {
                const sections = state.navItems;
                const index = sections.findIndex((nav) => nav.id === state.activeSection);
                if (index === -1) return true;
                return index > 0 || index < sections.length - 1;
            });

            // URL as the single source of truth for "where am I": one ?section= id
            // replaced the server param and the client-written #fragment, which disagreed.

            /** The id in ?section=, or '' when absent. */
            function locationId() {
                try {
                    return new URL(window.location.href).searchParams.get(SECTION_PARAM) || '';
                } catch (e) {
                    return '';
                }
            }

            /** Writes the current location into the URL: push for navigation, replace
             *  for the spy — pushing per target would walk the scrollback on Back. */
            function syncUrl(id, { push = false } = {}) {
                if (!id || typeof history === 'undefined') return;

                const url = new URL(window.location.href);
                if (id === DEFAULT_SECTION) {
                    url.searchParams.delete(SECTION_PARAM);
                } else {
                    url.searchParams.set(SECTION_PARAM, id);
                }
                url.hash = '';

                const next = url.pathname + url.search;
                if (push) history.pushState({ [SECTION_PARAM]: id }, '', next);
                else history.replaceState({ [SECTION_PARAM]: id }, '', next);
            }

            /** Applies a location id from outside the page: the server on first paint,
             *  or the Back button afterwards. */
            function applyLocation(id) {
                if (!id) {
                    spyArmed = true;
                    return;
                }

                if (isSectionId(id)) {
                    setActiveSection(id);
                    markAnchor(id);
                } else {
                    const group = parentGroupOf(id);
                    if (group) setActiveSection(group);
                    markAnchor(id);
                }

                nextTick(() => {
                    invalidateElementCache();
                    scrollTargetIntoView(id);
                    observeSpyTargets();
                    spyArmed = true;
                });
            }

            /** Scroll spy driven by IntersectionObserver, with no scroll handler (one
             *  forced a reflow per frame); it is only a trigger for the position read. */
            let spyObserver = null;

            // The spy is the URL's writer and applyLocation is its reader, so the
            // spy must stay quiet until the location has been handed to the scroller.
            let spyArmed = false;

            function observeSpyTargets() {
                spyObserver?.disconnect();
                spyObserver = null;

                const main = mainEl.value;
                if (!main || typeof IntersectionObserver === 'undefined') return;

                // A 1px band at the reading line makes the observer an edge trigger: it
                // fires exactly when the line enters or leaves a target, nothing else.
                const band = Math.max(1, Math.round(main.clientHeight * SPY_READING_RATIO));

                spyObserver = new IntersectionObserver(() => {
                    invalidateElementCache();
                    syncActiveFromScroll();
                }, {
                    root: main,
                    rootMargin: `-${band}px 0px -${Math.max(0, main.clientHeight - band - 1)}px 0px`,
                    threshold: 0
                });

                for (const id of orderedSpyIds.value) {
                    const el = document.getElementById(id);
                    if (el) spyObserver.observe(el);
                }

                invalidateElementCache();
                syncActiveFromScroll();
            }

            /** Picks the target the reader is on. Only ever writes activeAnchor: a
             *  section-level write here would unmount the section the server rendered. */
            function syncActiveFromScroll() {
                if (!spyArmed) return;

                const main = mainEl.value;
                if (!main) return;

                const positions = getTargetPositions();
                if (!positions.length) return;

                const scrollTop = main.scrollTop;

                // The scroller ran out of content first, so the last target can
                // never reach the reading line: the end of the list wins.
                if (scrollTop + main.clientHeight >= main.scrollHeight - 2) {
                    markAnchor(positions[positions.length - 1].id);
                    syncUrl(state.activeAnchor, { push: false });
                    return;
                }

                // The reading line, in the same content space as the positions.
                const line = scrollTop + Math.round(main.clientHeight * SPY_READING_RATIO);

                // Active = the target the line is inside, not the one that merely reached
                // it; a section contains its components, so the innermost one wins.
                let current = null;
                for (const item of positions) {
                    if (item.top > line || item.bottom <= line) continue;
                    if (!current || item.top > current.top) current = item;
                }

                // The line is in a margin or a gap between two examples: the last
                // target that reached it is still what the reader just read.
                if (!current) {
                    for (let i = positions.length - 1; i >= 0; i--) {
                        if (positions[i].top <= line) {
                            current = positions[i];
                            break;
                        }
                    }
                }

                markAnchor((current || positions[0]).id);
                syncUrl(state.activeAnchor, { push: false });
            }

            /** Fallback for engines without IntersectionObserver: poll on scroll. */
            let spyFrame = 0;
            function requestSpySync() {
                if (spyFrame || spyObserver) return;
                spyFrame = requestAnimationFrame(() => {
                    spyFrame = 0;
                    invalidateElementCache();
                    syncActiveFromScroll();
                });
            }

            /** Pins the shell to the space the layout leaves below the topbar, so the
             *  page never scrolls as a whole and the sidebar cannot move. */
            function measureShell() {
                const shell = shellEl.value;
                if (!shell) return;
                const absoluteTop = shell.getBoundingClientRect().top + (window.scrollY || 0);
                const viewport = document.documentElement.clientHeight || window.innerHeight;
                shellHeight.value = `${Math.round(Math.max(SHELL_MIN_HEIGHT, viewport - absoluteTop))}px`;
            }

            function onResize() {
                invalidateElementCache();
                measureShell();
                if (spyObserver) {
                    // Positions are relative to the scroller's scrollTop, so a
                    // resize invalidates them; the observer re-fires on layout.
                    invalidateElementCache();
                    syncActiveFromScroll();
                } else {
                    requestSpySync();
                }
            }

            function syncExpandedSections() {
                const query = String(state.searchQuery || '').trim().toLowerCase();
                const activeGroup = parentGroupOf(state.activeSection);
                for (const nav of state.navItems) {
                    if (nav.id === activeGroup) {
                        expandedSections[nav.id] = true;
                        continue;
                    }
                    if (!query) continue;
                    expandedSections[nav.id] = nav.label.toLowerCase().includes(query)
                        || nav.components.some((comp) => comp.label.toLowerCase().includes(query));
                }
            }

            const filteredNavItems = computed(() => {
                const query = String(state.searchQuery || '').trim().toLowerCase();
                if (!query) return state.navItems;
                return state.navItems
                    .map((nav) => ({
                        ...nav,
                        components: nav.components.filter((comp) =>
                            comp.label.toLowerCase().includes(query),
                        ),
                    }))
                    .filter((nav) =>
                        nav.label.toLowerCase().includes(query) || nav.components.length > 0,
                    );
            });

            // Hydration mismatch avoider logic
            const hydrateNavData = () => {
                state.navItems = (initState.navItems ?? []).map((nav) => ({
                    ...nav,
                    components: nav.components ?? [],
                }));
                invalidateElementCache();
                syncExpandedSections();
            };

            if (typeof window === 'undefined') {
                // SERVER: Always try to populate data immediately
                hydrateNavData();
            } else {
                // CLIENT: Check if the server actually successfully rendered the sidebar elements
                const navEl = document.querySelector('.phue-sidebar nav');

                if (navEl && navEl.children.length > 0) {
                    // The server successfully rendered the HTML data. Safe to hydrate immediately.
                    hydrateNavData();
                } else {
                    // The server rendered an empty sidebar.
                    // We MUST wait until after mount to populate data, or Vue will throw a mismatch!
                    onMounted(() => {
                        hydrateNavData();
                        nextTick(() => observeSpyTargets());
                    });
                }
            }

            watch(() => state.searchQuery, () => {
                invalidateElementCache();
                syncExpandedSections();
            });

            watch(() => state.navItems.length, () => {
                invalidateElementCache();
                nextTick(() => observeSpyTargets());
            });

            // Swapping the section replaces every observed element inside it, so the
            // observer has to be rebuilt against the new DOM.
            watch(() => state.activeSection, () => {
                invalidateElementCache();
                nextTick(() => observeSpyTargets());
            });

            let topbarObserver = null;
            let contentObserver = null;

            /** Back/forward across the entries scrollTo() pushed. Reuses applyLocation()
             *  so a history entry and a nav click can never take different paths. */
            function onPopState() {
                applyLocation(locationId());
            }

            /** Mirrors the `lg` breakpoint in JS: below it the sidebar is a drawer. */
            let mobileQuery = null;

            function onBreakpointChange(event) {
                isMobile.value = event.matches;
                // Growing into the desktop layout must not strand an open drawer,
                // because from lg up there is no scrim and no trigger left to close it.
                if (!event.matches) {
                    sidebarOpen.value = false;
                }
                invalidateElementCache();
                measureShell();
            }

            function onKeydown(event) {
                if (event.key === 'Escape' && sidebarOpen.value) {
                    sidebarOpen.value = false;
                }

                // Ctrl/Cmd+K focuses the component search, the same shortcut the docs
                // page binds. The search only exists above `lg` or in an open drawer,
                // so a shortcut press has to open the sidebar first or there is
                // nothing to focus and the browser's own "open search" UI takes over.
                if (!(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey) {
                    return;
                }
                if (event.key.toLowerCase() !== 'k') {
                    return;
                }

                if (isMobile.value && !sidebarOpen.value) {
                    sidebarOpen.value = true;
                }

                // The field is behind v-if on the drawer, so it does not exist yet on
                // the tick the shortcut is pressed; nextTick lands after the render.
                nextTick(() => {
                    const search = document.getElementById('phui-search-input');
                    if (!search) {
                        return;
                    }
                    event.preventDefault();
                    search.focus();
                    search.select();
                });
            }

            onMounted(() => {
                measureShell();
                window.addEventListener('resize', onResize);
                window.addEventListener('popstate', onPopState);
                document.addEventListener('keydown', onKeydown);

                // isMobile has to be correct before the first paint of the drawer,
                // and the server cannot know the viewport — start from the current one
                // and follow it from here on.
                if (typeof window.matchMedia === 'function') {
                    mobileQuery = window.matchMedia(MOBILE_QUERY);
                    isMobile.value = mobileQuery.matches;
                    if (typeof mobileQuery.addEventListener === 'function') {
                        mobileQuery.addEventListener('change', onBreakpointChange);
                    } else if (typeof mobileQuery.addListener === 'function') {
                        // Safari < 14 and friends.
                        mobileQuery.addListener(onBreakpointChange);
                    }
                }

                // The topbar can wrap or grow, which moves the shell without resizing it.
                const topbar = document.querySelector('.app-topbar');
                if (topbar && typeof ResizeObserver !== 'undefined') {
                    topbarObserver = new ResizeObserver(onResize);
                    topbarObserver.observe(topbar);
                }

                // Late-growing content (async components, webfonts) changes target positions.
                if (contentEl.value && typeof ResizeObserver !== 'undefined') {
                    contentObserver = new ResizeObserver(() => {
                        invalidateElementCache();
                        if (spyObserver) syncActiveFromScroll();
                        else requestSpySync();
                    });
                    contentObserver.observe(contentEl.value);
                }

                observeSpyTargets();

                // First paint honours the server's answer: ?section= and the injected state
                // always agree. applyLocation() disarms the spy until the scroll is handed over.
                applyLocation(locationId() || serverSection);
            });

            onBeforeUnmount(() => {
                window.removeEventListener('resize', onResize);
                window.removeEventListener('popstate', onPopState);
                document.removeEventListener('keydown', onKeydown);
                if (mobileQuery) {
                    if (typeof mobileQuery.removeEventListener === 'function') {
                        mobileQuery.removeEventListener('change', onBreakpointChange);
                    } else if (typeof mobileQuery.removeListener === 'function') {
                        mobileQuery.removeListener(onBreakpointChange);
                    }
                }
                topbarObserver?.disconnect();
                contentObserver?.disconnect();
                spyObserver?.disconnect();
                if (spyFrame) cancelAnimationFrame(spyFrame);
            });

            return {
                ...toRefs(state),
                shellEl,
                mainEl,
                contentEl,
                shellHeight,
                filteredNavItems,
                expandedSections,
                isMobile,
                sidebarOpen,
                toggleSection,
                scrollTo,
                sectionNeighbours,
                hasSectionNeighbours
            };
        }
    });

    // Ensure we only attach to window and mount if we are in the browser
    if (typeof window !== 'undefined') {
        window.__phueApp = app;
        window.__phueApp.mount('#app');
    }

    return app;
};
</script>
