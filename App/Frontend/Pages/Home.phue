<php>
return [
    'title' => 'Phue App',
    'state' => [
        'testValue' => $testValue ?? 'none',
    ],
];
</php>

<template>
<div class="d-flex flex-column gap-2 p-4">
    <h2>Phue App</h2>
    {{testValue}}
</div>
</template>

<script>
import { ref } from 'vue';
export default function mountApp() {
    window.__phueApp = createPhueApp({
        setup() {
            const testValue = ref(window.__INITIAL_STATE__.testValue);
            return { testValue };
        }
    });
}
</script>