<php>

use App\Config\NavigationConfig;

/**
 * @var string $content
 * @var string $uri
 * @var array $items
 * @var string $cacheKey
 * @var array $cache
 * @var \Phue\Core\UI\PhuePartialRenderer $partialRenderer
 */
$content = $content ?? '';
$uri = $uri ?? '/';
$items = $items ?? (class_exists(NavigationConfig::class) ? NavigationConfig::getAppItems() : []);
static $cache = [];

$cacheKey = 'nav_html_' . md5(serialize($items) . $uri);
    
if (isset($cache[$cacheKey])) {
    $navHtml = $cache[$cacheKey];
} else {
    $navHtml = $partialRenderer->renderPartial('PhNavigation', [
        'items' => $items,
        'uri'   => $uri
    ]);
    $cache[$cacheKey] = $navHtml;
}

return [
    'html' => sprintf(
        '<div class="app-layout">%s<main class="app-content">%s</main></div>',
        $navHtml,
        $content
    ),
];
</php>
<template>
<!-- App -->
</template>
