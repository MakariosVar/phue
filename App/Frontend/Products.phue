<php>
return [
    'title' => 'Phue App - Products',
    'state' => [
        'value' => $testValue ?? 'none',
        'products' => [
            ['id' => 1, 'name' => 'Widget A', 'price' => 19.99],
            ['id' => 2, 'name' => 'Widget B', 'price' => 29.99],
        ],
    ],
];
</php>

<template>
<div class="d-flex flex-column gap-2 p-4">
    <h2>Product Catalog</h2>
    <ul class="m-0 p-0 d-flex flex-column gap-1">
        <li v-for="p in products" :key="p.id" class="p-2">
            {{ p.name }} - ${{ p.price }}
        </li>
    </ul>
    {{testValue}}
</div>
</template>

<script>
import { createApp, ref } from '/assets/vendor/vue3/vue.esm-browser.js';

export default function mountApp() {
    window.__phueApp = createApp({
        setup() {
            const products = ref(window.__INITIAL_STATE__.products || []);
            const testValue = ref(window.__INITIAL_STATE__.value);
            return { products, testValue };
        }
    });
    window.__phueApp.mount('#app');
}

mountApp();
</script>